#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
demos_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
repo_root=$(CDPATH= cd -- "$demos_dir/../.." && pwd)
runtime_dir="$demos_dir/.runtime"
report_file="$runtime_dir/level-a-report.tsv"
capability_file="$demos_dir/level-a-capabilities.tsv"
active_ops=

cleanup_active() {
  if [ -n "$active_ops" ]; then
    "$active_ops" reset --confirm-destroy-data >/dev/null 2>&1 || true
  fi
}

trap cleanup_active EXIT HUP INT TERM

validate_capabilities() {
  [ -f "$capability_file" ] || { echo "missing $capability_file" >&2; exit 1; }
  awk -F '\t' '
    NF != 3 { print "invalid Level A capability row " NR > "/dev/stderr"; failed=1 }
    $1 !~ /^(contract-ledger|money-flow-ledger|people-groups|evidence-service|project-workspace|design-operations)$/ { print "unknown Level A application on row " NR > "/dev/stderr"; failed=1 }
    $2 !~ /^(complete|partial)$/ { print "invalid Level A capability status on row " NR > "/dev/stderr"; failed=1 }
    seen[$1]++
    END {
      if (NR != 6) { print "Level A capability manifest must contain six rows" > "/dev/stderr"; failed=1 }
      for (name in seen) if (seen[name] != 1) { print "duplicate Level A application: " name > "/dev/stderr"; failed=1 }
      exit failed
    }
  ' "$capability_file"
}

validate_report() {
  [ -s "$report_file" ] || { echo 'no Level A runtime report; run audit first' >&2; exit 1; }
  awk -F '\t' '
    NF != 3 { print "invalid Level A runtime row " NR > "/dev/stderr"; failed=1 }
    $1 !~ /^(contract-ledger|money-flow-ledger|people-groups|evidence-service|project-workspace|design-operations)$/ { print "unknown Level A runtime application on row " NR > "/dev/stderr"; failed=1 }
    $2 != "passed" { print "Level A runtime application did not pass on row " NR > "/dev/stderr"; failed=1 }
    $3 != "fresh-state,run,replay,cleanup" { print "incomplete Level A runtime evidence on row " NR > "/dev/stderr"; failed=1 }
    seen[$1]++
    END {
      if (NR != 6) { print "Level A runtime report must contain six rows" > "/dev/stderr"; failed=1 }
      for (name in seen) if (seen[name] != 1) { print "duplicate Level A runtime application: " name > "/dev/stderr"; failed=1 }
      exit failed
    }
  ' "$report_file"
}

run_step() {
  label=$1
  shift
  log_file=$1
  shift
  echo "  - $label"
  if "$@" >"$log_file" 2>&1; then
    sed 's/^/      /' "$log_file"
    return 0
  fi
  sed 's/^/      /' "$log_file" >&2
  return 1
}

run_demo() {
  name=$1
  directory=$2
  ops="$demos_dir/$directory/ops/demo"
  log_prefix="$runtime_dir/$name"
  active_ops=$ops

  echo "[$name] fresh-state → run → replay → cleanup"
  "$ops" init
  "$ops" reset --confirm-destroy-data >/dev/null 2>&1 || true
  run_step run "$log_prefix.run.log" "$ops" run
  run_step replay "$log_prefix.replay.log" "$ops" replay
  run_step cleanup "$log_prefix.cleanup.log" "$ops" reset --confirm-destroy-data
  active_ops=
  printf '%s\tpassed\tfresh-state,run,replay,cleanup\n' "$name" >>"$report_file"
}

show_result() {
  validate_report
  echo
  echo 'Runtime gate:'
  sed 's/^/  /' "$report_file"
  echo
  echo 'Business capability gate:'
  awk -F '\t' '{ printf "  %s\t%s\t%s\n", $1, $2, $3 }' "$capability_file"
  if awk -F '\t' '$2 != "complete" { found=1 } END { exit !found }' "$capability_file"; then
    echo
    echo 'LEVEL_A_STATUS=blocked'
    echo 'All six runtime demos passed, but partial capability rows must be completed or explicitly deferred before Level A can pass.'
  else
    echo
    echo 'LEVEL_A_STATUS=passed'
  fi
  echo "REPORT=$report_file"
}

case "${1:-}" in
  audit)
    if [ "${2:-}" != "--confirm-destroy-demo-data" ]; then
      echo 'audit resets only the six synthetic Demo data sets; rerun with --confirm-destroy-demo-data' >&2
      exit 1
    fi
    command -v docker >/dev/null 2>&1 || { echo 'docker is required' >&2; exit 1; }
    if [ ! -f "$demos_dir/.release-bundle" ]; then
      command -v go >/dev/null 2>&1 || { echo 'go is required outside a source-free release bundle' >&2; exit 1; }
    fi
    validate_capabilities
    mkdir -p "$runtime_dir"
    : >"$report_file"
    run_demo contract-ledger contract-ledger
    run_demo money-flow-ledger money-flow-ledger
    run_demo people-groups people-groups
    run_demo evidence-service evidence-service
    run_demo project-workspace project-workspace
    run_demo design-operations design-operations
    show_result
    ;;
  status)
    validate_capabilities
    show_result
    ;;
  *)
    echo "usage: $0 {audit --confirm-destroy-demo-data|status}" >&2
    exit 1
    ;;
esac
