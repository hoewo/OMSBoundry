FROM golang:1.26.0-alpine AS build
WORKDIR /src
COPY acceptance/project-workspace-demo/go.mod ./
COPY acceptance/project-workspace-demo/cmd/reference-stub ./cmd/reference-stub
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/reference-stub ./cmd/reference-stub

FROM alpine:3.22
RUN addgroup -S app && adduser -S -G app app
COPY --from=build /out/reference-stub /usr/local/bin/reference-stub
USER app
EXPOSE 9090
ENTRYPOINT ["reference-stub"]
