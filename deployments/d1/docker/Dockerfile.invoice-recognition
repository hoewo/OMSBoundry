# syntax=docker/dockerfile:1.7
ARG GO_IMAGE=golang:1.26.0-alpine
ARG RUNTIME_IMAGE=postgres:18.6-alpine
FROM ${GO_IMAGE} AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY packages/workload-identity ./packages/workload-identity
COPY packages/invoice-recognition-contract ./packages/invoice-recognition-contract
COPY backend/services/invoice-recognition/go.mod backend/services/invoice-recognition/go.sum ./backend/services/invoice-recognition/
RUN --mount=type=cache,id=oms-go-mod,target=/go/pkg/mod,sharing=locked cd backend/services/invoice-recognition && GOWORK=off go mod download
COPY backend/services/invoice-recognition/ ./backend/services/invoice-recognition/
RUN --mount=type=cache,id=oms-go-build,target=/root/.cache/go-build,sharing=locked cd backend/services/invoice-recognition \
 && GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/server ./cmd/server \
 && GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/ops ./cmd/ops \
 && GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/workload-keyctl ./cmd/workload-keyctl
FROM ${RUNTIME_IMAGE}
RUN apk add --no-cache poppler-utils tesseract-ocr tesseract-ocr-data-chi_sim tesseract-ocr-data-eng
RUN mkdir -p /app /workload-private /workload-public /backups && chown -R postgres:postgres /app /backups
COPY --from=build /out/server /out/ops /out/workload-keyctl /app/
COPY --chown=postgres:postgres backend/services/invoice-recognition/ops/backup backend/services/invoice-recognition/ops/restore-empty /app/
USER postgres
ENTRYPOINT []
CMD ["/app/server"]
