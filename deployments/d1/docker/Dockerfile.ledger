# syntax=docker/dockerfile:1.7
ARG GO_IMAGE=golang:1.26.0-alpine
ARG RUNTIME_IMAGE=postgres:18.6-alpine
FROM ${GO_IMAGE} AS build
ARG APP
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY backend/services/${APP}/go.mod backend/services/${APP}/go.sum ./backend/services/${APP}/
COPY packages/workload-identity/go.mod ./packages/workload-identity/
COPY packages/workload-identity/ ./packages/workload-identity/
COPY packages/payable-suggestion-contract/go.mod ./packages/payable-suggestion-contract/
COPY packages/payable-suggestion-contract/ ./packages/payable-suggestion-contract/
WORKDIR /src/backend/services/${APP}
RUN --mount=type=cache,id=oms-go-mod,target=/go/pkg/mod,sharing=locked go mod download
WORKDIR /src
COPY backend/services/${APP}/ ./backend/services/${APP}/
WORKDIR /src/backend/services/${APP}
RUN --mount=type=cache,id=oms-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=oms-go-build,target=/root/.cache/go-build,sharing=locked \
    GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/server ./cmd/server \
    && GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/ops ./cmd/ops \
    && GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/backup ./cmd/backup

WORKDIR /src/packages/workload-identity
RUN --mount=type=cache,id=oms-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=oms-go-build,target=/root/.cache/go-build,sharing=locked \
    GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/workload-keyctl ./cmd/workload-keyctl

FROM ${RUNTIME_IMAGE}
RUN mkdir -p /app /data/evidence /config /backups && chown -R postgres:postgres /app /data/evidence /backups
COPY --from=build /out/server /out/ops /out/backup /out/workload-keyctl /app/
USER postgres
ENTRYPOINT []
CMD ["/app/server"]
