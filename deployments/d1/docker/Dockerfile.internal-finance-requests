# syntax=docker/dockerfile:1.7
ARG GO_IMAGE=golang:1.26.0-alpine
ARG RUNTIME_IMAGE=postgres:18.6-alpine
FROM ${GO_IMAGE} AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY packages/workload-identity ./packages/workload-identity
COPY backend/services/internal-finance-requests/go.mod backend/services/internal-finance-requests/go.sum ./backend/services/internal-finance-requests/
RUN --mount=type=cache,id=oms-go-mod,target=/go/pkg/mod,sharing=locked cd backend/services/internal-finance-requests && GOWORK=off go mod download
COPY backend/services/internal-finance-requests/ ./backend/services/internal-finance-requests/
RUN --mount=type=cache,id=oms-go-build,target=/root/.cache/go-build,sharing=locked cd backend/services/internal-finance-requests \
 && GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/server ./cmd/server \
 && GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/ops ./cmd/ops \
 && GOWORK=off CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags='-s -w' -o /out/workload-keyctl ./cmd/workload-keyctl
FROM ${RUNTIME_IMAGE}
RUN mkdir -p /app /workload-private /workload-public /backups && chown -R postgres:postgres /app /backups
COPY --from=build /out/server /out/ops /out/workload-keyctl /app/
COPY --chown=postgres:postgres backend/services/internal-finance-requests/ops/backup backend/services/internal-finance-requests/ops/restore-empty /app/
USER postgres
ENTRYPOINT []
CMD ["/app/server"]
