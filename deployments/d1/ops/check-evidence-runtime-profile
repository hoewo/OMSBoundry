#!/bin/sh
# Runs inside Evidence. Compare only non-secret profile variables, not env dumps.
set -eu
expected=${1:?expected storage mode required}
primary=${2:-}
case "$expected" in local|hybrid|aliyun-oss) ;; *) exit 2;; esac
[ "${STORAGE_PROVIDER:-local}" = "$expected" ] || {
  echo 'Evidence runtime storage mode does not match the selected D1 profile' >&2
  exit 1
}
if [ "$expected" = hybrid ]; then
  case "$primary" in local|aliyun-oss) ;; *) exit 2;; esac
  [ "${PRIMARY_STORAGE_PROVIDER:-}" = "$primary" ] || {
    echo 'Evidence runtime Primary does not match the selected D1 profile' >&2
    exit 1
  }
fi
