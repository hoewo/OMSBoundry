#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
d1_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
compose_file="$d1_dir/compose.yaml"
pull_compose_file="$d1_dir/compose.pull.yaml"
https_compose_file="$d1_dir/compose.https.yaml"
evidence_oss_compose_file="$d1_dir/compose.evidence-oss.yaml"
env_file=${D1_ENV_FILE:-"$d1_dir/.env"}
project=${D1_PROJECT_NAME:-omsbizfoundry}
compose_override_file=${D1_COMPOSE_OVERRIDE_FILE:-}

usage() {
  echo "usage: D1_ENV_FILE=path $0 up|apply|status|check|config|images|prepare-images|preflight-upgrade|party-map contract|money INPUT_JSON|purge-open-api-usage OPERATOR_ID|backup|upgrade|restore BACKUP_ID|down" >&2
  exit 2
}

[ -f "$env_file" ] || {
  echo "D1 environment file not found: $env_file (copy .env.example to .env and replace every placeholder)" >&2
  exit 2
}

env_value() {
  key="$1"
  fallback="${2:-}"
  value=$(awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' "$env_file")
  if [ -n "$value" ]; then printf '%s' "$value"; else printf '%s' "$fallback"; fi
}

enable_contract=$(env_value ENABLE_CONTRACT true)
enable_money=$(env_value ENABLE_MONEY true)
enable_people=$(env_value ENABLE_PEOPLE true)
enable_party=$(env_value ENABLE_PARTY true)
enable_project=$(env_value ENABLE_PROJECT true)
enable_evidence=$(env_value ENABLE_EVIDENCE true)
enable_business_engagement=$(env_value ENABLE_BUSINESS_ENGAGEMENT false)
enable_billing=$(env_value ENABLE_BILLING false)
enable_production=$(env_value ENABLE_PRODUCTION false)
enable_approval_audit_results=$(env_value ENABLE_APPROVAL_AUDIT_RESULTS false)
enable_cost_outsourcing=$(env_value ENABLE_COST_OUTSOURCING false)
enable_bonus_distribution=$(env_value ENABLE_BONUS_DISTRIBUTION false)
enable_internal_finance_requests=$(env_value ENABLE_INTERNAL_FINANCE_REQUESTS false)
enable_payroll=$(env_value ENABLE_PAYROLL false)
reference_oa_bonus_profile=$(env_value REFERENCE_OA_BONUS_PROFILE)
reference_oa_personnel_profile=$(env_value REFERENCE_OA_PRODUCTION_PERSONNEL_PROFILE)
reference_oa_stage_profile=$(env_value REFERENCE_OA_PRODUCTION_STAGE_PROFILE)
oms_operating_party_id=$(env_value OMS_OPERATING_PARTY_ID)
oms_legacy_party_id=$(env_value OMS_QUALIFICATION_PARTY_ID)
if [ -n "$oms_operating_party_id" ] && [ -n "$oms_legacy_party_id" ] && [ "$oms_operating_party_id" != "$oms_legacy_party_id" ]; then
  echo "OMS_OPERATING_PARTY_ID conflicts with legacy OMS_QUALIFICATION_PARTY_ID" >&2
  exit 2
fi
[ -n "$oms_operating_party_id" ] || oms_operating_party_id=$oms_legacy_party_id
image_mode=$(env_value D1_IMAGE_MODE build)
ingress_mode=$(env_value D1_INGRESS_MODE http)
evidence_storage_mode=$(env_value D1_EVIDENCE_STORAGE_PROVIDER local)
tenant_id=$(env_value TENANT_ID)
backup_setting=$(env_value D1_BACKUP_DIR ./.runtime/backups)
backup_drain_seconds=$(env_value D1_BACKUP_DRAIN_SECONDS 5)
if [ -f "$d1_dir/.release-bundle" ] && [ "$image_mode" != pull ]; then
  echo "D1 release bundles only support D1_IMAGE_MODE=pull; target hosts must not rebuild application images" >&2
  exit 2
fi
case "$backup_setting" in
  /*) backup_dir="$backup_setting" ;;
  *) backup_dir="$d1_dir/${backup_setting#./}" ;;
esac

validate_port() {
  name=$1
  port=$2
  case "$port" in ''|*[!0-9]*) echo "$name must be an integer from 1 to 65535" >&2; exit 2 ;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || {
    echo "$name must be an integer from 1 to 65535" >&2
    exit 2
  }
}

validate_feedback_url() {
  name=$1
  raw=$2
  case "$raw" in
    https://?*) ;;
    http://127.0.0.1|http://127.0.0.1:*|http://127.0.0.1/*|http://localhost|http://localhost:*|http://localhost/*) ;;
    *) echo "$name must use HTTPS or loopback HTTP" >&2; exit 2 ;;
  esac
  case "$raw" in *[[:space:]]*) echo "$name must not contain whitespace" >&2; exit 2;; esac
}

validate_feedback_api_key() {
  raw=$1
  [ "${#raw}" -ge 24 ] || { echo "Feedback API Keys must contain at least 24 characters" >&2; exit 2; }
  case "$raw" in *[[:space:],]*) echo "Feedback API Keys must not contain whitespace or commas" >&2; exit 2;; esac
}

validate_feedback_config() {
  feedback_sdk_url=$(env_value FEEDBACK_SDK_URL)
  feedback_auth_mode=$(env_value FEEDBACK_AUTH_MODE)
  feedback_gateway_url=$(env_value FEEDBACK_GATEWAY_URL)
  feedback_project_id=$(env_value FEEDBACK_PROJECT_ID)
  feedback_api_key=$(env_value FEEDBACK_API_KEY)
  feedback_api_keys=$(env_value FEEDBACK_API_KEYS)
  feedback_identity_hmac_key=$(env_value FEEDBACK_IDENTITY_HMAC_KEY)
  feedback_identity_version=$(env_value FEEDBACK_IDENTITY_VERSION v1)
  feedback_notifications_enabled=$(env_value FEEDBACK_NOTIFICATIONS_ENABLED false)

  feedback_configured=false
  for value in "$feedback_sdk_url" "$feedback_auth_mode" "$feedback_gateway_url" "$feedback_project_id" "$feedback_api_key" "$feedback_api_keys" "$feedback_identity_hmac_key"; do
    [ -z "$value" ] || feedback_configured=true
  done
  [ "$feedback_notifications_enabled" = false ] || feedback_configured=true
  [ "$feedback_configured" = true ] || return 0

  [ "$feedback_auth_mode" = apiKey ] || { echo "FEEDBACK_AUTH_MODE must be apiKey for the first release" >&2; exit 2; }
  validate_feedback_url FEEDBACK_SDK_URL "$feedback_sdk_url"
  validate_feedback_url FEEDBACK_GATEWAY_URL "$feedback_gateway_url"
  [ "$feedback_project_id" = 115 ] || { echo "FEEDBACK_PROJECT_ID must be 115 for this OMS1 release" >&2; exit 2; }
  [ "$feedback_identity_version" = v1 ] || { echo "FEEDBACK_IDENTITY_VERSION must be v1" >&2; exit 2; }
  case "$feedback_notifications_enabled" in true|false) ;; *) echo "FEEDBACK_NOTIFICATIONS_ENABLED must be true or false" >&2; exit 2;; esac
  [ "${#feedback_identity_hmac_key}" -ge 32 ] || { echo "FEEDBACK_IDENTITY_HMAC_KEY must contain at least 32 characters" >&2; exit 2; }
  if [ -n "$feedback_api_key" ] && [ -n "$feedback_api_keys" ]; then
    echo "configure only one of FEEDBACK_API_KEY or FEEDBACK_API_KEYS" >&2
    exit 2
  fi
  if [ -n "$feedback_api_key" ]; then
    validate_feedback_api_key "$feedback_api_key"
    return 0
  fi
  [ -n "$feedback_api_keys" ] || { echo "Feedback API Key configuration is required" >&2; exit 2; }
  case "$feedback_api_keys" in ,*|*,|*,,*) echo "FEEDBACK_API_KEYS must contain one current key and at most one previous key" >&2; exit 2;; esac
  previous_ifs=$IFS
  IFS=,
  set -- $feedback_api_keys
  IFS=$previous_ifs
  [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { echo "FEEDBACK_API_KEYS must contain one current key and at most one previous key" >&2; exit 2; }
  for key in "$@"; do validate_feedback_api_key "$key"; done
}

validate_env() {
  validate_feedback_config
  case "$backup_drain_seconds" in ''|*[!0-9]*) echo "D1_BACKUP_DRAIN_SECONDS must be an integer from 0 to 30" >&2; exit 2;; esac
  [ "$backup_drain_seconds" -le 30 ] || { echo "D1_BACKUP_DRAIN_SECONDS must be an integer from 0 to 30" >&2; exit 2; }
  case "$reference_oa_bonus_profile" in ''|reference-oa-bonus-v2|reference-oa-bonus-v3) ;; *) echo "unsupported REFERENCE_OA_BONUS_PROFILE" >&2; exit 2 ;; esac
  case "$reference_oa_personnel_profile" in ''|reference-oa-production-personnel-v1) ;; *) echo "unsupported REFERENCE_OA_PRODUCTION_PERSONNEL_PROFILE" >&2; exit 2 ;; esac
  case "$reference_oa_stage_profile" in ''|reference-oa-stage-materials-v1) ;; *) echo "unsupported REFERENCE_OA_PRODUCTION_STAGE_PROFILE" >&2; exit 2 ;; esac
  if [ -n "$oms_operating_party_id" ] && ! printf '%s\n' "$oms_operating_party_id" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'; then
    echo "OMS_OPERATING_PARTY_ID must be a canonical lowercase UUID" >&2
    exit 2
  fi
  if [ -n "$oms_operating_party_id" ] && { [ "$enable_party" != true ] || [ "$enable_project" != true ] || [ "$enable_billing" != true ]; }; then
    echo "OMS operating Party requires Party, Project and Billing" >&2
    exit 2
  fi
  if [ -n "$reference_oa_stage_profile" ] && { [ "$enable_production" != true ] || [ "$enable_project" != true ] || [ "$enable_people" != true ] || [ "$enable_evidence" != true ]; }; then echo "production stage requires Production, Project, People and Evidence" >&2; exit 2; fi
  if [ -n "$reference_oa_personnel_profile" ] && { [ "$enable_project" != true ] || [ "$enable_people" != true ]; }; then echo "production personnel requires Project and People" >&2; exit 2; fi
  if [ "$reference_oa_bonus_profile" = reference-oa-bonus-v3 ] && { [ "$reference_oa_personnel_profile" != reference-oa-production-personnel-v1 ] || [ "$enable_bonus_distribution" != true ]; }; then echo "professional Bonus requires explicit personnel profile and Bonus selection" >&2; exit 2; fi
  for value in "$enable_contract" "$enable_money" "$enable_people" "$enable_party" "$enable_project" "$enable_evidence" "$enable_business_engagement" "$enable_billing" "$enable_production" "$enable_approval_audit_results" "$enable_cost_outsourcing" "$enable_bonus_distribution" "$enable_internal_finance_requests" "$enable_payroll"; do
    case "$value" in true|false) ;; *) echo "application enable flags must be true or false" >&2; exit 2 ;; esac
  done
  case "$image_mode" in build|pull) ;; *) echo "D1_IMAGE_MODE must be build or pull" >&2; exit 2 ;; esac
  case "$ingress_mode" in http|https) ;; *) echo "D1_INGRESS_MODE must be http or https" >&2; exit 2 ;; esac
  if [ "$image_mode" = pull ]; then
    validate_digest_image D1_POSTGRES_IMAGE
    validate_digest_image D1_IDENTITY_IMAGE
    validate_digest_image D1_WORKBENCH_IMAGE
    validate_digest_image D1_GATEWAY_IMAGE
    validate_digest_image D1_NGINX_IMAGE
    [ "$enable_contract" != true ] || validate_digest_image D1_CONTRACT_IMAGE
    [ "$enable_money" != true ] || validate_digest_image D1_MONEY_IMAGE
    [ "$enable_people" != true ] || validate_digest_image D1_PEOPLE_IMAGE
    [ "$enable_party" != true ] || validate_digest_image D1_PARTY_IMAGE
    [ "$enable_project" != true ] || validate_digest_image D1_PROJECT_IMAGE
    [ "$enable_evidence" != true ] || validate_digest_image D1_EVIDENCE_IMAGE
    [ "$enable_business_engagement" != true ] || validate_digest_image D1_BUSINESS_ENGAGEMENT_IMAGE
    [ "$enable_billing" != true ] || validate_digest_image D1_BILLING_IMAGE
    [ "$enable_production" != true ] || validate_digest_image D1_PRODUCTION_IMAGE
    [ "$enable_approval_audit_results" != true ] || validate_digest_image D1_APPROVAL_AUDIT_RESULTS_IMAGE
    [ "$enable_cost_outsourcing" != true ] || validate_digest_image D1_COST_OUTSOURCING_IMAGE
    [ "$enable_bonus_distribution" != true ] || validate_digest_image D1_BONUS_DISTRIBUTION_IMAGE
    [ "$enable_internal_finance_requests" != true ] || validate_digest_image D1_INTERNAL_FINANCE_REQUESTS_IMAGE
    [ "$enable_payroll" != true ] || validate_digest_image D1_PAYROLL_IMAGE
  fi
  if [ "$enable_business_engagement" = true ] && { [ "$enable_project" != true ] || [ "$enable_evidence" != true ]; }; then
    echo "ENABLE_BUSINESS_ENGAGEMENT=true requires ENABLE_PROJECT=true and ENABLE_EVIDENCE=true" >&2
    exit 2
  fi
  if [ "$enable_billing" = true ] && { [ "$enable_party" != true ] || [ "$enable_project" != true ] || [ "$enable_contract" != true ] || [ "$enable_money" != true ] || [ "$enable_evidence" != true ]; }; then
    echo "ENABLE_BILLING=true requires ENABLE_PARTY=true, ENABLE_PROJECT=true, ENABLE_CONTRACT=true, ENABLE_MONEY=true and ENABLE_EVIDENCE=true" >&2
    exit 2
  fi
  if [ "$enable_production" = true ] && { [ "$enable_people" != true ] || [ "$enable_project" != true ] || [ "$enable_evidence" != true ]; }; then
    echo "ENABLE_PRODUCTION=true requires ENABLE_PEOPLE=true, ENABLE_PROJECT=true and ENABLE_EVIDENCE=true" >&2
    exit 2
  fi
  if [ "$enable_approval_audit_results" = true ] && { [ "$enable_project" != true ] || [ "$enable_contract" != true ] || [ "$enable_evidence" != true ]; }; then
    echo "ENABLE_APPROVAL_AUDIT_RESULTS=true requires ENABLE_PROJECT=true, ENABLE_CONTRACT=true and ENABLE_EVIDENCE=true" >&2
    exit 2
  fi
  if [ "$enable_cost_outsourcing" = true ] && { [ "$enable_project" != true ] || [ "$enable_party" != true ] || [ "$enable_evidence" != true ]; }; then
    echo "ENABLE_COST_OUTSOURCING=true requires ENABLE_PROJECT=true, ENABLE_PARTY=true and ENABLE_EVIDENCE=true" >&2
    exit 2
  fi
  if [ "$enable_bonus_distribution" = true ] && { [ "$enable_project" != true ] || [ "$enable_people" != true ] || { [ "$enable_contract" != true ] && [ "$enable_money" != true ]; }; }; then
    echo "ENABLE_BONUS_DISTRIBUTION=true requires ENABLE_PROJECT=true, ENABLE_PEOPLE=true and at least one of ENABLE_CONTRACT=true or ENABLE_MONEY=true" >&2
    exit 2
  fi
  if [ "$enable_internal_finance_requests" = true ] && { [ "$enable_money" != true ] || [ "$enable_evidence" != true ]; }; then
    echo "ENABLE_INTERNAL_FINANCE_REQUESTS=true requires ENABLE_MONEY=true and ENABLE_EVIDENCE=true" >&2
    exit 2
  fi
  if [ "$enable_payroll" = true ] && { [ "$enable_people" != true ] || [ "$enable_money" != true ]; }; then
    echo "ENABLE_PAYROLL=true requires ENABLE_PEOPLE=true and ENABLE_MONEY=true" >&2
    exit 2
  fi
  project_party_base_url=$(env_value PROJECT_PARTY_BASE_URL)
  if [ "$enable_project" = true ] && [ "$enable_party" = true ]; then
    case "$project_party_base_url" in http://*|https://*) ;; *) echo "PROJECT_PARTY_BASE_URL is required when Project and Party are enabled" >&2; exit 2;; esac
  elif [ "$enable_party" != true ] && [ -n "$project_party_base_url" ]; then
    echo "PROJECT_PARTY_BASE_URL must be empty when Party Directory is disabled" >&2
    exit 2
  fi
  [ -n "$tenant_id" ] || { echo "TENANT_ID is required" >&2; exit 2; }
  issuer=$(env_value PUBLIC_ISSUER)
  case "$issuer" in https://*) ;; *) echo "PUBLIC_ISSUER must use HTTPS" >&2; exit 2;; esac
  cookie_secure=$(env_value COOKIE_SECURE false)
  public_bind=$(env_value PUBLIC_BIND 127.0.0.1)
  case "$cookie_secure" in true|false) ;; *) echo "COOKIE_SECURE must be true or false" >&2; exit 2;; esac
  if [ "$cookie_secure" != true ] && [ "$public_bind" != 127.0.0.1 ] && [ "$public_bind" != localhost ] && [ "$public_bind" != ::1 ]; then
    echo "COOKIE_SECURE=false is only allowed on a loopback bind" >&2
    exit 2
  fi
  if [ "$ingress_mode" = https ]; then
    [ "$cookie_secure" = true ] || { echo "COOKIE_SECURE must be true when D1_INGRESS_MODE=https" >&2; exit 2; }
    public_host=$(env_value D1_PUBLIC_HOST)
    printf '%s\n' "$public_host" | grep -Eq '^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$' || {
      echo "D1_PUBLIC_HOST must be a DNS hostname when D1_INGRESS_MODE=https" >&2
      exit 2
    }
    http_port=$(env_value PUBLIC_HTTP_PORT 80)
    https_port=$(env_value PUBLIC_HTTPS_PORT 443)
    validate_port PUBLIC_HTTP_PORT "$http_port"
    validate_port PUBLIC_HTTPS_PORT "$https_port"
    [ "$http_port" != "$https_port" ] || { echo "PUBLIC_HTTP_PORT and PUBLIC_HTTPS_PORT must differ" >&2; exit 2; }
    certificate_file=$(env_value D1_TLS_CERT_FILE)
    private_key_file=$(env_value D1_TLS_KEY_FILE)
    case "$certificate_file" in /*) ;; *) echo "D1_TLS_CERT_FILE must be an absolute host path" >&2; exit 2 ;; esac
    case "$private_key_file" in /*) ;; *) echo "D1_TLS_KEY_FILE must be an absolute host path" >&2; exit 2 ;; esac
    [ "$certificate_file" != "$private_key_file" ] || { echo "D1_TLS_CERT_FILE and D1_TLS_KEY_FILE must differ" >&2; exit 2; }
    [ -f "$certificate_file" ] || { echo "D1 TLS certificate file does not exist" >&2; exit 2; }
    [ -f "$private_key_file" ] || { echo "D1 TLS private-key file does not exist" >&2; exit 2; }
    if private_key_mode=$(stat -c '%a' "$private_key_file" 2>/dev/null); then :; else private_key_mode=$(stat -f '%Lp' "$private_key_file"); fi
    case "$private_key_mode" in 400|600) ;; *) echo "D1 TLS private key permissions must be 0400 or 0600" >&2; exit 2 ;; esac
    openssl x509 -in "$certificate_file" -noout >/dev/null 2>&1 || { echo "D1 TLS certificate is not valid PEM" >&2; exit 2; }
    openssl x509 -in "$certificate_file" -noout -checkend 0 >/dev/null 2>&1 || { echo "D1 TLS certificate is expired or not currently valid" >&2; exit 2; }
    openssl x509 -in "$certificate_file" -noout -checkhost "$public_host" >/dev/null 2>&1 || { echo "D1 TLS certificate does not cover D1_PUBLIC_HOST" >&2; exit 2; }
    openssl pkey -in "$private_key_file" -noout -passin pass: >/dev/null 2>&1 || { echo "D1 TLS private key must be valid unencrypted PEM" >&2; exit 2; }
    certificate_public_key=$(openssl x509 -in "$certificate_file" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | openssl dgst -sha256 -r | awk '{print $1}')
    private_public_key=$(openssl pkey -in "$private_key_file" -pubout -outform DER -passin pass: 2>/dev/null | openssl dgst -sha256 -r | awk '{print $1}')
    [ -n "$certificate_public_key" ] && [ "$certificate_public_key" = "$private_public_key" ] || {
      echo "D1 TLS certificate and private key do not match" >&2
      exit 2
    }
    case "$issuer" in "https://$public_host"/*) ;; *) echo "PUBLIC_ISSUER must use D1_PUBLIC_HOST in HTTPS mode" >&2; exit 2 ;; esac
  fi

  superuser_password=$(env_value POSTGRES_SUPERUSER_PASSWORD)
  identity_password=$(env_value IDENTITY_DB_PASSWORD)
  contract_password=$(env_value CONTRACT_DB_PASSWORD)
  money_password=$(env_value MONEY_DB_PASSWORD)
  people_password=$(env_value PEOPLE_DB_PASSWORD)
  party_password=$(env_value PARTY_DB_PASSWORD)
  project_password=$(env_value PROJECT_DB_PASSWORD)
  evidence_password=$(env_value EVIDENCE_DB_PASSWORD)
  business_engagement_password=$(env_value BUSINESS_ENGAGEMENT_DB_PASSWORD)
  billing_password=$(env_value BILLING_DB_PASSWORD)
  production_password=$(env_value PRODUCTION_DB_PASSWORD)
  approval_audit_results_password=$(env_value APPROVAL_AUDIT_RESULTS_DB_PASSWORD)
  cost_outsourcing_password=$(env_value COST_OUTSOURCING_DB_PASSWORD)
  bonus_distribution_password=$(env_value BONUS_DISTRIBUTION_DB_PASSWORD)
  internal_finance_requests_password=$(env_value INTERNAL_FINANCE_REQUESTS_DB_PASSWORD)
  payroll_password=$(env_value PAYROLL_DB_PASSWORD)
  for secret in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password" "$evidence_password" "$business_engagement_password" "$billing_password" "$production_password" "$approval_audit_results_password" "$cost_outsourcing_password" "$bonus_distribution_password" "$internal_finance_requests_password" "$payroll_password"; do
    case "$secret" in
      replace-with-*|'') echo "replace every database password placeholder" >&2; exit 2 ;;
      *[!A-Za-z0-9_.~-]*) echo "database passwords must be URL-safe characters: A-Z a-z 0-9 _ . ~ -" >&2; exit 2 ;;
    esac
    [ "${#secret}" -ge 16 ] || { echo "database passwords must contain at least 16 characters" >&2; exit 2; }
  done
  [ "$superuser_password" != "$identity_password" ] && [ "$superuser_password" != "$contract_password" ] && \
    [ "$superuser_password" != "$money_password" ] && [ "$identity_password" != "$contract_password" ] && \
    [ "$identity_password" != "$money_password" ] && [ "$contract_password" != "$money_password" ] || {
      echo "database accounts must not share passwords" >&2; exit 2;
    }
  [ "$people_password" != "$superuser_password" ] && [ "$people_password" != "$identity_password" ] && \
    [ "$people_password" != "$contract_password" ] && [ "$people_password" != "$money_password" ] || {
      echo "database accounts must not share passwords" >&2; exit 2;
    }
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password"; do
    [ "$party_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password"; do
    [ "$project_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password"; do
    [ "$evidence_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password" "$evidence_password"; do
    [ "$business_engagement_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password" "$evidence_password" "$business_engagement_password"; do
    [ "$billing_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password" "$evidence_password" "$business_engagement_password" "$billing_password"; do
    [ "$production_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password" "$evidence_password" "$business_engagement_password" "$billing_password" "$production_password"; do
    [ "$approval_audit_results_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password" "$evidence_password" "$business_engagement_password" "$billing_password" "$production_password" "$approval_audit_results_password"; do
    [ "$cost_outsourcing_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password" "$evidence_password" "$business_engagement_password" "$billing_password" "$production_password" "$approval_audit_results_password" "$cost_outsourcing_password"; do
    [ "$bonus_distribution_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password" "$evidence_password" "$business_engagement_password" "$billing_password" "$production_password" "$approval_audit_results_password" "$cost_outsourcing_password" "$bonus_distribution_password"; do
    [ "$internal_finance_requests_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  for other in "$superuser_password" "$identity_password" "$contract_password" "$money_password" "$people_password" "$party_password" "$project_password" "$evidence_password" "$business_engagement_password" "$billing_password" "$production_password" "$approval_audit_results_password" "$cost_outsourcing_password" "$bonus_distribution_password" "$internal_finance_requests_password"; do
    [ "$payroll_password" != "$other" ] || { echo "database accounts must not share passwords" >&2; exit 2; }
  done
  party_cursor_key=$(env_value PARTY_CURSOR_HMAC_KEY)
  case "$party_cursor_key" in replace-with-*|'') echo "replace PARTY_CURSOR_HMAC_KEY" >&2; exit 2;; esac
  [ "${#party_cursor_key}" -ge 32 ] || { echo "PARTY_CURSOR_HMAC_KEY must contain at least 32 bytes" >&2; exit 2; }
  evidence_base_url=$(env_value EVIDENCE_PUBLIC_BASE_URL)
  case "$evidence_base_url" in
    https://*) ;;
    http://127.0.0.1:*|http://localhost:*|http://\[::1\]:*) ;;
    *) echo "EVIDENCE_PUBLIC_BASE_URL must use HTTPS, except for loopback development" >&2; exit 2 ;;
  esac
  if [ "$ingress_mode" = https ]; then
    case "$evidence_base_url" in "https://$public_host"/*) ;; *) echo "EVIDENCE_PUBLIC_BASE_URL must use D1_PUBLIC_HOST in HTTPS mode" >&2; exit 2 ;; esac
  fi
  evidence_signing_key=$(env_value EVIDENCE_LOCAL_SIGNING_KEY)
  case "$evidence_signing_key" in replace-with-*|'') echo "replace EVIDENCE_LOCAL_SIGNING_KEY" >&2; exit 2;; esac
  case "$evidence_signing_key" in *[!A-Za-z0-9_-]*) echo "EVIDENCE_LOCAL_SIGNING_KEY must be unpadded base64url" >&2; exit 2;; esac
  normalized_key=$(printf '%s' "$evidence_signing_key" | tr '_-' '/+')
  case $((${#normalized_key} % 4)) in
    0) key_padding='' ;;
    2) key_padding='==' ;;
    3) key_padding='=' ;;
    *) echo "EVIDENCE_LOCAL_SIGNING_KEY is not valid base64url" >&2; exit 2 ;;
  esac
  decoded_evidence_key_bytes=$(printf '%s%s' "$normalized_key" "$key_padding" | openssl base64 -d -A 2>/dev/null | wc -c | tr -d ' ')
  [ "$decoded_evidence_key_bytes" -ge 32 ] || { echo "EVIDENCE_LOCAL_SIGNING_KEY must decode to at least 32 bytes" >&2; exit 2; }
  bootstrap_password=$(env_value BOOTSTRAP_ADMIN_PASSWORD)
  case "$bootstrap_password" in replace-with-*|'') echo "replace BOOTSTRAP_ADMIN_PASSWORD" >&2; exit 2;; esac
  [ "${#bootstrap_password}" -ge 12 ] || { echo "BOOTSTRAP_ADMIN_PASSWORD must contain at least 12 characters" >&2; exit 2; }
  case "$evidence_storage_mode" in local|hybrid|aliyun-oss) ;; *) echo 'invalid D1_EVIDENCE_STORAGE_PROVIDER' >&2; exit 2;; esac
  if [ "$evidence_storage_mode" != local ]; then
    [ "$enable_evidence" = true ] || { echo 'OSS profile requires Evidence selected' >&2; exit 2; }
    if [ "$evidence_storage_mode" = hybrid ]; then
      case "$(env_value EVIDENCE_PRIMARY_STORAGE_PROVIDER)" in local|aliyun-oss) ;; *) echo 'hybrid requires explicit Primary' >&2; exit 2;; esac
    else
      [ -z "$(env_value EVIDENCE_PRIMARY_STORAGE_PROVIDER)" ] || { echo 'single OSS mode must not set Primary' >&2; exit 2; }
    fi
    for key in EVIDENCE_OSS_REGION EVIDENCE_OSS_BUCKET EVIDENCE_OSS_UPLOAD_ROLE_ARN EVIDENCE_OSS_BROWSER_ENDPOINT EVIDENCE_OSS_SERVICE_ENDPOINT EVIDENCE_OSS_STS_ENDPOINT EVIDENCE_ECS_ROLE_NAME EVIDENCE_EGRESS_NETWORK; do
      [ -n "$(env_value "$key")" ] || { echo "missing $key" >&2; exit 2; }
    done
    for key in EVIDENCE_OSS_BROWSER_ENDPOINT EVIDENCE_OSS_SERVICE_ENDPOINT; do
      case "$(env_value "$key")" in https://*) ;; *) echo "$key must use HTTPS" >&2; exit 2;; esac
    done
    case "$(env_value EVIDENCE_OSS_BROWSER_CNAME false)" in true|false) ;; *) echo 'invalid OSS CNAME flag' >&2; exit 2;; esac
  fi
}

validate_digest_image() {
  key=$1
  reference=$(env_value "$key")
  case "$reference" in
    *@sha256:*) digest=${reference##*@sha256:} ;;
    *) echo "$key must use an immutable name@sha256:<64 lowercase hex> reference in pull mode" >&2; exit 2 ;;
  esac
  printf '%s\n' "$digest" | grep -Eq '^[a-f0-9]{64}$' || {
    echo "$key must end with a 64-character lowercase SHA-256 digest" >&2
    exit 2
  }
  case "$reference" in *[!A-Za-z0-9_./:@-]*) echo "$key contains unsupported characters" >&2; exit 2 ;; esac
}

