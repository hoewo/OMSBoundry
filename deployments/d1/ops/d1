    service_in_selection "$running_selection" production-operations && backup_enable_production=true
    service_in_selection "$running_selection" approval-audit-results && backup_enable_approval_audit_results=true
    service_in_selection "$running_selection" cost-outsourcing && backup_enable_cost_outsourcing=true
    service_in_selection "$running_selection" bonus-distribution && backup_enable_bonus_distribution=true
    service_in_selection "$running_selection" internal-finance-requests && backup_enable_internal_finance_requests=true
    service_in_selection "$running_selection" payroll && backup_enable_payroll=true
  elif [ "$selection_source" != configured ]; then
    echo "unsupported backup selection source: $selection_source" >&2
    exit 2
  fi

  check_stack_selection \
    "$backup_enable_contract" "$backup_enable_money" "$backup_enable_people" "$backup_enable_party" \
    "$backup_enable_project" "$backup_enable_evidence" "$backup_enable_business_engagement" "$backup_enable_billing" "$backup_enable_production" "$backup_enable_approval_audit_results" "$backup_enable_cost_outsourcing" "$backup_enable_bonus_distribution" "$backup_enable_internal_finance_requests" "$backup_enable_payroll" \
    >/dev/null
  # Capture the running owners, not a candidate env that may select a new
  # overlay during upgrade. These are public version choices, never secrets.
  backup_bonus_profile=''
  backup_personnel_profile=''
  backup_stage_profile=''
  backup_oms_qualification_party_id=''
  if [ "$backup_enable_bonus_distribution" = true ]; then
    backup_bonus_profile=$(compose_all exec -T bonus-distribution sh -c 'printf "%s\n" "${REFERENCE_OA_BONUS_PROFILE-}"')
  fi
  if [ "$backup_enable_project" = true ]; then
    backup_personnel_profile=$(compose_all exec -T project-workspace sh -c 'printf "%s\n" "${REFERENCE_OA_PRODUCTION_PERSONNEL_PROFILE-}"')
  fi
  if [ "$backup_enable_production" = true ]; then
    backup_stage_profile=$(compose_all exec -T production-operations sh -c 'printf "%s\n" "${REFERENCE_STAGE_MATERIAL_PROFILE-}"')
  fi
  backup_stage_workbench_profile=$(compose_all exec -T unified-workbench sh -c 'printf "%s\n" "${REFERENCE_OA_PRODUCTION_STAGE_PROFILE-}"')
  backup_oms_qualification_party_id=$(compose_all exec -T unified-workbench sh -c 'value=${OMS_OPERATING_PARTY_ID-}; [ -n "$value" ] || value=${OMS_QUALIFICATION_PARTY_ID-}; printf "%s\n" "$value"')
  [ "$backup_stage_profile" = "$backup_stage_workbench_profile" ] || { echo "running Production and Workbench stage profiles disagree" >&2; exit 1; }
  case "$backup_bonus_profile" in ''|reference-oa-bonus-v2|reference-oa-bonus-v3) ;; *) echo "running Bonus profile is unsupported" >&2; exit 1 ;; esac
  case "$backup_personnel_profile" in ''|reference-oa-production-personnel-v1) ;; *) echo "running personnel profile is unsupported" >&2; exit 1 ;; esac
  case "$backup_stage_profile" in ''|reference-oa-stage-materials-v1) ;; *) echo "running stage profile is unsupported" >&2; exit 1 ;; esac
  if [ -n "$backup_oms_qualification_party_id" ] && ! printf '%s\n' "$backup_oms_qualification_party_id" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'; then
    echo "running OMS operating Party ID is invalid" >&2; exit 1
  fi
  if [ "$backup_bonus_profile" = reference-oa-bonus-v3 ] && [ "$backup_personnel_profile" != reference-oa-production-personnel-v1 ]; then
    echo "running professional Bonus has no matching personnel profile" >&2; exit 1
  fi
  backup_id=$(date -u '+%Y%m%dT%H%M%SZ')
  target="$backup_dir/$backup_id"
  host_uid=$(id -u)
  host_gid=$(id -g)
  evidence_stopped=false
  ingress_was_running=false
  ingress_stopped=false
  backup_owner=host

  running_services=$(compose_all ps --status running --services)
  service_in_selection "$running_services" nginx && ingress_was_running=true

  restore_backup_state() {
    if [ "$evidence_stopped" = true ]; then
      compose_all up --detach --no-deps --no-build --wait evidence-service >/dev/null 2>&1 || true
      evidence_stopped=false
    fi
    if [ "$ingress_stopped" = true ]; then
      compose_all up --detach --no-deps --no-build --wait nginx >/dev/null 2>&1 || true
      ingress_stopped=false
    fi
    if [ "$backup_owner" = container ]; then
      compose exec -T --user 0:0 -e BACKUP_ID="$backup_id" -e HOST_UID="$host_uid" -e HOST_GID="$host_gid" \
        identity-access sh -eu -c \
        'chown -R "$HOST_UID:$HOST_GID" "/backups/$BACKUP_ID"; chmod 0700 "/backups/$BACKUP_ID"; find "/backups/$BACKUP_ID" -type f -exec chmod 0600 {} +' \
        >/dev/null 2>&1 || true
      backup_owner=host
    fi
    chmod 0700 "$backup_dir" >/dev/null 2>&1 || true
  }
  trap restore_backup_state EXIT HUP INT TERM

  mkdir -p "$target"
  chmod 700 "$target"
  chmod 0711 "$backup_dir"
  compose exec -T --user 0:0 -e BACKUP_ID="$backup_id" identity-access sh -eu -c \
    'chown postgres:postgres "/backups/$BACKUP_ID"; chmod 0700 "/backups/$BACKUP_ID"'
  backup_owner=container

  # Nginx is the only supported public D1 edge. Quiesce it before the first
  # Owner dump and leave the private application containers running so their
  # backup commands remain available. The bounded drain lets requests already
  # handed to an Owner settle before the sequential cross-Owner checkpoint.
  if [ "$ingress_was_running" = true ]; then
    ingress_stopped=true
    compose_all stop nginx >/dev/null
    [ "$backup_drain_seconds" -eq 0 ] || sleep "$backup_drain_seconds"
  fi
  {
    printf 'CONSISTENCY_MODE=public-ingress-quiesced-v1\n'
    printf 'PUBLIC_INGRESS_WAS_RUNNING=%s\n' "$ingress_was_running"
    printf 'DRAIN_SECONDS=%s\n' "$backup_drain_seconds"
  } >"$target/backup-consistency.env"

  compose exec -T -e BACKUP_ID="$backup_id" identity-access sh -eu -c \
    'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --exclude-table-data=public.suite_sessions --file="/backups/$BACKUP_ID/identity-access.dump"; install -m 600 /data/iam/signing-keys.json "/backups/$BACKUP_ID/signing-keys.json"'
  if [ "$backup_enable_contract" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" contract-ledger \
      /app/backup create --output "/backups/$backup_id/contract-ledger.zip"
  fi
  if [ "$backup_enable_money" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" money-flow-ledger \
      /app/backup create --output "/backups/$backup_id/money-flow-ledger.zip"
  fi
  if [ "$backup_enable_people" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" people-groups sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/people-groups.dump"'
  fi
  if [ "$backup_enable_party" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" party-directory \
      /app/backup create --output "/backups/$backup_id/party-directory.zip"
  fi
  if [ "$backup_enable_project" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" project-workspace sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/project-workspace.dump"'
  fi
  if [ "$backup_enable_evidence" = true ]; then
    evidence_stopped=true
    compose_all stop evidence-service >/dev/null
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" evidence-service \
      /app/backup create --output "/backups/$backup_id/evidence-service.zip" --confirm-service-stopped
    compose_all up --detach --no-deps --no-build --wait evidence-service >/dev/null
    evidence_stopped=false
  fi
  if [ "$backup_enable_business_engagement" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" business-engagement sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/business-engagement.dump"'
  fi
  if [ "$backup_enable_billing" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" billing-invoice sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/billing-invoice.dump"'
  fi
  if [ "$backup_enable_production" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" production-operations sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/production-operations.dump"'
  fi
  if [ "$backup_enable_approval_audit_results" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" approval-audit-results sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/approval-audit-results.dump"'
  fi
  if [ "$backup_enable_cost_outsourcing" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" cost-outsourcing sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/cost-outsourcing.dump"'
  fi
  if [ "$backup_enable_bonus_distribution" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" bonus-distribution sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/bonus-distribution.dump"'
  fi
  if [ "$backup_enable_internal_finance_requests" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" internal-finance-requests sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/internal-finance-requests.dump"'
  fi
  if [ "$backup_enable_payroll" = true ]; then
    compose_all exec -T -e BACKUP_ID="$backup_id" payroll sh -eu -c \
      'pg_dump --dbname "$DATABASE_URL" --format=custom --no-owner --no-privileges --file="/backups/$BACKUP_ID/payroll.dump"'
  fi

  compose exec -T --user 0:0 -e BACKUP_ID="$backup_id" -e HOST_UID="$host_uid" -e HOST_GID="$host_gid" \
    identity-access sh -eu -c \
    'chown -R "$HOST_UID:$HOST_GID" "/backups/$BACKUP_ID"; chmod 0700 "/backups/$BACKUP_ID"; find "/backups/$BACKUP_ID" -type f -exec chmod 0600 {} +'
  backup_owner=host
  chmod 0700 "$backup_dir"

  {
    printf 'ENABLE_CONTRACT=%s\n' "$backup_enable_contract"
    printf 'ENABLE_MONEY=%s\n' "$backup_enable_money"
    printf 'ENABLE_PEOPLE=%s\n' "$backup_enable_people"
    printf 'ENABLE_PARTY=%s\n' "$backup_enable_party"
    printf 'ENABLE_PROJECT=%s\n' "$backup_enable_project"
    printf 'ENABLE_EVIDENCE=%s\n' "$backup_enable_evidence"
    printf 'ENABLE_BUSINESS_ENGAGEMENT=%s\n' "$backup_enable_business_engagement"
    printf 'ENABLE_BILLING=%s\n' "$backup_enable_billing"
    printf 'ENABLE_PRODUCTION=%s\n' "$backup_enable_production"
    printf 'ENABLE_APPROVAL_AUDIT_RESULTS=%s\n' "$backup_enable_approval_audit_results"
    printf 'ENABLE_COST_OUTSOURCING=%s\n' "$backup_enable_cost_outsourcing"
    printf 'ENABLE_BONUS_DISTRIBUTION=%s\n' "$backup_enable_bonus_distribution"
    printf 'ENABLE_INTERNAL_FINANCE_REQUESTS=%s\n' "$backup_enable_internal_finance_requests"
    printf 'ENABLE_PAYROLL=%s\n' "$backup_enable_payroll"
    printf 'REFERENCE_OA_BONUS_PROFILE=%s\n' "$backup_bonus_profile"
    printf 'REFERENCE_OA_PRODUCTION_PERSONNEL_PROFILE=%s\n' "$backup_personnel_profile"
    printf 'REFERENCE_OA_PRODUCTION_STAGE_PROFILE=%s\n' "$backup_stage_profile"
    printf 'OMS_OPERATING_PARTY_ID=%s\n' "$backup_oms_qualification_party_id"
  } >"$target/suite-selection.env"

  capture_database_fingerprints "$target/database-fingerprints.tsv" \
    "$backup_enable_contract" "$backup_enable_money" "$backup_enable_people" "$backup_enable_party" \
    "$backup_enable_project" "$backup_enable_evidence" "$backup_enable_business_engagement" "$backup_enable_billing" \
    "$backup_enable_production" "$backup_enable_approval_audit_results" "$backup_enable_cost_outsourcing" \
    "$backup_enable_bonus_distribution" "$backup_enable_internal_finance_requests" "$backup_enable_payroll"

  manifest="$target/checksums.sha256"
  : >"$manifest"
  for artifact in "$target"/*; do
    [ "$(basename "$artifact")" = checksums.sha256 ] && continue
    printf '%s  %s\n' "$(digest_file "$artifact")" "$(basename "$artifact")" >>"$manifest"
  done
  chmod 600 "$target"/*
  if [ "$ingress_stopped" = true ] && [ "$selection_source" = configured ]; then
    compose_all up --detach --no-deps --no-build --wait nginx >/dev/null
    ingress_stopped=false
  fi
  # Upgrade immediately tears down the current composition. Do not reopen a
  # write window between its pre-mutation backup and that teardown.
  [ "$selection_source" != running ] || ingress_stopped=false
  trap - EXIT HUP INT TERM
  echo "backup created: $backup_id ($target)"
}

verify_backup() {
  target="$1"
  [ -f "$target/checksums.sha256" ] || { echo "backup checksum manifest is missing" >&2; exit 1; }
  while read -r expected filename; do
    [ -n "$expected" ] || continue
    actual=$(digest_file "$target/$filename")
    [ "$actual" = "$expected" ] || { echo "backup checksum mismatch: $filename" >&2; exit 1; }
  done <"$target/checksums.sha256"
}

verify_backup_selection_value() {
  selection_file=$1
  key=$2
  configured_value=$3
  backed_up_value=$(awk -F= -v key="$key" '$1 == key {print $2}' "$selection_file")
  case "$backed_up_value" in
    true|false) ;;
    *) echo "backup application selection is invalid for $key" >&2; exit 1 ;;
  esac
  [ "$backed_up_value" = "$configured_value" ] || {
    echo "backup application selection mismatch for $key: backup=$backed_up_value configured=$configured_value" >&2
    exit 1
  }
}

verify_optional_backup_selection_value() {
  selection_file=$1
  key=$2
  configured_value=$3
  count=$(awk -F= -v key="$key" '$1 == key {n++} END {print n+0}' "$selection_file")
  if [ "$count" = 0 ]; then
    [ "$configured_value" = false ] || { echo "backup application selection is missing for enabled $key" >&2; exit 1; }
    return 0
  fi
  [ "$count" = 1 ] || { echo "duplicate backup application selection for $key" >&2; exit 1; }
  verify_backup_selection_value "$selection_file" "$key" "$configured_value"
}

verify_backup_profile_value() {
  selection_file=$1
  key=$2
  configured_value=$3
  count=$(awk -F= -v key="$key" '$1 == key {n++} END {print n+0}' "$selection_file")
  if [ "$count" = 0 ]; then
    # Pre-profile backups remain compatible only with profiles disabled.
    [ -z "$configured_value" ] || { echo "backup profile declaration is missing for $key" >&2; exit 1; }
    return 0
  fi
  [ "$count" = 1 ] || { echo "duplicate backup profile declaration for $key" >&2; exit 1; }
  backed_up_value=$(awk -F= -v key="$key" '$1 == key {print substr($0,length(key)+2)}' "$selection_file")
  case "$key:$backed_up_value" in
    REFERENCE_OA_BONUS_PROFILE:|REFERENCE_OA_BONUS_PROFILE:reference-oa-bonus-v2|REFERENCE_OA_BONUS_PROFILE:reference-oa-bonus-v3|REFERENCE_OA_PRODUCTION_PERSONNEL_PROFILE:|REFERENCE_OA_PRODUCTION_PERSONNEL_PROFILE:reference-oa-production-personnel-v1|REFERENCE_OA_PRODUCTION_STAGE_PROFILE:|REFERENCE_OA_PRODUCTION_STAGE_PROFILE:reference-oa-stage-materials-v1) ;;
    *) echo "backup profile declaration is invalid for $key" >&2; exit 1 ;;
  esac
  [ "$backed_up_value" = "$configured_value" ] || { echo "backup profile mismatch for $key: backup=$backed_up_value configured=$configured_value" >&2; exit 1; }
}

verify_backup_oms_party_value() {
  selection_file=$1
  configured_value=$2
  count=$(awk -F= '$1 == "OMS_OPERATING_PARTY_ID" || $1 == "OMS_QUALIFICATION_PARTY_ID" {n++} END {print n+0}' "$selection_file")
  if [ "$count" = 0 ]; then
    [ -z "$configured_value" ] || { echo "backup OMS operating Party declaration is missing" >&2; exit 1; }
    return 0
  fi
  [ "$count" = 1 ] || { echo "duplicate backup OMS operating Party declaration" >&2; exit 1; }
  backed_up_value=$(awk -F= '$1 == "OMS_OPERATING_PARTY_ID" || $1 == "OMS_QUALIFICATION_PARTY_ID" {print substr($0,length($1)+2)}' "$selection_file")
  if [ -n "$backed_up_value" ] && ! printf '%s\n' "$backed_up_value" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'; then
    echo "backup OMS operating Party declaration is invalid" >&2; exit 1
  fi
  [ "$backed_up_value" = "$configured_value" ] || { echo "backup OMS operating Party mismatch: backup=$backed_up_value configured=$configured_value" >&2; exit 1; }
}

verify_backup_selection() {
  selection_file=$1
  if [ ! -f "$selection_file" ]; then
    [ -z "$reference_oa_bonus_profile" ] && [ -z "$reference_oa_personnel_profile" ] && [ -z "$reference_oa_stage_profile" ] && [ -z "$oms_operating_party_id" ] || { echo "backup selection is missing for an enabled customer profile" >&2; exit 1; }
    return 0
  fi
  verify_backup_selection_value "$selection_file" ENABLE_CONTRACT "$enable_contract"
  verify_backup_selection_value "$selection_file" ENABLE_MONEY "$enable_money"
  verify_backup_selection_value "$selection_file" ENABLE_PEOPLE "$enable_people"
  verify_backup_selection_value "$selection_file" ENABLE_PARTY "$enable_party"
  verify_backup_selection_value "$selection_file" ENABLE_PROJECT "$enable_project"
  verify_backup_selection_value "$selection_file" ENABLE_EVIDENCE "$enable_evidence"
  verify_backup_selection_value "$selection_file" ENABLE_BUSINESS_ENGAGEMENT "$enable_business_engagement"
  verify_backup_selection_value "$selection_file" ENABLE_BILLING "$enable_billing"
  verify_backup_selection_value "$selection_file" ENABLE_PRODUCTION "$enable_production"
  verify_backup_selection_value "$selection_file" ENABLE_APPROVAL_AUDIT_RESULTS "$enable_approval_audit_results"
  verify_backup_selection_value "$selection_file" ENABLE_COST_OUTSOURCING "$enable_cost_outsourcing"
  verify_backup_selection_value "$selection_file" ENABLE_BONUS_DISTRIBUTION "$enable_bonus_distribution"
  verify_optional_backup_selection_value "$selection_file" ENABLE_INTERNAL_FINANCE_REQUESTS "$enable_internal_finance_requests"
  verify_optional_backup_selection_value "$selection_file" ENABLE_PAYROLL "$enable_payroll"
  verify_backup_profile_value "$selection_file" REFERENCE_OA_BONUS_PROFILE "$reference_oa_bonus_profile"
  verify_backup_profile_value "$selection_file" REFERENCE_OA_PRODUCTION_PERSONNEL_PROFILE "$reference_oa_personnel_profile"
  verify_backup_profile_value "$selection_file" REFERENCE_OA_PRODUCTION_STAGE_PROFILE "$reference_oa_stage_profile"
  verify_backup_oms_party_value "$selection_file" "$oms_operating_party_id"
}

restore_backup() {
  backup_id="${1:-}"
  [ -n "$backup_id" ] || usage
  case "$backup_id" in *[!A-Za-z0-9_.-]*) echo "invalid backup ID" >&2; exit 2;; esac
  [ "${D1_CONFIRM_EMPTY_RESTORE:-}" = yes ] || {
    echo "restore replaces this Compose project's volumes; rerun with D1_CONFIRM_EMPTY_RESTORE=yes" >&2
    exit 2
  }
  target="$backup_dir/$backup_id"
  [ -d "$target" ] || { echo "backup not found: $target" >&2; exit 2; }
  verify_backup "$target"
  verify_backup_selection "$target/suite-selection.env"
  [ -f "$target/identity-access.dump" ] && [ -f "$target/signing-keys.json" ] || {
    echo "IAM backup artifacts are incomplete" >&2; exit 1;
  }
  if [ -f "$target/backup-consistency.env" ]; then
    grep -qx 'CONSISTENCY_MODE=public-ingress-quiesced-v1' "$target/backup-consistency.env" || {
      echo "backup consistency declaration is invalid" >&2; exit 1;
    }
    grep -Eq '^PUBLIC_INGRESS_WAS_RUNNING=(true|false)$' "$target/backup-consistency.env" || {
      echo "backup ingress declaration is invalid" >&2; exit 1;
    }
    grep -Eq '^DRAIN_SECONDS=([0-9]|[12][0-9]|30)$' "$target/backup-consistency.env" || {
      echo "backup drain declaration is invalid" >&2; exit 1;
    }
  fi
  [ "$enable_contract" != true ] || [ -f "$target/contract-ledger.zip" ] || { echo "Contract backup is missing" >&2; exit 1; }
  [ "$enable_money" != true ] || [ -f "$target/money-flow-ledger.zip" ] || { echo "Money Flow backup is missing" >&2; exit 1; }
  [ "$enable_people" != true ] || [ -f "$target/people-groups.dump" ] || { echo "People & Groups backup is missing" >&2; exit 1; }
  [ "$enable_party" != true ] || [ -f "$target/party-directory.zip" ] || { echo "Party Directory backup is missing" >&2; exit 1; }
  [ "$enable_project" != true ] || [ -f "$target/project-workspace.dump" ] || { echo "Project Workspace backup is missing" >&2; exit 1; }
  [ "$enable_evidence" != true ] || [ -f "$target/evidence-service.zip" ] || { echo "Evidence Service backup is missing" >&2; exit 1; }
  [ "$enable_business_engagement" != true ] || [ -f "$target/business-engagement.dump" ] || { echo "Business Engagement backup is missing" >&2; exit 1; }
  [ "$enable_billing" != true ] || [ -f "$target/billing-invoice.dump" ] || { echo "Billing backup is missing" >&2; exit 1; }
  [ "$enable_production" != true ] || [ -f "$target/production-operations.dump" ] || { echo "Production Operations backup is missing" >&2; exit 1; }
  [ "$enable_approval_audit_results" != true ] || [ -f "$target/approval-audit-results.dump" ] || { echo "Approval & Audit Results backup is missing" >&2; exit 1; }
  [ "$enable_cost_outsourcing" != true ] || [ -f "$target/cost-outsourcing.dump" ] || { echo "Cost & Outsourcing backup is missing" >&2; exit 1; }
  [ "$enable_bonus_distribution" != true ] || [ -f "$target/bonus-distribution.dump" ] || { echo "Bonus Distribution backup is missing" >&2; exit 1; }
  [ "$enable_internal_finance_requests" != true ] || [ -f "$target/internal-finance-requests.dump" ] || { echo "Internal Finance Requests backup is missing" >&2; exit 1; }
  [ "$enable_payroll" != true ] || [ -f "$target/payroll.dump" ] || { echo "Payroll backup is missing" >&2; exit 1; }

  restore_host_uid=$(id -u)
  restore_host_gid=$(id -g)
  restore_backup_owner=host
  restore_fingerprint_temp=''
  restore_backup_permissions() {
    if [ "$restore_backup_owner" = container ]; then
      compose run --rm --no-deps --user 0:0 \
        -e BACKUP_ID="$backup_id" -e HOST_UID="$restore_host_uid" -e HOST_GID="$restore_host_gid" \
        identity-access sh -eu -c \
        'chown -R "$HOST_UID:$HOST_GID" "/backups/$BACKUP_ID"; chmod 0700 "/backups/$BACKUP_ID"; find "/backups/$BACKUP_ID" -type f -exec chmod 0600 {} + ' \
        >/dev/null 2>&1 || true
      restore_backup_owner=host
    fi
    [ -z "$restore_fingerprint_temp" ] || rm -f "$restore_fingerprint_temp"
    chmod 0700 "$backup_dir" >/dev/null 2>&1 || true
  }
  trap restore_backup_permissions EXIT HUP INT TERM

  render_manifest
  prepare_images
  # Docker can briefly retain an edge-network endpoint after the last container
  # has been removed. A bounded retry keeps an otherwise valid restore
  # recoverable without weakening the empty-volume precondition.
  if ! compose_all down --volumes --remove-orphans; then
    sleep 2
    if ! compose_all down --volumes --remove-orphans; then
      remaining_containers=$(compose_all ps --all --quiet)
      [ -z "$remaining_containers" ] || {
        echo "restore cleanup left Compose project containers behind" >&2
        exit 1
      }
      echo "restore cleanup left only a stale Docker network; continuing with the empty Compose project" >&2
    fi
  fi
  compose up --detach --wait postgres
  # A completed backup is deliberately host-owned 0700/0600. Transfer only
  # this selected backup to the common non-root runtime user while restore
  # containers need it, then return it to the invoking host user below (and
  # from the trap on every failure path). This avoids making database dumps
  # or signing keys world-readable merely to cross the bind mount boundary.
  chmod 0711 "$backup_dir"
  compose run --rm --no-deps --user 0:0 -e BACKUP_ID="$backup_id" identity-access sh -eu -c \
    'chown -R postgres:postgres "/backups/$BACKUP_ID"; chmod 0700 "/backups/$BACKUP_ID"; find "/backups/$BACKUP_ID" -type f -exec chmod 0600 {} +'
  restore_backup_owner=container
  compose run --rm --no-deps -e BACKUP_ID="$backup_id" identity-access sh -eu -c \
    'attempt=0; until pg_isready --dbname "$DATABASE_URL" >/dev/null 2>&1; do attempt=$((attempt + 1)); [ "$attempt" -lt 30 ] || { echo "PostgreSQL did not become reachable for restore" >&2; exit 1; }; sleep 1; done; install -m 600 "/backups/$BACKUP_ID/signing-keys.json" /data/iam/signing-keys.json; pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/identity-access.dump"'
  if [ "$enable_contract" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" contract-ledger \
      /app/backup restore --input "/backups/$backup_id/contract-ledger.zip"
  fi
  if [ "$enable_money" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" money-flow-ledger \
      /app/backup restore --input "/backups/$backup_id/money-flow-ledger.zip"
  fi
  if [ "$enable_people" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" people-groups sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/people-groups.dump"'
  fi
  if [ "$enable_party" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" party-directory \
      /app/backup restore --input "/backups/$backup_id/party-directory.zip"
  fi
  if [ "$enable_project" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" project-workspace sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/project-workspace.dump"'
  fi
  if [ "$enable_evidence" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" evidence-service \
      /app/backup restore --input "/backups/$backup_id/evidence-service.zip"
  fi
  if [ "$enable_business_engagement" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" business-engagement sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/business-engagement.dump"'
  fi
  if [ "$enable_billing" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" billing-invoice sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/billing-invoice.dump"'
  fi
  if [ "$enable_production" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" production-operations sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/production-operations.dump"'
  fi
  if [ "$enable_approval_audit_results" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" approval-audit-results sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/approval-audit-results.dump"'
  fi
  if [ "$enable_cost_outsourcing" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" cost-outsourcing sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/cost-outsourcing.dump"'
  fi
  if [ "$enable_bonus_distribution" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" bonus-distribution sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/bonus-distribution.dump"'
  fi
  if [ "$enable_internal_finance_requests" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" internal-finance-requests sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/internal-finance-requests.dump"'
  fi
  if [ "$enable_payroll" = true ]; then
    compose_all run --rm --no-deps -e BACKUP_ID="$backup_id" payroll sh -eu -c \
      'pg_restore --dbname "$DATABASE_URL" --single-transaction --exit-on-error --no-owner --no-privileges "/backups/$BACKUP_ID/payroll.dump"'
  fi
  restore_backup_permissions
  if [ -f "$target/database-fingerprints.tsv" ]; then
    restore_fingerprint_temp=$(mktemp "${TMPDIR:-/tmp}/omsbizfoundry-d1-restored-fingerprints.XXXXXX")
    capture_database_fingerprints "$restore_fingerprint_temp" \
      "$enable_contract" "$enable_money" "$enable_people" "$enable_party" \
      "$enable_project" "$enable_evidence" "$enable_business_engagement" "$enable_billing" \
      "$enable_production" "$enable_approval_audit_results" "$enable_cost_outsourcing" \
      "$enable_bonus_distribution" "$enable_internal_finance_requests" "$enable_payroll"
    if ! cmp -s "$target/database-fingerprints.tsv" "$restore_fingerprint_temp"; then
      echo 'restored database fingerprints do not match the quiesced backup checkpoint' >&2
      diff -u "$target/database-fingerprints.tsv" "$restore_fingerprint_temp" >&2 || true
      exit 1
    fi
    rm -f "$restore_fingerprint_temp"
    restore_fingerprint_temp=''
  fi
  trap - EXIT HUP INT TERM
  compose_enabled up --detach --wait
  remove_disabled
  check_stack
  echo "backup restored and verified: $backup_id"
}

command=${1:-}
if [ "$evidence_storage_mode" != local ]; then
  case "$command" in up|apply|upgrade|restore|backup|check|preflight-upgrade)
    # Fail before any image build, service stop, backup or business mutation.
    EVIDENCE_IMDS_NETWORK=$(env_value EVIDENCE_EGRESS_NETWORK) sh "$script_dir/evidence-imds-guard" status
    ;;
  esac
fi
case "$command" in
  up|apply) bring_up ;;
  status) compose_enabled ps ;;
  check) check_stack ;;
  config) shift; compose_enabled config "$@" ;;
  images) compose_enabled config --images | sort -u ;;
  prepare-images) prepare_images ;;
  preflight-upgrade) preflight_upgrade ;;
  party-map) run_party_map "${2:-}" "${3:-}" ;;
  purge-open-api-usage) purge_open_api_usage "${2:-}" ;;
  backup) create_backup ;;
  upgrade)
    preflight_upgrade
    echo "creating pre-mutation backup from the currently deployed application selection"
    create_backup running
    echo "replacing D1 containers while preserving named data volumes"
    compose_all down --remove-orphans
    start_prepared_stack
    check_stack
    ;;
  restore) restore_backup "${2:-}" ;;
  down) compose_all down --remove-orphans ;;
  *) usage ;;
esac
