# Record only table counts, row counts and SHA-256 values.  The canonical row
# stream is reduced to one SHA-256 per row inside PostgreSQL before it crosses
# the container boundary, so password hashes, API Key verifiers, account
# details and other business values never enter the backup evidence file.
capture_database_fingerprints() {
  output=$1
  shift
  fingerprint_contract=$1
  fingerprint_money=$2
  fingerprint_people=$3
  fingerprint_party=$4
  fingerprint_project=$5
  fingerprint_evidence=$6
  fingerprint_business_engagement=$7
  fingerprint_billing=$8
  fingerprint_production=$9
  fingerprint_approval_audit_results=${10}
  fingerprint_cost_outsourcing=${11}
  fingerprint_bonus_distribution=${12}
  fingerprint_internal_finance_requests=${13}
  fingerprint_payroll=${14}

  databases=identity_access
  [ "$fingerprint_contract" != true ] || databases="$databases contract_ledger"
  [ "$fingerprint_money" != true ] || databases="$databases money_flow"
  [ "$fingerprint_people" != true ] || databases="$databases people_groups"
  [ "$fingerprint_party" != true ] || databases="$databases party_directory"
  [ "$fingerprint_project" != true ] || databases="$databases project_workspace"
  [ "$fingerprint_evidence" != true ] || databases="$databases evidence_service"
  [ "$fingerprint_business_engagement" != true ] || databases="$databases business_engagement"
  [ "$fingerprint_billing" != true ] || databases="$databases billing_invoice"
  [ "$fingerprint_production" != true ] || databases="$databases design_operations"
  [ "$fingerprint_approval_audit_results" != true ] || databases="$databases approval_audit_results"
  [ "$fingerprint_cost_outsourcing" != true ] || databases="$databases cost_outsourcing"
  [ "$fingerprint_bonus_distribution" != true ] || databases="$databases bonus_distribution"
  [ "$fingerprint_internal_finance_requests" != true ] || databases="$databases internal_finance_requests"
  [ "$fingerprint_payroll" != true ] || databases="$databases payroll"

  temporary="$output.tmp"
  rm -f "$temporary"
  {
    printf 'FORMAT\tomsbizfoundry.d1-database-fingerprints/v1\n'
    printf 'EXCLUDED_DATA\tidentity_access.public.suite_sessions\n'
    printf 'DATABASE\tTABLE_COUNT\tROW_COUNT\tSCHEMA_SHA256\tFACT_SHA256\n'
  } >"$temporary"
  chmod 600 "$temporary"

  for database in $databases; do
    excluded_table=''
    [ "$database" != identity_access ] || excluded_table=suite_sessions

    schema_rows=$(compose exec -T postgres sh -eu -c '
      psql --quiet --tuples-only --no-align --set=ON_ERROR_STOP=1 \
        --username "$POSTGRES_USER" --dbname "$1"
    ' sh "$database" <<'SQL'
WITH metadata AS (
  SELECT jsonb_build_object(
    'kind','column','table',table_name,'name',column_name,
    'ordinal',ordinal_position,'type',data_type,'nullable',is_nullable,
    'default',column_default
  ) AS item
  FROM information_schema.columns
  WHERE table_schema='public'
  UNION ALL
  SELECT jsonb_build_object(
    'kind','constraint','table',c.conrelid::regclass::text,'name',c.conname,
    'definition',pg_get_constraintdef(c.oid,true)
  )
  FROM pg_constraint c
  JOIN pg_namespace n ON n.oid=c.connamespace
  WHERE n.nspname='public'
  UNION ALL
  SELECT jsonb_build_object(
    'kind','index','table',tablename,'name',indexname,'definition',indexdef
  )
  FROM pg_indexes
  WHERE schemaname='public'
  UNION ALL
  SELECT jsonb_build_object(
    'kind','trigger','table',event_object_table,'name',trigger_name,
    'timing',action_timing,'event',event_manipulation,
    'statement',action_statement
  )
  FROM information_schema.triggers
  WHERE trigger_schema='public'
)
SELECT item::text FROM metadata ORDER BY item::text;
SQL
    )

    fact_rows=$(compose exec -T postgres sh -eu -c '
      psql --quiet --tuples-only --no-align --field-separator="|" --set=ON_ERROR_STOP=1 \
        --set=excluded_table="$2" --username "$POSTGRES_USER" --dbname "$1"
    ' sh "$database" "$excluded_table" <<'SQL'
CREATE TEMP TABLE d1_fingerprint_tables(table_name text PRIMARY KEY);
INSERT INTO d1_fingerprint_tables(table_name)
SELECT table_name
FROM information_schema.tables
WHERE table_schema='public'
  AND table_type='BASE TABLE'
  AND (:'excluded_table'='' OR table_name<>:'excluded_table');

CREATE TEMP TABLE d1_fingerprint_rows(
  record_kind text NOT NULL,
  table_name text NOT NULL,
  row_digest text NOT NULL
);
INSERT INTO d1_fingerprint_rows(record_kind,table_name,row_digest)
SELECT 'T',table_name,'' FROM d1_fingerprint_tables;

DO $$
DECLARE item record;
BEGIN
  FOR item IN SELECT table_name FROM d1_fingerprint_tables ORDER BY table_name
  LOOP
    EXECUTE format(
      'INSERT INTO d1_fingerprint_rows(record_kind,table_name,row_digest) '
      'SELECT ''R'',%L,encode(sha256(convert_to(to_jsonb(value)::text,''UTF8'')),''hex'') FROM %I AS value',
      item.table_name,item.table_name
    );
  END LOOP;
END $$;
SELECT record_kind,table_name,row_digest
FROM d1_fingerprint_rows
ORDER BY record_kind,table_name,row_digest;
SQL
    )

    table_count=$(printf '%s\n' "$fact_rows" | awk -F '|' '$1=="T" {n++} END {print n+0}')
    row_count=$(printf '%s\n' "$fact_rows" | awk -F '|' '$1=="R" {n++} END {print n+0}')
    schema_sha=$(printf '%s' "$schema_rows" | digest_text)
    fact_sha=$(printf '%s' "$fact_rows" | digest_text)
    printf '%s\t%s\t%s\t%s\t%s\n' "$database" "$table_count" "$row_count" "$schema_sha" "$fact_sha" >>"$temporary"
  done

  mv "$temporary" "$output"
  chmod 600 "$output"
}

