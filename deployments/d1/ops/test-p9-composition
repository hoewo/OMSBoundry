#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
d1="$script_dir/d1"
test_dir=$(mktemp -d "${TMPDIR:-/tmp}/omsbizfoundry-p9-composition.XXXXXX")
trap 'rm -rf -- "$test_dir"' EXIT HUP INT TERM

write_env() {
  target=$1
  cat >"$target" <<ENV
SUITE_VERSION=p9-test
D1_IMAGE_MODE=build
D1_INGRESS_MODE=http
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=18000
COOKIE_SECURE=false
PUBLIC_ISSUER=https://oms.example.test/auth
TENANT_ID=22222222-2222-4222-8222-222222222222
POSTGRES_SUPERUSER=oms_admin
POSTGRES_SUPERUSER_PASSWORD=AdminPassword_123
IDENTITY_DB_PASSWORD=IdentityPassword_123
CONTRACT_DB_PASSWORD=ContractPassword_123
MONEY_DB_PASSWORD=MoneyPassword_123
PEOPLE_DB_PASSWORD=PeoplePassword_123
PARTY_DB_PASSWORD=PartyPassword_1234
PROJECT_DB_PASSWORD=ProjectPassword_123
EVIDENCE_DB_PASSWORD=EvidencePassword_123
BUSINESS_ENGAGEMENT_DB_PASSWORD=BusinessEngagementPassword_123
BILLING_DB_PASSWORD=BillingInvoicePassword_123
PRODUCTION_DB_PASSWORD=ProductionPassword_123
APPROVAL_AUDIT_RESULTS_DB_PASSWORD=ApprovalAuditResultsPassword_123
COST_OUTSOURCING_DB_PASSWORD=CostOutsourcingPassword_123
BONUS_DISTRIBUTION_DB_PASSWORD=BonusDistributionPassword_123
INTERNAL_FINANCE_REQUESTS_DB_PASSWORD=InternalFinancePassword_123
PAYROLL_DB_PASSWORD=PayrollPassword_123
BOOTSTRAP_ADMIN_PASSWORD=BootstrapPassword_123
ENABLE_CONTRACT=false
ENABLE_MONEY=true
ENABLE_PEOPLE=true
ENABLE_PARTY=false
ENABLE_PROJECT=false
ENABLE_EVIDENCE=true
ENABLE_BUSINESS_ENGAGEMENT=false
ENABLE_BILLING=false
ENABLE_PRODUCTION=false
ENABLE_APPROVAL_AUDIT_RESULTS=false
ENABLE_COST_OUTSOURCING=false
ENABLE_BONUS_DISTRIBUTION=false
ENABLE_INTERNAL_FINANCE_REQUESTS=true
ENABLE_PAYROLL=true
PROJECT_PARTY_BASE_URL=
PARTY_CURSOR_HMAC_KEY=PartyCursorHMACKey_1234567890123456
EVIDENCE_PUBLIC_BASE_URL=http://127.0.0.1:18000/evidence
EVIDENCE_LOCAL_SIGNING_KEY=YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE
D1_BACKUP_DIR=$test_dir/backups
D1_BACKUP_DRAIN_SECONDS=0
ENV
}

env_file="$test_dir/d1.env"
write_env "$env_file"
D1_ENV_FILE="$env_file" D1_PROJECT_NAME=omsbizfoundry-p9-static "$d1" config --format json >"$test_dir/rendered.json"

jq -e '
  .services["internal-finance-requests-workload-key-permissions"] != null and
  .services["internal-finance-requests-workload-keys"].environment.WORKLOAD_ID == "internal-finance-requests" and
  .services["internal-finance-requests-workload-keys"].environment.WORKLOAD_SUBJECT_ID == "ffffffff-ffff-4fff-bfff-ffffffffffff" and
  .services["internal-finance-requests"].environment.MONEY_BASE_URL == "http://money-flow-ledger:8083" and
  .services["internal-finance-requests"].environment.EVIDENCE_BASE_URL == "http://evidence-service:8085" and
  .services["internal-finance-requests"].depends_on["internal-finance-requests-workload-keys"].condition == "service_completed_successfully" and
  .services["internal-finance-requests"].depends_on["money-flow-ledger"].condition == "service_healthy" and
  .services["internal-finance-requests"].depends_on["evidence-service"].condition == "service_healthy" and
  .services.payroll.environment.WORKLOAD_ID == "payroll" and
  .services.payroll.environment.MONEY_BASE_URL == "http://money-flow-ledger:8083" and
  .services.payroll.depends_on["people-groups"].condition == "service_healthy" and
  .services.payroll.depends_on["money-flow-ledger"].condition == "service_healthy" and
  .volumes["internal-finance-requests-workload-private"] != null
' "$test_dir/rendered.json" >/dev/null || {
  echo 'P9 rendered composition has an incomplete Finance/Payroll dependency graph' >&2
  exit 1
}

assert_invalid_selection() {
  name=$1
  setting=$2
  expected=$3
  prerequisite=${4:-}
  invalid_env="$test_dir/$name.env"
  cp "$env_file" "$invalid_env"
  [ -z "$prerequisite" ] || printf '%s\n' "$prerequisite" >>"$invalid_env"
  printf '%s\n' "$setting" >>"$invalid_env"
  if D1_ENV_FILE="$invalid_env" D1_PROJECT_NAME="omsbizfoundry-p9-$name" "$d1" config >"$test_dir/$name.out" 2>"$test_dir/$name.err"; then
    echo "P9 accepted invalid selection: $setting" >&2
    exit 1
  fi
  grep -Fq "$expected" "$test_dir/$name.err"
}

assert_invalid_selection finance-without-money 'ENABLE_MONEY=false' 'ENABLE_INTERNAL_FINANCE_REQUESTS=true requires ENABLE_MONEY=true and ENABLE_EVIDENCE=true'
assert_invalid_selection finance-without-evidence 'ENABLE_EVIDENCE=false' 'ENABLE_INTERNAL_FINANCE_REQUESTS=true requires ENABLE_MONEY=true and ENABLE_EVIDENCE=true'
assert_invalid_selection payroll-without-people 'ENABLE_PEOPLE=false' 'ENABLE_PAYROLL=true requires ENABLE_PEOPLE=true and ENABLE_MONEY=true' 'ENABLE_INTERNAL_FINANCE_REQUESTS=false'
assert_invalid_selection payroll-without-money 'ENABLE_MONEY=false' 'ENABLE_PAYROLL=true requires ENABLE_PEOPLE=true and ENABLE_MONEY=true' 'ENABLE_INTERNAL_FINANCE_REQUESTS=false'

invalid_drain_env="$test_dir/invalid-drain.env"
cp "$env_file" "$invalid_drain_env"
printf '%s\n' 'D1_BACKUP_DRAIN_SECONDS=31' >>"$invalid_drain_env"
if D1_ENV_FILE="$invalid_drain_env" D1_PROJECT_NAME=omsbizfoundry-p9-invalid-drain "$d1" config >"$test_dir/invalid-drain.out" 2>"$test_dir/invalid-drain.err"; then
  echo 'P9 accepted an out-of-range backup drain interval' >&2
  exit 1
fi
grep -Fq 'D1_BACKUP_DRAIN_SECONDS must be an integer from 0 to 30' "$test_dir/invalid-drain.err"

feedback_key='ak_test_0123456789abcdef0123456789abcdef0123456789abcdef'
feedback_hmac='0123456789abcdef0123456789abcdef'
feedback_env="$test_dir/feedback.env"
cp "$env_file" "$feedback_env"
printf '%s\n' \
  'FEEDBACK_SDK_URL=https://feedback.example.test/sdk.js' \
  'FEEDBACK_AUTH_MODE=apiKey' \
  'FEEDBACK_GATEWAY_URL=https://feedback.example.test' \
  'FEEDBACK_PROJECT_ID=115' \
  "FEEDBACK_API_KEY=$feedback_key" \
  "FEEDBACK_IDENTITY_HMAC_KEY=$feedback_hmac" \
  'FEEDBACK_IDENTITY_VERSION=v1' \
  'FEEDBACK_NOTIFICATIONS_ENABLED=true' >>"$feedback_env"
D1_ENV_FILE="$feedback_env" D1_PROJECT_NAME=omsbizfoundry-p9-feedback "$d1" config --format json >"$test_dir/feedback.json"
jq -e '
  .services["unified-workbench"].environment.FEEDBACK_SDK_URL == "https://feedback.example.test/sdk.js" and
  .services.gateway.environment.FEEDBACK_AUTH_MODE == "apiKey" and
  (.services.gateway.environment.FEEDBACK_PROJECT_ID | tostring) == "115" and
  (.services.gateway.environment.FEEDBACK_NOTIFICATIONS_ENABLED | tostring) == "true"
' "$test_dir/feedback.json" >/dev/null

feedback_rotation_env="$test_dir/feedback-rotation.env"
cp "$feedback_env" "$feedback_rotation_env"
printf '%s\n' \
  'FEEDBACK_API_KEY=' \
  "FEEDBACK_API_KEYS=${feedback_key},ak_previous_0123456789abcdef0123456789abcdef" >>"$feedback_rotation_env"
D1_ENV_FILE="$feedback_rotation_env" D1_PROJECT_NAME=omsbizfoundry-p9-feedback-rotation \
  "$d1" config --format json >"$test_dir/feedback-rotation.json"
jq -e '.services.gateway.environment.FEEDBACK_API_KEY == "" and (.services.gateway.environment.FEEDBACK_API_KEYS | split(",") | length) == 2' \
  "$test_dir/feedback-rotation.json" >/dev/null

assert_invalid_feedback() {
  name=$1
  settings=$2
  expected=$3
  invalid_env="$test_dir/feedback-$name.env"
  cp "$env_file" "$invalid_env"
  printf '%s\n' "$settings" >>"$invalid_env"
  if D1_ENV_FILE="$invalid_env" D1_PROJECT_NAME="omsbizfoundry-p9-feedback-$name" "$d1" config >"$test_dir/feedback-$name.out" 2>"$test_dir/feedback-$name.err"; then
    echo "P9 accepted invalid Feedback config: $name" >&2
    exit 1
  fi
  grep -Fq "$expected" "$test_dir/feedback-$name.err"
}

feedback_common="FEEDBACK_SDK_URL=https://feedback.example.test/sdk.js
FEEDBACK_AUTH_MODE=apiKey
FEEDBACK_GATEWAY_URL=https://feedback.example.test
FEEDBACK_PROJECT_ID=115
FEEDBACK_API_KEY=$feedback_key
FEEDBACK_IDENTITY_HMAC_KEY=$feedback_hmac
FEEDBACK_IDENTITY_VERSION=v1
FEEDBACK_NOTIFICATIONS_ENABLED=true"
assert_invalid_feedback partial 'FEEDBACK_AUTH_MODE=apiKey' 'FEEDBACK_SDK_URL must use HTTPS or loopback HTTP'
assert_invalid_feedback wrong-project "${feedback_common}
FEEDBACK_PROJECT_ID=116" 'FEEDBACK_PROJECT_ID must be 115 for this OMS1 release'
assert_invalid_feedback insecure-remote "${feedback_common}
FEEDBACK_SDK_URL=http://feedback.example.test/sdk.js" 'FEEDBACK_SDK_URL must use HTTPS or loopback HTTP'
assert_invalid_feedback ambiguous-keys "${feedback_common}
FEEDBACK_API_KEYS=${feedback_key},ak_previous_0123456789abcdef0123456789abcdef" 'configure only one of FEEDBACK_API_KEY or FEEDBACK_API_KEYS'
assert_invalid_feedback too-many-keys "${feedback_common}
FEEDBACK_API_KEY=
FEEDBACK_API_KEYS=${feedback_key},ak_previous_0123456789abcdef0123456789abcdef,ak_older_0123456789abcdef0123456789abcdef" 'FEEDBACK_API_KEYS must contain one current key and at most one previous key'
assert_invalid_feedback short-hmac "${feedback_common}
FEEDBACK_IDENTITY_HMAC_KEY=too-short" 'FEEDBACK_IDENTITY_HMAC_KEY must contain at least 32 characters'
assert_invalid_feedback session-mode "${feedback_common}
FEEDBACK_AUTH_MODE=session" 'FEEDBACK_AUTH_MODE must be apiKey for the first release'

# Exercise the selected backup and empty-target restore command graph without
# starting Docker. This proves the two new Owners participate in the same D1
# orchestration and checksum manifest; it deliberately does not claim a real
# PostgreSQL restore.
mock_bin="$test_dir/mock-bin"
mock_log="$test_dir/docker.log"
mkdir -p "$mock_bin"
cat >"$mock_bin/docker" <<'MOCK'
#!/bin/sh
set -eu
printf '%s\n' "$*" >>"$D1_DOCKER_MOCK_LOG"
case " $* " in
  *' ps --status running --services '*)
    printf '%s\n' "${D1_DOCKER_MOCK_RUNNING_SERVICES-nginx}"
    exit 0
    ;;
  *' ps --all --services '*)
    printf '%s\n' "${D1_DOCKER_MOCK_ALL_SERVICES-identity-access
money-flow-ledger
people-groups
evidence-service
internal-finance-requests
payroll
unified-workbench
gateway
nginx
postgres}"
    exit 0
    ;;
esac
case " $* " in
  *' exec -T postgres sh -eu -c '*psql*)
    printf 'T|test_table%s|%s\n' "${D1_DOCKER_MOCK_FINGERPRINT_SUFFIX:-}" "${D1_DOCKER_MOCK_FINGERPRINT_SUFFIX:-}"
    printf 'R|test_table%s|%s\n' "${D1_DOCKER_MOCK_FINGERPRINT_SUFFIX:-}" "${D1_DOCKER_MOCK_FINGERPRINT_SUFFIX:-}"
    printf 'S|public.test_sequence%s%s|%s%s\n' \
      "${D1_DOCKER_MOCK_FINGERPRINT_SUFFIX:-}" "${D1_DOCKER_MOCK_SEQUENCE_SUFFIX:-}" \
      "${D1_DOCKER_MOCK_FINGERPRINT_SUFFIX:-}" "${D1_DOCKER_MOCK_SEQUENCE_SUFFIX:-}"
    exit 0
    ;;
esac
if [ "${D1_DOCKER_MOCK_FAIL_PAYROLL:-}" = 1 ]; then
  case " $* " in
    *' payroll sh -eu -c '*pg_dump*) exit 17 ;;
  esac
fi
backup_id=''
for argument in "$@"; do
  case "$argument" in BACKUP_ID=*) backup_id=${argument#BACKUP_ID=};; esac
done
if [ -n "$backup_id" ]; then
  target="$D1_TEST_BACKUP_DIR/$backup_id"
  mkdir -p "$target"
  for artifact in identity-access.dump signing-keys.json money-flow-ledger.zip people-groups.dump evidence-service.zip internal-finance-requests.dump payroll.dump; do
    : >"$target/$artifact"
  done
fi
MOCK
chmod +x "$mock_bin/docker"
: >"$mock_log"
PATH="$mock_bin:$PATH" D1_DOCKER_MOCK_LOG="$mock_log" D1_TEST_BACKUP_DIR="$test_dir/backups" \
  D1_ENV_FILE="$env_file" D1_PROJECT_NAME=omsbizfoundry-p9-static "$d1" backup >"$test_dir/backup.out"
cp "$mock_log" "$test_dir/backup-docker.log"
backup=$(find "$test_dir/backups" -mindepth 1 -maxdepth 1 -type d -print -quit)
[ -n "$backup" ] && [ -f "$backup/checksums.sha256" ] && [ -f "$backup/suite-selection.env" ]
grep -qx 'ENABLE_INTERNAL_FINANCE_REQUESTS=true' "$backup/suite-selection.env"
grep -qx 'ENABLE_PAYROLL=true' "$backup/suite-selection.env"
grep -q 'internal-finance-requests.dump' "$backup/checksums.sha256"
grep -q 'payroll.dump' "$backup/checksums.sha256"
grep -q 'backup-consistency.env' "$backup/checksums.sha256"
grep -q 'database-fingerprints.tsv' "$backup/checksums.sha256"
grep -qx 'CONSISTENCY_MODE=public-ingress-quiesced-v1' "$backup/backup-consistency.env"
grep -qx 'PUBLIC_INGRESS_WAS_RUNNING=true' "$backup/backup-consistency.env"
grep -qx 'FORMAT	omsbizfoundry.d1-database-fingerprints/v1' "$backup/database-fingerprints.tsv"
grep -qx 'EXCLUDED_DATA	identity_access.public.suite_sessions' "$backup/database-fingerprints.tsv"
grep -q '^internal_finance_requests	' "$backup/database-fingerprints.tsv"
grep -q '^payroll	' "$backup/database-fingerprints.tsv"
awk -F '\t' '
  NR <= 3 { next }
  $2 != 1 || $3 != 1 { exit 1 }
  { databases++ }
  END { if (databases != 6) exit 1 }
' "$backup/database-fingerprints.tsv"
stop_line=$(grep -n ' stop nginx' "$test_dir/backup-docker.log" | head -n 1 | cut -d: -f1)
first_dump_line=$(grep -n 'identity-access sh -eu -c .*pg_dump' "$test_dir/backup-docker.log" | head -n 1 | cut -d: -f1)
last_dump_line=$(grep -n 'payroll sh -eu -c .*pg_dump' "$test_dir/backup-docker.log" | tail -n 1 | cut -d: -f1)
restart_line=$(grep -n ' up --detach --no-deps --no-build --wait nginx' "$test_dir/backup-docker.log" | tail -n 1 | cut -d: -f1)
[ -n "$stop_line" ] && [ -n "$first_dump_line" ] && [ -n "$last_dump_line" ] && [ -n "$restart_line" ] \
  && [ "$stop_line" -lt "$first_dump_line" ] && [ "$restart_line" -gt "$last_dump_line" ] || {
  echo 'P9 joint backup did not quiesce public ingress around every Owner dump' >&2
  exit 1
}
backup_id=$(basename "$backup")
PATH="$mock_bin:$PATH" D1_DOCKER_MOCK_LOG="$mock_log" D1_TEST_BACKUP_DIR="$test_dir/backups" \
  D1_CONFIRM_EMPTY_RESTORE=yes D1_ENV_FILE="$env_file" D1_PROJECT_NAME=omsbizfoundry-p9-static \
  "$d1" restore "$backup_id" >"$test_dir/restore.out"
grep -q 'internal-finance-requests sh -eu -c .*pg_dump' "$mock_log"
grep -q 'payroll sh -eu -c .*pg_dump' "$mock_log"
grep -q 'run --rm --no-deps .*internal-finance-requests sh -eu -c .*pg_restore' "$mock_log"
grep -q 'run --rm --no-deps .*payroll sh -eu -c .*pg_restore' "$mock_log"

# Backups created before BF-248 have no database fingerprint artifact. They
# remain restorable after their original checksum manifest is verified.
legacy_backup_id="$backup_id-legacy"
legacy_backup="$test_dir/backups/$legacy_backup_id"
cp -R "$backup" "$legacy_backup"
rm "$legacy_backup/database-fingerprints.tsv"
awk '$2 != "database-fingerprints.tsv"' "$legacy_backup/checksums.sha256" >"$legacy_backup/checksums.sha256.tmp"
mv "$legacy_backup/checksums.sha256.tmp" "$legacy_backup/checksums.sha256"
PATH="$mock_bin:$PATH" D1_DOCKER_MOCK_LOG="$mock_log" D1_TEST_BACKUP_DIR="$test_dir/backups" \
  D1_CONFIRM_EMPTY_RESTORE=yes D1_ENV_FILE="$env_file" D1_PROJECT_NAME=omsbizfoundry-p9-static \
  "$d1" restore "$legacy_backup_id" >"$test_dir/restore-legacy.out"
grep -Fq "backup restored and verified: $legacy_backup_id" "$test_dir/restore-legacy.out"

# A structurally invalid fingerprint must fail before the destructive empty-
# target cleanup, even when its outer checksum was recomputed.
malformed_backup_id="$backup_id-malformed"
malformed_backup="$test_dir/backups/$malformed_backup_id"
malformed_log="$test_dir/malformed-docker.log"
cp -R "$backup" "$malformed_backup"
awk -F '\t' 'BEGIN { OFS="\t" } $1=="payroll" { $2=0 } { print }' \
  "$malformed_backup/database-fingerprints.tsv" >"$malformed_backup/database-fingerprints.tsv.tmp"
mv "$malformed_backup/database-fingerprints.tsv.tmp" "$malformed_backup/database-fingerprints.tsv"
fingerprint_sha=$(openssl dgst -sha256 -r "$malformed_backup/database-fingerprints.tsv" | awk '{print $1}')
awk -v sha="$fingerprint_sha" '$2=="database-fingerprints.tsv" {$1=sha} {print}' \
  "$malformed_backup/checksums.sha256" >"$malformed_backup/checksums.sha256.tmp"
mv "$malformed_backup/checksums.sha256.tmp" "$malformed_backup/checksums.sha256"
: >"$malformed_log"
if PATH="$mock_bin:$PATH" D1_DOCKER_MOCK_LOG="$malformed_log" D1_TEST_BACKUP_DIR="$test_dir/backups" \
  D1_CONFIRM_EMPTY_RESTORE=yes D1_ENV_FILE="$env_file" D1_PROJECT_NAME=omsbizfoundry-p9-static \
  "$d1" restore "$malformed_backup_id" >"$test_dir/restore-malformed.out" 2>"$test_dir/restore-malformed.err"; then
  echo 'P9 restore accepted a malformed database fingerprint artifact' >&2
  exit 1
fi
grep -Fq 'database fingerprint artifact has an invalid or duplicate record' "$test_dir/restore-malformed.err"
if grep -q ' down --volumes --remove-orphans' "$malformed_log"; then
  echo 'P9 restore performed destructive cleanup before rejecting malformed fingerprints' >&2
  exit 1
fi

if PATH="$mock_bin:$PATH" D1_DOCKER_MOCK_LOG="$mock_log" D1_DOCKER_MOCK_FINGERPRINT_SUFFIX=-changed \
  D1_TEST_BACKUP_DIR="$test_dir/backups" D1_CONFIRM_EMPTY_RESTORE=yes D1_ENV_FILE="$env_file" \
  D1_PROJECT_NAME=omsbizfoundry-p9-static "$d1" restore "$backup_id" \
  >"$test_dir/restore-mismatch.out" 2>"$test_dir/restore-mismatch.err"; then
  echo 'P9 restore accepted mismatched database fingerprints' >&2
  exit 1
fi
grep -Fq 'restored database fingerprints do not match the quiesced backup checkpoint' "$test_dir/restore-mismatch.err"

# A sequence-only drift must also change the fact digest. Matching table rows
# are insufficient because the next generated identifier is checkpoint state.
if PATH="$mock_bin:$PATH" D1_DOCKER_MOCK_LOG="$mock_log" D1_DOCKER_MOCK_SEQUENCE_SUFFIX=-advanced \
  D1_TEST_BACKUP_DIR="$test_dir/backups" D1_CONFIRM_EMPTY_RESTORE=yes D1_ENV_FILE="$env_file" \
  D1_PROJECT_NAME=omsbizfoundry-p9-static "$d1" restore "$backup_id" \
  >"$test_dir/restore-sequence-mismatch.out" 2>"$test_dir/restore-sequence-mismatch.err"; then
  echo 'P9 restore accepted a sequence-only fingerprint mismatch' >&2
  exit 1
fi
grep -Fq 'restored database fingerprints do not match the quiesced backup checkpoint' \
  "$test_dir/restore-sequence-mismatch.err"

# A failed Owner dump must still restore the public edge through the trap.
failure_env="$test_dir/failure.env"
failure_log="$test_dir/failure-docker.log"
cp "$env_file" "$failure_env"
printf '%s\n' "D1_BACKUP_DIR=$test_dir/failure-backups" >>"$failure_env"
: >"$failure_log"
if PATH="$mock_bin:$PATH" D1_DOCKER_MOCK_LOG="$failure_log" D1_DOCKER_MOCK_FAIL_PAYROLL=1 \
  D1_TEST_BACKUP_DIR="$test_dir/failure-backups" D1_ENV_FILE="$failure_env" D1_PROJECT_NAME=omsbizfoundry-p9-failure \
  "$d1" backup >"$test_dir/failure.out" 2>"$test_dir/failure.err"; then
  echo 'P9 joint backup ignored an injected Payroll dump failure' >&2
  exit 1
fi
failure_stop_line=$(grep -n ' stop nginx' "$failure_log" | head -n 1 | cut -d: -f1)
failure_restart_line=$(grep -n ' up --detach --no-deps --no-build --wait nginx' "$failure_log" | tail -n 1 | cut -d: -f1)
[ -n "$failure_stop_line" ] && [ -n "$failure_restart_line" ] && [ "$failure_restart_line" -gt "$failure_stop_line" ] || {
  echo 'P9 failed backup did not restore public ingress' >&2
  exit 1
}

# An intentionally closed edge stays closed after a successful explicit
# backup; the operation must preserve its original running state.
closed_env="$test_dir/closed.env"
closed_log="$test_dir/closed-docker.log"
cp "$env_file" "$closed_env"
printf '%s\n' "D1_BACKUP_DIR=$test_dir/closed-backups" >>"$closed_env"
: >"$closed_log"
PATH="$mock_bin:$PATH" D1_DOCKER_MOCK_LOG="$closed_log" D1_DOCKER_MOCK_RUNNING_SERVICES='' \
  D1_TEST_BACKUP_DIR="$test_dir/closed-backups" D1_ENV_FILE="$closed_env" D1_PROJECT_NAME=omsbizfoundry-p9-closed \
  "$d1" backup >"$test_dir/closed.out"
if grep -q ' stop nginx\| up --detach --no-deps --no-build --wait nginx' "$closed_log"; then
  echo 'P9 backup changed an ingress that was already stopped' >&2
  exit 1
fi

# Upgrade owns the stopped edge after a successful pre-mutation backup. It
# must proceed directly to Compose teardown without a backup/write gap.
upgrade_env="$test_dir/upgrade.env"
upgrade_log="$test_dir/upgrade-docker.log"
cp "$env_file" "$upgrade_env"
printf '%s\n' "D1_BACKUP_DIR=$test_dir/upgrade-backups" >>"$upgrade_env"
: >"$upgrade_log"
PATH="$mock_bin:$PATH" D1_DOCKER_MOCK_LOG="$upgrade_log" D1_TEST_BACKUP_DIR="$test_dir/upgrade-backups" \
  D1_ENV_FILE="$upgrade_env" D1_PROJECT_NAME=omsbizfoundry-p9-upgrade "$d1" upgrade >"$test_dir/upgrade.out"
upgrade_stop_line=$(grep -n ' stop nginx' "$upgrade_log" | head -n 1 | cut -d: -f1)
upgrade_down_line=$(grep -n ' down --remove-orphans' "$upgrade_log" | head -n 1 | cut -d: -f1)
[ -n "$upgrade_stop_line" ] && [ -n "$upgrade_down_line" ] && [ "$upgrade_down_line" -gt "$upgrade_stop_line" ] || {
  echo 'P9 upgrade did not preserve the pre-mutation stop boundary' >&2
  exit 1
}
if sed -n "${upgrade_stop_line},${upgrade_down_line}p" "$upgrade_log" | grep -q ' up --detach --no-deps --no-build --wait nginx'; then
  echo 'P9 upgrade reopened ingress between its backup and Compose teardown' >&2
  exit 1
fi
tail -n "+$((upgrade_down_line + 1))" "$upgrade_log" | grep -q ' up --detach --no-build --wait'

echo 'PASS D1 P9 composition test'
