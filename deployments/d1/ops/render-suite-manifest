      "readiness_path": "/health/ready",
      "audience": "business-engagement",
      "entry_action": "business-engagement.read",
      "capability_manifest": "/config/business-engagement-capabilities.json"
    },
    {
      "id": "billing-invoice",
      "version": "0.1.0",
