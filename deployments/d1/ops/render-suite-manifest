      "readiness_path": "/health/ready",
      "audience": "internal-finance-requests",
      "entry_actions": ["internal-finance-requests.self.read", "internal-finance-requests.tenant.read"],
      "capability_manifest": "/config/internal-finance-requests-capabilities.json"
    },
    {
      "id": "payroll",
      "version": "0.1.0",
      "enabled": $enable_payroll,
      "required": false,
      "route_prefix": "/payroll/v1",
      "upstream": "http://payroll:8093",
      "readiness_path": "/health/ready",
      "audience": "payroll",
      "entry_actions": ["payroll.self.read", "payroll.tenant.read"],
      "capability_manifest": "/config/payroll-capabilities.json"
    }
  ]
}
JSON
mv "$temporary" "$output"
trap - EXIT HUP INT TERM
