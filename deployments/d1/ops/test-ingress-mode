#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
d1_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
d1="$script_dir/d1"
mkdir -p "$d1_dir/.runtime"
test_dir=$(mktemp -d "$d1_dir/.runtime/ingress-mode-test.XXXXXX")
trap 'rm -rf -- "$test_dir"' EXIT HUP INT TERM

certificate="$test_dir/app.example.test.pem"
private_key="$test_dir/app.example.test.key"
other_key="$test_dir/other.key"
openssl req -x509 -newkey rsa:2048 -sha256 -days 1 -nodes \
  -subj '/CN=app.example.test' -addext 'subjectAltName=DNS:app.example.test' \
  -keyout "$private_key" -out "$certificate" >/dev/null 2>&1
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$other_key" >/dev/null 2>&1
chmod 600 "$private_key" "$other_key"

write_common_env() {
  target=$1
  cat >"$target" <<'ENV'
SUITE_VERSION=test
D1_IMAGE_MODE=build
TENANT_ID=22222222-2222-4222-8222-222222222222
POSTGRES_SUPERUSER_PASSWORD=AdminPassword_123
IDENTITY_DB_PASSWORD=IdentityPassword_123
CONTRACT_DB_PASSWORD=ContractPassword_123
MONEY_DB_PASSWORD=MoneyPassword_123
PEOPLE_DB_PASSWORD=PeoplePassword_123
PARTY_DB_PASSWORD=PartyPassword_1234
PROJECT_DB_PASSWORD=ProjectPassword_123
EVIDENCE_DB_PASSWORD=EvidencePassword_123
BUSINESS_ENGAGEMENT_DB_PASSWORD=BusinessEngagementPassword_123
BILLING_DB_PASSWORD=BillingInvoicePassword_123
PRODUCTION_DB_PASSWORD=ProductionPassword_123
APPROVAL_AUDIT_RESULTS_DB_PASSWORD=ApprovalAuditResultsPassword_123
COST_OUTSOURCING_DB_PASSWORD=CostOutsourcingPassword_123
BONUS_DISTRIBUTION_DB_PASSWORD=BonusDistributionPassword_123
BOOTSTRAP_ADMIN_PASSWORD=BootstrapPassword_123
ENABLE_CONTRACT=true
ENABLE_MONEY=true
ENABLE_PEOPLE=true
ENABLE_PARTY=true
ENABLE_PROJECT=true
ENABLE_EVIDENCE=true
ENABLE_BUSINESS_ENGAGEMENT=false
ENABLE_BILLING=false
ENABLE_PRODUCTION=false
ENABLE_APPROVAL_AUDIT_RESULTS=false
ENABLE_COST_OUTSOURCING=false
ENABLE_BONUS_DISTRIBUTION=false
PROJECT_PARTY_BASE_URL=http://party-directory:8090
PARTY_CURSOR_HMAC_KEY=PartyCursorHMACKey_1234567890123456
EVIDENCE_LOCAL_SIGNING_KEY=YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE
ENV
}

http_env="$test_dir/http.env"
write_common_env "$http_env"
cat >>"$http_env" <<'ENV'
D1_INGRESS_MODE=http
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=18000
COOKIE_SECURE=false
PUBLIC_ISSUER=https://oms.example.test/auth
EVIDENCE_PUBLIC_BASE_URL=http://127.0.0.1:18000/evidence
ENV

https_env="$test_dir/https.env"
write_common_env "$https_env"
cat >>"$https_env" <<ENV
D1_INGRESS_MODE=https
PUBLIC_BIND=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
D1_PUBLIC_HOST=app.example.test
D1_TLS_CERT_FILE=$certificate
D1_TLS_KEY_FILE=$private_key
COOKIE_SECURE=true
PUBLIC_ISSUER=https://app.example.test/auth
EVIDENCE_PUBLIC_BASE_URL=https://app.example.test/evidence
ENV

D1_ENV_FILE="$http_env" D1_PROJECT_NAME=omsbizfoundry-ingress-http \
  "$d1" config --format json >"$test_dir/http.json"
jq -e '
  [.services | to_entries[] | select((.value.ports // []) | length > 0) | .key] == ["nginx"] and
  ([.services.nginx.ports[] | {host_ip,published,target}] ==
    [{"host_ip":"127.0.0.1","published":"18000","target":8080}]) and
  ([.services.nginx.volumes[] | select(.target | startswith("/etc/nginx/tls/"))] | length == 0)
' "$test_dir/http.json" >/dev/null

D1_ENV_FILE="$https_env" D1_PROJECT_NAME=omsbizfoundry-ingress-https \
  "$d1" config --format json >"$test_dir/https.json"
jq -e --arg certificate "$certificate" --arg private_key "$private_key" '
  [.services | to_entries[] | select((.value.ports // []) | length > 0) | .key] == ["nginx"] and
  ([.services.nginx.ports[] | {host_ip,published,target}] | sort_by(.target) ==
    [{"host_ip":"0.0.0.0","published":"80","target":8080},{"host_ip":"0.0.0.0","published":"443","target":8443}]) and
  (any(.services.nginx.volumes[]; .source == $certificate and .target == "/etc/nginx/tls/fullchain.pem" and .read_only == true)) and
  (any(.services.nginx.volumes[]; .source == $private_key and .target == "/etc/nginx/tls/privkey.pem" and .read_only == true))
' "$test_dir/https.json" >/dev/null

ENABLE_EVIDENCE=true D1_INGRESS_MODE=http \
  "$script_dir/render-nginx-config" "$test_dir/nginx-http.conf"
grep -q 'listen 8080;' "$test_dir/nginx-http.conf"
! grep -q 'listen 8443 ssl;' "$test_dir/nginx-http.conf"
grep -q 'proxy_set_header X-Forwarded-For \$remote_addr;' "$test_dir/nginx-http.conf"
! grep -q '\$proxy_add_x_forwarded_for' "$test_dir/nginx-http.conf"

ENABLE_EVIDENCE=true D1_INGRESS_MODE=https D1_PUBLIC_HOST=app.example.test \
  "$script_dir/render-nginx-config" "$test_dir/nginx-https.conf"
grep -q 'listen 8080;' "$test_dir/nginx-https.conf"
grep -q 'listen 8443 ssl;' "$test_dir/nginx-https.conf"
grep -q 'server_name app.example.test;' "$test_dir/nginx-https.conf"
grep -q 'return 308 https://app.example.test$request_uri;' "$test_dir/nginx-https.conf"
! grep -q '__D1_PUBLIC_HOST__' "$test_dir/nginx-https.conf"
! grep -q 'https://$host' "$test_dir/nginx-https.conf"
grep -q 'proxy_set_header X-Forwarded-For \$remote_addr;' "$test_dir/nginx-https.conf"
! grep -q '\$proxy_add_x_forwarded_for' "$test_dir/nginx-https.conf"

invalid_env="$test_dir/invalid-key.env"
cp "$https_env" "$invalid_env"
printf 'D1_TLS_KEY_FILE=%s\n' "$other_key" >>"$invalid_env"
if D1_ENV_FILE="$invalid_env" "$d1" config --format json >"$test_dir/invalid.out" 2>"$test_dir/invalid.err"; then
  echo 'mismatched TLS private key was accepted' >&2
  exit 1
fi
grep -q 'certificate and private key do not match' "$test_dir/invalid.err" || {
  echo 'TLS mismatch rejection did not explain the failure' >&2
  exit 1
}

if docker info >/dev/null 2>&1 && docker image inspect nginx:1.28-alpine >/dev/null 2>&1; then
  docker run --rm --add-host gateway:127.0.0.1 \
    -v "$test_dir/nginx-http.conf:/etc/nginx/nginx.conf:ro" \
    nginx:1.28-alpine nginx -t >/dev/null
  docker run --rm --add-host gateway:127.0.0.1 \
    -v "$test_dir/nginx-https.conf:/etc/nginx/nginx.conf:ro" \
    -v "$certificate:/etc/nginx/tls/fullchain.pem:ro" \
    -v "$private_key:/etc/nginx/tls/privkey.pem:ro" \
    nginx:1.28-alpine nginx -t >/dev/null
else
  echo 'SKIP nginx -t: Docker daemon or nginx:1.28-alpine image unavailable' >&2
fi

echo 'PASS D1 ingress mode test'
