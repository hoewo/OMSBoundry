SUITE_VERSION=dev
# build: build application images from this checkout (local development default)
# pull: pull every enabled service from immutable digest-pinned references below
D1_IMAGE_MODE=build
# http: loopback development through PUBLIC_PORT (default)
# https: production-style 80 redirect + 443 TLS through compose.https.yaml
D1_INGRESS_MODE=http
# Explicit customer selection only; empty keeps manual OA allocation HTTP absent.
# Matching Bonus schema/image, capability manifest, Gateway/Workbench readers,
# and Suite schema/renderer are one release; selection never grants access.
REFERENCE_OA_BONUS_PROFILE=
REFERENCE_OA_PRODUCTION_PERSONNEL_PROFILE=
# Shared original OA scheme collection, explicit opt-in only. Requires
# Production/Project/People/Evidence matching images and native IAM grants.
REFERENCE_OA_PRODUCTION_STAGE_PROFILE=
# Explicit stable Party Directory identity of the company operating OMS.
# Empty keeps direction-sensitive invoice commands closed. The old
# OMS_QUALIFICATION_PARTY_ID name remains a compatibility alias only.
OMS_OPERATING_PARTY_ID=
# Optional Feedback SDK V2 adapter. The project-specific API Key and the
# independent HMAC key are deployment secrets and must never be committed.
# Direct apiKey mode is the explicitly accepted first-release boundary; the
# browser can inspect the key, so use a dedicated, rate-limited, revocable key.
FEEDBACK_SDK_URL=
FEEDBACK_AUTH_MODE=
FEEDBACK_GATEWAY_URL=
FEEDBACK_PROJECT_ID=
FEEDBACK_API_KEY=
# During rotation only, set current key first and previous key second.
FEEDBACK_API_KEYS=
FEEDBACK_IDENTITY_HMAC_KEY=
FEEDBACK_IDENTITY_VERSION=v1
FEEDBACK_NOTIFICATIONS_ENABLED=false
# v3 Bonus requires the explicit personnel-v1 profile and Project/People/Bonus
# applications. Project enrollment and exact IAM grants remain separate commands.
# Optional Evidence cloud profile v1. Never switch historical Local references
# to single OSS; use the compatible hybrid image and explicit new-upload Primary.
D1_EVIDENCE_STORAGE_PROVIDER=local
# EVIDENCE_PRIMARY_STORAGE_PROVIDER=aliyun-oss
# EVIDENCE_OSS_REGION=cn-hangzhou
# EVIDENCE_OSS_BUCKET=customer-private-files
# EVIDENCE_OSS_UPLOAD_ROLE_ARN=acs:ram::<account-id>:role/<upload-role>
# EVIDENCE_OSS_BROWSER_ENDPOINT=https://files.example.com
# EVIDENCE_OSS_BROWSER_CNAME=true
# EVIDENCE_OSS_SERVICE_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
# EVIDENCE_OSS_STS_ENDPOINT=sts.cn-hangzhou.aliyuncs.com
# EVIDENCE_ECS_ROLE_NAME=CustomerEvidenceServiceRole
# EVIDENCE_EGRESS_NETWORK=customer-evidence-egress
# Required only when D1_IMAGE_MODE=pull. Do not use mutable tag-only references.
# D1_POSTGRES_IMAGE=registry.example/omsbizfoundry/base-postgres@sha256:<64-lowercase-hex>
# D1_IDENTITY_IMAGE=registry.example/omsbizfoundry/identity-access@sha256:<64-lowercase-hex>
# D1_CONTRACT_IMAGE=registry.example/omsbizfoundry/contract-ledger@sha256:<64-lowercase-hex>
# D1_MONEY_IMAGE=registry.example/omsbizfoundry/money-flow-ledger@sha256:<64-lowercase-hex>
# D1_PEOPLE_IMAGE=registry.example/omsbizfoundry/people-groups@sha256:<64-lowercase-hex>
# D1_PARTY_IMAGE=registry.example/omsbizfoundry/party-directory@sha256:<64-lowercase-hex>
# D1_PROJECT_IMAGE=registry.example/omsbizfoundry/project-workspace@sha256:<64-lowercase-hex>
# D1_EVIDENCE_IMAGE=registry.example/omsbizfoundry/evidence-service@sha256:<64-lowercase-hex>
# D1_BUSINESS_ENGAGEMENT_IMAGE=registry.example/omsbizfoundry/business-engagement@sha256:<64-lowercase-hex>
# D1_BILLING_IMAGE=registry.example/omsbizfoundry/billing-invoice@sha256:<64-lowercase-hex>
# D1_PRODUCTION_IMAGE=registry.example/omsbizfoundry/production-operations@sha256:<64-lowercase-hex>
# D1_APPROVAL_AUDIT_RESULTS_IMAGE=registry.example/omsbizfoundry/approval-audit-results@sha256:<64-lowercase-hex>
# D1_COST_OUTSOURCING_IMAGE=registry.example/omsbizfoundry/cost-outsourcing@sha256:<64-lowercase-hex>
# D1_BONUS_DISTRIBUTION_IMAGE=registry.example/omsbizfoundry/bonus-distribution@sha256:<64-lowercase-hex>
# D1_INTERNAL_FINANCE_REQUESTS_IMAGE=registry.example/omsbizfoundry/internal-finance-requests@sha256:<64-lowercase-hex>
# D1_PAYROLL_IMAGE=registry.example/omsbizfoundry/payroll@sha256:<64-lowercase-hex>
# D1_WORKBENCH_IMAGE=registry.example/omsbizfoundry/unified-workbench@sha256:<64-lowercase-hex>
# D1_GATEWAY_IMAGE=registry.example/omsbizfoundry/gateway@sha256:<64-lowercase-hex>
# D1_NGINX_IMAGE=registry.example/omsbizfoundry/base-nginx@sha256:<64-lowercase-hex>
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=18000
# Required only when D1_INGRESS_MODE=https. Keep key material outside this
# repository and configure only absolute host paths here.
# PUBLIC_HTTP_PORT=80
# PUBLIC_HTTPS_PORT=443
# D1_PUBLIC_HOST=app.example.com
# D1_TLS_CERT_FILE=/opt/omsbizfoundry/secrets/tls/app.example.com.pem
# D1_TLS_KEY_FILE=/opt/omsbizfoundry/secrets/tls/app.example.com.key
COOKIE_SECURE=false
PUBLIC_ISSUER=https://oms.example.test/auth
TENANT_ID=22222222-2222-4222-8222-222222222222
TENANT_NAME=OMSBizFoundry 演示公司
POLICY_SERVICE_SUBJECT_ID=33333333-3333-4333-8333-333333333333
POLICY_TIMEOUT=3s
PROJECT_WORKLOAD_SUBJECT_ID=44444444-4444-4444-8444-444444444444
BUSINESS_ENGAGEMENT_WORKLOAD_SUBJECT_ID=55555555-5555-4555-8555-555555555555
CONTRACT_WORKLOAD_SUBJECT_ID=66666666-6666-4666-8666-666666666666
MONEY_WORKLOAD_SUBJECT_ID=77777777-7777-4777-8777-777777777778
BILLING_WORKLOAD_SUBJECT_ID=88888888-8888-4888-8888-888888888888
PRODUCTION_WORKLOAD_SUBJECT_ID=99999999-9999-4999-8999-999999999999
APPROVAL_AUDIT_RESULTS_WORKLOAD_SUBJECT_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
COST_OUTSOURCING_WORKLOAD_SUBJECT_ID=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
BONUS_DISTRIBUTION_WORKLOAD_SUBJECT_ID=cccccccc-cccc-4ccc-8ccc-cccccccccccc
PEOPLE_WORKLOAD_SUBJECT_ID=dddddddd-dddd-4ddd-8ddd-dddddddddddd
PAYROLL_WORKLOAD_SUBJECT_ID=eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee
INTERNAL_FINANCE_REQUESTS_WORKLOAD_SUBJECT_ID=ffffffff-ffff-4fff-bfff-ffffffffffff
WORKLOAD_CREDENTIAL_TTL=1m
WORKLOAD_REFRESH_BEFORE=15s
PROJECT_PEOPLE_BASE_URL=http://people-groups:8084
PAYROLL_PEOPLE_BASE_URL=http://people-groups:8084
PROJECT_PARTY_BASE_URL=http://party-directory:8090
# Set when canonical Production material references are selected. An omitted
# endpoint does not make Production a Project startup dependency.
PROJECT_PRODUCTION_BASE_URL=
PROJECT_COST_BASE_URL=

POSTGRES_SUPERUSER=oms_admin
# 数据库密码需各不相同、至少 16 字符，并只使用 A-Z a-z 0-9 _ . ~ -，以便安全进入 PostgreSQL URL。
POSTGRES_SUPERUSER_PASSWORD=replace-with-random-database-admin-password
IDENTITY_DB_PASSWORD=replace-with-random-identity-password
CONTRACT_DB_PASSWORD=replace-with-random-contract-password
MONEY_DB_PASSWORD=replace-with-random-money-password
PEOPLE_DB_PASSWORD=replace-with-random-people-password
PARTY_DB_PASSWORD=replace-with-random-party-password
PROJECT_DB_PASSWORD=replace-with-random-project-password
EVIDENCE_DB_PASSWORD=replace-with-random-evidence-password
BUSINESS_ENGAGEMENT_DB_PASSWORD=replace-with-random-business-engagement-password
BILLING_DB_PASSWORD=replace-with-random-billing-password
PRODUCTION_DB_PASSWORD=replace-with-random-production-password
APPROVAL_AUDIT_RESULTS_DB_PASSWORD=replace-with-random-approval-audit-results-password
COST_OUTSOURCING_DB_PASSWORD=replace-with-random-cost-outsourcing-password
BONUS_DISTRIBUTION_DB_PASSWORD=replace-with-random-bonus-distribution-password
INTERNAL_FINANCE_REQUESTS_DB_PASSWORD=replace-with-random-internal-finance-password
PAYROLL_DB_PASSWORD=replace-with-random-payroll-password

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-bytes

ENABLE_CONTRACT=true
ENABLE_MONEY=true
ENABLE_PEOPLE=true
ENABLE_PARTY=true
ENABLE_PROJECT=true
ENABLE_EVIDENCE=true
ENABLE_BUSINESS_ENGAGEMENT=false
ENABLE_BILLING=false
ENABLE_PRODUCTION=false
ENABLE_APPROVAL_AUDIT_RESULTS=false
ENABLE_COST_OUTSOURCING=false
ENABLE_BONUS_DISTRIBUTION=false
ENABLE_INTERNAL_FINANCE_REQUESTS=false
ENABLE_PAYROLL=false
BILLING_ALLOWED_CURRENCIES=CNY
# At least 32 random bytes. It signs opaque Party list cursors, not user credentials.
PARTY_CURSOR_HMAC_KEY=replace-with-random-party-cursor-hmac-key
# Must be the browser-reachable suite URL plus /evidence. HTTP is allowed only for loopback development.
EVIDENCE_PUBLIC_BASE_URL=http://127.0.0.1:18000/evidence
# At least 32 random bytes encoded as unpadded base64url.
EVIDENCE_LOCAL_SIGNING_KEY=replace-with-unpadded-base64url
EVIDENCE_MAX_UPLOAD_BYTES=2147483648
# D1's private Gateway trusts the single client IP that its Nginx edge
# overwrites into X-Forwarded-For. Do not expose Gateway directly.
REQUESTS_PER_MINUTE=120
# Employee API Key limits are separate from the browser/session limit. Disable
# TLS enforcement only in an explicit loopback-only acceptance environment.
OPEN_API_KEY_REQUESTS_PER_MINUTE=60
OPEN_API_TENANT_REQUESTS_PER_MINUTE=600
OPEN_API_REQUIRE_HTTPS=true
D1_BACKUP_DIR=./.runtime/backups
