{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsbizfoundry.local/contracts/read-projections/v1/metric-projection.schema.json",
  "title": "Metric Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_application",
    "tenant_id",
    "definition_version",
    "observed_at",
    "items"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "source_application": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "tenant_id": { "$ref": "#/$defs/uuid" },
    "definition_version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}-v[1-9][0-9]*$"
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tenant_id", "resource_type", "resource_id"],
      "properties": {
        "kind": { "const": "ledger_owner" },
        "tenant_id": { "$ref": "#/$defs/uuid" },
        "resource_type": { "const": "party" },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_key",
        "scope",
        "unit",
        "currency",
        "value",
        "redacted",
        "source_digest",
        "time_range",
        "observed_at",
        "deep_link"
      ],
      "properties": {
        "metric_key": {
          "enum": [
            "receivable_outstanding",
            "payable_outstanding",
            "receipt_effective",
            "payment_effective",
            "receipt_unallocated",
            "payment_unallocated"
          ]
        },
        "scope": { "$ref": "#/$defs/scope" },
        "unit": { "const": "money" },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "value": {
          "type": ["string", "null"],
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "redacted": { "type": "boolean" },
        "source_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "time_range": { "const": "current" },
        "observed_at": { "type": "string", "format": "date-time" },
        "deep_link": {
          "type": "string",
          "pattern": "^/[^/].*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "redacted": { "const": true } },
            "required": ["redacted"]
          },
          "then": {
            "properties": {
              "value": { "type": "null" },
              "source_digest": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              },
              "source_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
