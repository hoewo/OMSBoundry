{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsbizfoundry.local/contracts/access/v1/capability-credential-claims.schema.json",
  "title": "OMSBizFoundry Capability Credential JWT Claims v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ver",
    "iss",
    "sub",
    "tid",
    "aud",
    "name",
    "actions",
    "scope",
    "iat",
    "nbf",
    "exp",
    "auth_time",
    "jti"
  ],
  "properties": {
    "ver": { "const": "1" },
    "iss": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 256 },
    "sub": { "type": "string", "format": "uuid" },
    "tid": { "type": "string", "format": "uuid" },
    "aud": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" }
    },
    "scope": { "$ref": "iam-context.schema.json#/$defs/scope" },
    "iat": { "type": "integer", "minimum": 0 },
    "nbf": { "type": "integer", "minimum": 0 },
    "exp": { "type": "integer", "minimum": 0 },
    "auth_time": { "type": "integer", "minimum": 0 },
    "jti": { "type": "string", "format": "uuid" }
  }
}
