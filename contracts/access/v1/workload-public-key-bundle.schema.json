{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsbizfoundry.local/contracts/access/v1/workload-public-key-bundle.schema.json",
  "title": "OMSBizFoundry Workload Public Key Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workload_id", "subject_id", "keys"],
  "properties": {
    "version": { "const": "1" },
    "workload_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "subject_id": { "type": "string", "format": "uuid" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kty", "crv", "use", "alg", "kid", "x", "status", "created_at"],
        "properties": {
          "kty": { "const": "OKP" },
          "crv": { "const": "Ed25519" },
          "use": { "const": "sig" },
          "alg": { "const": "EdDSA" },
          "kid": { "type": "string", "format": "uuid" },
          "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "status": { "enum": ["active", "retiring"] },
          "created_at": { "type": "string", "format": "date-time" },
          "retire_after": { "type": "string", "format": "date-time" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "retiring" } } },
            "then": { "required": ["retire_after"] }
          }
        ]
      }
    }
  }
}
