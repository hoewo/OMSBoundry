{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsbizfoundry.local/contracts/access/v1/workload-identity-policy.schema.json",
  "title": "OMSBizFoundry Workload Identity Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identities"],
  "properties": {
    "schema_version": { "const": "1" },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject_id", "display_name", "public_keys_path", "permissions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "subject_id": { "type": "string", "format": "uuid" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "public_keys_path": { "type": "string", "minLength": 1 },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["audience", "action", "resource_types"],
              "properties": {
                "audience": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
                "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
                "resource_types": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
                }
              }
            }
          }
        }
      }
    }
  }
}
