{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsbizfoundry.local/contracts/access/v1/service-credential-request.schema.json",
  "title": "OMSBizFoundry Service Credential Exchange Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertion", "audience", "action", "scope"],
  "properties": {
    "assertion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "audience": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "scope": {
      "allOf": [
        { "$ref": "iam-context.schema.json#/$defs/scope" },
        {
          "properties": { "kind": { "const": "resources" } },
          "required": ["kind", "resources"]
        }
      ]
    }
  }
}
