{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsbizfoundry.local/contracts/access/v1/iam-context.schema.json",
  "title": "OMSBizFoundry IAM Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issuer",
    "tenant_id",
    "subject_id",
    "display_name",
    "audience",
    "credential_id",
    "issued_at",
    "expires_at",
    "actions",
    "scope"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "issuer": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 256 },
    "tenant_id": { "type": "string", "format": "uuid" },
    "subject_id": { "type": "string", "format": "uuid" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "audience": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "credential_id": { "type": "string", "format": "uuid" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" }
    },
    "scope": { "$ref": "#/$defs/scope" }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resources"],
      "properties": {
        "kind": { "enum": ["tenant", "resources"] },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
              "id": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        }
      }
    }
  }
}
