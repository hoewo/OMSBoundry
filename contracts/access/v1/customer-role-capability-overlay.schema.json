{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsbizfoundry.local/contracts/access/v1/customer-role-capability-overlay.schema.json",
  "title": "OMSBizFoundry Customer Role Capability Overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "overlay_id", "overlay_version", "application_id", "audience", "site_roles"],
  "properties": {
    "schema_version": { "const": "1" },
    "overlay_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "overlay_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "application_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "audience": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "site_roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_name", "scope_kind", "actions"],
        "properties": {
          "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "scope_kind": { "enum": ["tenant", "resources"] },
          "actions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" }
          }
        }
      }
    },
    "assignment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }
      }
    }
  }
}
