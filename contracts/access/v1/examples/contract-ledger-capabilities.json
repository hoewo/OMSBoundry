    { "id": "contract-ledger.draft.manage", "description": "建立、编辑、取消合同草稿并维护签约主体", "risk": "write", "resource_types": ["contract"] },
    { "id": "contract-ledger.lifecycle.manage", "description": "激活、变更、终止、结算和关闭合同", "risk": "write", "resource_types": ["contract"] },
    { "id": "contract-ledger.correct", "description": "追加受控更正文书", "risk": "privileged", "resource_types": ["contract"] },
    { "id": "contract-ledger.evidence.manage", "description": "新增合同证据和证据版本", "risk": "write", "resource_types": ["contract", "evidence"] },
    { "id": "contract-ledger.export", "description": "导出可校验合同账簿", "risk": "privileged", "resource_types": ["contract"] },
    { "id": "contract-ledger.restore", "description": "恢复合同账簿", "risk": "privileged", "resource_types": ["contract"] },
    { "id": "contract-ledger.reference.read", "description": "供受信工作负载读取精确合同或结算摘要", "risk": "privileged", "resource_types": ["contract", "settlement"] }
  ]
}
