{
  "schema_version": "1",
  "application_id": "contract-ledger",
  "application_version": "0.1.0",
  "audience": "contract-ledger",
  "capabilities": [
    { "id": "contract-ledger.view", "description": "查看合同、主体、关系、结算、证据元数据和审计", "risk": "read", "resource_types": ["contract", "party"] },
