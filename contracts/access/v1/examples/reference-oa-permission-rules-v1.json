      "id": "identity_governance",
      "owner": "identity-access",
      "description": "账号、登录、会话和权限治理；身份超级管理员默认不取得 OA 业务权限。"
    },
    {
      "id": "oa_site_position",
      "owner": "customer-overlay",
      "description": "OA 站点职位模板；OA 管理员在这一层拥有全部 OA 规则权限。"
    },
    {
      "id": "project_role_and_temporary_grant",
      "owner": "project-workspace-and-policy-provider",
      "description": "项目角色和临时授权只在精确 Project／Resource 范围内生效。"
    },
    {
      "id": "native_application_authorization",
      "owner": "iam-and-target-applications",
      "description": "规则解析为各小系统的版本化原生 Capability；IAM 签发有界 Credential，目标应用按 allowed_actions、资源、状态和 revision 最终授权。"
    }
  ],
