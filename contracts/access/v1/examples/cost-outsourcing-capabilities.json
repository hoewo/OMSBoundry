    { "id": "outsourcing-engagement.amount.read", "description": "读取或提交外委与合同冻结金额", "risk": "privileged", "resource_types": ["project", "outsourcing_engagement"] },
    { "id": "outsourcing-engagement.correct", "description": "基于 expected revision 追加外委事项纠正", "risk": "write", "resource_types": ["project", "outsourcing_engagement"] },
