#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
d1_dir="$repo_dir/deployments/d1"
env_file=${D1_ENV_FILE:-"$d1_dir/.env"}

[ -f "$env_file" ] || { echo "D1 environment file not found: $env_file" >&2; exit 2; }
for command in curl jq openssl; do
  command -v "$command" >/dev/null 2>&1 || { echo "$command is required" >&2; exit 2; }
done

env_value() {
  key="$1"
  fallback="${2:-}"
  value=$(awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' "$env_file")
  if [ -n "$value" ]; then printf '%s' "$value"; else printf '%s' "$fallback"; fi
}

ingress_mode=$(env_value D1_INGRESS_MODE http)
if [ -n "${D1_PUBLIC_URL:-}" ]; then
  base_url=$D1_PUBLIC_URL
elif [ "$ingress_mode" = https ]; then
  public_host=$(env_value D1_PUBLIC_HOST)
  public_https_port=$(env_value PUBLIC_HTTPS_PORT 443)
  if [ "$public_https_port" = 443 ]; then base_url="https://$public_host"; else base_url="https://$public_host:$public_https_port"; fi
else
  base_url="http://$(env_value PUBLIC_BIND 127.0.0.1):$(env_value PUBLIC_PORT 18000)"
fi
admin_username=$(env_value BOOTSTRAP_ADMIN_USERNAME admin)
admin_password=$(env_value BOOTSTRAP_ADMIN_PASSWORD)
[ -n "$admin_password" ] || { echo "BOOTSTRAP_ADMIN_PASSWORD is required in $env_file" >&2; exit 2; }
[ "$(env_value ENABLE_PROJECT true)" = true ] || { echo "Project Workspace must be enabled" >&2; exit 2; }

expect_status() {
  expected="$1"
  actual="$2"
  label="$3"
  [ "$actual" = "$expected" ] || { echo "$label: HTTP $actual, expected $expected" >&2; exit 1; }
}

new_uuid() {
  value=$(openssl rand -hex 16)
  printf '%s-%s-4%s-8%s-%s' \
    "$(printf '%s' "$value" | cut -c1-8)" \
    "$(printf '%s' "$value" | cut -c9-12)" \
    "$(printf '%s' "$value" | cut -c14-16)" \
    "$(printf '%s' "$value" | cut -c18-20)" \
    "$(printf '%s' "$value" | cut -c21-32)"
}

cookie_value() {
  cookie_file="$1"
  cookie_name="$2"
  awk -F '\t' -v name="$cookie_name" '$6 == name {value=$7} END {print value}' "$cookie_file"
}

decode_jwt_payload() {
  token="$1"
  part=$(printf '%s' "$token" | cut -d. -f2)
  case $((${#part} % 4)) in
    0) padding='' ;;
    2) padding='==' ;;
    3) padding='=' ;;
    *) echo "invalid JWT payload encoding" >&2; return 1 ;;
  esac
  printf '%s%s' "$part" "$padding" | tr '_-' '/+' | openssl base64 -d -A
}

fetch_csrf() {
  cookie_file="$1"
  curl --fail --silent --show-error --cookie-jar "$cookie_file" "$base_url/auth/api/v1/csrf" | jq -er .csrf_token
}

login() {
  cookie_file="$1"
  csrf_token="$2"
  username="$3"
  password="$4"
  output_file="$5"
  payload=$(jq -cn --arg username "$username" --arg password "$password" '{username:$username,password:$password}')
  expect_status 200 "$(curl --silent --show-error --output "$output_file" --write-out '%{http_code}' \
    --cookie "$cookie_file" --cookie-jar "$cookie_file" -H 'Content-Type: application/json' \
    -H "X-CSRF-Token: $csrf_token" --data "$payload" "$base_url/auth/api/v1/login")" "login $username"
}

admin_json() {
  path="$1"
  payload="$2"
  output_file="$3"
  expected="$4"
  expect_status "$expected" "$(curl --silent --show-error --output "$output_file" --write-out '%{http_code}' \
    --cookie "$admin_cookies" --cookie-jar "$admin_cookies" -H 'Content-Type: application/json' \
    -H "X-CSRF-Token: $admin_csrf" --data "$payload" "$base_url/auth$path")" "$path"
}

authorize_project() {
  cookie_file="$1"
  csrf_token="$2"
  resource_id="$3"
  expected="$4"
  label="$5"
  if [ -n "$resource_id" ]; then
    actual=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
      --cookie "$cookie_file" --cookie-jar "$cookie_file" \
      --data-urlencode "csrf_token=$csrf_token" --data-urlencode resource_type=project \
      --data-urlencode "resource_id=$resource_id" "$base_url/gateway/authorize/project-workspace")
  else
    actual=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
      --cookie "$cookie_file" --cookie-jar "$cookie_file" \
      --data-urlencode "csrf_token=$csrf_token" "$base_url/gateway/authorize/project-workspace")
  fi
  expect_status "$expected" "$actual" "$label"
}

project_json() {
  method="$1"
  path="$2"
  cookie_file="$3"
  payload="$4"
  output_file="$5"
  expected="$6"
  if [ -n "$payload" ]; then
    actual=$(curl --silent --show-error --output "$output_file" --write-out '%{http_code}' \
      --request "$method" --cookie "$cookie_file" --cookie-jar "$cookie_file" \
      -H 'Content-Type: application/json' --data "$payload" "$base_url/project$path")
  else
    actual=$(curl --silent --show-error --output "$output_file" --write-out '%{http_code}' \
      --request "$method" --cookie "$cookie_file" --cookie-jar "$cookie_file" "$base_url/project$path")
  fi
  expect_status "$expected" "$actual" "$method $path"
}

workspace=$(mktemp -d "${TMPDIR:-/tmp}/oms-d1-resource-auth.XXXXXX")
trap 'rm -rf "$workspace"' EXIT HUP INT TERM

# The bootstrap administrator gets tenant-wide Project actions only through the
# same formal IAM grant API used by every other subject.
D1_ENV_FILE="$env_file" D1_PUBLIC_URL="$base_url" "$d1_dir/ops/grant-bootstrap-access" >/dev/null

admin_cookies="$workspace/admin.cookies"
admin_csrf=$(fetch_csrf "$admin_cookies")
login "$admin_cookies" "$admin_csrf" "$admin_username" "$admin_password" "$workspace/admin-login.json"
jq -e --arg username "$admin_username" '.principal.username == $username and .principal.administrator == true' \
  "$workspace/admin-login.json" >/dev/null
authorize_project "$admin_cookies" "$admin_csrf" "" 303 "authorize administrator for tenant Project scope"

stamp="$(date -u '+%m%d%H%M%S')$(openssl rand -hex 3)"
create_project() {
  number="$1"
  name="$2"
  output="$3"
  payload=$(jq -cn --arg command_id "$(new_uuid)" --arg project_number "$number" --arg name "$name" \
    '{command_id:$command_id,project_number:$project_number,name:$name,summary:"D1 resource authorization acceptance",planned_start_date:null,planned_end_date:null,project_type_keys:["validation"]}')
  project_json POST /api/v1/projects "$admin_cookies" "$payload" "$output" 201
}

create_project "D1-A-$stamp" "Project A $stamp" "$workspace/project-a.json"
create_project "D1-B-$stamp" "Project B $stamp" "$workspace/project-b.json"
project_a=$(jq -er .id "$workspace/project-a.json")
project_b=$(jq -er .id "$workspace/project-b.json")
project_b_name=$(jq -er .name "$workspace/project-b.json")

operator_username="d1project-$stamp"
operator_password="D1-project-$stamp!42"
payload=$(jq -cn --arg username "$operator_username" --arg display_name "D1 Project A operator $stamp" \
  '{username:$username,display_name:$display_name}')
admin_json /api/v1/admin/invitations "$payload" "$workspace/operator-invitation.json" 201
operator_id=$(jq -er .subject.id "$workspace/operator-invitation.json")
operator_token=$(jq -er .token "$workspace/operator-invitation.json")

operator_cookies="$workspace/operator.cookies"
operator_csrf=$(fetch_csrf "$operator_cookies")
payload=$(jq -cn --arg token "$operator_token" --arg password "$operator_password" '{token:$token,password:$password}')
expect_status 200 "$(curl --silent --show-error --output "$workspace/operator-activation.json" --write-out '%{http_code}' \
  --cookie "$operator_cookies" --cookie-jar "$operator_cookies" -H 'Content-Type: application/json' \
  -H "X-CSRF-Token: $operator_csrf" --data "$payload" "$base_url/auth/api/v1/activate")" "activate operator"
login "$operator_cookies" "$operator_csrf" "$operator_username" "$operator_password" "$workspace/operator-login.json"
jq -e '.principal.administrator == false' "$workspace/operator-login.json" >/dev/null

grant_scope=$(jq -cn --arg project_id "$project_a" '{kind:"resources",resources:[{type:"project",id:$project_id}]}')
for action in project-workspace.read project-workspace.update; do
  payload=$(jq -cn --arg subject_id "$operator_id" --arg audience project-workspace --arg action "$action" \
    --argjson scope "$grant_scope" '{subject_id:$subject_id,audience:$audience,action:$action,scope:$scope}')
  admin_json /api/v1/admin/grants "$payload" /dev/null 204
done

# A resource-only grant must not silently widen into a tenant credential or a
# different Project credential.
authorize_project "$operator_cookies" "$operator_csrf" "" 403 "deny tenant Project credential"
authorize_project "$operator_cookies" "$operator_csrf" "$project_b" 403 "deny Project B credential"
authorize_project "$operator_cookies" "$operator_csrf" "$project_a" 303 "authorize Project A resource credential"

operator_credential=$(cookie_value "$operator_cookies" oms_cap_project_workspace)
[ -n "$operator_credential" ] || { echo "Project capability cookie is missing" >&2; exit 1; }
decode_jwt_payload "$operator_credential" >"$workspace/operator-claims.json"
jq -e --arg project_id "$project_a" '
  .ver == "1" and .aud == "project-workspace" and
  .scope.kind == "resources" and .scope.resources == [{"type":"project","id":$project_id}] and
  (.actions | sort) == ["project-workspace.read","project-workspace.update"] and
  (.exp > .iat) and (.exp - .iat <= 300)
' "$workspace/operator-claims.json" >/dev/null

project_json GET /api/v1/projects "$operator_cookies" "" "$workspace/operator-list.json" 403
project_json GET "/api/v1/projects/$project_a" "$operator_cookies" "" "$workspace/operator-project-a.json" 200
project_json GET "/api/v1/projects/$project_b" "$operator_cookies" "" "$workspace/operator-project-b.json" 403

updated_name="Project A scoped update $stamp"
payload=$(jq -cn --arg command_id "$(new_uuid)" --arg name "$updated_name" \
  --slurpfile details "$workspace/operator-project-a.json" '
  ($details[0].project) as $p |
  {command_id:$command_id,expected_revision:$p.revision,project_number:$p.project_number,name:$name,
   summary:$p.summary,planned_start_date:($p.planned_start_date // null),planned_end_date:($p.planned_end_date // null),
   project_type_keys:$p.project_type_keys}')
project_json PUT "/api/v1/projects/$project_a" "$operator_cookies" "$payload" "$workspace/operator-update-a.json" 200
jq -e --arg name "$updated_name" '.name == $name and .revision == 2' "$workspace/operator-update-a.json" >/dev/null

# Reuse a syntactically valid body against Project B. Scope rejection occurs
# before the handler and therefore must leave Project B unchanged.
project_json PUT "/api/v1/projects/$project_b" "$operator_cookies" "$payload" "$workspace/operator-update-b.json" 403
project_json GET "/api/v1/projects/$project_b" "$admin_cookies" "" "$workspace/admin-project-b-after.json" 200
jq -e --arg name "$project_b_name" '.project.name == $name and .project.revision == 1' "$workspace/admin-project-b-after.json" >/dev/null

expect_status 200 "$(curl --silent --show-error --output "$workspace/project-page.html" --write-out '%{http_code}' \
  --cookie "$operator_cookies" "$base_url/project/")" "open Project Workspace page"
grep -Fq 'assets/demo.js' "$workspace/project-page.html" || { echo "Project Workspace page does not use the Gateway-safe asset path" >&2; exit 1; }
expect_status 200 "$(curl --silent --show-error --output "$workspace/project-demo.js" --write-out '%{http_code}' \
  --cookie "$operator_cookies" "$base_url/project/assets/demo.js")" "load Project Workspace browser client"
grep -Fq '由统一入口提供短期凭证' "$workspace/project-demo.js" || { echo "Project browser client does not recognize unified entry" >&2; exit 1; }

printf '%s\n' \
  "D1 resource authorization acceptance passed:" \
  "- Nginx was the only public hop and Gateway exchanged the IAM Suite Session for a Project-scoped credential" \
  "- the credential contained only read/update, one audience, and exactly Project A" \
  "- tenant listing, Project B credential issuance, read and update were rejected" \
  "- Project A read/update succeeded and the denied Project B write left revision 1 unchanged" \
  "- the Project browser client loaded correctly below the /project Gateway prefix" \
  "Known boundary: this proves direct Resource Grant enforcement; Business Fact Snapshot/Policy issuance and per-grant revocation remain unimplemented."
