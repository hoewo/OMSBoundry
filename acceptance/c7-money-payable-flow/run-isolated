evidence_dir=${C7_MONEY_EVIDENCE_DIR:-"$repo_dir/deployments/d1/.runtime/c7-money-payable-evidence"}
service_pids=''

cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  for pid in $service_pids; do kill "$pid" >/dev/null 2>&1 || true; done
  for pid in $service_pids; do wait "$pid" >/dev/null 2>&1 || true; done
  docker rm -f "$container" >/dev/null 2>&1 || true
  mkdir -p "$evidence_dir"
  for artifact in http-evidence.tsv processes.tsv initial-unavailable.json accepted-suggestion.json accepted-intake.json accepted-decision.json accepted-synchronized.json accepted-history.json rejected-suggestion.json rejected-intake.json rejected-decision.json rejected-synchronized.json money-facts.tsv source-withdrawal.tsv mapping-1.json mapping-2.json result.md bonus.log money.log; do
    [ ! -f "$runtime/$artifact" ] || cp "$runtime/$artifact" "$evidence_dir/$artifact"
  done
  rm -rf "$runtime"
  exit "$status"
}
