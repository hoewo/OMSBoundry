    "$base_url/billing/api/v1/invoice-registrations/$billing_id/evidence")" "attach Billing Evidence"
  jq -e --arg file_id "$file_id" '.revision == 3 and (.evidence_refs | any(.file_id == $file_id and .version == 1))' "$workspace/billing-evidence.json" >/dev/null

  payload=$(jq -cn --arg command_id "$(new_uuid)" '{command_id:$command_id,expected_revision:3,reason:"D1 重复登记"}')
  expect_status 200 "$(curl --silent --show-error --output "$workspace/billing-invalidated.json" --write-out '%{http_code}' \
    --cookie "$cookies" -H 'Content-Type: application/json' --data "$payload" \
    "$base_url/billing/api/v1/invoice-registrations/$billing_id/invalidation")" "invalidate Billing registration"
  jq -e '.revision == 4 and .status == "registration_invalidated"' "$workspace/billing-invalidated.json" >/dev/null

  expect_status 200 "$(curl --silent --show-error --output "$workspace/billing-history.json" --write-out '%{http_code}' \
    --cookie "$cookies" "$base_url/billing/api/v1/invoice-registrations/$billing_id/history")" "read Billing history"
  jq -e '[.items[].revision] == [4,3,2,1]' "$workspace/billing-history.json" >/dev/null || { echo "Billing revision history is incomplete" >&2; exit 1; }
  expect_status 200 "$(curl --silent --show-error --output "$workspace/billing-list.json" --write-out '%{http_code}' \
    --cookie "$cookies" "$base_url/billing/api/v1/invoice-registrations?project_id=$project_id")" "list Billing invoices"
  jq -e --arg id "$billing_id" '.effective_amount_minor == 0 and (.items | any(.id == $id and .status == "registration_invalidated"))' "$workspace/billing-list.json" >/dev/null || {
    echo "Billing effective total did not exclude the invalidated registration" >&2
    exit 1
  }

  # Revocation is reflected only after a fresh Gateway -> IAM credential. The
  # target then redacts current/history amounts and rejects blind amount writes.
  payload=$(jq -cn --arg subject_id "$admin_subject_id" --arg audience billing-invoice --arg action billing-invoice.amount.read \
    '{subject_id:$subject_id,audience:$audience,action:$action}')
  expect_status 204 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" -H 'Content-Type: application/json' -H "X-CSRF-Token: $csrf" --data "$payload" \
    "$base_url/auth/api/v1/admin/grants/revoke")" "revoke Billing amount visibility"
  expect_status 303 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" --cookie-jar "$cookies" --data-urlencode "csrf_token=$csrf" \
    "$base_url/gateway/authorize/billing-invoice")" "refresh Billing after amount revoke"
  expect_status 200 "$(curl --silent --show-error --output "$workspace/billing-redacted.json" --write-out '%{http_code}' \
