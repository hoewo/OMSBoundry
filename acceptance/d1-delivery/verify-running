    --cookie "$cookies" "$base_url/billing/api/v1/invoice-registrations/$billing_id/history")" "read redacted Billing history"
  jq -e '(.items | length) == 4 and all(.items[]; .snapshot.amount_visible == false and .snapshot.amount_minor == null and .snapshot.currency == null)' "$workspace/billing-redacted-history.json" >/dev/null || { echo "Billing history leaked amount after revocation" >&2; exit 1; }
  payload=$(jq -cn --arg command_id "$(new_uuid)" '{command_id:$command_id,expected_revision:4,reason:"blind amount write",patch:{amount_minor:99999}}')
  expect_status 403 "$(curl --silent --show-error --output "$workspace/billing-blind-amount.json" --write-out '%{http_code}' \
    --cookie "$cookies" -H 'Content-Type: application/json' --data "$payload" \
    "$base_url/billing/api/v1/invoice-registrations/$billing_id/corrections")" "reject blind Billing amount correction"
  payload=$(jq -cn --arg subject_id "$admin_subject_id" --arg audience billing-invoice --arg action billing-invoice.amount.read \
    '{subject_id:$subject_id,audience:$audience,action:$action}')
  expect_status 204 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" -H 'Content-Type: application/json' -H "X-CSRF-Token: $csrf" --data "$payload" \
    "$base_url/auth/api/v1/admin/grants")" "restore Billing amount visibility"
  expect_status 303 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" --cookie-jar "$cookies" --data-urlencode "csrf_token=$csrf" \
    "$base_url/gateway/authorize/billing-invoice")" "refresh Billing after amount restore"
  expect_status 200 "$(curl --silent --show-error --output "$workspace/billing-restored-amount.json" --write-out '%{http_code}' \
    --cookie "$cookies" "$base_url/billing/api/v1/invoice-registrations/$billing_id")" "read restored Billing amount"
  jq -e '.amount_visible == true and .amount_minor == 12345 and (.allowed_actions | index("amount_read")) != null' "$workspace/billing-restored-amount.json" >/dev/null || { echo "Billing amount permission did not recover" >&2; exit 1; }

  for expectation in \
    "party-directory|party-directory.reference.read|party|$party_id" \
    "party-directory|party-directory.reference.read|party|$billing_recipient_id" \
    "project-workspace|project-workspace.read|project|$project_id" \
    "evidence-service|evidence-service.view|file|$file_id"; do
    IFS='|' read -r audience action resource_type resource_id <<EOF
$expectation
EOF
    workload_audits=$(compose exec -T postgres sh -eu -c "psql -U \"\$POSTGRES_USER\" -d identity_access -At -c \"SELECT count(*) FROM iam_audit_entries WHERE action='iam_service_credential_issued' AND details->>'workload_id'='billing-invoice' AND details->>'audience'='$audience' AND details->'actions' @> '[\\\"$action\\\"]'::jsonb AND details->'scope'->'resources' @> '[{\\\"type\\\":\\\"$resource_type\\\",\\\"id\\\":\\\"$resource_id\\\"}]'::jsonb\"")
    [ "$workload_audits" -ge 1 ] || { echo "Billing exact workload credential audit is missing: $expectation" >&2; exit 1; }
  done

  expect_status 303 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" --cookie-jar "$cookies" --data-urlencode "csrf_token=$csrf" \
    --data-urlencode resource_type=project --data-urlencode "resource_id=$project_id" \
    "$base_url/gateway/authorize/billing-invoice")" "authorize project-scoped Billing"
  expect_status 403 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" "$base_url/billing/api/v1/invoice-registrations")" "reject unfiltered project-scoped Billing list"
  expect_status 200 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" "$base_url/billing/api/v1/invoice-registrations?project_id=$project_id")" "allow scoped Billing list"
  expect_status 403 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" "$base_url/billing/api/v1/invoice-registrations?project_id=$(new_uuid)")" "reject adjacent Billing project"
