if [ "$enable_evidence" = true ]; then
  expect_status 303 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" --cookie-jar "$cookies" --data-urlencode "csrf_token=$csrf" \
    "$base_url/gateway/authorize/evidence-service")" "authorize Evidence Service"

  printf '%%PDF-1.7\nD1 Evidence %s\n' "$stamp" >"$workspace/evidence.pdf"
  evidence_size=$(wc -c <"$workspace/evidence.pdf" | tr -d ' ')
  evidence_sha=$(openssl dgst -sha256 -r "$workspace/evidence.pdf" | awk '{print $1}')
  payload=$(jq -cn --arg file_name "d1-evidence-$stamp.pdf" --arg media_type application/pdf \
    --arg sha256 "$evidence_sha" --argjson size_bytes "$evidence_size" \
    '{file_name:$file_name,size_bytes:$size_bytes,media_type:$media_type,sha256:$sha256,client_context:{purpose:"d1-delivery-acceptance"}}')
  expect_status 201 "$(curl --silent --show-error --output "$workspace/upload-session.json" --write-out '%{http_code}' \
    --cookie "$cookies" -H 'Content-Type: application/json' -H "Idempotency-Key: $(new_uuid)" \
    --data "$payload" "$base_url/evidence/v1/upload-sessions")" "create Evidence upload session"
  session_id=$(jq -er .session_id "$workspace/upload-session.json")
  upload_url=$(jq -er .authorization.upload_url "$workspace/upload-session.json")
  case "$upload_url" in "$base_url/evidence/v1/local-uploads/"*) ;; *) echo "Evidence upload URL is outside the D1 public data plane" >&2; exit 1;; esac

  # No suite cookie is sent: the object-bound short-lived token is the only
  # credential on this Nginx -> Evidence byte path.
  expect_status 204 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --request PUT -H 'Content-Type: application/pdf' --data-binary "@$workspace/evidence.pdf" "$upload_url")" "upload Evidence bytes"
  payload=$(jq -cn --arg sha256 "$evidence_sha" --argjson observed_size_bytes "$evidence_size" \
    '{observed_size_bytes:$observed_size_bytes,observed_sha256:$sha256}')
  expect_status 200 "$(curl --silent --show-error --output "$workspace/evidence-version.json" --write-out '%{http_code}' \
    --cookie "$cookies" -H 'Content-Type: application/json' -H "Idempotency-Key: $(new_uuid)" \
    --data "$payload" "$base_url/evidence/v1/upload-sessions/$session_id/complete")" "complete Evidence upload"
  file_id=$(jq -er .file_id "$workspace/evidence-version.json")
  [ "$(jq -er .sha256 "$workspace/evidence-version.json")" = "$evidence_sha" ] || { echo "Evidence service-confirmed digest differs" >&2; exit 1; }
  payload='{"disposition":"inline","delivery_mode":"direct"}'
  expect_status 200 "$(curl --silent --show-error --output "$workspace/evidence-grant.json" --write-out '%{http_code}' \
