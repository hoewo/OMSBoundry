if [ "${D1_ACCEPTANCE_DISRUPTIVE:-}" = yes ] && [ "$enable_billing" = true ]; then
  billing_outage_command=$(new_uuid)
  payload=$(jq -cn --arg command_id "$billing_outage_command" --arg issued_on "$(date -u '+%Y-%m-%d')" \
    --arg issuer_id "$party_id" --argjson issuer_revision "$party_revision" \
    --arg recipient_id "$billing_recipient_id" --argjson recipient_revision "$billing_recipient_revision" \
    --arg project_id "$project_id" --argjson project_revision "$project_revision" \
    '{command_id:$command_id,issued_on:$issued_on,amount_minor:6789,currency:"CNY",issuer_party_ref:{id:$issuer_id,revision:$issuer_revision},recipient_party_ref:{id:$recipient_id,revision:$recipient_revision},source_refs:[{kind:"project",resource_id:$project_id,source_revision:$project_revision}],note:"D1 Billing Party outage"}')
  billing_before_count=$(compose exec -T postgres sh -eu -c "psql -U \"\$POSTGRES_USER\" -d billing_invoice -At -c 'SELECT count(*) FROM invoice_registrations'")
  compose stop party-directory >/dev/null
  expect_status 503 "$(curl --silent --show-error --output "$workspace/billing-party-outage.json" --write-out '%{http_code}' \
    --cookie "$cookies" -H 'Content-Type: application/json' --data "$payload" \
    "$base_url/billing/api/v1/invoice-registrations")" "reject Billing write while Party is stopped"
  billing_outage_commands=$(compose exec -T postgres sh -eu -c "psql -U \"\$POSTGRES_USER\" -d billing_invoice -At -c \"SELECT count(*) FROM invoice_registration_commands WHERE command_id='$billing_outage_command'\"")
  billing_after_failure_count=$(compose exec -T postgres sh -eu -c "psql -U \"\$POSTGRES_USER\" -d billing_invoice -At -c 'SELECT count(*) FROM invoice_registrations'")
  [ "$billing_outage_commands" = 0 ] && [ "$billing_after_failure_count" = "$billing_before_count" ] || {
    echo "Billing dependency failure produced a partial write" >&2
    exit 1
  }
  expect_status 200 "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --cookie "$cookies" "$base_url/billing/api/v1/invoice-registrations/$billing_id")" "read existing Billing snapshot while Party is stopped"
  compose start party-directory >/dev/null
  recovered=false; attempts=0
  while [ "$attempts" -lt 30 ]; do
    if [ "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --cookie "$cookies" "$base_url/party/health/ready")" = 200 ]; then recovered=true; break; fi
    attempts=$((attempts + 1)); sleep 1
  done
  [ "$recovered" = true ] || { echo "Party Directory did not recover for Billing retry" >&2; exit 1; }
  expect_status 201 "$(curl --silent --show-error --output "$workspace/billing-party-retry.json" --write-out '%{http_code}' \
    --cookie "$cookies" -H 'Content-Type: application/json' --data "$payload" \
    "$base_url/billing/api/v1/invoice-registrations")" "retry Billing write after Party recovery"
  billing_outage_commands=$(compose exec -T postgres sh -eu -c "psql -U \"\$POSTGRES_USER\" -d billing_invoice -At -c \"SELECT count(*) FROM invoice_registration_commands WHERE command_id='$billing_outage_command'\"")
  billing_after_recovery_count=$(compose exec -T postgres sh -eu -c "psql -U \"\$POSTGRES_USER\" -d billing_invoice -At -c 'SELECT count(*) FROM invoice_registrations'")
  [ "$billing_outage_commands" = 1 ] && [ "$billing_after_recovery_count" -eq $((billing_before_count + 1)) ] || {
    echo "Billing retry did not commit exactly once after dependency recovery" >&2
    exit 1
  }
  fault_suffix=", Billing dependency failure no-write and recovery"
fi

