    --cookie "$cookies" "$base_url/billing/api/v1/invoice-registrations/$billing_id")" "read Billing after stale revision"
  jq -e '.revision == 2 and .note == "D1 verified invoice"' "$workspace/billing-after-stale.json" >/dev/null || { echo "Billing stale revision changed state" >&2; exit 1; }

  payload=$(jq -cn --arg command_id "$(new_uuid)" --arg file_id "$file_id" \
    '{command_id:$command_id,expected_revision:2,reason:"D1 关联原始票据",evidence_refs:[{file_id:$file_id,version:1,purpose:"invoice_document",display_name:"D1 invoice.pdf"}]}')
  expect_status 200 "$(curl --silent --show-error --output "$workspace/billing-evidence.json" --write-out '%{http_code}' \
