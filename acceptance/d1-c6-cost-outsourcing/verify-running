  printf '%s\t%s\t%s\t%s\t%s\n' "$audience" "$action" "$resource_type" "$resource_id" "$count" >>"$workspace/workload-audits.tsv"
  [ "$count" -ge 1 ] || { echo "missing exact C6 workload audit: $audience/$action/$resource_type/$resource_id" >&2; exit 1; }
}
