#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tmp_root=$(printenv TMPDIR 2>/dev/null || printf /tmp)
runtime=$(mktemp -d "$tmp_root/oms-p9-c3-test.XXXXXX")
trap 'rm -rf -- "$runtime"' EXIT HUP INT TERM
mkdir -p "$runtime/bin"

P9_C2_TEST_ARTIFACT_DIR="$runtime/fixture" "$script_dir/test-c2-member-payroll" >/dev/null

primary_password=$(cat "$runtime/fixture/primary.password")
secondary_password=$(cat "$runtime/fixture/secondary.password")

cat >"$runtime/bin/docker" <<'MOCK'
#!/bin/sh
set -eu
case "${1:-}" in
  ps) printf 'container-payroll\n' ;;
  exec)
    payload=$(mktemp "${TMPDIR:-/tmp}/p9-c3-scheme-payload.XXXXXX")
    trap 'rm -f -- "$payload"' EXIT HUP INT TERM
    cat >"$payload"
    jq -e '
      (.command_id|test("^[0-9a-f-]{36}$")) and .region_code=="P9-C3" and .effective_month=="2026-10" and
      (.authority_source|startswith("urn:omsbizfoundry:acceptance:")) and
      (.components|length)==6 and all(.components[];.individual_rate_bps==0 and .employer_rate_bps==0 and .base_floor_minor==0 and .base_cap_minor>0) and
      (.reason|contains("不代表任何地区法定比例"))
    ' "$payload" >/dev/null
    printf 'imported standard contribution scheme id=cccccccc-3333-4333-8333-cccccccccccc revision=1\n'
    ;;
  *) echo "unexpected mock docker command: $*" >&2; exit 2 ;;
esac
MOCK
chmod 0755 "$runtime/bin/docker"

cat >"$runtime/bin/curl" <<'MOCK'
#!/bin/sh
set -eu
output= cookie= cookie_jar= method=GET url=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output) output=$2; shift 2 ;;
    --write-out|--connect-timeout|--max-time|--request|--cookie|--cookie-jar|--cacert|-H|--data-binary|--data-urlencode)
      option=$1; value=$2
      case "$option" in --request) method=$value;; --cookie) cookie=$value;; --cookie-jar) cookie_jar=$value;; esac
      shift 2
      ;;
    --silent|--show-error) shift ;;
    http://*|https://*) url=$1; shift ;;
    *) shift ;;
  esac
done
[ -n "$output" ] || exit 2
: >"$output"
if [ -n "$cookie_jar" ]; then printf '# mock cookie jar\n' >"$cookie_jar"; fi
actor=primary
case "$cookie$cookie_jar" in *secondary*) actor=secondary;; esac
status=200
path=$(printf '%s' "$url" | sed -E 's#^https?://[^/]+##')
scheme='{"id":"cccccccc-3333-4333-8333-cccccccccccc","scheme_kind":"standard","region_code":"P9-C3","revision":1,"components":[{"key":"pension","individual_rate_bps":0,"employer_rate_bps":0},{"key":"medical","individual_rate_bps":0,"employer_rate_bps":0},{"key":"unemployment","individual_rate_bps":0,"employer_rate_bps":0},{"key":"work_injury","individual_rate_bps":0,"employer_rate_bps":0},{"key":"maternity","individual_rate_bps":0,"employer_rate_bps":0},{"key":"housing_fund","individual_rate_bps":0,"employer_rate_bps":0}]}'
primary_run='{"id":"aaaaaaaa-4444-4444-8444-aaaaaaaaaaaa","tenant_id":"11111111-1111-4111-8111-111111111111","period":"2026-10","run_kind":"regular","status":"review_pending","revision":1,"planned_pay_date":"2026-10-31","approval_status":"not_required","approval_policy_snapshot":{"mode":"not_required"},"contribution_scheme_id":"cccccccc-3333-4333-8333-cccccccccccc","contribution_scheme_revision":1,"contribution_scheme_snapshot":{"region_code":"P9-C3","components":[{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0}]},"lines":[{"id":"aaaaaaaa-5555-4555-8555-aaaaaaaaaaaa","tenant_id":"11111111-1111-4111-8111-111111111111","person_id":"aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa","person_source_revision":1,"compensation_profile_id":"aaaaaaaa-3333-4333-8333-aaaaaaaaaaaa","compensation_profile_revision":1,"status":"review_pending","payment_account_missing":true,"fixed_salary_minor":1000000,"gross_minor":1000000,"employee_contribution_minor":0,"employer_contribution_minor":0,"tax_minor":0,"net_payable_minor":1000000,"actual_paid_minor":0,"allocated_paid_minor":0,"revision":1}]}'
secondary_run='{"id":"bbbbbbbb-4444-4444-8444-bbbbbbbbbbbb","tenant_id":"22222222-2222-4222-8222-222222222222","period":"2026-10","run_kind":"regular","status":"review_pending","revision":1,"planned_pay_date":"2026-10-31","approval_status":"not_required","approval_policy_snapshot":{"mode":"not_required"},"contribution_scheme_id":"cccccccc-3333-4333-8333-cccccccccccc","contribution_scheme_revision":1,"contribution_scheme_snapshot":{"region_code":"P9-C3","components":[{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0},{"individual_rate_bps":0,"employer_rate_bps":0}]},"lines":[{"id":"bbbbbbbb-5555-4555-8555-bbbbbbbbbbbb","tenant_id":"22222222-2222-4222-8222-222222222222","person_id":"bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb","person_source_revision":1,"compensation_profile_id":"bbbbbbbb-3333-4333-8333-bbbbbbbbbbbb","compensation_profile_revision":1,"status":"review_pending","payment_account_missing":true,"fixed_salary_minor":1200000,"gross_minor":1200000,"employee_contribution_minor":0,"employer_contribution_minor":0,"tax_minor":0,"net_payable_minor":1200000,"actual_paid_minor":0,"allocated_paid_minor":0,"revision":1}]}'
case "$method $path" in
  'GET /auth/api/v1/csrf') printf '{"csrf_token":"csrf-%s"}\n' "$actor" >"$output" ;;
  'POST /auth/api/v1/login') printf '{"principal":{"subject_id":"ok"}}\n' >"$output" ;;
  'GET /auth/api/v1/session')
    if [ "$actor" = primary ]; then printf '{"principal":{"tenant_id":"11111111-1111-4111-8111-111111111111","subject_id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"}}\n' >"$output"
    else printf '{"principal":{"tenant_id":"22222222-2222-4222-8222-222222222222","subject_id":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"}}\n' >"$output"; fi
    ;;
  'POST /auth/api/v1/admin/grants')
    if [ -f "$P9_MOCK_REPLAY_STATE" ]; then status=409; printf '{"error":{"code":"conflict"}}\n' >"$output"; else status=204; fi
    ;;
  'POST /gateway/authorize/payroll') status=303 ;;
  'GET /payroll/v1/contribution-schemes') printf '[%s]\n' "$scheme" >"$output" ;;
  'GET /payroll/v1/compensation-profiles/aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa') printf '{"id":"aaaaaaaa-3333-4333-8333-aaaaaaaaaaaa","revision":1,"currency":"CNY","fixed_salary_minor":1000000}\n' >"$output" ;;
  'GET /payroll/v1/compensation-profiles/bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb') printf '{"id":"bbbbbbbb-3333-4333-8333-bbbbbbbbbbbb","revision":1,"currency":"CNY","fixed_salary_minor":1200000}\n' >"$output" ;;
  'POST /payroll/v1/payroll-periods')
    if [ "$actor" = primary ]; then printf '%s\n' "$primary_run" >"$output"; else printf '%s\n' "$secondary_run" >"$output"; fi
    status=201
    ;;
  'GET /payroll/v1/payroll-periods')
    if [ "$actor" = primary ]; then printf '{"items":[%s]}\n' "$primary_run" >"$output"; else printf '{"items":[%s]}\n' "$secondary_run" >"$output"; fi
    ;;
  'GET /payroll/v1/payroll-periods/bbbbbbbb-4444-4444-8444-bbbbbbbbbbbb') status=404; printf '{"error":{"code":"not_found"}}\n' >"$output" ;;
  'GET /payroll/v1/payroll-periods/aaaaaaaa-4444-4444-8444-aaaaaaaaaaaa') status=404; printf '{"error":{"code":"not_found"}}\n' >"$output" ;;
  *) echo "unexpected mock curl request: $method $path" >&2; exit 2 ;;
esac
printf '%s 0.001' "$status"
MOCK
chmod 0755 "$runtime/bin/curl"

run_c3() {
  target=$1
  env P9_MOCK_REPLAY_STATE="$runtime/replay" PATH="$runtime/bin:$PATH" \
    P9_C0_EVIDENCE_DIR="$runtime/fixture/c0" P9_C1_EVIDENCE_DIR="$runtime/fixture/c1" P9_C2_EVIDENCE_DIR="$runtime/fixture/c2" \
    P9_C3_EVIDENCE_DIR="$runtime/$target" P9_PRIMARY_ADMIN_USERNAME=p9-primary P9_PRIMARY_ADMIN_PASSWORD_FILE="$runtime/fixture/primary.password" \
    P9_SECONDARY_ADMIN_USERNAME=p9-secondary P9_SECONDARY_ADMIN_PASSWORD_FILE="$runtime/fixture/secondary.password" \
    "$script_dir/verify-c3-payroll-periods" >"$runtime/$target.out"
}

run_c3 c3
grep -Fq 'PASS P9 C3' "$runtime/c3.out"
"$script_dir/verify-c3-evidence" "$runtime/c3" >/dev/null
jq -e '.phase=="C3" and .scheme.synthetic_zero_rates==true and .scheme.statutorily_authoritative==false and .checks.money_written==false' "$runtime/c3/state-after-c3.json" >/dev/null

touch "$runtime/replay"
run_c3 c3-replay
"$script_dir/verify-c3-evidence" "$runtime/c3-replay" >/dev/null
if grep -R -F "$primary_password" "$runtime/c3" "$runtime/c3-replay" >/dev/null 2>&1 || grep -R -F "$secondary_password" "$runtime/c3" "$runtime/c3-replay" >/dev/null 2>&1; then
  echo 'P9 C3 leaked an administrator password into evidence' >&2
  exit 1
fi

tampered="$runtime/c3-tampered"; cp -R "$runtime/c3" "$tampered"; printf 'tamper\n' >>"$tampered/result.md"
if "$script_dir/verify-c3-evidence" "$tampered" >/dev/null 2>&1; then echo 'P9 C3 evidence verifier accepted digest drift' >&2; exit 1; fi

incomplete="$runtime/c3-incomplete"; cp -R "$runtime/c3" "$incomplete"
awk -F '\t' '$1!="GET secondary cross-tenant Payroll Period"' "$incomplete/http-evidence.tsv" >"$incomplete/http.tmp"; mv "$incomplete/http.tmp" "$incomplete/http-evidence.tsv"
http_sha=$(openssl dgst -sha256 -r "$incomplete/http-evidence.tsv" | awk '{print $1}')
awk -v sha="$http_sha" '$2=="http-evidence.tsv" {$1=sha} {print $1"  "$2}' "$incomplete/checksums.sha256" >"$incomplete/checksums.tmp"; mv "$incomplete/checksums.tmp" "$incomplete/checksums.sha256"
if "$script_dir/verify-c3-evidence" "$incomplete" >/dev/null 2>&1; then echo 'P9 C3 evidence verifier accepted a recomputed but incomplete HTTP matrix' >&2; exit 1; fi

echo 'PASS P9 C3 offline Payroll Period driver and evidence regression'
