#!/bin/sh
set -eu
[ "$#" -eq 1 ] || { echo 'usage: verify-c8-evidence EVIDENCE_DIR' >&2; exit 2; }; evidence_dir=$1
[ -d "$evidence_dir" ] || { echo "P9 C8 evidence directory not found: $evidence_dir" >&2; exit 2; }
for command_name in jq openssl; do command -v "$command_name" >/dev/null 2>&1 || { echo "$command_name is required" >&2; exit 2; }; done
[ -z "$(find "$evidence_dir" -type l -print -quit)" ] || { echo 'P9 C8 evidence must not contain symbolic links' >&2; exit 1; }
expected='checksums.sha256
http-evidence.tsv
operations.tsv
result.md
state-after-c8.json'
[ "$(find "$evidence_dir" -mindepth 1 -maxdepth 1 -exec basename {} \;|sort)" = "$expected" ] || { echo 'P9 C8 evidence has an invalid artifact set' >&2; exit 1; }
files='http-evidence.tsv
operations.tsv
result.md
state-after-c8.json'
actual=$(awk 'NF!=2||$1!~/^[0-9a-f]{64}$/{exit 1}{print $2}' "$evidence_dir/checksums.sha256") || { echo 'P9 C8 checksum manifest is malformed' >&2; exit 1; }
[ "$actual" = "$files" ] || { echo 'P9 C8 checksum manifest has an invalid file set' >&2; exit 1; }
while read -r digest artifact; do [ "$(openssl dgst -sha256 -r "$evidence_dir/$artifact"|awk '{print $1}')" = "$digest" ] || { echo "P9 C8 checksum mismatch for $artifact" >&2; exit 1; }; done <"$evidence_dir/checksums.sha256"
uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
jq -e --arg uuid "$uuid" '.schema_version==1 and .scenario_id=="oms-v1-p9-full-composition-v1" and .phase=="C8" and .result=="pass" and .deployment.profile=="D1" and ([.deployment.c0_checksums_sha256,.deployment.c1_checksums_sha256,.deployment.c2_checksums_sha256,.deployment.c3_checksums_sha256,.deployment.c4_checksums_sha256,.deployment.c5_checksums_sha256,.deployment.c6_checksums_sha256,.deployment.c7_checksums_sha256]|all(test("^[0-9a-f]{64}$"))) and .party_runtime.mode=="local_compatibility" and .party_runtime.party_directory_unified==false and (.tenants|length)==2 and .tenants[0].tenant_id!=.tenants[1].tenant_id and all(.tenants[];(.tenant_id|test($uuid)) and (.person_id|test($uuid)) and (.payment_profile.id|test($uuid)) and .payment_profile.revision>=1 and (.payroll.run_id|test($uuid)) and .payroll.run_revision>=3 and .payroll.status=="paid" and (.payroll.line_id|test($uuid)) and .payroll.line_revision>=3 and .payroll.line_status=="paid" and .payroll.net_payable_minor>0 and .payroll.actual_paid_minor==.payroll.net_payable_minor and .payroll.allocated_paid_minor==.payroll.net_payable_minor and .payroll.overage_minor==0 and (.payroll.payment_command_id|test($uuid))) and .checks.payment_profile_snapshot=="pass" and .checks.payroll_review=="pass" and .checks.payroll_to_money_write=="pass" and .checks.self_payslip_projection=="pass" and .checks.cross_tenant_payment_not_found=="pass" and .checks.direct_database_write==false and .checks.secrets_recorded==false' "$evidence_dir/state-after-c8.json" >/dev/null || { echo 'P9 C8 state has an invalid schema or failed check' >&2; exit 1; }
awk -F '\t' 'NR==1{if($0!="tenant_role\toperation\tresult")exit 1;next} NF!=3||$2!="payroll-owner-set"||$3!="pass"{exit 1} {seen[$1]++} END{if(seen["primary"]!=1||seen["secondary"]!=1)exit 1}' "$evidence_dir/operations.tsv" || { echo 'P9 C8 operations evidence is incomplete' >&2; exit 1; }
awk -F '\t' 'NR==1{if($0!="request\texpected_status\tactual_status\ttime_seconds")exit 1;next} NF!=4||$4!~/^[0-9]+([.][0-9]+)?$/{exit 1} $1=="POST primary Payroll payment"{ap++} $1=="POST secondary Payroll payment"{bp++} $1=="GET primary self payslips"{as++} $1=="GET secondary self payslips"{bs++} $1=="POST primary cross-tenant Payroll payment"{cross++} $2=="204/409"{if($3!=204&&$3!=409)exit 1;next} $2!=$3{exit 1} END{if(ap!=1||bp!=1||as!=1||bs!=1||cross!=1)exit 1}' "$evidence_dir/http-evidence.tsv" || { echo 'P9 C8 HTTP evidence is incomplete' >&2; exit 1; }
if grep -REq 'Authorization:|account_number|password|(^|[^0-9a-f])[0-9]{14,32}([^0-9a-f]|$)' "$evidence_dir"; then echo 'P9 C8 evidence contains a protected value' >&2; exit 1; fi
echo 'PASS P9 C8 evidence integrity, Payroll payment matrix and secret exclusion'
