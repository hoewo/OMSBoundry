#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tmp_root=$(printenv TMPDIR 2>/dev/null || printf /tmp)
runtime=$(mktemp -d "$tmp_root/oms-p9-c2-test.XXXXXX")
trap 'rm -rf -- "$runtime"' EXIT HUP INT TERM
mkdir -p "$runtime/c0" "$runtime/c1" "$runtime/bin"
export_dir=$(printenv P9_C2_TEST_ARTIFACT_DIR 2>/dev/null || true)

services='approval-audit-results
billing-invoice
bonus-distribution
business-engagement
contract-ledger
cost-outsourcing
evidence-service
gateway
identity-access
internal-finance-requests
money-flow-ledger
nginx
party-directory
payroll
people-groups
postgres
production-operations
project-workspace
unified-workbench'
digest=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
image_id=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

printf '%s\n' "$services" | jq -Rn --arg digest "$digest" '
  [inputs | select(length>0)] |
  {schema_version:"1",services:map({service:.,image:("test/"+.+"@sha256:"+$digest),profiles:[],depends_on:[],networks:["test"],ports:(if .=="nginx" then [{published:"443",target:443}] else [] end)}),volumes:["test"],networks:["test"]}
' >"$runtime/c0/compose-topology.json"
printf '%s\n' "$services" | jq -Rn --arg digest "$digest" --arg image_id "$image_id" '
  [inputs | select(length>0)] |
  map({service:.,container:("container-"+.),configured_image:("test/"+.+"@sha256:"+$digest),image_id:$image_id,state:"running",health:"healthy"})
' >"$runtime/c0/services-and-health.json"
printf '%s\n' "$services" | jq -Rn --arg digest "$digest" --arg image_id "$image_id" '
  [inputs | select(length>0)] |
  map({configured_image:("test/"+.+"@sha256:"+$digest),image_id:$image_id,repo_digests:[("test/"+.+"@sha256:"+$digest)]})
' >"$runtime/c0/images.json"
printf 'version=v0.1.0-test\ncommit=1111111111111111111111111111111111111111\nbuilt_at=2026-10-26T00:00:00Z\ntarget=linux/amd64\n' >"$runtime/c0/release-metadata.txt"
printf '{"status":"ready"}\n' >"$runtime/c0/readiness.json"
printf 'PASS mock schema and contracts\n' >"$runtime/c0/schema-and-contract-check.log"
printf '{"schema_version":"1","suite_id":"p9-test","tenant_id":"11111111-1111-4111-8111-111111111111","applications":[]}\n' >"$runtime/c0/suite-manifest.json"
manifest_sha=$(openssl dgst -sha256 -r "$runtime/c0/suite-manifest.json" | awk '{print $1}')
topology_sha=$(openssl dgst -sha256 -r "$runtime/c0/compose-topology.json" | awk '{print $1}')
check_sha=$(openssl dgst -sha256 -r "$runtime/c0/schema-and-contract-check.log" | awk '{print $1}')
jq -n --arg manifest "$manifest_sha" --arg topology "$topology_sha" --arg check "$check_sha" '
  {schema_version:1,scenario_id:"oms-v1-p9-full-composition-v1",phase:"C0",result:"pass",captured_at:"2026-10-26T00:00:00Z",tenant_id:"11111111-1111-4111-8111-111111111111",deployment:{profile:"D1",compose_project:"p9-mock",public_url:"https://oms.example.test",image_mode:"pull",running_services:19,healthy_services:19},release:{version:"v0.1.0-test",commit:"1111111111111111111111111111111111111111",built_at:"2026-10-26T00:00:00Z",target:"linux/amd64"},suite:{enabled_applications:[],domain_application_count:14},feedback:{auth_mode:"apiKey",project_id:115,notifications_enabled:true,configured_key_count:1,secrets_recorded:false},checks:{exact_service_set:"pass",nginx_only_host_port:"pass",digest_pinned_images:"pass",running_images_match_configured_references:"pass",schemas_current_and_contracts_valid:"pass",public_readiness:"pass",suite_manifest_sha256:$manifest,compose_topology_sha256:$topology,schema_and_contract_log_sha256:$check},artifacts:["checksums.sha256","compose-topology.json","images.json","readiness.json","release-metadata.txt","schema-and-contract-check.log","services-and-health.json","state-after-c0.json","suite-manifest.json"]}
' >"$runtime/c0/state-after-c0.json"
: >"$runtime/c0/checksums.sha256"
for artifact in compose-topology.json images.json readiness.json release-metadata.txt schema-and-contract-check.log services-and-health.json state-after-c0.json suite-manifest.json; do
  printf '%s  %s\n' "$(openssl dgst -sha256 -r "$runtime/c0/$artifact" | awk '{print $1}')" "$artifact" >>"$runtime/c0/checksums.sha256"
done
chmod 600 "$runtime/c0/"*
"$script_dir/verify-evidence" "$runtime/c0" >/dev/null

c0_checksums_sha256=$(openssl dgst -sha256 -r "$runtime/c0/checksums.sha256" | awk '{print $1}')
cat >"$runtime/c1/http-evidence.tsv" <<'EOF'
request	expected_status	actual_status	time_seconds
GET /auth/api/v1/csrf	200	200	0.001
GET /auth/api/v1/csrf	200	200	0.001
POST /auth/api/v1/login	200/401	401	0.001
POST /auth/api/v1/login	200	200	0.001
POST /auth/api/v1/login	200	200	0.001
GET /auth/api/v1/session	200	200	0.001
GET /auth/api/v1/session	200	200	0.001
POST People grant	204/409	204	0.001
POST People grant	204/409	204	0.001
POST People grant	204/409	204	0.001
POST People grant	204/409	204	0.001
POST /gateway/authorize/people-groups	303	303	0.001
POST /gateway/authorize/people-groups	303	303	0.001
POST primary Person	201	201	0.001
POST secondary Person	201	201	0.001
GET primary Person list	200	200	0.001
GET secondary Person list	200	200	0.001
GET primary cross-tenant Person	404	404	0.001
GET secondary cross-tenant Person	404	404	0.001
GET primary Workbench	200	200	0.001
GET secondary Workbench	200	200	0.001
EOF
jq -n --arg c0 "$c0_checksums_sha256" '{schema_version:1,scenario_id:"oms-v1-p9-full-composition-v1",phase:"C1",result:"pass",captured_at:"2026-10-26T00:01:00Z",deployment:{profile:"D1",compose_project:"p9-mock",public_url:"https://oms.example.test",c0_checksums_sha256:$c0},tenant_provisioning:"created",tenants:[{id:"11111111-1111-4111-8111-111111111111",administrator_subject_id:"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",person:{id:"aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa",revision:1,reference_code:"P9-C1-A"}},{id:"22222222-2222-4222-8222-222222222222",administrator_subject_id:"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",person:{id:"bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb",revision:1,reference_code:"P9-C1-B"}}],checks:{same_public_origin:"pass",session_tenant_context:"pass",people_capability_per_tenant:"pass",person_list_isolation:"pass",cross_tenant_person_not_found:"pass",workbench_session_tenant:"pass",secrets_recorded:false}}' >"$runtime/c1/state-after-c1.json"
cat >"$runtime/c1/result.md" <<'EOF'
# P9 C1 mock result

- Result: pass
- Secrets recorded: no
EOF
: >"$runtime/c1/checksums.sha256"
for artifact in http-evidence.tsv result.md state-after-c1.json; do
  printf '%s  %s\n' "$(openssl dgst -sha256 -r "$runtime/c1/$artifact" | awk '{print $1}')" "$artifact" >>"$runtime/c1/checksums.sha256"
done
chmod 600 "$runtime/c1/"*
"$script_dir/verify-c1-evidence" "$runtime/c1" >/dev/null

primary_password='P9-c2-primary-secret-must-not-leak'
secondary_password='P9-c2-secondary-secret-must-not-leak'
printf '%s\n' "$primary_password" >"$runtime/primary.password"
printf '%s\n' "$secondary_password" >"$runtime/secondary.password"
chmod 600 "$runtime/primary.password" "$runtime/secondary.password"

cat >"$runtime/bin/curl" <<'MOCK'
#!/bin/sh
set -eu
output=
cookie=
cookie_jar=
method=GET
url=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output) output=$2; shift 2 ;;
    --write-out|--connect-timeout|--max-time|--request|--cookie|--cookie-jar|--cacert|-H|--data-binary|--data-urlencode)
      option=$1
      value=$2
      case "$option" in
        --request) method=$value ;;
        --cookie) cookie=$value ;;
        --cookie-jar) cookie_jar=$value ;;
      esac
      shift 2
      ;;
    --silent|--show-error) shift ;;
    http://*|https://*) url=$1; shift ;;
    *) shift ;;
  esac
done
[ -n "$output" ] || exit 2
: >"$output"
if [ -n "$cookie_jar" ]; then printf '# mock cookie jar\n' >"$cookie_jar"; fi
actor=primary
case "$cookie$cookie_jar" in *secondary*) actor=secondary;; esac
status=200
path=$(printf '%s' "$url" | sed -E 's#^https?://[^/]+##')
case "$method $path" in
  'GET /auth/api/v1/csrf') printf '{"csrf_token":"csrf-%s"}\n' "$actor" >"$output" ;;
  'POST /auth/api/v1/login') printf '{"principal":{"subject_id":"ok"}}\n' >"$output" ;;
  'GET /auth/api/v1/session')
    if [ "$actor" = primary ]; then
      printf '{"principal":{"tenant_id":"11111111-1111-4111-8111-111111111111","subject_id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"}}\n' >"$output"
    else
      printf '{"principal":{"tenant_id":"22222222-2222-4222-8222-222222222222","subject_id":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"}}\n' >"$output"
    fi
    ;;
  'POST /auth/api/v1/admin/grants')
    if [ -f "$P9_MOCK_REPLAY_STATE" ]; then
      status=409
      printf '{"error":{"code":"conflict","message":"Capability already granted"}}\n' >"$output"
    else
      status=204
    fi
    ;;
  'POST /gateway/authorize/payroll') status=303 ;;
  'PUT /payroll/v1/compensation-profiles/aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa')
    printf '{"id":"aaaaaaaa-3333-4333-8333-aaaaaaaaaaaa","tenant_id":"11111111-1111-4111-8111-111111111111","person_id":"aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa","person_source_revision":1,"effective_month":"2026-10","fixed_salary_minor":1000000,"social_insurance_base_minor":800000,"housing_fund_base_minor":800000,"currency":"CNY","revision":1}\n' >"$output"
    ;;
  'PUT /payroll/v1/compensation-profiles/bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb')
    printf '{"id":"bbbbbbbb-3333-4333-8333-bbbbbbbbbbbb","tenant_id":"22222222-2222-4222-8222-222222222222","person_id":"bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb","person_source_revision":1,"effective_month":"2026-10","fixed_salary_minor":1200000,"social_insurance_base_minor":900000,"housing_fund_base_minor":900000,"currency":"CNY","revision":1}\n' >"$output"
    ;;
  'GET /payroll/v1/compensation-profiles')
    if [ "$actor" = primary ]; then
      printf '[{"id":"aaaaaaaa-3333-4333-8333-aaaaaaaaaaaa","tenant_id":"11111111-1111-4111-8111-111111111111"}]\n' >"$output"
    else
      printf '[{"id":"bbbbbbbb-3333-4333-8333-bbbbbbbbbbbb","tenant_id":"22222222-2222-4222-8222-222222222222"}]\n' >"$output"
    fi
    ;;
  'GET /payroll/v1/compensation-profiles/'*) status=404; printf '{"code":"PAYROLL_PROFILE_NOT_FOUND"}\n' >"$output" ;;
  *) echo "unexpected mock curl request: $method $path" >&2; exit 2 ;;
esac
printf '%s 0.001' "$status"
MOCK
chmod 0755 "$runtime/bin/curl"

run_c2() {
  target=$1
  env \
    P9_MOCK_REPLAY_STATE="$runtime/replay" \
    PATH="$runtime/bin:$PATH" \
    P9_C0_EVIDENCE_DIR="$runtime/c0" \
    P9_C1_EVIDENCE_DIR="$runtime/c1" \
    P9_C2_EVIDENCE_DIR="$runtime/$target" \
    P9_PRIMARY_ADMIN_USERNAME=p9-primary \
    P9_PRIMARY_ADMIN_PASSWORD_FILE="$runtime/primary.password" \
    P9_SECONDARY_ADMIN_USERNAME=p9-secondary \
    P9_SECONDARY_ADMIN_PASSWORD_FILE="$runtime/secondary.password" \
    "$script_dir/verify-c2-member-payroll" >"$runtime/$target.out"
}

run_c2 c2
grep -Fq 'PASS P9 C2' "$runtime/c2.out"
"$script_dir/verify-c2-evidence" "$runtime/c2" >/dev/null
jq -e '.phase=="C2" and (.tenants|length)==2 and .checks.statutory_rates_asserted==false and .checks.secrets_recorded==false' "$runtime/c2/state-after-c2.json" >/dev/null

touch "$runtime/replay"
run_c2 c2-replay
"$script_dir/verify-c2-evidence" "$runtime/c2-replay" >/dev/null
if grep -R -F "$primary_password" "$runtime/c2" "$runtime/c2-replay" >/dev/null 2>&1 || grep -R -F "$secondary_password" "$runtime/c2" "$runtime/c2-replay" >/dev/null 2>&1; then
  echo 'P9 C2 leaked an administrator password into evidence' >&2
  exit 1
fi

tampered="$runtime/c2-tampered"
cp -R "$runtime/c2" "$tampered"
printf 'tamper\n' >>"$tampered/result.md"
if "$script_dir/verify-c2-evidence" "$tampered" >/dev/null 2>&1; then
  echo 'P9 C2 evidence verifier accepted digest drift' >&2
  exit 1
fi

schema_tampered="$runtime/c2-schema-tampered"
cp -R "$runtime/c2" "$schema_tampered"
awk -F '\t' '$1!="GET secondary cross-tenant Compensation"' "$schema_tampered/http-evidence.tsv" >"$schema_tampered/http-evidence.tmp"
mv "$schema_tampered/http-evidence.tmp" "$schema_tampered/http-evidence.tsv"
http_sha=$(openssl dgst -sha256 -r "$schema_tampered/http-evidence.tsv" | awk '{print $1}')
awk -v sha="$http_sha" '$2=="http-evidence.tsv" {$1=sha} {print $1"  "$2}' "$schema_tampered/checksums.sha256" >"$schema_tampered/checksums.tmp"
mv "$schema_tampered/checksums.tmp" "$schema_tampered/checksums.sha256"
if "$script_dir/verify-c2-evidence" "$schema_tampered" >/dev/null 2>&1; then
  echo 'P9 C2 evidence verifier accepted a recomputed but incomplete HTTP matrix' >&2
  exit 1
fi

if [ -n "$export_dir" ]; then
  [ ! -e "$export_dir" ] || { echo "P9_C2_TEST_ARTIFACT_DIR already exists: $export_dir" >&2; exit 2; }
  mkdir -p "$export_dir"
  cp -R "$runtime/c0" "$runtime/c1" "$runtime/c2" "$export_dir/"
  cp "$runtime/primary.password" "$runtime/secondary.password" "$export_dir/"
  chmod 700 "$export_dir"
  chmod 600 "$export_dir/primary.password" "$export_dir/secondary.password"
fi

echo 'PASS P9 C2 offline member-to-payroll driver and evidence regression'
