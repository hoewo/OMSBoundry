#!/bin/sh
set -eu

[ "$#" -eq 1 ] || { echo 'usage: verify-c2-evidence EVIDENCE_DIR' >&2; exit 2; }
evidence_dir=$1
[ -d "$evidence_dir" ] || { echo "P9 C2 evidence directory not found: $evidence_dir" >&2; exit 2; }
for command_name in jq openssl; do
  command -v "$command_name" >/dev/null 2>&1 || { echo "$command_name is required" >&2; exit 2; }
done
[ -z "$(find "$evidence_dir" -type l -print -quit)" ] || { echo 'P9 C2 evidence must not contain symbolic links' >&2; exit 1; }

expected_entries='checksums.sha256
http-evidence.tsv
result.md
state-after-c2.json'
actual_entries=$(find "$evidence_dir" -mindepth 1 -maxdepth 1 -exec basename {} \; | sort)
[ "$actual_entries" = "$expected_entries" ] || { echo 'P9 C2 evidence directory does not contain the fixed artifact set' >&2; exit 1; }
expected_files='http-evidence.tsv
result.md
state-after-c2.json'
actual_files=$(awk 'NF!=2 || $1!~/^[0-9a-f]{64}$/ {exit 1} {print $2}' "$evidence_dir/checksums.sha256") || { echo 'P9 C2 checksum manifest is malformed' >&2; exit 1; }
[ "$actual_files" = "$expected_files" ] || { echo 'P9 C2 checksum manifest has an invalid file set' >&2; exit 1; }
while read -r expected artifact; do
  actual=$(openssl dgst -sha256 -r "$evidence_dir/$artifact" | awk '{print $1}')
  [ "$actual" = "$expected" ] || { echo "P9 C2 checksum mismatch for $artifact" >&2; exit 1; }
done <"$evidence_dir/checksums.sha256"

uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
jq -e --arg uuid "$uuid" '
  .schema_version==1 and .scenario_id=="oms-v1-p9-full-composition-v1" and .phase=="C2" and .result=="pass" and
  .deployment.profile=="D1" and (.deployment.c0_checksums_sha256|test("^[0-9a-f]{64}$")) and (.deployment.c1_checksums_sha256|test("^[0-9a-f]{64}$")) and
  (.tenants|length)==2 and (.tenants[0].id != .tenants[1].id) and (.tenants[0].person_id != .tenants[1].person_id) and
  all(.tenants[]; (.id|test($uuid)) and (.person_id|test($uuid)) and (.compensation_profile.id|test($uuid)) and .compensation_profile.revision>=1) and
  .checks.people_reference_preserved=="pass" and .checks.payroll_capability_per_tenant=="pass" and
  .checks.compensation_list_isolation=="pass" and .checks.cross_tenant_compensation_not_found=="pass" and
  .checks.precise_minor_units=="pass" and .checks.statutory_rates_asserted==false and .checks.secrets_recorded==false
' "$evidence_dir/state-after-c2.json" >/dev/null || { echo 'P9 C2 state has an invalid schema or failed check' >&2; exit 1; }

awk -F '\t' '
  NR==1 {if ($0!="request\texpected_status\tactual_status\ttime_seconds") exit 1; next}
  NF!=4 {exit 1}
  $4 !~ /^[0-9]+([.][0-9]+)?$/ {exit 1}
  $1=="GET /auth/api/v1/csrf" {csrf++}
  $1=="POST /auth/api/v1/login" {login++}
  $1=="GET /auth/api/v1/session" {session++}
  $1=="POST Payroll grant" {grant++}
  $1=="POST /gateway/authorize/payroll" {authorize++}
  $1=="PUT primary Compensation Profile" {primary_put++}
  $1=="PUT secondary Compensation Profile" {secondary_put++}
  $1=="GET primary Compensation list" {primary_list++}
  $1=="GET secondary Compensation list" {secondary_list++}
  $1=="GET primary cross-tenant Compensation" {primary_cross++}
  $1=="GET secondary cross-tenant Compensation" {secondary_cross++}
  $2==$3 {next}
  $2=="204/409" && ($3=="204" || $3=="409") {next}
  {exit 1}
  END {
    if (csrf!=2 || login!=2 || session!=2 || grant!=4 || authorize!=2 || primary_put!=1 || secondary_put!=1 ||
        primary_list!=1 || secondary_list!=1 || primary_cross!=1 || secondary_cross!=1) exit 1
  }
' "$evidence_dir/http-evidence.tsv" || { echo 'P9 C2 HTTP evidence contains a failed assertion' >&2; exit 1; }

echo "PASS P9 C2 evidence integrity: $evidence_dir"
