#!/bin/sh
set -eu
umask 077

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
required_env() { value=$(printenv "$1" 2>/dev/null || true); [ -n "$value" ] || { echo "set $1" >&2; exit 2; }; printf '%s' "$value"; }
for command_name in curl jq openssl; do command -v "$command_name" >/dev/null 2>&1 || { echo "$command_name is required" >&2; exit 2; }; done

c0_dir=$(required_env P9_C0_EVIDENCE_DIR); c1_dir=$(required_env P9_C1_EVIDENCE_DIR); c2_dir=$(required_env P9_C2_EVIDENCE_DIR)
c3_dir=$(required_env P9_C3_EVIDENCE_DIR); c4_dir=$(required_env P9_C4_EVIDENCE_DIR); c5_dir=$(required_env P9_C5_EVIDENCE_DIR)
c6_dir=$(required_env P9_C6_EVIDENCE_DIR); c7_dir=$(required_env P9_C7_EVIDENCE_DIR); c8_dir=$(required_env P9_C8_EVIDENCE_DIR)
evidence_dir=$(required_env P9_C9_EVIDENCE_DIR); secret_dir=$(required_env P9_C5_SECRET_DIR)
primary_username=$(required_env P9_PRIMARY_ADMIN_USERNAME); primary_password_file=$(required_env P9_PRIMARY_ADMIN_PASSWORD_FILE)
secondary_username=$(required_env P9_SECONDARY_ADMIN_USERNAME); secondary_password_file=$(required_env P9_SECONDARY_ADMIN_PASSWORD_FILE)
d1_env=$(required_env D1_ENV_FILE); ca_bundle=$(printenv P9_CURL_CA_BUNDLE 2>/dev/null || true)
[ "${P9_C9_CONFIRM_IN_PLACE_RESTORE:-}" = yes ] || { echo 'C9 destroys and restores this exact D1 Compose project; rerun with P9_C9_CONFIRM_IN_PLACE_RESTORE=yes' >&2; exit 2; }

case "$evidence_dir" in /*) ;; *) echo 'P9_C9_EVIDENCE_DIR must be absolute' >&2; exit 2;; esac
case "$secret_dir" in /*) ;; *) echo 'P9_C5_SECRET_DIR must be absolute' >&2; exit 2;; esac
case "$d1_env" in /*) ;; *) echo 'D1_ENV_FILE must be absolute' >&2; exit 2;; esac
[ -f "$d1_env" ] || { echo "D1_ENV_FILE not found: $d1_env" >&2; exit 2; }
[ ! -e "$evidence_dir" ] || { [ -d "$evidence_dir" ] && [ -z "$(find "$evidence_dir" -mindepth 1 -print -quit)" ] || { echo "P9 C9 evidence directory must be absent or empty: $evidence_dir" >&2; exit 2; }; }
case "$secret_dir/" in "$evidence_dir/"*|"$evidence_dir/") echo 'P9 C5 secrets must not be inside C9 evidence' >&2; exit 2;; esac
case "$evidence_dir/" in "$secret_dir/"*|"$secret_dir/") echo 'P9 C9 evidence must not be inside the C5 secret directory' >&2; exit 2;; esac
[ -z "$ca_bundle" ] || [ -f "$ca_bundle" ] || { echo "P9_CURL_CA_BUNDLE not found: $ca_bundle" >&2; exit 2; }
file_mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"; }
[ -d "$secret_dir" ] && [ "$(file_mode "$secret_dir")" = 700 ] || { echo 'P9 C5 secret directory must be mode 0700' >&2; exit 2; }
for file in "$secret_dir/primary.api-key" "$secret_dir/secondary.api-key" "$primary_password_file" "$secondary_password_file"; do
  [ -f "$file" ] && [ "$(file_mode "$file")" = 600 ] || { echo "protected input must exist with mode 0600: $file" >&2; exit 2; }
done

"$script_dir/verify-evidence" "$c0_dir" >/dev/null
for phase in 1 2 3 4 5 6 7 8; do eval dir=\$c${phase}_dir; "$script_dir/verify-c${phase}-evidence" "$dir" >/dev/null; done
c0_state="$c0_dir/state-after-c0.json"; compose_project=$(jq -er '.deployment.compose_project' "$c0_state"); base_url=$(jq -er '.deployment.public_url|sub("/+$";"")' "$c0_state")
[ -z "${D1_PROJECT_NAME:-}" ] || [ "$D1_PROJECT_NAME" = "$compose_project" ] || { echo 'D1_PROJECT_NAME does not match the C0 Compose project' >&2; exit 2; }
case "$base_url" in https://*|http://127.0.0.1:*|http://localhost:*) ;; *) echo 'C0 public URL is not allowed' >&2; exit 1;; esac
c0_sha=$(openssl dgst -sha256 -r "$c0_dir/checksums.sha256"|awk '{print $1}')
phase=1
while [ "$phase" -le 8 ]; do
  eval phase_dir=\$c${phase}_dir
  [ "$(jq -er '.deployment.compose_project' "$phase_dir/state-after-c$phase.json")" = "$compose_project" ] || { echo "C$phase Compose project changed" >&2; exit 1; }
  prior=0
  while [ "$prior" -lt "$phase" ]; do eval prior_dir=\$c${prior}_dir; actual=$(openssl dgst -sha256 -r "$prior_dir/checksums.sha256"|awk '{print $1}'); [ "$(jq -er ".deployment.c${prior}_checksums_sha256" "$phase_dir/state-after-c$phase.json")" = "$actual" ] || { echo "C$phase does not bind C$prior" >&2; exit 1; }; prior=$((prior+1)); done
  phase=$((phase+1))
done

tmp_root=$(printenv TMPDIR 2>/dev/null || printf /tmp); workspace=$(mktemp -d "$tmp_root/oms-p9-c9.XXXXXX"); evidence_stage=
trap 'rm -rf -- "$workspace"; [ -z "$evidence_stage" ] || rm -rf -- "$evidence_stage"' EXIT HUP INT TERM
chmod 700 "$workspace"; events="$workspace/recovery-events.tsv"; printf 'event\tresult\tdetail\npre-restore-chain\tpass\tc0-c8\n' >"$events"

d1_command=${P9_C9_D1_COMMAND:-"$repo_dir/deployments/d1/ops/d1"}
case "$d1_command" in /*) ;; *) echo 'P9_C9_D1_COMMAND must be absolute' >&2; exit 2;; esac
[ -x "$d1_command" ] || { echo "D1 command is not executable: $d1_command" >&2; exit 2; }
env D1_ENV_FILE="$d1_env" D1_PROJECT_NAME="$compose_project" "$d1_command" backup >"$workspace/backup.log" 2>&1
backup_id=$(sed -n 's/^backup created: \([0-9]\{8\}T[0-9]\{6\}Z\) (.*/\1/p' "$workspace/backup.log" | tail -1)
[ -n "$backup_id" ] || { echo 'D1 backup did not return a valid backup ID' >&2; exit 1; }
backup_setting=$(awk -F= '$1=="D1_BACKUP_DIR"{sub(/^[^=]*=/,"");v=$0}END{print v}' "$d1_env"); [ -n "$backup_setting" ] || backup_setting=./.runtime/backups
case "$backup_setting" in /*) backup_root=$backup_setting;; *) backup_root="$repo_dir/deployments/d1/${backup_setting#./}";; esac
backup="$backup_root/$backup_id"; [ -d "$backup" ] || { echo "D1 backup directory not found: $backup" >&2; exit 1; }
[ -z "$(find "$backup" -type l -print -quit)" ] || { echo 'D1 backup contains symbolic links' >&2; exit 1; }
expected_backup='approval-audit-results.dump
backup-consistency.env
billing-invoice.dump
bonus-distribution.dump
business-engagement.dump
checksums.sha256
contract-ledger.zip
cost-outsourcing.dump
database-fingerprints.tsv
evidence-service.zip
identity-access.dump
internal-finance-requests.dump
money-flow-ledger.zip
party-directory.zip
payroll.dump
people-groups.dump
production-operations.dump
project-workspace.dump
signing-keys.json
suite-selection.env'
[ "$(find "$backup" -mindepth 1 -maxdepth 1 -type f -exec basename {} \; | sort)" = "$expected_backup" ] || { echo 'D1 full-composition backup has an invalid artifact set' >&2; exit 1; }
expected_backup_manifest='approval-audit-results.dump
backup-consistency.env
billing-invoice.dump
bonus-distribution.dump
business-engagement.dump
contract-ledger.zip
cost-outsourcing.dump
database-fingerprints.tsv
evidence-service.zip
identity-access.dump
internal-finance-requests.dump
money-flow-ledger.zip
party-directory.zip
payroll.dump
people-groups.dump
production-operations.dump
project-workspace.dump
signing-keys.json
suite-selection.env'
actual_backup_manifest=$(awk 'NF!=2||length($1)!=64||$1!~/^[0-9a-f]+$/||$2~/\//||seen[$2]++{exit 1}{print $2}' "$backup/checksums.sha256") || { echo 'D1 backup checksum manifest is malformed or duplicated' >&2; exit 1; }
[ "$actual_backup_manifest" = "$expected_backup_manifest" ] || { echo 'D1 backup checksum manifest has an invalid file set' >&2; exit 1; }
while read -r digest file; do case "$file" in */*|'') echo 'D1 backup checksum manifest has an unsafe name' >&2; exit 1;; esac; [ "$(openssl dgst -sha256 -r "$backup/$file"|awk '{print $1}')" = "$digest" ] || { echo "D1 backup checksum mismatch: $file" >&2; exit 1; }; done <"$backup/checksums.sha256"
grep -qx 'CONSISTENCY_MODE=public-ingress-quiesced-v1' "$backup/backup-consistency.env" || { echo 'D1 backup is not ingress-quiesced' >&2; exit 1; }
for flag in ENABLE_CONTRACT ENABLE_MONEY ENABLE_PEOPLE ENABLE_PARTY ENABLE_PROJECT ENABLE_EVIDENCE ENABLE_BUSINESS_ENGAGEMENT ENABLE_BILLING ENABLE_PRODUCTION ENABLE_APPROVAL_AUDIT_RESULTS ENABLE_COST_OUTSOURCING ENABLE_BONUS_DISTRIBUTION ENABLE_INTERNAL_FINANCE_REQUESTS ENABLE_PAYROLL; do grep -qx "$flag=true" "$backup/suite-selection.env" || { echo "D1 backup does not contain the full P9 selection: $flag" >&2; exit 1; }; done
expected_databases='approval_audit_results
billing_invoice
bonus_distribution
business_engagement
contract_ledger
cost_outsourcing
design_operations
evidence_service
identity_access
internal_finance_requests
money_flow
party_directory
payroll
people_groups
project_workspace'
actual_databases=$(awk -F '\t' 'NR==1{if($0!="FORMAT\tomsbizfoundry.d1-database-fingerprints/v1")exit 1;next} NR==2{if($0!="EXCLUDED_DATA\tidentity_access.public.suite_sessions")exit 1;next} NR==3{if($0!="DATABASE\tTABLE_COUNT\tROW_COUNT\tSCHEMA_SHA256\tFACT_SHA256")exit 1;next} NR>=4{if(NF!=5||$1!~/^[a-z][a-z0-9_]*$/||$2!~/^[1-9][0-9]*$/||$3!~/^[0-9]+$/||length($4)!=64||$4!~/^[0-9a-f]+$/||length($5)!=64||$5!~/^[0-9a-f]+$/||seen[$1]++)exit 1;print $1}' "$backup/database-fingerprints.tsv" | sort) || { echo 'D1 database fingerprint artifact is invalid' >&2; exit 1; }
[ "$actual_databases" = "$expected_databases" ] || { echo 'D1 database fingerprint selection is not the full P9 set' >&2; exit 1; }
backup_manifest_sha=$(openssl dgst -sha256 -r "$backup/checksums.sha256"|awk '{print $1}'); fingerprint_sha=$(openssl dgst -sha256 -r "$backup/database-fingerprints.tsv"|awk '{print $1}')
printf 'joint-backup\tpass\t%s\n' "$backup_id" >>"$events"

env D1_ENV_FILE="$d1_env" D1_PROJECT_NAME="$compose_project" D1_CONFIRM_EMPTY_RESTORE=yes "$d1_command" restore "$backup_id" >"$workspace/restore.log" 2>&1
grep -Fqx "backup restored and verified: $backup_id" "$workspace/restore.log" || { echo 'D1 empty-target restore did not report verified completion' >&2; exit 1; }
printf 'empty-target-restore\tpass\t%s\ndatabase-fingerprint-match\tpass\t%s\n' "$backup_id" "$fingerprint_sha" >>"$events"
env D1_ENV_FILE="$d1_env" D1_PROJECT_NAME="$compose_project" "$d1_command" check >"$workspace/check.log" 2>&1
printf 'd1-health\tpass\tfull-composition\n' >>"$events"

post7="$workspace/post-c7"; post8="$workspace/post-c8"; probe_started_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ'); sleep 1
env P9_C0_EVIDENCE_DIR="$c0_dir" P9_C1_EVIDENCE_DIR="$c1_dir" P9_C2_EVIDENCE_DIR="$c2_dir" P9_C3_EVIDENCE_DIR="$c3_dir" P9_C4_EVIDENCE_DIR="$c4_dir" P9_C5_EVIDENCE_DIR="$c5_dir" P9_C6_EVIDENCE_DIR="$c6_dir" P9_C7_EVIDENCE_DIR="$post7" P9_C5_SECRET_DIR="$secret_dir" P9_PRIMARY_ADMIN_USERNAME="$primary_username" P9_PRIMARY_ADMIN_PASSWORD_FILE="$primary_password_file" P9_SECONDARY_ADMIN_USERNAME="$secondary_username" P9_SECONDARY_ADMIN_PASSWORD_FILE="$secondary_password_file" "$script_dir/verify-c7-reimbursement-payments" >/dev/null
jq -s -e '.[0].tenants==.[1].tenants' "$c7_dir/state-after-c7.json" "$post7/state-after-c7.json" >/dev/null || { echo 'post-restore C7 stable replay changed business facts' >&2; exit 1; }
printf 'c7-stable-replay\tpass\tstable-business-facts\n' >>"$events"
env P9_C0_EVIDENCE_DIR="$c0_dir" P9_C1_EVIDENCE_DIR="$c1_dir" P9_C2_EVIDENCE_DIR="$c2_dir" P9_C3_EVIDENCE_DIR="$c3_dir" P9_C4_EVIDENCE_DIR="$c4_dir" P9_C5_EVIDENCE_DIR="$c5_dir" P9_C6_EVIDENCE_DIR="$c6_dir" P9_C7_EVIDENCE_DIR="$post7" P9_C8_EVIDENCE_DIR="$post8" P9_PRIMARY_ADMIN_USERNAME="$primary_username" P9_PRIMARY_ADMIN_PASSWORD_FILE="$primary_password_file" P9_SECONDARY_ADMIN_USERNAME="$secondary_username" P9_SECONDARY_ADMIN_PASSWORD_FILE="$secondary_password_file" "$script_dir/verify-c8-payroll-payments" >/dev/null
jq -s -e '.[0].tenants==.[1].tenants' "$c8_dir/state-after-c8.json" "$post8/state-after-c8.json" >/dev/null || { echo 'post-restore C8 stable replay changed business facts' >&2; exit 1; }
printf 'c8-stable-replay\tpass\tstable-business-facts\n' >>"$events"

curl_result() { output=$1; shift; set -- --silent --show-error --connect-timeout 10 --max-time 45 --output "$output" --write-out '%{http_code}' "$@"; [ -z "$ca_bundle" ] || set -- --cacert "$ca_bundle" "$@"; curl "$@"; }
session_request() { method=$1; path=$2; cookies=$3; csrf=$4; payload=$5; output=$6; expected=$7; set -- --request "$method" --cookie "$cookies" --cookie-jar "$cookies"; [ -z "$csrf" ] || set -- "$@" -H "X-CSRF-Token: $csrf"; [ -z "$payload" ] || set -- "$@" -H 'Content-Type: application/json' --data-binary "@$payload"; actual=$(curl_result "$output" "$@" "$base_url$path"); case "$expected:$actual" in 204/409:204|204/409:409) ;; *) [ "$actual" = "$expected" ] || { echo "$method $path returned HTTP $actual, expected $expected" >&2; exit 1; };; esac; printf '%s' "$actual"; }
probe_actor() {
  actor=$1; index=$2; username=$3; password_file=$4
  cookies="$workspace/$actor.cookies"; csrf_body="$workspace/$actor-csrf.json"; [ "$(curl_result "$csrf_body" --cookie-jar "$cookies" "$base_url/auth/api/v1/csrf")" = 200 ] || { echo "$actor CSRF failed" >&2; exit 1; }; chmod 600 "$cookies"; csrf=$(jq -er .csrf_token "$csrf_body")
  jq -Rs --arg username "$username" '{username:$username,password:(rtrimstr("\n")|rtrimstr("\r"))}' "$password_file" >"$workspace/$actor-login-request.json"
  session_request POST /auth/api/v1/login "$cookies" "$csrf" "$workspace/$actor-login-request.json" "$workspace/$actor-login.json" 200 >/dev/null; rm -f "$workspace/$actor-login-request.json"
  session_request GET /auth/api/v1/session "$cookies" '' '' "$workspace/$actor-session.json" 200 >/dev/null; subject=$(jq -er .principal.subject_id "$workspace/$actor-session.json")
  for action in evidence-service.view evidence-service.download; do jq -n --arg subject "$subject" --arg action "$action" '{subject_id:$subject,audience:"evidence-service",action:$action}' >"$workspace/$actor-grant.json"; session_request POST /auth/api/v1/admin/grants "$cookies" "$csrf" "$workspace/$actor-grant.json" "$workspace/$actor-grant.out" 204/409 >/dev/null; done
  actual=$(curl_result "$workspace/$actor-authorize.out" --request POST --cookie "$cookies" --cookie-jar "$cookies" --data-urlencode "csrf_token=$csrf" "$base_url/gateway/authorize/evidence-service"); [ "$actual" = 303 ] || { echo "$actor Evidence authorization failed" >&2; exit 1; }
  file=$(jq -er ".tenants[$index].evidence.file_id" "$c6_dir/state-after-c6.json"); version=$(jq -er ".tenants[$index].evidence.version" "$c6_dir/state-after-c6.json"); expected_sha=$(jq -er ".tenants[$index].evidence.sha256" "$c6_dir/state-after-c6.json")
  jq -n '{disposition:"inline",delivery_mode:"direct",file_name:"p9-c9-restored-invoice.pdf"}' >"$workspace/$actor-access-request.json"
  session_request POST "/evidence/v1/files/$file/versions/$version/access-grants" "$cookies" "$csrf" "$workspace/$actor-access-request.json" "$workspace/$actor-access.json" 200 >/dev/null
  download_url=$(jq -er '.url|select(startswith("https://") or startswith("http://127.0.0.1:") or startswith("http://localhost:"))' "$workspace/$actor-access.json")
  [ "$(curl_result "$workspace/$actor-invoice.pdf" "$download_url")" = 200 ] || { echo "$actor restored Evidence download failed" >&2; exit 1; }
  [ "$(openssl dgst -sha256 -r "$workspace/$actor-invoice.pdf"|awk '{print $1}')" = "$expected_sha" ] || { echo "$actor restored Evidence bytes changed" >&2; exit 1; }
  printf '%s-evidence-bytes\tpass\t%s\n' "$actor" "$expected_sha" >>"$events"
  session_request GET '/auth/api/v1/open-api-usage?limit=100' "$cookies" '' '' "$workspace/$actor-usage.json" 200 >/dev/null
  key_id=$(jq -er ".tenants[$index].api_key.id" "$c5_dir/state-after-c5.json")
  jq -e --arg key "$key_id" --arg started "$probe_started_at" 'any(.items[];.key_id==$key and (.action=="open-api.reimbursement.read" or .action=="open-api.reimbursement.list") and .http_status==200 and .occurred_at >= $started)' "$workspace/$actor-usage.json" >/dev/null || { echo "$actor has no post-restore Open API continuation audit" >&2; exit 1; }
  printf '%s-continuation-write\tpass\topen-api-usage-audit\n' "$actor" >>"$events"
}
probe_actor primary 0 "$primary_username" "$primary_password_file"; probe_actor secondary 1 "$secondary_username" "$secondary_password_file"

captured_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ'); post7_sha=$(openssl dgst -sha256 -r "$post7/checksums.sha256"|awk '{print $1}'); post8_sha=$(openssl dgst -sha256 -r "$post8/checksums.sha256"|awk '{print $1}')
set --; phase=0; while [ "$phase" -le 8 ]; do eval dir=\$c${phase}_dir; eval c${phase}_sha=$(openssl dgst -sha256 -r "$dir/checksums.sha256"|awk '{print $1}'); phase=$((phase+1)); done
jq -n --arg captured "$captured_at" --arg project "$compose_project" --arg url "$base_url" --arg c0 "$c0_sha" --arg c1 "$c1_sha" --arg c2 "$c2_sha" --arg c3 "$c3_sha" --arg c4 "$c4_sha" --arg c5 "$c5_sha" --arg c6 "$c6_sha" --arg c7 "$c7_sha" --arg c8 "$c8_sha" --arg post7 "$post7_sha" --arg post8 "$post8_sha" --arg backup "$backup_id" --arg manifest "$backup_manifest_sha" --arg fingerprints "$fingerprint_sha" --slurpfile c6state "$c6_dir/state-after-c6.json" --slurpfile c7state "$post7/state-after-c7.json" --slurpfile c8state "$post8/state-after-c8.json" '
  {schema_version:1,scenario_id:"oms-v1-p9-full-composition-v1",phase:"C9",result:"pass",captured_at:$captured,
   deployment:{profile:"D1",compose_project:$project,public_url:$url,c0_checksums_sha256:$c0,c1_checksums_sha256:$c1,c2_checksums_sha256:$c2,c3_checksums_sha256:$c3,c4_checksums_sha256:$c4,c5_checksums_sha256:$c5,c6_checksums_sha256:$c6,c7_checksums_sha256:$c7,c8_checksums_sha256:$c8,post_c7_checksums_sha256:$post7,post_c8_checksums_sha256:$post8},
   backup:{id:$backup,checksums_sha256:$manifest,database_fingerprints_sha256:$fingerprints,consistency_mode:"public-ingress-quiesced-v1",database_count:15},
   recovery:{empty_target_restore:"pass",database_fingerprint_match:"pass",d1_health:"pass",evidence_bytes:"pass",stable_command_replay:"pass",continuation_write:"open_api_usage_audit"},
   tenants:[$c6state[0].tenants[] as $base | ($c7state[0].tenants[]|select(.tenant_id==$base.id)) as $paid | ($c8state[0].tenants[]|select(.tenant_id==$base.id)) as $payroll | {tenant_id:$base.id,evidence:($base.evidence+{bytes_match:true}),reimbursement:{id:$paid.reimbursement.id,status:$paid.reimbursement.status},payroll:{run_id:$payroll.payroll.run_id,line_id:$payroll.payroll.line_id,status:$payroll.payroll.status}}],
   checks:{pre_restore_chain_verified:"pass",post_restore_business_equivalence:"pass",backup_material_embedded:false,direct_database_write:false,secrets_recorded:false}}
' >"$workspace/state-after-c9.json"
cat >"$workspace/result.md" <<EOF
# P9 C9 recovery result

- Result: pass
- Captured at: $captured_at
- Backup: $backup_id, public ingress quiesced, fifteen database fingerprints matched after empty-target restore.
- Post-restore: D1 health, both invoice byte digests, C7/C8 stable-command replay and fresh Open API usage audit passed.
- Backup archives, database dumps, signing keys, credentials and signed URLs recorded in evidence: no
- Direct database write by the acceptance gate: no
EOF
mkdir -p "$(dirname -- "$evidence_dir")"; evidence_stage=$(mktemp -d "$(dirname -- "$evidence_dir")/.p9-c9-evidence.XXXXXX"); chmod 700 "$evidence_stage"
cp -R "$post7" "$evidence_stage/post-c7"; cp -R "$post8" "$evidence_stage/post-c8"; cp "$events" "$evidence_stage/recovery-events.tsv"; cp "$workspace/result.md" "$workspace/state-after-c9.json" "$evidence_stage/"; chmod 600 "$evidence_stage/recovery-events.tsv" "$evidence_stage/result.md" "$evidence_stage/state-after-c9.json"
: >"$evidence_stage/checksums.sha256"; for artifact in post-c7/checksums.sha256 post-c8/checksums.sha256 recovery-events.tsv result.md state-after-c9.json; do printf '%s  %s\n' "$(openssl dgst -sha256 -r "$evidence_stage/$artifact"|awk '{print $1}')" "$artifact" >>"$evidence_stage/checksums.sha256"; done
chmod 600 "$evidence_stage/checksums.sha256"; "$script_dir/verify-c9-evidence" "$evidence_stage" >/dev/null
[ ! -d "$evidence_dir" ] || rmdir "$evidence_dir"; mv "$evidence_stage" "$evidence_dir"; evidence_stage=
echo 'PASS P9 C9 joint backup, empty-target restore, byte recovery and continuation'
