#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tmp_root=$(printenv TMPDIR 2>/dev/null || printf /tmp)
runtime=$(mktemp -d "$tmp_root/oms-p9-c5-test.XXXXXX")
trap 'rm -rf -- "$runtime"' EXIT HUP INT TERM
mkdir -p "$runtime/bin"
artifact_dir=${P9_C5_TEST_ARTIFACT_DIR:-}

P9_C4_TEST_ARTIFACT_DIR="$runtime/fixture" "$script_dir/test-c4-finance-requests" >/dev/null
primary_password=$(cat "$runtime/fixture/primary.password")
secondary_password=$(cat "$runtime/fixture/secondary.password")
primary_secret='bfk_primary000_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'
secondary_secret='bfk_secondar00_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB'

cat >"$runtime/bin/curl" <<'MOCK'
#!/bin/sh
set -eu
output= cookie= cookie_jar= method=GET url= data_file= config=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output) output=$2; shift 2 ;;
    --config) config=$2; shift 2 ;;
    --write-out|--connect-timeout|--max-time|--request|--cookie|--cookie-jar|--cacert|-H|--data-binary|--data-urlencode)
      option=$1; value=$2
      case "$option" in
        --request) method=$value ;;
        --cookie) cookie=$value ;;
        --cookie-jar) cookie_jar=$value ;;
        --data-binary) data_file=${value#@} ;;
      esac
      shift 2
      ;;
    --silent|--show-error) shift ;;
    http://*|https://*) url=$1; shift ;;
    *) shift ;;
  esac
done
[ -n "$output" ] || exit 2
: >"$output"
if [ -n "$cookie_jar" ]; then printf '# mock cookie jar\n' >"$cookie_jar"; fi
actor=primary
case "$cookie$cookie_jar$config" in *secondary*) actor=secondary;; esac
status=200
path=$(printf '%s' "$url" | sed -E 's#^https?://[^/]+##')
primary_key_id=aaaaaaaa-8888-4888-8888-aaaaaaaaaaaa
secondary_key_id=bbbbbbbb-8888-4888-8888-bbbbbbbbbbbb
primary_subject_id=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
secondary_subject_id=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
primary_tenant_id=11111111-1111-4111-8111-111111111111
secondary_tenant_id=22222222-2222-4222-8222-222222222222
case "$method $path" in
  'GET /auth/api/v1/csrf') printf '{"csrf_token":"csrf-%s"}\n' "$actor" >"$output" ;;
  'POST /auth/api/v1/login') printf '{"principal":{"subject_id":"ok"}}\n' >"$output" ;;
  'GET /auth/api/v1/session')
    if [ "$actor" = primary ]; then printf '{"principal":{"tenant_id":"%s","subject_id":"%s"}}\n' "$primary_tenant_id" "$primary_subject_id" >"$output"
    else printf '{"principal":{"tenant_id":"%s","subject_id":"%s"}}\n' "$secondary_tenant_id" "$secondary_subject_id" >"$output"; fi
    ;;
  'POST /auth/api/v1/admin/grants')
    jq -e '.audience=="open-api" and (.action=="open-api.invoice-reimbursement.use" or .action=="open-api.key.manage" or .action=="open-api.self-audit.read")' "$data_file" >/dev/null || exit 2
    if [ -f "$P9_MOCK_REPLAY_STATE" ]; then status=409; printf '{"error":{"code":"conflict"}}\n' >"$output"; else status=204; fi
    ;;
  'POST /auth/api/v1/api-keys')
    [ ! -f "$P9_MOCK_REPLAY_STATE" ] || { echo 'replay attempted to create another API Key' >&2; exit 2; }
    jq -e '.ttl_days==180 and (.label|length)>0' "$data_file" >/dev/null || exit 2
    status=201
    if [ "$actor" = primary ]; then
      printf '{"id":"%s","label":"P9 C5 primary 连续验收","prefix":"bfk_primary000","status":"active","created_at":"2026-10-26T00:00:00Z","expires_at":"2027-04-24T00:00:00Z","secret":"bfk_primary000_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}\n' "$primary_key_id" >"$output"
    else
      printf '{"id":"%s","label":"P9 C5 secondary 连续验收","prefix":"bfk_secondar00","status":"active","created_at":"2026-10-26T00:00:00Z","expires_at":"2027-04-24T00:00:00Z","secret":"bfk_secondar00_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"}\n' "$secondary_key_id" >"$output"
    fi
    ;;
  'GET /auth/api/v1/api-keys')
    if [ "$actor" = primary ]; then printf '{"items":[{"id":"%s","label":"P9 C5 primary 连续验收","prefix":"bfk_primary000","status":"active","created_at":"2026-10-26T00:00:00Z","expires_at":"2027-04-24T00:00:00Z"}]}\n' "$primary_key_id" >"$output"
    else printf '{"items":[{"id":"%s","label":"P9 C5 secondary 连续验收","prefix":"bfk_secondar00","status":"active","created_at":"2026-10-26T00:00:00Z","expires_at":"2027-04-24T00:00:00Z"}]}\n' "$secondary_key_id" >"$output"; fi
    ;;
  'GET /open-api/v1/me')
    [ -f "$config" ] || exit 2
    if [ "$actor" = primary ]; then
      grep -Fq 'Authorization: ApiKey bfk_primary000_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' "$config" || exit 2
      printf '{"version":"v1","tenant_id":"%s","subject_id":"%s","key_id":"%s","key_prefix":"bfk_primary000","capabilities":["open-api.invoice-reimbursement.use"]}\n' "$primary_tenant_id" "$primary_subject_id" "$primary_key_id" >"$output"
    else
      grep -Fq 'Authorization: ApiKey bfk_secondar00_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB' "$config" || exit 2
      printf '{"version":"v1","tenant_id":"%s","subject_id":"%s","key_id":"%s","key_prefix":"bfk_secondar00","capabilities":["open-api.invoice-reimbursement.use"]}\n' "$secondary_tenant_id" "$secondary_subject_id" "$secondary_key_id" >"$output"
    fi
    ;;
  'GET /open-api/v1/settings') printf '{"webhook":{"available":false,"status":"not_available","callback_url_editable":false}}\n' >"$output" ;;
  'GET /auth/api/v1/open-api-usage?limit=20')
    if [ "$actor" = primary ]; then
      printf '{"items":[{"id":"aaaaaaaa-9991-4991-8991-aaaaaaaaaaaa","key_id":"%s","key_prefix":"bfk_primary000","subject_id":"%s","action":"open-api.settings.read","request_id":"request-primary-settings","source_ip_masked":"127.0.0.0/24","result_code":"OK","http_status":200,"occurred_at":"2026-10-26T00:02:00Z"},{"id":"aaaaaaaa-9992-4992-8992-aaaaaaaaaaaa","key_id":"%s","key_prefix":"bfk_primary000","subject_id":"%s","action":"open-api.profile.read","request_id":"request-primary-profile","source_ip_masked":"127.0.0.0/24","result_code":"OK","http_status":200,"occurred_at":"2026-10-26T00:01:00Z"}]}\n' "$primary_key_id" "$primary_subject_id" "$primary_key_id" "$primary_subject_id" >"$output"
    else
      printf '{"items":[{"id":"bbbbbbbb-9991-4991-8991-bbbbbbbbbbbb","key_id":"%s","key_prefix":"bfk_secondar00","subject_id":"%s","action":"open-api.settings.read","request_id":"request-secondary-settings","source_ip_masked":"127.0.0.0/24","result_code":"OK","http_status":200,"occurred_at":"2026-10-26T00:02:00Z"},{"id":"bbbbbbbb-9992-4992-8992-bbbbbbbbbbbb","key_id":"%s","key_prefix":"bfk_secondar00","subject_id":"%s","action":"open-api.profile.read","request_id":"request-secondary-profile","source_ip_masked":"127.0.0.0/24","result_code":"OK","http_status":200,"occurred_at":"2026-10-26T00:01:00Z"}]}\n' "$secondary_key_id" "$secondary_subject_id" "$secondary_key_id" "$secondary_subject_id" >"$output"
    fi
    ;;
  *) echo "unexpected mock curl request: $method $path" >&2; exit 2 ;;
esac
printf '%s 0.001' "$status"
MOCK
chmod 0755 "$runtime/bin/curl"

mkdir -p "$runtime/secrets"
chmod 0700 "$runtime/secrets"
run_c5() {
  target=$1
  env P9_MOCK_REPLAY_STATE="$runtime/replay" PATH="$runtime/bin:$PATH" \
    P9_C0_EVIDENCE_DIR="$runtime/fixture/c0" P9_C1_EVIDENCE_DIR="$runtime/fixture/c1" P9_C2_EVIDENCE_DIR="$runtime/fixture/c2" \
    P9_C3_EVIDENCE_DIR="$runtime/fixture/c3" P9_C4_EVIDENCE_DIR="$runtime/fixture/c4" P9_C5_EVIDENCE_DIR="$runtime/$target" \
    P9_C5_SECRET_DIR="$runtime/secrets" P9_PRIMARY_ADMIN_USERNAME=p9-primary P9_PRIMARY_ADMIN_PASSWORD_FILE="$runtime/fixture/primary.password" \
    P9_SECONDARY_ADMIN_USERNAME=p9-secondary P9_SECONDARY_ADMIN_PASSWORD_FILE="$runtime/fixture/secondary.password" \
    "$script_dir/verify-c5-api-keys" >"$runtime/$target.out"
}

run_c5 c5
grep -Fq 'PASS P9 C5' "$runtime/c5.out"
"$script_dir/verify-c5-evidence" "$runtime/c5" >/dev/null
jq -e '([.tenants[].api_key.provisioning]|all(.=="created")) and .checks.secrets_recorded==false and .checks.business_write_performed==false' "$runtime/c5/state-after-c5.json" >/dev/null
[ "$(cat "$runtime/secrets/primary.api-key")" = "$primary_secret" ]
[ "$(cat "$runtime/secrets/secondary.api-key")" = "$secondary_secret" ]
[ "$(stat -f '%Lp' "$runtime/secrets" 2>/dev/null || stat -c '%a' "$runtime/secrets")" = 700 ]

touch "$runtime/replay"
run_c5 c5-replay
"$script_dir/verify-c5-evidence" "$runtime/c5-replay" >/dev/null
jq -e '[.tenants[].api_key.provisioning]|all(.=="reused")' "$runtime/c5-replay/state-after-c5.json" >/dev/null
if grep -R -F "$primary_secret" "$runtime/c5" "$runtime/c5-replay" >/dev/null 2>&1 || grep -R -F "$secondary_secret" "$runtime/c5" "$runtime/c5-replay" >/dev/null 2>&1; then
  echo 'P9 C5 leaked an API Key secret into evidence' >&2
  exit 1
fi
if grep -R -F "$primary_password" "$runtime/c5" "$runtime/c5-replay" >/dev/null 2>&1 || grep -R -F "$secondary_password" "$runtime/c5" "$runtime/c5-replay" >/dev/null 2>&1; then
  echo 'P9 C5 leaked an administrator password into evidence' >&2
  exit 1
fi

tampered="$runtime/c5-tampered"; cp -R "$runtime/c5" "$tampered"; printf 'tamper\n' >>"$tampered/result.md"
if "$script_dir/verify-c5-evidence" "$tampered" >/dev/null 2>&1; then echo 'P9 C5 evidence verifier accepted digest drift' >&2; exit 1; fi

incomplete="$runtime/c5-incomplete"; cp -R "$runtime/c5" "$incomplete"
awk -F '\t' '$1!="GET secondary Open API settings"' "$incomplete/http-evidence.tsv" >"$incomplete/http.tmp"; mv "$incomplete/http.tmp" "$incomplete/http-evidence.tsv"
http_sha=$(openssl dgst -sha256 -r "$incomplete/http-evidence.tsv" | awk '{print $1}')
awk -v sha="$http_sha" '$2=="http-evidence.tsv" {$1=sha} {print $1"  "$2}' "$incomplete/checksums.sha256" >"$incomplete/checksums.tmp"; mv "$incomplete/checksums.tmp" "$incomplete/checksums.sha256"
if "$script_dir/verify-c5-evidence" "$incomplete" >/dev/null 2>&1; then echo 'P9 C5 evidence verifier accepted a recomputed but incomplete HTTP matrix' >&2; exit 1; fi

leaked="$runtime/c5-leaked"; cp -R "$runtime/c5" "$leaked"; printf '\n%s\n' "$primary_secret" >>"$leaked/result.md"
result_sha=$(openssl dgst -sha256 -r "$leaked/result.md" | awk '{print $1}')
awk -v sha="$result_sha" '$2=="result.md" {$1=sha} {print $1"  "$2}' "$leaked/checksums.sha256" >"$leaked/checksums.tmp"; mv "$leaked/checksums.tmp" "$leaked/checksums.sha256"
if "$script_dir/verify-c5-evidence" "$leaked" >/dev/null 2>&1; then echo 'P9 C5 evidence verifier accepted a recomputed API Key secret leak' >&2; exit 1; fi

if [ -n "$artifact_dir" ]; then
  [ ! -e "$artifact_dir" ] || { echo "P9 C5 test artifact directory already exists: $artifact_dir" >&2; exit 2; }
  mkdir -p "$artifact_dir/secrets"
  chmod 0700 "$artifact_dir/secrets"
  for phase in c0 c1 c2 c3 c4; do cp -R "$runtime/fixture/$phase" "$artifact_dir/$phase"; done
  cp -R "$runtime/c5" "$artifact_dir/c5"
  cp "$runtime/fixture/primary.password" "$artifact_dir/primary.password"
  cp "$runtime/fixture/secondary.password" "$artifact_dir/secondary.password"
  cp "$runtime/secrets/primary.api-key" "$runtime/secrets/primary.json" "$runtime/secrets/secondary.api-key" "$runtime/secrets/secondary.json" "$artifact_dir/secrets/"
  chmod 0600 "$artifact_dir/primary.password" "$artifact_dir/secondary.password" "$artifact_dir/secrets/"*
fi

echo 'PASS P9 C5 offline organization account API Key driver, rerun and evidence regression'
