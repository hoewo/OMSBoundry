#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tmp_root=$(printenv TMPDIR 2>/dev/null || printf /tmp); runtime=$(mktemp -d "$tmp_root/oms-p9-c6-test.XXXXXX")
trap 'rm -rf -- "$runtime"' EXIT HUP INT TERM
mkdir -p "$runtime/bin"; artifact_dir=${P9_C6_TEST_ARTIFACT_DIR:-}
P9_C5_TEST_ARTIFACT_DIR="$runtime/fixture" "$script_dir/test-c5-api-keys" >/dev/null
primary_secret=$(cat "$runtime/fixture/secrets/primary.api-key"); secondary_secret=$(cat "$runtime/fixture/secrets/secondary.api-key")

cat >"$runtime/bin/curl" <<'MOCK'
#!/bin/sh
set -eu
output= method=GET url= data_file= config= headers=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output) output=$2; shift 2;; --config) config=$2; shift 2;; --dump-header) headers=$2; shift 2;;
    --write-out|--connect-timeout|--max-time|--request|--cacert|-H|--data-binary)
      option=$1; value=$2; [ "$option" = --request ] && method=$value; [ "$option" = --data-binary ] && data_file=${value#@}; shift 2;;
    --silent|--show-error) shift;; http://*|https://*) url=$1; shift;; *) shift;;
  esac
done
[ -n "$output" ] || exit 2
if [ -z "$url" ] && [ -f "$config" ]; then url=$(sed -n 's/^url = "\(.*\)"$/\1/p' "$config"); fi
[ -n "$url" ] || exit 2
: >"$output"; [ -z "$headers" ] || : >"$headers"
actor=primary; case "$config$url" in *secondary*) actor=secondary;; esac
status=200; path=$(printf '%s' "$url" | sed -E 's#^https?://[^/]+##')
if [ "$actor" = primary ]; then
  tenant=11111111-1111-4111-8111-111111111111; person=aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa
  file=aaaaaaaa-aaaa-4aaa-8aaa-111111111111; session=aaaaaaaa-aaaa-4aaa-8aaa-222222222222; request=aaaaaaaa-aaaa-4aaa-8aaa-333333333333
  other_request=bbbbbbbb-bbbb-4bbb-8bbb-333333333333; prefix=bfk_primary000
else
  tenant=22222222-2222-4222-8222-222222222222; person=bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb
  file=bbbbbbbb-bbbb-4bbb-8bbb-111111111111; session=bbbbbbbb-bbbb-4bbb-8bbb-222222222222; request=bbbbbbbb-bbbb-4bbb-8bbb-333333333333
  other_request=aaaaaaaa-aaaa-4aaa-8aaa-333333333333; prefix=bfk_secondar00
fi
final=$(printf '{"id":"%s","tenant_id":"%s","applicant_subject_id":"subject","request_type":"reimbursement","title":"P9 C6 %s 员工发票报销","amount_minor":23456,"currency":"CNY","status":"payable","details":{"applicant":{"id":"%s","revision":1,"digest":"sha256:test","display_name":"P9 employee"},"payee":{"kind":"person","display_name":"P9 employee","bank_name":"P9 验收银行","account_last4":"7890"},"lines":[{"id":"%s","business_date":"2026-10-26","category_key":"travel","category_name":"差旅费","category_revision":1,"purpose":"P9 C6 双租户发票报销验收","amount_minor":23456,"evidence":[{"file_id":"%s","version":1,"purpose":"invoice"}],"invoice":{"code":"P9C6","number":"000001","issuer_name":"P9 虚构开票方","invoice_date":"2026-10-26","amount_minor":23456}}],"approval":{"policy":"not_required","status":"not_applicable","revision":1},"duplicate":{"status":"none"}},"approval_policy":"not_required","approval_status":"not_applicable","paid_minor":0,"allocated_minor":0,"overage_minor":0,"payment_unknown_count":0,"revision":2,"allowed_actions":["read","withdraw"]}' "$request" "$tenant" "$actor" "$person" "$session" "$file")
case "$method $path" in
  'POST /open-api/v1/evidence/upload-sessions')
    jq -e '.media_type=="application/pdf" and .size_bytes>0 and (.sha256|test("^[0-9a-f]{64}$")) and .client_context.purpose=="invoice"' "$data_file" >/dev/null || exit 2
    status=201; printf '{"session_id":"%s","authorization":{"upload_url":"https://upload.test/%s"}}\n' "$session" "$actor" >"$output";;
  'PUT /primary'|'PUT /secondary')
    [ -s "$data_file" ] && grep -Fq '%PDF-1.7' "$data_file" || exit 2; status=204; [ -z "$headers" ] || printf 'HTTP/1.1 204 No Content\r\nETag: "%s-etag"\r\n\r\n' "$actor" >"$headers";;
  "POST /open-api/v1/evidence/upload-sessions/$session/complete")
    jq -e '.observed_size_bytes>0 and (.observed_sha256|test("^[0-9a-f]{64}$")) and (.etag|length)>0' "$data_file" >/dev/null || exit 2
    printf '{"file_id":"%s","version":1,"validation_profile":"invoice-v1","security_status":"passed","status":"available"}\n' "$file" >"$output";;
  'POST /open-api/v1/reimbursements')
    jq -e --arg file "$file" '.title!="" and (.lines|length)==1 and .lines[0].amount_minor==23456 and .lines[0].evidence[0].file_id==$file and .payee.account_number=="6222020000007890"' "$data_file" >/dev/null || exit 2
    status=201; printf '{"id":"%s","revision":1,"status":"draft"}\n' "$request" >"$output";;
  "POST /open-api/v1/reimbursements/$request/submit") jq -e '.expected_revision==1 and .suspected_duplicate_acknowledged==false' "$data_file" >/dev/null || exit 2; printf '%s\n' "$final" >"$output";;
  "GET /open-api/v1/reimbursements/$request") printf '%s\n' "$final" >"$output";;
  "GET /open-api/v1/reimbursements/$other_request") status=404; printf '{"error":{"code":"FINANCE_REQUEST_NOT_FOUND"}}\n' >"$output";;
  'GET /open-api/v1/reimbursements?limit=20') printf '{"items":[%s]}\n' "$final" >"$output";;
  *) echo "unexpected mock curl request: $method $path" >&2; exit 2;;
esac
case "$path" in /open-api/*)
  [ -f "$config" ] || exit 2
  if [ "$actor" = primary ]; then grep -Fq 'Authorization: ApiKey bfk_primary000_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' "$config" || exit 2
  else grep -Fq 'Authorization: ApiKey bfk_secondar00_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB' "$config" || exit 2; fi;; esac
printf '%s 0.001' "$status"
MOCK
chmod 0755 "$runtime/bin/curl"

env PATH="$runtime/bin:$PATH" P9_C0_EVIDENCE_DIR="$runtime/fixture/c0" P9_C1_EVIDENCE_DIR="$runtime/fixture/c1" \
  P9_C2_EVIDENCE_DIR="$runtime/fixture/c2" P9_C3_EVIDENCE_DIR="$runtime/fixture/c3" P9_C4_EVIDENCE_DIR="$runtime/fixture/c4" \
  P9_C5_EVIDENCE_DIR="$runtime/fixture/c5" P9_C5_SECRET_DIR="$runtime/fixture/secrets" P9_C6_EVIDENCE_DIR="$runtime/c6" \
  "$script_dir/verify-c6-invoice-reimbursements" >"$runtime/c6.out"
grep -Fq 'PASS P9 C6' "$runtime/c6.out"; "$script_dir/verify-c6-evidence" "$runtime/c6" >/dev/null
jq -e '.phase=="C6" and ([.tenants[].reimbursement.status]|all(.=="payable")) and ([.tenants[].reimbursement.paid_minor]|all(.==0)) and .checks.money_written==false' "$runtime/c6/state-after-c6.json" >/dev/null
if grep -R -F "$primary_secret" "$runtime/c6" >/dev/null 2>&1 || grep -R -F "$secondary_secret" "$runtime/c6" >/dev/null 2>&1; then echo 'P9 C6 leaked an API Key into evidence' >&2; exit 1; fi

tampered="$runtime/c6-tampered"; cp -R "$runtime/c6" "$tampered"; printf 'tamper\n' >>"$tampered/result.md"
if "$script_dir/verify-c6-evidence" "$tampered" >/dev/null 2>&1; then echo 'P9 C6 evidence verifier accepted digest drift' >&2; exit 1; fi
incomplete="$runtime/c6-incomplete"; cp -R "$runtime/c6" "$incomplete"
awk -F '\t' '$1!="GET secondary cross-tenant reimbursement"' "$incomplete/http-evidence.tsv" >"$incomplete/http.tmp"; mv "$incomplete/http.tmp" "$incomplete/http-evidence.tsv"
http_sha=$(openssl dgst -sha256 -r "$incomplete/http-evidence.tsv" | awk '{print $1}')
awk -v sha="$http_sha" '$2=="http-evidence.tsv" {$1=sha} {print $1"  "$2}' "$incomplete/checksums.sha256" >"$incomplete/checksums.tmp"; mv "$incomplete/checksums.tmp" "$incomplete/checksums.sha256"
if "$script_dir/verify-c6-evidence" "$incomplete" >/dev/null 2>&1; then echo 'P9 C6 evidence verifier accepted a recomputed incomplete HTTP matrix' >&2; exit 1; fi
leaked="$runtime/c6-leaked"; cp -R "$runtime/c6" "$leaked"; printf '\n%s\n' "$primary_secret" >>"$leaked/result.md"
result_sha=$(openssl dgst -sha256 -r "$leaked/result.md" | awk '{print $1}')
awk -v sha="$result_sha" '$2=="result.md" {$1=sha} {print $1"  "$2}' "$leaked/checksums.sha256" >"$leaked/checksums.tmp"; mv "$leaked/checksums.tmp" "$leaked/checksums.sha256"
if "$script_dir/verify-c6-evidence" "$leaked" >/dev/null 2>&1; then echo 'P9 C6 evidence verifier accepted a recomputed API Key leak' >&2; exit 1; fi

if [ -n "$artifact_dir" ]; then
  [ ! -e "$artifact_dir" ] || { echo "P9 C6 test artifact directory already exists: $artifact_dir" >&2; exit 2; }
  mkdir -p "$artifact_dir/secrets"; chmod 0700 "$artifact_dir/secrets"
  for phase in c0 c1 c2 c3 c4 c5; do cp -R "$runtime/fixture/$phase" "$artifact_dir/$phase"; done
  cp -R "$runtime/c6" "$artifact_dir/c6"; cp "$runtime/fixture/primary.password" "$runtime/fixture/secondary.password" "$artifact_dir/"
  cp "$runtime/fixture/secrets/"* "$artifact_dir/secrets/"; chmod 0600 "$artifact_dir/primary.password" "$artifact_dir/secondary.password" "$artifact_dir/secrets/"*
fi
echo 'PASS P9 C6 offline invoice upload, reimbursement and evidence regression'
