#!/bin/sh
set -eu

[ "$#" -eq 1 ] || { echo 'usage: verify-c5-evidence EVIDENCE_DIR' >&2; exit 2; }
evidence_dir=$1
[ -d "$evidence_dir" ] || { echo "P9 C5 evidence directory not found: $evidence_dir" >&2; exit 2; }
for command_name in jq openssl; do
  command -v "$command_name" >/dev/null 2>&1 || { echo "$command_name is required" >&2; exit 2; }
done
[ -z "$(find "$evidence_dir" -type l -print -quit)" ] || { echo 'P9 C5 evidence must not contain symbolic links' >&2; exit 1; }

expected_entries='checksums.sha256
http-evidence.tsv
result.md
state-after-c5.json'
actual_entries=$(find "$evidence_dir" -mindepth 1 -maxdepth 1 -exec basename {} \; | sort)
[ "$actual_entries" = "$expected_entries" ] || { echo 'P9 C5 evidence directory does not contain the fixed artifact set' >&2; exit 1; }
expected_files='http-evidence.tsv
result.md
state-after-c5.json'
actual_files=$(awk 'NF!=2 || $1!~/^[0-9a-f]{64}$/ {exit 1} {print $2}' "$evidence_dir/checksums.sha256") || { echo 'P9 C5 checksum manifest is malformed' >&2; exit 1; }
[ "$actual_files" = "$expected_files" ] || { echo 'P9 C5 checksum manifest has an invalid file set' >&2; exit 1; }
while read -r expected artifact; do
  actual=$(openssl dgst -sha256 -r "$evidence_dir/$artifact" | awk '{print $1}')
  [ "$actual" = "$expected" ] || { echo "P9 C5 checksum mismatch for $artifact" >&2; exit 1; }
done <"$evidence_dir/checksums.sha256"

uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
jq -e --arg uuid "$uuid" '
  .schema_version==1 and .scenario_id=="oms-v1-p9-full-composition-v1" and .phase=="C5" and .result=="pass" and
  .deployment.profile=="D1" and
  ([.deployment.c0_checksums_sha256,.deployment.c1_checksums_sha256,.deployment.c2_checksums_sha256,.deployment.c3_checksums_sha256,.deployment.c4_checksums_sha256] | all(test("^[0-9a-f]{64}$"))) and
  (.tenants|length)==2 and (.tenants[0].id != .tenants[1].id) and
  (.tenants[0].person_id != .tenants[1].person_id) and (.tenants[0].api_key.id != .tenants[1].api_key.id) and
  all(.tenants[];
    (.id|test($uuid)) and (.person_id|test($uuid)) and (.api_key.id|test($uuid)) and
    (.api_key.prefix|test("^bfk_[A-Za-z0-9_-]{10}$")) and .api_key.status=="active" and
    .api_key.ttl_days==180 and (.api_key.provisioning=="created" or .api_key.provisioning=="reused")) and
  .checks.one_time_secret_externalized=="pass" and .checks.api_key_list_isolation=="pass" and
  .checks.open_api_identity_binding=="pass" and .checks.settings_webhook_placeholder=="pass" and
  .checks.self_usage_audit=="pass" and .checks.business_write_performed==false and .checks.secrets_recorded==false
' "$evidence_dir/state-after-c5.json" >/dev/null || { echo 'P9 C5 state has an invalid schema or failed check' >&2; exit 1; }

created_count=$(jq '[.tenants[].api_key | select(.provisioning=="created")] | length' "$evidence_dir/state-after-c5.json")
awk -F '\t' -v expected_create="$created_count" '
  NR==1 {if ($0!="request\texpected_status\tactual_status\ttime_seconds") exit 1; next}
  NF!=4 {exit 1}
  $4 !~ /^[0-9]+([.][0-9]+)?$/ {exit 1}
  $1=="GET /auth/api/v1/csrf" {csrf++}
  $1=="POST /auth/api/v1/login" {login++}
  $1=="GET /auth/api/v1/session" {session++}
  $1=="POST Open API grant" {grant++}
  $1=="POST primary API Key" {primary_create++}
  $1=="POST secondary API Key" {secondary_create++}
  $1=="GET primary API Key list" {primary_list++}
  $1=="GET secondary API Key list" {secondary_list++}
  $1=="GET primary Open API profile" {primary_profile++}
  $1=="GET secondary Open API profile" {secondary_profile++}
  $1=="GET primary Open API settings" {primary_settings++}
  $1=="GET secondary Open API settings" {secondary_settings++}
  $1=="GET primary Open API usage" {primary_usage++}
  $1=="GET secondary Open API usage" {secondary_usage++}
  $2==$3 {next}
  $2=="204/409" && ($3=="204" || $3=="409") {next}
  {exit 1}
  END {
    if (csrf!=2 || login!=2 || session!=2 || grant!=6 ||
        primary_list!=1 || secondary_list!=1 || primary_profile!=1 || secondary_profile!=1 ||
        primary_settings!=1 || secondary_settings!=1 || primary_usage!=1 || secondary_usage!=1 ||
        primary_create+secondary_create!=expected_create) exit 1
  }
' "$evidence_dir/http-evidence.tsv" || { echo 'P9 C5 HTTP evidence contains a failed or incomplete assertion matrix' >&2; exit 1; }

if grep -REq 'bfk_[A-Za-z0-9_-]{10}_[A-Za-z0-9_-]{32,64}' "$evidence_dir"; then
  echo 'P9 C5 evidence contains an API Key secret' >&2
  exit 1
fi

echo 'PASS P9 C5 evidence integrity, secret exclusion and assertion matrix'
