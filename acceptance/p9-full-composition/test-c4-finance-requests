#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tmp_root=$(printenv TMPDIR 2>/dev/null || printf /tmp)
runtime=$(mktemp -d "$tmp_root/oms-p9-c4-test.XXXXXX")
trap 'rm -rf -- "$runtime"' EXIT HUP INT TERM
mkdir -p "$runtime/bin"
artifact_dir=${P9_C4_TEST_ARTIFACT_DIR:-}

P9_C3_TEST_ARTIFACT_DIR="$runtime/fixture" "$script_dir/test-c3-payroll-periods" >/dev/null
primary_password=$(cat "$runtime/fixture/primary.password")
secondary_password=$(cat "$runtime/fixture/secondary.password")

cat >"$runtime/bin/curl" <<'MOCK'
#!/bin/sh
set -eu
output= cookie= cookie_jar= method=GET url= data_file=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output) output=$2; shift 2 ;;
    --write-out|--connect-timeout|--max-time|--request|--cookie|--cookie-jar|--cacert|-H|--data-binary|--data-urlencode)
      option=$1; value=$2
      case "$option" in
        --request) method=$value ;;
        --cookie) cookie=$value ;;
        --cookie-jar) cookie_jar=$value ;;
        --data-binary) data_file=${value#@} ;;
      esac
      shift 2
      ;;
    --silent|--show-error) shift ;;
    http://*|https://*) url=$1; shift ;;
    *) shift ;;
  esac
done
[ -n "$output" ] || exit 2
: >"$output"
if [ -n "$cookie_jar" ]; then printf '# mock cookie jar\n' >"$cookie_jar"; fi
actor=primary
case "$cookie$cookie_jar" in *secondary*) actor=secondary;; esac
status=200
path=$(printf '%s' "$url" | sed -E 's#^https?://[^/]+##')
primary_person='{"id":"aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa","tenant_id":"11111111-1111-4111-8111-111111111111","reference_code":"P9-C1-A","display_name":"P9 主租户成员","status":"active","revision":1}'
secondary_person='{"id":"bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb","tenant_id":"22222222-2222-4222-8222-222222222222","reference_code":"P9-C1-B","display_name":"P9 次租户成员","status":"active","revision":1}'
primary_digest=sha256:$(printf '%s\n' "$primary_person" | openssl dgst -sha256 -r | awk '{print $1}')
secondary_digest=sha256:$(printf '%s\n' "$secondary_person" | openssl dgst -sha256 -r | awk '{print $1}')
primary_final=$(printf '{"id":"aaaaaaaa-6666-4666-8666-aaaaaaaaaaaa","tenant_id":"11111111-1111-4111-8111-111111111111","applicant_subject_id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","request_type":"payment","title":"P9 C4 primary 验收供应商服务费","amount_minor":12345,"currency":"CNY","status":"payable","details":{"applicant":{"id":"aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa","revision":1,"digest":"%s","display_name":"P9 主租户成员"},"payee":{"kind":"one_time","entity_kind":"organization","display_name":"P9 C4 primary 验收供应商","bank_name":"P9 验收银行","account_last4":"7890"},"lines":[{"id":"aaaaaaaa-7777-4777-8777-aaaaaaaaaaaa","purpose":"P9 C4 双租户付款申请验收","amount_minor":12345}],"missing_evidence_acknowledged":true,"approval":{"policy":"not_required","status":"not_applicable","revision":1},"duplicate":{"status":"none"}},"approval_policy":"not_required","approval_status":"not_applicable","paid_minor":0,"allocated_minor":0,"overage_minor":0,"payment_unknown_count":0,"revision":2,"allowed_actions":["read","withdraw"]}' "$primary_digest")
secondary_final=$(printf '{"id":"bbbbbbbb-6666-4666-8666-bbbbbbbbbbbb","tenant_id":"22222222-2222-4222-8222-222222222222","applicant_subject_id":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb","request_type":"payment","title":"P9 C4 secondary 验收供应商服务费","amount_minor":12345,"currency":"CNY","status":"payable","details":{"applicant":{"id":"bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb","revision":1,"digest":"%s","display_name":"P9 次租户成员"},"payee":{"kind":"one_time","entity_kind":"organization","display_name":"P9 C4 secondary 验收供应商","bank_name":"P9 验收银行","account_last4":"7890"},"lines":[{"id":"bbbbbbbb-7777-4777-8777-bbbbbbbbbbbb","purpose":"P9 C4 双租户付款申请验收","amount_minor":12345}],"missing_evidence_acknowledged":true,"approval":{"policy":"not_required","status":"not_applicable","revision":1},"duplicate":{"status":"none"}},"approval_policy":"not_required","approval_status":"not_applicable","paid_minor":0,"allocated_minor":0,"overage_minor":0,"payment_unknown_count":0,"revision":2,"allowed_actions":["read","withdraw"]}' "$secondary_digest")
case "$method $path" in
  'GET /auth/api/v1/csrf') printf '{"csrf_token":"csrf-%s"}\n' "$actor" >"$output" ;;
  'POST /auth/api/v1/login') printf '{"principal":{"subject_id":"ok"}}\n' >"$output" ;;
  'GET /auth/api/v1/session')
    if [ "$actor" = primary ]; then printf '{"principal":{"tenant_id":"11111111-1111-4111-8111-111111111111","subject_id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"}}\n' >"$output"
    else printf '{"principal":{"tenant_id":"22222222-2222-4222-8222-222222222222","subject_id":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"}}\n' >"$output"; fi
    ;;
  'POST /auth/api/v1/admin/grants')
    if [ -f "$P9_MOCK_REPLAY_STATE" ]; then status=409; printf '{"error":{"code":"conflict"}}\n' >"$output"; else status=204; fi
    ;;
  'POST /gateway/authorize/people-groups'|'POST /gateway/authorize/internal-finance-requests') status=303 ;;
  'GET /people/api/v1/persons/aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa') printf '%s\n' "$primary_person" >"$output" ;;
  'GET /people/api/v1/persons/bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb') printf '%s\n' "$secondary_person" >"$output" ;;
  'POST /internal-finance/v1/finance-requests')
    jq -e '.request_type=="payment" and .amount_minor==12345 and .currency=="CNY" and .details.payee.kind=="one_time" and .details.payee.account_number!="" and (.details.lines|length)==1 and ((.details.lines[0].evidence // [])|length)==0' "$data_file" >/dev/null || exit 2
    if [ "$actor" = primary ]; then printf '{"id":"aaaaaaaa-6666-4666-8666-aaaaaaaaaaaa","revision":1,"status":"draft"}\n' >"$output"
    else printf '{"id":"bbbbbbbb-6666-4666-8666-bbbbbbbbbbbb","revision":1,"status":"draft"}\n' >"$output"; fi
    status=201
    ;;
  'POST /internal-finance/v1/finance-requests/aaaaaaaa-6666-4666-8666-aaaaaaaaaaaa/submit')
    jq -e '.expected_revision==1 and .missing_evidence_acknowledged==true' "$data_file" >/dev/null || exit 2
    if [ -f "$P9_MOCK_REPLAY_STATE" ]; then status=409; printf '{"error":{"code":"FINANCE_REQUEST_STATE_CONFLICT"}}\n' >"$output"; else printf '%s\n' "$primary_final" >"$output"; fi
    ;;
  'POST /internal-finance/v1/finance-requests/bbbbbbbb-6666-4666-8666-bbbbbbbbbbbb/submit')
    jq -e '.expected_revision==1 and .missing_evidence_acknowledged==true' "$data_file" >/dev/null || exit 2
    if [ -f "$P9_MOCK_REPLAY_STATE" ]; then status=409; printf '{"error":{"code":"FINANCE_REQUEST_STATE_CONFLICT"}}\n' >"$output"; else printf '%s\n' "$secondary_final" >"$output"; fi
    ;;
  'GET /internal-finance/v1/finance-requests/aaaaaaaa-6666-4666-8666-aaaaaaaaaaaa')
    if [ "$actor" = secondary ]; then status=404; printf '{"error":{"code":"FINANCE_REQUEST_NOT_FOUND"}}\n' >"$output"; else printf '%s\n' "$primary_final" >"$output"; fi
    ;;
  'GET /internal-finance/v1/finance-requests/bbbbbbbb-6666-4666-8666-bbbbbbbbbbbb')
    if [ "$actor" = primary ]; then status=404; printf '{"error":{"code":"FINANCE_REQUEST_NOT_FOUND"}}\n' >"$output"; else printf '%s\n' "$secondary_final" >"$output"; fi
    ;;
  'GET /internal-finance/v1/finance-requests')
    if [ "$actor" = primary ]; then printf '{"items":[%s]}\n' "$primary_final" >"$output"; else printf '{"items":[%s]}\n' "$secondary_final" >"$output"; fi
    ;;
  *) echo "unexpected mock curl request: $method $path" >&2; exit 2 ;;
esac
printf '%s 0.001' "$status"
MOCK
chmod 0755 "$runtime/bin/curl"

run_c4() {
  target=$1
  env P9_MOCK_REPLAY_STATE="$runtime/replay" PATH="$runtime/bin:$PATH" \
    P9_C0_EVIDENCE_DIR="$runtime/fixture/c0" P9_C1_EVIDENCE_DIR="$runtime/fixture/c1" P9_C2_EVIDENCE_DIR="$runtime/fixture/c2" P9_C3_EVIDENCE_DIR="$runtime/fixture/c3" \
    P9_C4_EVIDENCE_DIR="$runtime/$target" P9_PRIMARY_ADMIN_USERNAME=p9-primary P9_PRIMARY_ADMIN_PASSWORD_FILE="$runtime/fixture/primary.password" \
    P9_SECONDARY_ADMIN_USERNAME=p9-secondary P9_SECONDARY_ADMIN_PASSWORD_FILE="$runtime/fixture/secondary.password" \
    "$script_dir/verify-c4-finance-requests" >"$runtime/$target.out"
}

run_c4 c4
grep -Fq 'PASS P9 C4' "$runtime/c4.out"
"$script_dir/verify-c4-evidence" "$runtime/c4" >/dev/null
jq -e '.phase=="C4" and .checks.approval_not_required=="pass" and .checks.payment_facts_absent=="pass" and .checks.money_written==false' "$runtime/c4/state-after-c4.json" >/dev/null

touch "$runtime/replay"
run_c4 c4-replay
"$script_dir/verify-c4-evidence" "$runtime/c4-replay" >/dev/null
if grep -R -F "$primary_password" "$runtime/c4" "$runtime/c4-replay" >/dev/null 2>&1 || grep -R -F "$secondary_password" "$runtime/c4" "$runtime/c4-replay" >/dev/null 2>&1; then
  echo 'P9 C4 leaked an administrator password into evidence' >&2
  exit 1
fi

tampered="$runtime/c4-tampered"; cp -R "$runtime/c4" "$tampered"; printf 'tamper\n' >>"$tampered/result.md"
if "$script_dir/verify-c4-evidence" "$tampered" >/dev/null 2>&1; then echo 'P9 C4 evidence verifier accepted digest drift' >&2; exit 1; fi

incomplete="$runtime/c4-incomplete"; cp -R "$runtime/c4" "$incomplete"
awk -F '\t' '$1!="GET secondary cross-tenant Finance request"' "$incomplete/http-evidence.tsv" >"$incomplete/http.tmp"; mv "$incomplete/http.tmp" "$incomplete/http-evidence.tsv"
http_sha=$(openssl dgst -sha256 -r "$incomplete/http-evidence.tsv" | awk '{print $1}')
awk -v sha="$http_sha" '$2=="http-evidence.tsv" {$1=sha} {print $1"  "$2}' "$incomplete/checksums.sha256" >"$incomplete/checksums.tmp"; mv "$incomplete/checksums.tmp" "$incomplete/checksums.sha256"
if "$script_dir/verify-c4-evidence" "$incomplete" >/dev/null 2>&1; then echo 'P9 C4 evidence verifier accepted a recomputed but incomplete HTTP matrix' >&2; exit 1; fi

if [ -n "$artifact_dir" ]; then
  [ ! -e "$artifact_dir" ] || { echo "P9 C4 test artifact directory already exists: $artifact_dir" >&2; exit 2; }
  mkdir -p "$artifact_dir"
  for phase in c0 c1 c2 c3; do cp -R "$runtime/fixture/$phase" "$artifact_dir/$phase"; done
  cp -R "$runtime/c4" "$artifact_dir/c4"
  cp "$runtime/fixture/primary.password" "$artifact_dir/primary.password"
  cp "$runtime/fixture/secondary.password" "$artifact_dir/secondary.password"
  chmod 0600 "$artifact_dir/primary.password" "$artifact_dir/secondary.password"
fi

echo 'PASS P9 C4 offline Finance request driver and evidence regression'
