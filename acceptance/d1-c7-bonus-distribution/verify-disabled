#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
d1_dir="$repo_dir/deployments/d1"
enabled_env=${D1_ENV_FILE:-"$script_dir/d1.env.example"}
project=${D1_PROJECT_NAME:?set D1_PROJECT_NAME to the isolated D1 stack}
base_url=${D1_PUBLIC_URL:?set D1_PUBLIC_URL to the Nginx entry URL}
evidence_dir=${C7_D1_EVIDENCE_DIR:-"$d1_dir/.runtime/c7-d1-evidence"}
ids_file="$evidence_dir/ids.json"

workspace=$(mktemp -d "${TMPDIR:-/tmp}/oms-d1-c7-disabled.XXXXXX")
disabled_env="$workspace/d1-disabled.env"
sed 's/^ENABLE_BONUS_DISTRIBUTION=true$/ENABLE_BONUS_DISTRIBUTION=false/' "$enabled_env" >"$disabled_env"
grep -qx 'ENABLE_BONUS_DISTRIBUTION=false' "$disabled_env" || { echo 'failed to create disabled C7 selection' >&2; exit 1; }
restore_enabled() {
  status=$?
  trap - EXIT HUP INT TERM
  D1_ENV_FILE="$enabled_env" "$d1_dir/ops/d1" apply >/dev/null 2>&1 || true
  rm -rf "$workspace"
  exit "$status"
}
trap restore_enabled EXIT HUP INT TERM

D1_ENV_FILE="$disabled_env" "$d1_dir/ops/d1" apply
for service in bonus-distribution bonus-distribution-migrate bonus-distribution-workload-keys bonus-distribution-workload-key-permissions; do
  if docker container inspect "${project}-${service}-1" >/dev/null 2>&1; then
    echo "disabled C7 service is still present: $service" >&2
    exit 1
  fi
done
jq -e '.applications[] | select(.id == "bonus-distribution") | .enabled == false' "$d1_dir/.runtime/suite-manifest.json" >/dev/null

cookies="$workspace/admin.cookies"
status=$(curl --silent --show-error --output "$workspace/csrf.json" --write-out '%{http_code}' --cookie-jar "$cookies" "$base_url/auth/api/v1/csrf")
[ "$status" = 200 ] || { echo "disabled selection CSRF HTTP $status" >&2; exit 1; }
csrf=$(jq -er .csrf_token "$workspace/csrf.json")
username=$(awk -F= '$1=="BOOTSTRAP_ADMIN_USERNAME" {print $2}' "$enabled_env"); password=$(awk -F= '$1=="BOOTSTRAP_ADMIN_PASSWORD" {print $2}' "$enabled_env")
payload=$(jq -cn --arg username "$username" --arg password "$password" '{username:$username,password:$password}')
status=$(curl --silent --show-error --output "$workspace/login.json" --write-out '%{http_code}' --cookie "$cookies" --cookie-jar "$cookies" -H 'Content-Type: application/json' -H "X-CSRF-Token: $csrf" --data "$payload" "$base_url/auth/api/v1/login")
[ "$status" = 200 ] || { echo "disabled selection login HTTP $status" >&2; exit 1; }
curl --fail --silent --show-error --cookie "$cookies" "$base_url/workbench/" >"$workspace/workbench.html"
! grep -Fq '/gateway/authorize/bonus-distribution' "$workspace/workbench.html" || { echo 'disabled C7 still appears in Workbench' >&2; exit 1; }
status=$(curl --silent --show-error --output "$workspace/route.out" --write-out '%{http_code}' --cookie "$cookies" "$base_url/bonus/")
[ "$status" = 404 ] || { echo "disabled C7 route HTTP $status, expected 404" >&2; exit 1; }

sleep 1
backup_output=$(D1_ENV_FILE="$disabled_env" "$d1_dir/ops/d1" backup)
printf '%s\n' "$backup_output"
backup_id=$(printf '%s\n' "$backup_output" | sed -n 's/^backup created: \([^ ]*\).*/\1/p')
[ -n "$backup_id" ] || { echo 'disabled selection backup ID is missing' >&2; exit 1; }
backup_dir_value=$(awk -F= '$1=="D1_BACKUP_DIR" {sub(/^[^=]*=/,""); print}' "$disabled_env")
case "$backup_dir_value" in /*) backup_root="$backup_dir_value" ;; *) backup_root="$d1_dir/${backup_dir_value#./}" ;; esac
grep -qx 'ENABLE_BONUS_DISTRIBUTION=false' "$backup_root/$backup_id/suite-selection.env"
[ ! -e "$backup_root/$backup_id/bonus-distribution.dump" ] || { echo 'disabled backup unexpectedly contains C7 dump' >&2; exit 1; }

D1_ENV_FILE="$enabled_env" "$d1_dir/ops/d1" apply
project_id=$(jq -er .project_id "$ids_file")
production_pool=$(jq -er .production_pool_id "$ids_file")
status=$(curl --silent --show-error --output "$workspace/authorize.out" --write-out '%{http_code}' \
  --cookie "$cookies" --cookie-jar "$cookies" --data-urlencode "csrf_token=$csrf" \
  --data-urlencode resource_type=project --data-urlencode "resource_id=$project_id" \
  "$base_url/gateway/authorize/bonus-distribution")
[ "$status" = 303 ] || { echo "re-enabled C7 authorization HTTP $status" >&2; exit 1; }
status=$(curl --silent --show-error --output "$workspace/pools.json" --write-out '%{http_code}' --cookie "$cookies" "$base_url/bonus/api/v1/bonus-pools?project_id=$project_id")
[ "$status" = 200 ] || { echo "re-enabled C7 API HTTP $status" >&2; exit 1; }
jq -e --arg id "$production_pool" '(.items | length) == 2 and any(.items[]; .id == $id and .state == "withdrawn" and .revision == 3)' "$workspace/pools.json" >/dev/null || { echo 'C7 data did not survive disable and re-enable' >&2; exit 1; }

printf '%s\n' '# C7 D1 未选装缺席复验' '' '- Suite Manifest enabled=false。' '- Workbench 无入口，Gateway route 为 404，runtime、migration 与工作负载 key 容器均缺席。' '- 取消选装后的备份 selection=false 且无 bonus-distribution.dump。' '- 重新选装后恢复前数据仍在，生产 Pool 保持 withdrawn revision 3。' >"$evidence_dir/disabled-result.md"
cat "$evidence_dir/disabled-result.md"
trap - EXIT HUP INT TERM
rm -rf "$workspace"
