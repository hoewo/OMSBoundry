jq -e '(.items | length) == 2 and [.items[].event_kind] == ["drafted","published"]' "$workspace/production-history.json" >/dev/null
business_sha=$(jq -Sc '{id,tenant_id,bonus_type,state,project,source,policy,amount_minor,unallocated_minor,revision,allocations,supersedes,superseded_by}' "$workspace/business-published.json" | openssl dgst -sha256 -r | awk '{print $1}')
production_sha=$(jq -Sc '{id,tenant_id,bonus_type,state,project,source,policy,amount_minor,unallocated_minor,revision,allocations,supersedes,superseded_by}' "$workspace/production-published.json" | openssl dgst -sha256 -r | awk '{print $1}')
business_history_sha=$(jq -Sc . "$workspace/business-history.json" | openssl dgst -sha256 -r | awk '{print $1}')
production_history_sha=$(jq -Sc . "$workspace/production-history.json" | openssl dgst -sha256 -r | awk '{print $1}')
jq -cn --arg project_id "$project_id" --arg business_pool_id "$business_pool" --arg production_pool_id "$production_pool" --arg receipt_set_id "$receipt_set_id" --arg settlement_id "$settlement_id" '{project_id:$project_id,business_pool_id:$business_pool_id,production_pool_id:$production_pool_id,receipt_set_id:$receipt_set_id,settlement_id:$settlement_id}' >"$workspace/ids.json"
jq -cn --arg business_sha256 "$business_sha" --arg production_sha256 "$production_sha" --arg business_history_sha256 "$business_history_sha" --arg production_history_sha256 "$production_history_sha" '{business_sha256:$business_sha256,production_sha256:$production_sha256,business_history_sha256:$business_history_sha256,production_history_sha256:$production_history_sha256,pool_count:2,allocation_count:2}' >"$workspace/state.json"
assertions=$(awk -F '\t' 'NR>1 {count++} END {print count+0}' "$http_evidence"); mismatches=$(awk -F '\t' 'NR>1 && $2!=$3 {count++} END {print count+0}' "$http_evidence")
printf '%s\n' '# C7 D1 正式组合首次验证' '' "- HTTP 断言：$assertions" "- 状态不匹配：$mismatches" "- 经营 Pool：${business_pool}；生产 Pool：${production_pool}。" '- Nginx → Gateway → IAM → Bonus 正式入口、两类真实来源、独立数据库和精确工作负载审计通过。' '- C7 Capability Manifest 无 payable 行为；C8 未被装入。' '- 下一步：联合备份、空目标恢复、恢复后追加事实及未选装缺席。' >"$workspace/result.md"
[ "$mismatches" = 0 ] || { echo "HTTP mismatches=$mismatches" >&2; exit 1; }
cat "$workspace/result.md"
