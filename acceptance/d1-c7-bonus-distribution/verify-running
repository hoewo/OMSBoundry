production_publish='{"command_id":"c7d10000-0000-4000-8000-000000000053","expected_revision":1,"reason":"C7 D1 生产奖金确认"}'
request POST "$base_url/bonus/api/v1/bonus-pools/$production_pool/publication" "$admin_cookies" "$production_publish" "$workspace/production-published.json" 200 'POST production Bonus publication'
