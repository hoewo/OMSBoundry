echo '[6/7] 验证四类精确工作负载凭证审计'
printf 'audience\taction\tresource_type\tresource_id\taudit_count\n' >"$workspace/workload-audits.tsv"
assert_workload_audit project-workspace project-workspace.read project "$project_id"
assert_workload_audit people-groups people-groups.person.reference.read person "$business_person_id"
assert_workload_audit people-groups people-groups.person.reference.read person "$production_person_id"
assert_workload_audit contract-ledger contract-ledger.reference.read settlement "$settlement_id"
