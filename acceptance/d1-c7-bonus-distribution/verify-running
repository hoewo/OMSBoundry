business_pool=$(jq -er .id "$workspace/business-draft.json")
business_publish='{"command_id":"c7d10000-0000-4000-8000-000000000051","expected_revision":1,"reason":"C7 D1 经营奖金确认"}'
request POST "$base_url/bonus/api/v1/bonus-pools/$business_pool/publication" "$admin_cookies" "$business_publish" "$workspace/business-published.json" 200 'POST business Bonus publication'
jq -e --arg settlement "$settlement_id" '.state == "published" and .revision == 2 and .amount_minor == 10000 and .source.id == $settlement and .allocations[0].amount_minor == 10000' "$workspace/business-published.json" >/dev/null

echo '[5/7] 通过正式 C7 API 建立并发布生产奖金'
