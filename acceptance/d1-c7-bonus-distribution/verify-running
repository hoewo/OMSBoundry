receipt_set_id=$(jq -er .receipt_set.id "$workspace/receipt-set.json")
jq -e '.receipt_set.revision == 1 and .receipt_set.total_amount_minor == 106500 and (.receipt_set.items | length) == 1' "$workspace/receipt-set.json" >/dev/null
authorize_app bonus-distribution "$project_id" "$workspace/authorize-bonus-project.out"

echo '[4/7] 通过正式 C7 API 建立并发布经营奖金'
business_payload=$(jq -cn --arg command c7d10000-0000-4000-8000-000000000050 --arg project "$project_id" --arg settlement "$settlement_id" --arg person "$business_person_id" --arg assignment "$business_assignment_id" '{command_id:$command,project:{id:$project,revision:1},source:{settlement_id:$settlement,revision:1},policy:{key:"reference-oa-bonus-v1",version:"1.0.0",rate_basis_points:1000,rounding:"half_up"},allocations:[{person:{id:$person,revision:1},assignment:{id:$assignment,revision:1},ratio_basis_points:10000,reason:"经营参与"}]}')
