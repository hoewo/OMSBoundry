echo '[7/7] 固化恢复前 Pool／Allocation／来源快照和历史'
request GET "$base_url/bonus/api/v1/bonus-pools/$business_pool/history" "$admin_cookies" '' "$workspace/business-history.json" 200 'GET business Bonus history'
request GET "$base_url/bonus/api/v1/bonus-pools/$production_pool/history" "$admin_cookies" '' "$workspace/production-history.json" 200 'GET production Bonus history'
request GET "$base_url/bonus/api/v1/bonus-pools?project_id=$project_id" "$admin_cookies" '' "$workspace/pool-list.json" 200 'GET Bonus pools'
