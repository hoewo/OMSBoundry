#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
d1_dir="$repo_dir/deployments/d1"
env_file=${D1_ENV_FILE:-"$script_dir/d1.env.example"}
compose_project=${D1_PROJECT_NAME:?set D1_PROJECT_NAME to the isolated D1 stack}
base_url=${D1_PUBLIC_URL:?set D1_PUBLIC_URL to the Nginx entry URL}
evidence_dir=${C7_D1_EVIDENCE_DIR:-"$d1_dir/.runtime/c7-d1-evidence"}

for command in curl jq openssl docker awk sed; do
  command -v "$command" >/dev/null 2>&1 || { echo "$command is required" >&2; exit 2; }
done
[ -f "$env_file" ] || { echo "D1 environment file not found: $env_file" >&2; exit 2; }

env_value() {
  key=$1; fallback=${2:-}
  value=$(awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' "$env_file")
  if [ -n "$value" ]; then printf '%s' "$value"; else printf '%s' "$fallback"; fi
}
compose() {
  docker compose --project-name "$compose_project" --env-file "$env_file" \
    --file "$d1_dir/compose.yaml" --file "${D1_COMPOSE_OVERRIDE_FILE:?set D1_COMPOSE_OVERRIDE_FILE}" \
    --profile contract --profile money --profile people --profile project --profile bonus-distribution "$@"
}
new_uuid() {
  value=$(openssl rand -hex 16)
  printf '%s-%s-4%s-8%s-%s' "$(printf '%s' "$value" | cut -c1-8)" "$(printf '%s' "$value" | cut -c9-12)" \
    "$(printf '%s' "$value" | cut -c14-16)" "$(printf '%s' "$value" | cut -c18-20)" "$(printf '%s' "$value" | cut -c21-32)"
}
expect_status() { [ "$1" = "$2" ] || { echo "$3: HTTP $2, expected $1" >&2; exit 1; }; }
record_http() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$http_evidence"; }
request() {
  method=$1; url=$2; cookie=$3; payload=$4; output=$5; expected=$6; label=$7
  if [ -n "$payload" ]; then
    result=$(curl --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
      --request "$method" --cookie "$cookie" --cookie-jar "$cookie" -H 'Content-Type: application/json' --data "$payload" "$url")
  else
    result=$(curl --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
      --request "$method" --cookie "$cookie" --cookie-jar "$cookie" "$url")
  fi
  actual=${result%% *}; duration=${result#* }
  record_http "$label" "$expected" "$actual" "$duration"
  if [ "$actual" != "$expected" ] && [ "$output" != /dev/null ]; then cat "$output" >&2; printf '\n' >&2; fi
  expect_status "$expected" "$actual" "$label"
}
authorize_app() {
  app=$1; resource_id=${2:-}; output=$3
  if [ -n "$resource_id" ]; then
    result=$(curl --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
      --cookie "$admin_cookies" --cookie-jar "$admin_cookies" --data-urlencode "csrf_token=$admin_csrf" \
      --data-urlencode resource_type=project --data-urlencode "resource_id=$resource_id" \
      "$base_url/gateway/authorize/$app")
  else
    result=$(curl --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
      --cookie "$admin_cookies" --cookie-jar "$admin_cookies" --data-urlencode "csrf_token=$admin_csrf" \
      "$base_url/gateway/authorize/$app")
  fi
  actual=${result%% *}; duration=${result#* }
  record_http "POST /gateway/authorize/$app" 303 "$actual" "$duration"
  expect_status 303 "$actual" "authorize $app"
}
psql_database() {
  database=$1
  compose exec -T postgres psql --set=ON_ERROR_STOP=1 --username "$(env_value POSTGRES_SUPERUSER oms_admin)" --dbname "$database"
}
assert_workload_audit() {
  audience=$1; action=$2; resource_type=$3; resource_id=$4
  count=$(compose exec -T postgres sh -eu -c "psql -U \"\$POSTGRES_USER\" -d identity_access -At -c \"SELECT count(*) FROM iam_audit_entries WHERE action='iam_service_credential_issued' AND details->>'workload_id'='bonus-distribution' AND details->>'audience'='$audience' AND details->'actions' @> '[\\\"$action\\\"]'::jsonb AND details->'scope'->'resources' @> '[{\\\"type\\\":\\\"$resource_type\\\",\\\"id\\\":\\\"$resource_id\\\"}]'::jsonb\"")
  printf '%s\t%s\t%s\t%s\t%s\n' "$audience" "$action" "$resource_type" "$resource_id" "$count" >>"$workspace/workload-audits.tsv"
  [ "$count" -ge 1 ] || { echo "missing exact C7 workload audit: $audience/$action/$resource_type/$resource_id" >&2; exit 1; }
}

workspace=$(mktemp -d "${TMPDIR:-/tmp}/oms-d1-c7.XXXXXX")
http_evidence="$workspace/http-evidence.tsv"
printf 'request\texpected_status\tactual_status\ttime_seconds\n' >"$http_evidence"
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  mkdir -p "$evidence_dir"
  for artifact in http-evidence.tsv workload-audits.tsv ids.json state.json business-published.json production-published.json business-history.json production-history.json pool-list.json receipt-set.json workbench.html bonus.html bonus.js result.md; do
    [ ! -f "$workspace/$artifact" ] || cp "$workspace/$artifact" "$evidence_dir/$artifact"
  done
  rm -rf "$workspace"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

"$d1_dir/ops/grant-bootstrap-access" >/dev/null
admin_cookies="$workspace/admin.cookies"
request GET "$base_url/auth/api/v1/csrf" "$admin_cookies" '' "$workspace/admin-csrf.json" 200 'GET /auth/api/v1/csrf'
admin_csrf=$(jq -er .csrf_token "$workspace/admin-csrf.json")
payload=$(jq -cn --arg username "$(env_value BOOTSTRAP_ADMIN_USERNAME admin)" --arg password "$(env_value BOOTSTRAP_ADMIN_PASSWORD)" '{username:$username,password:$password}')
result=$(curl --silent --show-error --output "$workspace/admin-login.json" --write-out '%{http_code} %{time_total}' \
  --cookie "$admin_cookies" --cookie-jar "$admin_cookies" -H 'Content-Type: application/json' -H "X-CSRF-Token: $admin_csrf" \
  --data "$payload" "$base_url/auth/api/v1/login")
actual=${result%% *}; duration=${result#* }; record_http 'POST /auth/api/v1/login' 200 "$actual" "$duration"; expect_status 200 "$actual" 'login'
actor_id=$(jq -er .principal.subject_id "$workspace/admin-login.json")

echo '[1/7] 验证正式选择集、独立容器、Workbench、页面和边界排除'
manifest="$d1_dir/.runtime/suite-manifest.json"
for selected in contract-ledger money-flow-ledger people-groups project-workspace bonus-distribution; do
  jq -e --arg id "$selected" 'any(.applications[]; .id == $id and .enabled == true)' "$manifest" >/dev/null || { echo "$selected is not enabled" >&2; exit 1; }
done
for absent in party-directory evidence-service business-engagement billing-invoice production-operations approval-audit-results cost-outsourcing; do
  jq -e --arg id "$absent" 'any(.applications[]; .id == $id and .enabled == false)' "$manifest" >/dev/null || { echo "$absent is not disabled" >&2; exit 1; }
done
for service in bonus-distribution bonus-distribution-migrate bonus-distribution-workload-keys bonus-distribution-workload-key-permissions; do
  [ -n "$(compose ps --all --quiet "$service")" ] || { echo "$service is missing from the selected D1 composition" >&2; exit 1; }
done
authorize_app bonus-distribution '' "$workspace/authorize-unscoped.out"
request GET "$base_url/workbench/" "$admin_cookies" '' "$workspace/workbench.html" 200 'GET /workbench/'
grep -Fq '/gateway/authorize/bonus-distribution' "$workspace/workbench.html" || { echo 'Bonus is missing from Workbench' >&2; exit 1; }
request GET "$base_url/bonus/" "$admin_cookies" '' "$workspace/bonus.html" 200 'GET /bonus/'
grep -Fq '奖金分配' "$workspace/bonus.html" || { echo 'Bonus page marker is missing' >&2; exit 1; }
request GET "$base_url/bonus/assets/bonus-distribution.js" "$admin_cookies" '' "$workspace/bonus.js" 200 'GET Bonus browser asset'
for marker in 'allowed_actions' 'supersession' 'gatewayMode'; do grep -Fq "$marker" "$workspace/bonus.js" || { echo "Bonus browser marker is missing: $marker" >&2; exit 1; }; done
for action in bonus-payable-suggestion.create bonus-payable-suggestion.read bonus-payable-suggestion.withdraw; do
  jq -e --arg action "$action" 'any(.capabilities[]; .id == $action)' "$repo_dir/contracts/access/v1/examples/bonus-distribution-capabilities.json" >/dev/null || {
    echo "Bonus payable capability is missing: $action" >&2
    exit 1
  }
done

echo '[2/7] 在来源应用自己的数据库建立精确已确认事实'
tenant_id=$(env_value TENANT_ID)
