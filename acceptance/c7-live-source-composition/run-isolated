request POST http://127.0.0.1:19205/api/v1/bonus-pools/production-drafts "$bonus_token" "$production_payload" "$runtime/production-draft.json" 201
production_pool=$(jq -er .id "$runtime/production-draft.json")
jq -e '.bonus_type == "production" and .state == "draft" and .amount_minor == 10000 and .source.id == "'$receipt_set_id'" and .source.items[0].transaction_revision == 1 and .allocations[0].person.id == "'$production_person_id'"' "$runtime/production-draft.json" >/dev/null
production_publish=$(jq -cn '{command_id:"c7000000-0000-4000-8000-000000000053",expected_revision:1,reason:"C7 生产奖金确认"}')
request POST "http://127.0.0.1:19205/api/v1/bonus-pools/$production_pool/publication" "$bonus_token" "$production_publish" "$runtime/production-published.json" 200
jq -e '.state == "published" and .revision == 2' "$runtime/production-published.json" >/dev/null

# A human correction starts as a new draft. First prove a source outage yields no partial facts.
replacement_payload=$(jq -cn --arg command c7000000-0000-4000-8000-000000000054 --arg project "$project_id" --arg settlement "$settlement_id" --arg person "$business_person_id" --arg assignment "$business_assignment_id" '{command_id:$command,project:{id:$project,revision:1},source:{settlement_id:$settlement,revision:1},policy:{key:"reference-oa-bonus-v1",version:"1.0.0",rate_basis_points:1000,rounding:"half_up"},allocations:[{person:{id:$person,revision:1},assignment:{id:$assignment,revision:1},ratio_basis_points:10000,reason:"经营参与纠错"}]}')
kill "$contract_pid"
wait "$contract_pid" >/dev/null 2>&1 || true
request POST http://127.0.0.1:19205/api/v1/bonus-pools/business-drafts "$bonus_token" "$replacement_payload" "$runtime/business-dependency-failure.json" 503
jq -e '.error.code == "REFERENCE_SERVICE_UNAVAILABLE" and .error.retryable == true' "$runtime/business-dependency-failure.json" >/dev/null
[ "$(docker exec "$container" psql -U postgres -d bonus -At -c 'SELECT count(*) FROM bonus_pools')" = 2 ]

start contract_recovery env HTTP_ADDR=127.0.0.1:19203 DATABASE_URL='postgres://postgres:postgres@127.0.0.1:55468/contract?sslmode=disable' \
  MIGRATION_MODE=auto IDENTITY_PROVIDER=iam IAM_ISSUER="$issuer" IAM_TENANT_ID="$tenant_id" IAM_PUBLIC_KEYS_PATH="$runtime/iam-public.json" \
  EVIDENCE_STORAGE_DIR="$runtime/contract-evidence" \
  "$runtime/contract-ledger"
wait_http http://127.0.0.1:19203/health/ready
request POST http://127.0.0.1:19205/api/v1/bonus-pools/business-drafts "$bonus_token" "$replacement_payload" "$runtime/business-replacement.json" 201
replacement_pool=$(jq -er .id "$runtime/business-replacement.json")
jq -e '.state == "draft" and .revision == 1 and .amount_minor == 10000 and .allocations[0].reason == "经营参与纠错"' "$runtime/business-replacement.json" >/dev/null

supersession_payload=$(jq -cn --arg published "$business_pool" --arg replacement "$replacement_pool" '{command_id:"c7000000-0000-4000-8000-000000000055",published_pool_id:$published,expected_published_revision:2,replacement_pool_id:$replacement,expected_replacement_revision:1,reason:"C7 人工纠错验证"}')
request POST http://127.0.0.1:19205/api/v1/bonus-pools/supersession "$bonus_token" "$supersession_payload" "$runtime/business-supersession.json" 200
jq -e --arg old "$business_pool" --arg replacement "$replacement_pool" '.superseded.id == $old and .superseded.state == "superseded" and .superseded.revision == 3 and .superseded.superseded_by.pool_id == $replacement and .published.id == $replacement and .published.state == "published" and .published.revision == 2 and .published.supersedes.pool_id == $old' "$runtime/business-supersession.json" >/dev/null

withdraw_payload=$(jq -cn '{command_id:"c7000000-0000-4000-8000-000000000056",expected_revision:2,reason:"C7 生产奖金撤回验证"}')
request POST "http://127.0.0.1:19205/api/v1/bonus-pools/$production_pool/withdrawal" "$bonus_token" "$withdraw_payload" "$runtime/production-withdrawn.json" 200
jq -e '.state == "withdrawn" and .revision == 3' "$runtime/production-withdrawn.json" >/dev/null

request GET "http://127.0.0.1:19205/api/v1/bonus-pools/$business_pool/history" "$bonus_token" '' "$runtime/business-history.json" 200
request GET "http://127.0.0.1:19205/api/v1/bonus-pools/$replacement_pool/history" "$bonus_token" '' "$runtime/replacement-history.json" 200
request GET "http://127.0.0.1:19205/api/v1/bonus-pools/$production_pool/history" "$bonus_token" '' "$runtime/production-history.json" 200
jq -e '(.items|length) == 3 and .items[-1].event_kind == "superseded"' "$runtime/business-history.json" >/dev/null
jq -e '(.items|length) == 2 and .items[-1].event_kind == "published"' "$runtime/replacement-history.json" >/dev/null
jq -e '(.items|length) == 3 and .items[-1].event_kind == "withdrawn"' "$runtime/production-history.json" >/dev/null
request GET "http://127.0.0.1:19205/api/v1/bonus-pools?project_id=$project_id" "$bonus_token" '' "$runtime/pool-list.json" 200
jq -e '(.items|length) == 3 and ([.items[].state]|sort) == ["published","superseded","withdrawn"] and (.allowed_actions|index("bonus-pool.business.calculate")) != null and (.allowed_actions|index("bonus-pool.production.calculate")) != null' "$runtime/pool-list.json" >/dev/null

docker exec "$container" psql -U postgres -d bonus -AtF '|' -c "SELECT count(*),count(*) FILTER (WHERE state='published'),count(*) FILTER (WHERE state='superseded'),count(*) FILTER (WHERE state='withdrawn'),count(DISTINCT bonus_type),count(DISTINCT project_id) FROM bonus_pools" >"$runtime/bonus-facts.tsv"
grep -Eq '^3\|1\|1\|1\|2\|1$' "$runtime/bonus-facts.tsv"
docker exec "$container" psql -U postgres -d people -AtF '|' -c 'SELECT count(*) FROM persons' >"$runtime/source-facts.tsv"
docker exec "$container" psql -U postgres -d project -AtF '|' -c "SELECT count(*) FROM projects" >>"$runtime/source-facts.tsv"
docker exec "$container" psql -U postgres -d contract -AtF '|' -c 'SELECT count(*) FROM contract_settlements' >>"$runtime/source-facts.tsv"
docker exec "$container" psql -U postgres -d money -AtF '|' -c 'SELECT count(*) FROM receipt_sets' >>"$runtime/source-facts.tsv"
[ "$(tr '\n' ' ' <"$runtime/source-facts.tsv")" = '2 1 1 1 ' ]

printf 'service\tpid\tport\tdatabase\n' >"$runtime/processes.tsv"
printf 'identity-access\t%s\t19200\tidentity\nproject-workspace\t%s\t19201\tproject\npeople-groups\t%s\t19202\tpeople\ncontract-ledger\t%s\t19203\tcontract\nmoney-flow-ledger\t%s\t19204\tmoney\nbonus-distribution\t%s\t19205\tbonus\npostgresql\tdocker:%s\t55468\tsix independent databases\n' "$iam_pid" "$project_pid" "$people_pid" "$contract_recovery_pid" "$money_pid" "$bonus_pid" "$container" >>"$runtime/processes.tsv"

printf '%s\n' \
  '# C7 真实来源独立进程组合结果' '' \
  '- 真实 IAM、Project、People、Contract、Money 与 Bonus 作为六个进程启动，并各自使用独立数据库。' \
  '- Bonus 通过 IAM 工作负载交换获得单 action、精确 resource 凭证；没有静态来源令牌。' \
  '- 人类工作台根页面、同源脚本和 Gateway 相对路径策略已装入；无凭证读取真实 API 返回 401。' \
  '- 经营奖金从真实 Settlement／Person／Assignment 建立并发布；生产奖金从真实 Receipt Set／Person／Assignment 建立并发布。' \
  '- 两个 1065.00 CNY 来源按 reference-oa-bonus-v1 计算为 100.00 CNY，金额使用整数最小单位。' \
  '- Contract 停机时替代草稿返回可恢复 503 且奖池仍为 2 条；恢复后同一业务输入建立一次替代草稿。' \
  '- 经营旧奖池与新草稿完成原子 supersession，双向关系和三段历史可读；生产奖池显式撤回并保留三段历史。' \
  '- 本轮不包含正式 D1、联合备份恢复或 Money 应付建议。' >"$runtime/result.md"
cat "$runtime/result.md"

if [ "${C7_HOLD_AFTER_ASSERTIONS:-false}" = true ]; then
  # The token stays inside the disposable runtime and is never copied into evidence.
  printf '%s' "$bonus_token" >"$runtime/browser-token"
  printf 'C7_BROWSER_URL=http://127.0.0.1:19205/?project_id=%s\n' "$project_id"
  printf 'C7_BROWSER_TOKEN_FILE=%s/browser-token\n' "$runtime"
  while :; do sleep 5; done
fi
