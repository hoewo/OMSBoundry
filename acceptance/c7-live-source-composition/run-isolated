container="oms-c7-live-pg18-$$"
evidence_dir=${C7_EVIDENCE_DIR:-"$repo_dir/deployments/d1/.runtime/c7-live-source-evidence"}
service_pids=''

# A failed rerun must not leave prior artifacts looking like current evidence.
rm -rf "$evidence_dir"
mkdir -p "$evidence_dir"

cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  for pid in $service_pids; do kill "$pid" >/dev/null 2>&1 || true; done
  for pid in $service_pids; do wait "$pid" >/dev/null 2>&1 || true; done
  docker rm -f "$container" >/dev/null 2>&1 || true
  mkdir -p "$evidence_dir"
  for artifact in processes.tsv http-evidence.tsv money-migration.json workspace.html workspace.js unauthenticated.json receipt-set.json business-draft.json business-published.json production-draft.json production-published.json business-dependency-failure.json business-replacement.json business-supersession.json production-withdrawn.json business-history.json replacement-history.json production-history.json pool-list.json source-facts.tsv bonus-facts.tsv result.md iam.log project.log people.log contract.log contract_recovery.log money.log bonus.log; do
    [ ! -f "$runtime/$artifact" ] || cp "$runtime/$artifact" "$evidence_dir/$artifact"
  done
  rm -rf "$runtime"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

for command in go docker curl jq openssl; do
  command -v "$command" >/dev/null 2>&1 || { echo "$command is required" >&2; exit 2; }
done

build() { (cd "$repo_dir" && go build -o "$runtime/$1" "$2"); }
