admin_subject=$(curl --silent --fail --cookie "$admin_cookies" http://127.0.0.1:19200/api/v1/session | jq -er .principal.subject_id)
grant() {
  audience=$1; action=$2; scope_json=${3:-}
  if [ -n "$scope_json" ]; then
    payload=$(jq -cn --arg subject "$admin_subject" --arg audience "$audience" --arg action "$action" --argjson scope "$scope_json" '{subject_id:$subject,audience:$audience,action:$action,scope:$scope}')
  else
    payload=$(jq -cn --arg subject "$admin_subject" --arg audience "$audience" --arg action "$action" '{subject_id:$subject,audience:$audience,action:$action}')
  fi
  curl --silent --fail --cookie "$admin_cookies" -H 'Content-Type: application/json' -H "X-CSRF-Token: $csrf" --data "$payload" http://127.0.0.1:19200/api/v1/admin/grants >/dev/null
}
