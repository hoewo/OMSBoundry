done
credential() {
  audience=$1; scope_json=${2:-}
  if [ -n "$scope_json" ]; then payload=$(jq -cn --arg audience "$audience" --argjson scope "$scope_json" '{audience:$audience,scope:$scope}'); else payload=$(jq -cn --arg audience "$audience" '{audience:$audience}'); fi
  curl --silent --fail --cookie "$admin_cookies" -H 'Content-Type: application/json' -H "X-CSRF-Token: $csrf" --data "$payload" http://127.0.0.1:19200/api/v1/credentials | jq -er .token
}
