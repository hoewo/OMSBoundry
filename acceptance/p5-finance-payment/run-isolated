#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo=$(CDPATH= cd -- "$script_dir/../.." && pwd)
runtime=$(mktemp -d "${TMPDIR:-/tmp}/oms-p5-finance.XXXXXX")
container="oms-p5-finance-pg18-$$"
evidence_dir=${P5_FINANCE_EVIDENCE_DIR:-"$repo/deployments/d1/.runtime/p5-finance-payment-evidence"}
service_pids=''

cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  for pid in $service_pids; do kill "$pid" >/dev/null 2>&1 || true; done
  for pid in $service_pids; do wait "$pid" >/dev/null 2>&1 || true; done
  docker rm -f "$container" >/dev/null 2>&1 || true
  mkdir -p "$evidence_dir"
  for artifact in http-evidence.tsv result.md money-facts.tsv audit-facts.tsv restore-facts.tsv finance.log money.log request-created.json request-submitted.json request-partial.json request-final.json overage-required.json batch-result.json ordinary-export.json sensitive-purpose-required.json sensitive-export.json; do
    [ ! -f "$runtime/$artifact" ] || cp "$runtime/$artifact" "$evidence_dir/$artifact"
  done
  rm -rf "$runtime"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

for command_name in go docker curl jq lsof; do
  command -v "$command_name" >/dev/null 2>&1 || { echo "$command_name is required" >&2; exit 2; }
done
for port in 19331 19332; do
  ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 || { echo "port $port is already in use" >&2; exit 2; }
done

echo '[1/8] 构建 Finance、Money 及运维命令（限制并行度）'
(cd "$repo/backend/services/internal-finance-requests" && GOMAXPROCS=2 GOWORK=off go build -p 1 -o "$runtime/finance" ./cmd/server && GOMAXPROCS=2 GOWORK=off go build -p 1 -o "$runtime/finance-ops" ./cmd/ops)
(cd "$repo/backend/services/money-flow-ledger" && GOMAXPROCS=2 GOWORK=off go build -p 1 -o "$runtime/money" ./cmd/server && GOMAXPROCS=2 GOWORK=off go build -p 1 -o "$runtime/money-ops" ./cmd/ops)

echo '[2/8] 启动临时 PostgreSQL 18 并迁移两个独立数据库'
docker run --detach --name "$container" -e POSTGRES_PASSWORD=postgres -p 127.0.0.1::5432 postgres:18.6-alpine >/dev/null
for attempt in $(seq 1 60); do
  docker exec "$container" pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1 && break
  [ "$attempt" -lt 60 ] || { docker logs "$container" >&2; exit 1; }
  sleep 1
done
postgres_port=$(docker port "$container" 5432/tcp | sed 's/.*://')
docker exec "$container" createdb -h 127.0.0.1 -U postgres finance
docker exec "$container" createdb -h 127.0.0.1 -U postgres money
finance_database="postgres://postgres:postgres@127.0.0.1:$postgres_port/finance?sslmode=disable"
money_database="postgres://postgres:postgres@127.0.0.1:$postgres_port/money?sslmode=disable"

tenant=11111111-1111-4111-8111-111111111111
actor=22222222-2222-4222-8222-222222222222
applicant=33333333-3333-4333-8333-333333333333
owner_party=95000000-0000-4000-8000-000000000010
finance_token=p5-finance-template-token-12345
money_token=p5-money-reference-token-1234567

DATABASE_URL="$finance_database" "$runtime/finance-ops" migrate >/dev/null
DATABASE_URL="$money_database" "$runtime/money-ops" migrate >/dev/null
docker exec -i "$container" psql -h 127.0.0.1 -v ON_ERROR_STOP=1 -U postgres -d money <<SQL
INSERT INTO parties(id,kind,legal_name,revision,created_at,updated_at)
VALUES ('$owner_party','organization','P5 验收公司',1,now(),now());
SQL
DATABASE_URL="$money_database" "$runtime/money-ops" internal-finance-owner-set \
  --command-id 95000000-0000-4000-8000-000000000011 \
  --tenant-id "$tenant" --local-party-id "$owner_party" \
  --actor-kind iam_subject --actor-id "$actor" --actor-display-name 'P5 资金经办人' \
  --reason 'P5 财务申请账簿主体复核' >"$runtime/owner-setting.json"

echo '[3/8] 启动最小两个 Owner 并建立 Finance → Money 版本化通道'
HTTP_ADDR=127.0.0.1:19331 DATABASE_URL="$money_database" MIGRATION_MODE=verify IDENTITY_PROVIDER=local \
  BOOTSTRAP_ADMIN_USERNAME=p5-money-admin BOOTSTRAP_ADMIN_DISPLAY_NAME='P5 资金经办人' \
  BOOTSTRAP_ADMIN_PASSWORD='p5-money-acceptance-password-2026' \
  REFERENCE_TENANT_ID="$tenant" REFERENCE_ACCESS_TOKEN="$money_token" \
  "$runtime/money" >"$runtime/money.log" 2>&1 &
money_pid=$!
service_pids="$money_pid"

wait_http() {
  url=$1; log=$2
  for attempt in $(seq 1 60); do
    curl -fsS "$url" >/dev/null 2>&1 && return 0
    [ "$attempt" -lt 60 ] || { sed -n '1,180p' "$log" >&2; exit 1; }
    sleep 1
  done
}
wait_http http://127.0.0.1:19331/health/ready "$runtime/money.log"

HTTP_ADDR=127.0.0.1:19332 DATABASE_URL="$finance_database" MIGRATION_MODE=verify IDENTITY_PROVIDER=template \
  TEMPLATE_TENANT_ID="$tenant" TEMPLATE_SUBJECT_ID="$actor" TEMPLATE_DISPLAY_NAME='P5 财务经办人' \
  TEMPLATE_ACCESS_TOKEN="$finance_token" MONEY_BASE_URL=http://127.0.0.1:19331 MONEY_ACCESS_TOKEN="$money_token" \
  "$runtime/finance" >"$runtime/finance.log" 2>&1 &
finance_pid=$!
service_pids="$service_pids $finance_pid"
wait_http http://127.0.0.1:19332/health/ready "$runtime/finance.log"

printf 'request\texpected\tactual\n' >"$runtime/http-evidence.tsv"
request() {
  method=$1; url=$2; token=$3; payload=$4; output=$5; expected=$6
  if [ -n "$payload" ]; then
    actual=$(curl -sS -o "$output" -w '%{http_code}' -X "$method" -H "Authorization: Bearer $token" -H 'Content-Type: application/json' --data "$payload" "$url")
  else
    actual=$(curl -sS -o "$output" -w '%{http_code}' -X "$method" -H "Authorization: Bearer $token" "$url")
  fi
  printf '%s %s\t%s\t%s\n' "$method" "$url" "$expected" "$actual" >>"$runtime/http-evidence.tsv"
  [ "$actual" = "$expected" ] || { sed -n '1,180p' "$output" >&2; exit 1; }
}

echo '[4/8] 新建并提交付款申请；审批占位默认无需审批'
create_payload=$(jq -cn --arg applicant "$applicant" '{
  command_id:"95000000-0000-4000-8000-000000000021",
  request_type:"payment",title:"P5 供应商服务费",amount_minor:10000,currency:"CNY",
  details:{
    applicant:{id:$applicant,revision:1,digest:("sha256:"+("1"*64)),display_name:"P5 申请人"},
    payee:{kind:"one_time",entity_kind:"organization",display_name:"P5 临时供应商",bank_name:"验收银行",account_number:"6222021234567890"},
    lines:[{id:"95000000-0000-4000-8000-000000000022",business_date:"2026-10-25",category_key:"service",category_name:"服务费",category_revision:1,purpose:"P5 跨服务付款验收",amount_minor:10000}],
    attribution:{},approval:{policy:"not_required",status:"not_applicable",revision:1}
  }
}')
request POST http://127.0.0.1:19332/api/v1/finance-requests "$finance_token" "$create_payload" "$runtime/request-created.json" 201
request_id=$(jq -er '.id' "$runtime/request-created.json")
revision=$(jq -er '.revision' "$runtime/request-created.json")
submit_payload=$(jq -cn --argjson revision "$revision" '{command_id:"95000000-0000-4000-8000-000000000023",expected_revision:$revision,missing_evidence_acknowledged:true}')
request POST "http://127.0.0.1:19332/api/v1/finance-requests/$request_id/submit" "$finance_token" "$submit_payload" "$runtime/request-submitted.json" 200
jq -e '.status=="payable" and .approval_policy=="not_required" and .approval_status=="not_applicable" and .details.payee.account_last4=="7890" and (.details.payee|has("account_number")|not)' "$runtime/request-submitted.json" >/dev/null

echo '[5/8] 先部分付款，再验证超额门禁并显式确认超额'
revision=$(jq -er '.revision' "$runtime/request-submitted.json")
partial_payload=$(jq -cn --argjson revision "$revision" '{command_id:"95000000-0000-4000-8000-000000000031",expected_revision:$revision,actual_amount_minor:6000,occurred_on:"2026-10-25",note:"P5 首笔部分付款",overage_confirmed:false,overage_reason:""}')
request POST "http://127.0.0.1:19332/api/v1/finance-requests/$request_id/payments" "$finance_token" "$partial_payload" "$runtime/request-partial.json" 200
jq -e '.status=="partially_paid" and .paid_minor==6000 and .allocated_minor==6000 and .overage_minor==0' "$runtime/request-partial.json" >/dev/null

revision=$(jq -er '.revision' "$runtime/request-partial.json")
overage_missing=$(jq -cn --argjson revision "$revision" '{command_id:"95000000-0000-4000-8000-000000000032",expected_revision:$revision,actual_amount_minor:5000,occurred_on:"2026-10-25",note:"P5 超额门禁",overage_confirmed:false,overage_reason:""}')
request POST "http://127.0.0.1:19332/api/v1/finance-requests/$request_id/payments" "$finance_token" "$overage_missing" "$runtime/overage-required.json" 400
jq -e '.code=="INVALID_REQUEST"' "$runtime/overage-required.json" >/dev/null
overage_confirmed=$(jq -cn --argjson revision "$revision" '{command_id:"95000000-0000-4000-8000-000000000033",expected_revision:$revision,actual_amount_minor:5000,occurred_on:"2026-10-25",note:"P5 已核对超额",overage_confirmed:true,overage_reason:"银行实付多 10 元，保留未分配余额复核"}')
request POST "http://127.0.0.1:19332/api/v1/finance-requests/$request_id/payments" "$finance_token" "$overage_confirmed" "$runtime/request-final.json" 200
jq -e '.status=="paid_with_overpayment" and .paid_minor==11000 and .allocated_minor==10000 and .overage_minor==1000 and (.payments|length)==2 and ([.payments[].operator_subject_id]|all(.=="22222222-2222-4222-8222-222222222222"))' "$runtime/request-final.json" >/dev/null

echo '[6/8] 批量付款验证部分成功且不回滚成功项'
batch_1=$(printf '%s' "$create_payload" | jq -c '.command_id="95000000-0000-4000-8000-000000000041" | .title="P5 批量付款成功项" | .amount_minor=2000 | .details.lines[0].id="95000000-0000-4000-8000-000000000042" | .details.lines[0].amount_minor=2000')
batch_2=$(printf '%s' "$create_payload" | jq -c '.command_id="95000000-0000-4000-8000-000000000043" | .title="P5 批量付款冲突项" | .amount_minor=3000 | .details.lines[0].id="95000000-0000-4000-8000-000000000044" | .details.lines[0].amount_minor=3000')
request POST http://127.0.0.1:19332/api/v1/finance-requests "$finance_token" "$batch_1" "$runtime/batch-1-created.json" 201
request POST http://127.0.0.1:19332/api/v1/finance-requests "$finance_token" "$batch_2" "$runtime/batch-2-created.json" 201
batch_1_id=$(jq -er '.id' "$runtime/batch-1-created.json")
batch_2_id=$(jq -er '.id' "$runtime/batch-2-created.json")
request POST "http://127.0.0.1:19332/api/v1/finance-requests/$batch_1_id/submit" "$finance_token" '{"command_id":"95000000-0000-4000-8000-000000000045","expected_revision":1,"missing_evidence_acknowledged":true}' "$runtime/batch-1-submitted.json" 200
request POST "http://127.0.0.1:19332/api/v1/finance-requests/$batch_2_id/submit" "$finance_token" '{"command_id":"95000000-0000-4000-8000-000000000046","expected_revision":1,"missing_evidence_acknowledged":true}' "$runtime/batch-2-submitted.json" 200
batch_payload=$(jq -cn --arg first "$batch_1_id" --arg second "$batch_2_id" '{items:[{request_id:$first,command_id:"95000000-0000-4000-8000-000000000047",expected_revision:2,actual_amount_minor:2000,occurred_on:"2026-10-25",note:"P5 批量成功项",overage_confirmed:false,overage_reason:""},{request_id:$second,command_id:"95000000-0000-4000-8000-000000000048",expected_revision:1,actual_amount_minor:3000,occurred_on:"2026-10-25",note:"P5 过期 revision",overage_confirmed:false,overage_reason:""}]}')
request POST http://127.0.0.1:19332/api/v1/finance-payments/batch "$finance_token" "$batch_payload" "$runtime/batch-result.json" 200
jq -e '([.items[]|select(.request!=null)]|length)==1 and ([.items[]|select(.error_code=="REVISION_CONFLICT")]|length)==1' "$runtime/batch-result.json" >/dev/null
request GET "http://127.0.0.1:19332/api/v1/finance-requests/$batch_1_id" "$finance_token" '' "$runtime/batch-1-final.json" 200
request GET "http://127.0.0.1:19332/api/v1/finance-requests/$batch_2_id" "$finance_token" '' "$runtime/batch-2-final.json" 200
jq -e '.status=="paid" and .allocated_minor==2000' "$runtime/batch-1-final.json" >/dev/null
jq -e '.status=="payable" and .paid_minor==0' "$runtime/batch-2-final.json" >/dev/null
request POST "http://127.0.0.1:19332/api/v1/finance-requests/$batch_2_id/withdraw" "$finance_token" '{"command_id":"95000000-0000-4000-8000-000000000049","expected_revision":2,"reason":"P5 撤回修订验收"}' "$runtime/batch-2-withdrawn.json" 200
jq -e '.status=="withdrawn" and .revision==3 and .withdrawal_reason=="P5 撤回修订验收"' "$runtime/batch-2-withdrawn.json" >/dev/null
request POST "http://127.0.0.1:19332/api/v1/finance-requests/$batch_2_id/submit" "$finance_token" '{"command_id":"95000000-0000-4000-8000-000000000050","expected_revision":3,"missing_evidence_acknowledged":true}' "$runtime/batch-2-resubmitted.json" 200
jq -e '.status=="payable" and .revision==4 and .paid_minor==0' "$runtime/batch-2-resubmitted.json" >/dev/null

echo '[7/8] 验证普通导出脱敏、敏感导出显式用途、审计与空目标恢复'
request GET http://127.0.0.1:19332/api/v1/finance-request-exports "$finance_token" '' "$runtime/ordinary-export.json" 200
jq -e '.sensitive==false and (.items|length)==3 and ([.items[].details.payee.account_last4]|all(.=="7890")) and ([.items[].details.payee|has("account_number")]|all(.==false))' "$runtime/ordinary-export.json" >/dev/null
request GET http://127.0.0.1:19332/api/v1/finance-request-sensitive-exports "$finance_token" '' "$runtime/sensitive-purpose-required.json" 400
jq -e '.code=="SENSITIVE_ACCESS_PURPOSE_REQUIRED"' "$runtime/sensitive-purpose-required.json" >/dev/null
request GET 'http://127.0.0.1:19332/api/v1/finance-request-sensitive-exports?purpose=P5%E8%B4%A2%E5%8A%A1%E5%AE%A1%E8%AE%A1' "$finance_token" '' "$runtime/sensitive-export.json" 200
jq -e '.sensitive==true and .purpose=="P5财务审计" and (.items|length)==3 and ([.items[].details.payee.account_number]|all(.=="6222021234567890"))' "$runtime/sensitive-export.json" >/dev/null

docker exec "$container" psql -h 127.0.0.1 -U postgres -d money -AtF '|' -c "SELECT (SELECT count(*) FROM obligations WHERE source_application='internal-finance-requests' AND source_resource_type='finance_request'),(SELECT count(*) FROM cash_transactions),(SELECT count(*) FROM allocations),(SELECT count(*) FROM internal_finance_payment_deliveries),round(((SELECT COALESCE(sum(amount),0) FROM cash_transactions)-(SELECT COALESCE(sum(amount),0) FROM allocations))*100)::bigint" >"$runtime/money-facts.tsv"
grep -Eq '^2\|3\|3\|3\|1000$' "$runtime/money-facts.tsv"
docker exec "$container" psql -h 127.0.0.1 -U postgres -d finance -AtF '|' -c "SELECT count(*),min(purpose),max(result) FROM finance_sensitive_access_audit_events" >"$runtime/audit-facts.tsv"
grep -Eq '^3\|P5财务审计\|succeeded$' "$runtime/audit-facts.tsv"

docker exec "$container" pg_dump -h 127.0.0.1 -U postgres -Fc -f /tmp/p5-finance.dump finance
docker exec "$container" pg_dump -h 127.0.0.1 -U postgres -Fc -f /tmp/p5-money.dump money
docker exec "$container" createdb -h 127.0.0.1 -U postgres finance_restore
docker exec "$container" createdb -h 127.0.0.1 -U postgres money_restore
docker exec "$container" pg_restore -h 127.0.0.1 -U postgres --single-transaction --exit-on-error --no-owner --no-privileges -d finance_restore /tmp/p5-finance.dump
docker exec "$container" pg_restore -h 127.0.0.1 -U postgres --single-transaction --exit-on-error --no-owner --no-privileges -d money_restore /tmp/p5-money.dump
docker exec "$container" psql -h 127.0.0.1 -U postgres -d finance_restore -AtF '|' -c "SELECT (SELECT count(*) FROM finance_requests),(SELECT count(*) FROM finance_payment_deliveries),(SELECT count(*) FROM finance_sensitive_access_audit_events)" >"$runtime/restore-facts.tsv"
docker exec "$container" psql -h 127.0.0.1 -U postgres -d money_restore -AtF '|' -c "SELECT (SELECT count(*) FROM obligations WHERE source_application='internal-finance-requests'),(SELECT count(*) FROM cash_transactions),(SELECT count(*) FROM allocations),(SELECT count(*) FROM internal_finance_payment_deliveries)" >>"$runtime/restore-facts.tsv"
grep -Eq '^3\|3\|3$' "$runtime/restore-facts.tsv"
grep -Eq '^2\|3\|3\|3$' "$runtime/restore-facts.tsv"

echo '[8/8] 汇总证据并自动关闭进程和容器'
assertions=$(awk -F '\t' 'NR>1 {count++} END {print count+0}' "$runtime/http-evidence.tsv")
mismatches=$(awk -F '\t' 'NR>1 && $2!=$3 {count++} END {print count+0}' "$runtime/http-evidence.tsv")
printf '%s\n' \
  '# P5 财务申请与付款跨服务验收结果' '' \
  "- HTTP 断言：${assertions}；状态不匹配：${mismatches}。" \
  '- Finance 与 Money 使用两个独立数据库，通过版本化 HTTP 连接。' \
  '- 付款申请默认无需审批；审批字段作为显式占位保留。' \
  '- 主申请两笔实际付款只创建一个 Money 义务，精确核销 10000 分并保留 1000 分超额未分配余额。' \
  '- 批量付款一笔成功、一笔 revision 冲突；成功 Money 事实未回滚，失败申请未变化。' \
  '- 普通导出只含账号尾号；敏感导出必须声明用途并逐条审计；Finance 与 Money 均完成空目标恢复核对。' \
  '- 本验收只使用临时本地资源，退出时自动清理；未执行 D1 或公网部署。' >"$runtime/result.md"
[ "$mismatches" = 0 ] || exit 1
cat "$runtime/result.md"
