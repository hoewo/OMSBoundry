#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
d1_dir=${D1_DIR:-"$repo_dir/deployments/d1"}
env_file=${D1_ENV_FILE:-"$d1_dir/.env"}
base_url=${D1_PUBLIC_URL:?set D1_PUBLIC_URL to the Nginx entry URL}
project=${D1_PROJECT_NAME:?set D1_PROJECT_NAME to the running isolated D1 stack}
evidence_dir=${OA_JOURNEY_EVIDENCE_DIR:-"$script_dir/.evidence/c1"}
c0_state=${OA_JOURNEY_C0_STATE:-"$(dirname "$evidence_dir")/c0/state-after-c0.json"}

[ -f "$env_file" ] || { echo "D1 environment file not found: $env_file" >&2; exit 2; }
[ -f "$c0_state" ] || { echo "C0 state not found: $c0_state" >&2; exit 2; }
for command in curl jq openssl; do
  command -v "$command" >/dev/null 2>&1 || { echo "$command is required" >&2; exit 2; }
done

env_value() {
  key=$1
  fallback=${2:-}
  value=$(awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' "$env_file")
  if [ -n "$value" ]; then printf '%s' "$value"; else printf '%s' "$fallback"; fi
}

expect_status() {
  expected=$1
  actual=$2
  label=$3
  [ "$actual" = "$expected" ] || { echo "$label: HTTP $actual, expected $expected" >&2; exit 1; }
}

new_uuid() {
  value=$(openssl rand -hex 16)
  printf '%s-%s-4%s-8%s-%s' \
    "$(printf '%s' "$value" | cut -c1-8)" \
    "$(printf '%s' "$value" | cut -c9-12)" \
    "$(printf '%s' "$value" | cut -c14-16)" \
    "$(printf '%s' "$value" | cut -c18-20)" \
    "$(printf '%s' "$value" | cut -c21-32)"
}

tenant_id=$(env_value TENANT_ID)
admin_username=$(env_value BOOTSTRAP_ADMIN_USERNAME admin)
admin_password=$(env_value BOOTSTRAP_ADMIN_PASSWORD)
[ -n "$tenant_id" ] || { echo "TENANT_ID is required" >&2; exit 2; }
[ -n "$admin_password" ] || { echo "BOOTSTRAP_ADMIN_PASSWORD is required" >&2; exit 2; }
jq -e --arg tenant "$tenant_id" --arg project "$project" \
  '.phase == "C0" and .result == "pass" and .tenant_id == $tenant and .deployment.compose_project == $project' "$c0_state" >/dev/null || {
  echo "C0 state does not match this tenant and Compose project" >&2
  exit 1
}

workspace=$(mktemp -d "${TMPDIR:-/tmp}/oms-full-oa-c1.XXXXXX")
trap 'rm -rf "$workspace"' EXIT HUP INT TERM
http_evidence="$workspace/http-evidence.tsv"
printf 'request\texpected_status\tactual_status\ttime_seconds\n' >"$http_evidence"

record_http() {
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$http_evidence"
}

request() {
  method=$1
  url=$2
  cookie_file=$3
  csrf_token=$4
  request_payload=$5
  output_file=$6
  expected=$7
  if [ -n "$request_payload" ]; then
    result=$(curl --silent --show-error --output "$output_file" --write-out '%{http_code} %{time_total}' \
      --request "$method" --cookie "$cookie_file" --cookie-jar "$cookie_file" \
      -H 'Content-Type: application/json' -H "X-CSRF-Token: $csrf_token" \
      --data "$request_payload" "$url")
  else
    result=$(curl --silent --show-error --output "$output_file" --write-out '%{http_code} %{time_total}' \
      --request "$method" --cookie "$cookie_file" --cookie-jar "$cookie_file" "$url")
  fi
  actual=${result%% *}
  duration=${result#* }
  record_http "$method $url" "$expected" "$actual" "$duration"
  if [ "$actual" != "$expected" ] && [ -s "$output_file" ]; then cat "$output_file" >&2; printf '\n' >&2; fi
  expect_status "$expected" "$actual" "$method $url"
}

fetch_csrf() {
  cookie_file=$1
  output_file=$2
  result=$(curl --silent --show-error --output "$output_file" --write-out '%{http_code} %{time_total}' \
    --cookie-jar "$cookie_file" "$base_url/auth/api/v1/csrf")
  actual=${result%% *}
  duration=${result#* }
  record_http 'GET /auth/api/v1/csrf' 200 "$actual" "$duration"
  expect_status 200 "$actual" 'fetch CSRF'
  jq -er .csrf_token "$output_file"
}

login() {
  cookie_file=$1
  csrf_token=$2
  username=$3
  password=$4
  output_file=$5
  payload=$(jq -cn --arg username "$username" --arg password "$password" '{username:$username,password:$password}')
  request POST "$base_url/auth/api/v1/login" "$cookie_file" "$csrf_token" "$payload" "$output_file" 200
}

authorize_app() {
  cookie_file=$1
  csrf_token=$2
  application=$3
  output_file=$4
  result=$(curl --silent --show-error --output "$output_file" --write-out '%{http_code} %{time_total}' \
    --cookie "$cookie_file" --cookie-jar "$cookie_file" --data-urlencode "csrf_token=$csrf_token" \
    "$base_url/gateway/authorize/$application")
  actual=${result%% *}
  duration=${result#* }
  record_http "POST /gateway/authorize/$application" 303 "$actual" "$duration"
  expect_status 303 "$actual" "authorize $application"
}

authorize_project_assignment() {
  cookie_file=$1
  csrf_token=$2
  resource_id=$3
  assignment_id=$4
  assignment_revision=$5
  output_file=$6
  expected=$7
  result=$(curl --silent --show-error --output "$output_file" --write-out '%{http_code} %{time_total}' \
    --cookie "$cookie_file" --cookie-jar "$cookie_file" \
    --data-urlencode "csrf_token=$csrf_token" --data-urlencode resource_type=project \
    --data-urlencode "resource_id=$resource_id" --data-urlencode business_fact_kind=project_assignment \
    --data-urlencode business_fact_source=project-workspace --data-urlencode "business_fact_id=$assignment_id" \
    --data-urlencode "business_fact_revision=$assignment_revision" \
    "$base_url/gateway/authorize/project-workspace")
  actual=${result%% *}
  duration=${result#* }
  record_http 'POST /gateway/authorize/project-workspace assignment' "$expected" "$actual" "$duration"
  expect_status "$expected" "$actual" 'authorize Project through Assignment fact'
}

# Restore the explicit bootstrap capability set before the journey starts.
D1_ENV_FILE="$env_file" D1_PUBLIC_URL="$base_url" "$d1_dir/ops/grant-bootstrap-access" >/dev/null

admin_cookies="$workspace/admin.cookies"
admin_csrf=$(fetch_csrf "$admin_cookies" "$workspace/admin-csrf.json")
login "$admin_cookies" "$admin_csrf" "$admin_username" "$admin_password" "$workspace/admin-login.json"
admin_subject_id=$(curl --fail --silent --show-error --cookie "$admin_cookies" "$base_url/auth/api/v1/session" | jq -er .principal.subject_id)

authorize_app "$admin_cookies" "$admin_csrf" party-directory "$workspace/admin-authorize-party.out"
authorize_app "$admin_cookies" "$admin_csrf" people-groups "$workspace/admin-authorize-people.out"
authorize_app "$admin_cookies" "$admin_csrf" project-workspace "$workspace/admin-authorize-project.out"

stamp="$(date -u '+%Y%m%dT%H%M%SZ')-$(openssl rand -hex 3)"
printf '{"schema_version":"1","actors":[]}\n' >"$workspace/state-private-c1.json"
chmod 600 "$workspace/state-private-c1.json"

create_actor_person() {
  role=$1
  display_name=$2
  username="journey-$role-$stamp"
  password="C1-$role-$stamp!Aa7"
  payload=$(jq -cn --arg username "$username" --arg display_name "$display_name" '{username:$username,display_name:$display_name}')
  request POST "$base_url/auth/api/v1/admin/invitations" "$admin_cookies" "$admin_csrf" "$payload" "$workspace/$role-invitation.json" 201
  subject_id=$(jq -er .subject.id "$workspace/$role-invitation.json")
  token=$(jq -er .token "$workspace/$role-invitation.json")

  actor_cookies="$workspace/$role.cookies"
  actor_csrf=$(fetch_csrf "$actor_cookies" "$workspace/$role-csrf.json")
  payload=$(jq -cn --arg token "$token" --arg password "$password" '{token:$token,password:$password}')
  request POST "$base_url/auth/api/v1/activate" "$actor_cookies" "$actor_csrf" "$payload" "$workspace/$role-activation.json" 200
  login "$actor_cookies" "$actor_csrf" "$username" "$password" "$workspace/$role-login.json"
  printf '%s\n' "$actor_csrf" >"$workspace/$role.csrf"

  payload=$(jq -cn --arg command_id "$(new_uuid)" --arg display_name "$display_name" --arg iam_subject_id "$subject_id" \
    '{command_id:$command_id,display_name:$display_name,iam_subject_id:$iam_subject_id}')
  request POST "$base_url/people/api/v1/persons" "$admin_cookies" "$admin_csrf" "$payload" "$workspace/$role-person.json" 201
  person_id=$(jq -er .id "$workspace/$role-person.json")
  person_revision=$(jq -er .revision "$workspace/$role-person.json")
  jq -n --arg role "$role" --arg username "$username" --arg password "$password" \
    --arg subject_id "$subject_id" --arg person_id "$person_id" --argjson person_revision "$person_revision" \
    '{role:$role,username:$username,password:$password,subject_id:$subject_id,person_id:$person_id,person_revision:$person_revision}' \
    >"$workspace/$role-secret.json"
  jq --slurpfile actor "$workspace/$role-secret.json" '.actors += $actor' "$workspace/state-private-c1.json" >"$workspace/state-private-c1.tmp"
  mv "$workspace/state-private-c1.tmp" "$workspace/state-private-c1.json"
  chmod 600 "$workspace/state-private-c1.json"
  jq 'del(.password)' "$workspace/$role-secret.json" >"$workspace/$role-meta.json"
}

create_actor_person business_owner '连续旅程经营负责人'
create_actor_person production_owner '连续旅程生产负责人'
create_actor_person participant '连续旅程参与人'
create_actor_person neighbor '连续旅程相邻人员'

party_command=$(new_uuid)
party_payload=$(jq -cn --arg command_id "$party_command" --arg legal_name "连续旅程客户 $stamp" \
  --arg registration_identifier "OA-JOURNEY-$stamp" \
  '{command_id:$command_id,kind:"organization",legal_name:$legal_name,registration_identifier:$registration_identifier}')
request POST "$base_url/party/api/v1/parties" "$admin_cookies" "$admin_csrf" "$party_payload" "$workspace/party.json" 201
party_id=$(jq -er .id "$workspace/party.json")
party_revision=$(jq -er .revision "$workspace/party.json")
[ "$party_revision" -eq 1 ] || { echo "new Party revision is not 1" >&2; exit 1; }

project_command=$(new_uuid)
project_payload=$(jq -cn --arg command_id "$project_command" --arg project_number "OA-JOURNEY-$stamp" \
  --arg name "完整 OA 连续验证项目 $stamp" --arg party_id "$party_id" --argjson party_revision "$party_revision" \
  '{command_id:$command_id,project_number:$project_number,name:$name,summary:"C1-C8 共用业务主线",planned_start_date:null,planned_end_date:null,project_type_keys:["design","consultation"],client_party:{party_id:$party_id,source_revision:$party_revision}}')
request POST "$base_url/project/api/v1/projects" "$admin_cookies" "$admin_csrf" "$project_payload" "$workspace/project.json" 201
project_id=$(jq -er .id "$workspace/project.json")
request POST "$base_url/project/api/v1/projects" "$admin_cookies" "$admin_csrf" "$project_payload" "$workspace/project-replay.json" 201
jq -e --arg id "$project_id" '.id == $id and .revision == 1' "$workspace/project-replay.json" >/dev/null || {
  echo "Project command replay did not preserve identity and revision" >&2
  exit 1
}

neighbor_project_payload=$(jq -cn --arg command_id "$(new_uuid)" --arg project_number "OA-NEIGHBOR-$stamp" \
  --arg name "相邻权限边界项目 $stamp" --arg party_id "$party_id" --argjson party_revision "$party_revision" \
  '{command_id:$command_id,project_number:$project_number,name:$name,summary:"仅用于验证资源隔离",planned_start_date:null,planned_end_date:null,project_type_keys:["design"],client_party:{party_id:$party_id,source_revision:$party_revision}}')
request POST "$base_url/project/api/v1/projects" "$admin_cookies" "$admin_csrf" "$neighbor_project_payload" "$workspace/neighbor-project.json" 201
neighbor_project_id=$(jq -er .id "$workspace/neighbor-project.json")

assign_person() {
  role=$1
  expected_revision=$2
  output=$3
  command_id=$4
  person_id=$(jq -er .person_id "$workspace/$role-meta.json")
  person_revision=$(jq -er .person_revision "$workspace/$role-meta.json")
  payload=$(jq -cn --arg command_id "$command_id" --argjson expected_revision "$expected_revision" \
    --arg person_id "$person_id" --argjson source_revision "$person_revision" --arg role_key "$role" \
    '{command_id:$command_id,expected_revision:$expected_revision,operation:"assign",subject_kind:"person",subject_id:$person_id,source_revision:$source_revision,role_key:$role_key}')
  request POST "$base_url/project/api/v1/projects/$project_id/assignments" "$admin_cookies" "$admin_csrf" "$payload" "$output" 200
}

business_command=$(new_uuid)
assign_person business_owner 1 "$workspace/business-owner-assignment.json" "$business_command"
business_assignment_id=$(jq -er .assignment.id "$workspace/business-owner-assignment.json")
assign_person business_owner 1 "$workspace/business-owner-assignment-replay.json" "$business_command"
jq -e --arg id "$business_assignment_id" '.assignment.id == $id and .project.revision == 2' "$workspace/business-owner-assignment-replay.json" >/dev/null || {
  echo "Assignment command replay did not preserve identity and revision" >&2
  exit 1
}

assign_person production_owner 2 "$workspace/production-owner-assignment.json" "$(new_uuid)"
assign_person participant 3 "$workspace/participant-assignment.json" "$(new_uuid)"
participant_assignment_id=$(jq -er .assignment.id "$workspace/participant-assignment.json")
participant_assignment_revision=$(jq -er .assignment.created_project_revision "$workspace/participant-assignment.json")

neighbor_person_id=$(jq -er .person_id "$workspace/neighbor-meta.json")
neighbor_person_revision=$(jq -er .person_revision "$workspace/neighbor-meta.json")
stale_payload=$(jq -cn --arg command_id "$(new_uuid)" --arg person_id "$neighbor_person_id" --argjson source_revision "$neighbor_person_revision" \
  '{command_id:$command_id,expected_revision:1,operation:"assign",subject_kind:"person",subject_id:$person_id,source_revision:$source_revision,role_key:"participant"}')
request POST "$base_url/project/api/v1/projects/$project_id/assignments" "$admin_cookies" "$admin_csrf" "$stale_payload" "$workspace/stale-assignment-denied.json" 409
request GET "$base_url/project/api/v1/projects/$project_id" "$admin_cookies" "$admin_csrf" '' "$workspace/project-before-completion.json" 200
jq -e '.project.revision == 4 and (.assignments | length) == 3' "$workspace/project-before-completion.json" >/dev/null || {
  echo "stale Assignment attempt changed Project state" >&2
  exit 1
}

participant_cookies="$workspace/participant.cookies"
participant_csrf=$(cat "$workspace/participant.csrf")
authorize_project_assignment "$participant_cookies" "$participant_csrf" "$project_id" "$participant_assignment_id" "$participant_assignment_revision" "$workspace/participant-authorize-main.out" 303
request GET "$base_url/project/api/v1/projects/$project_id" "$participant_cookies" "$participant_csrf" '' "$workspace/participant-read-main.json" 200
request GET "$base_url/project/api/v1/projects/$neighbor_project_id" "$participant_cookies" "$participant_csrf" '' "$workspace/participant-read-neighbor-denied.json" 403
authorize_project_assignment "$participant_cookies" "$participant_csrf" "$neighbor_project_id" "$participant_assignment_id" "$participant_assignment_revision" "$workspace/participant-authorize-neighbor-denied.json" 403

complete_payload=$(jq -cn --arg command_id "$(new_uuid)" '{command_id:$command_id,expected_revision:4}')
request POST "$base_url/project/api/v1/projects/$project_id/complete-initiation" "$admin_cookies" "$admin_csrf" "$complete_payload" "$workspace/project-active.json" 200
project_revision=$(jq -er .revision "$workspace/project-active.json")
jq -e '.status == "active" and .revision == 5 and .client_party.party_id != null' "$workspace/project-active.json" >/dev/null || {
  echo "Project did not become active with the expected shared Party snapshot" >&2
  exit 1
}

captured_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
jq -n \
  --arg schema_version 1 \
  --arg scenario_id reference-oa-full-suite-continuous-v1 \
  --arg captured_at "$captured_at" \
  --arg tenant_id "$tenant_id" \
  --arg project_id "$project_id" \
  --argjson project_revision "$project_revision" \
  --arg neighbor_project_id "$neighbor_project_id" \
  --arg party_id "$party_id" \
  --argjson party_revision "$party_revision" \
  --arg admin_subject_id "$admin_subject_id" \
  --slurpfile business_owner "$workspace/business_owner-meta.json" \
  --slurpfile production_owner "$workspace/production_owner-meta.json" \
  --slurpfile participant "$workspace/participant-meta.json" \
  --slurpfile neighbor "$workspace/neighbor-meta.json" \
  --slurpfile business_assignment "$workspace/business-owner-assignment.json" \
  --slurpfile production_assignment "$workspace/production-owner-assignment.json" \
  --slurpfile participant_assignment "$workspace/participant-assignment.json" \
  '{
    schema_version:$schema_version,
    scenario_id:$scenario_id,
    phase:"C1",
    result:"pass",
    captured_at:$captured_at,
    tenant_id:$tenant_id,
    administrator_subject_id:$admin_subject_id,
    party:{id:$party_id,revision:$party_revision},
    people:[$business_owner[0],$production_owner[0],$participant[0],$neighbor[0]],
    project:{id:$project_id,revision:$project_revision,status:"active"},
    neighbor_project:{id:$neighbor_project_id,revision:1,status:"draft"},
    assignments:[
      $business_assignment[0].assignment,
      $production_assignment[0].assignment,
      $participant_assignment[0].assignment
    ],
    checks:{
      same_party_snapshot:"pass",
      project_command_replay:"pass",
      assignment_command_replay:"pass",
      stale_project_revision_denied_without_write:"pass",
      participant_main_project_read:"pass",
      participant_neighbor_project_denied:"pass",
      initiation_completed:"pass"
    },
    private_state:"state-private-c1.json (mode 0600; validation actors only)"
  }' >"$workspace/state-after-c1.json"

http_failures=$(awk -F '\t' 'NR > 1 && $2 != $3 {count++} END {print count+0}' "$http_evidence")
[ "$http_failures" -eq 0 ] || { echo "$http_failures HTTP assertions failed" >&2; exit 1; }

mkdir -p "$evidence_dir"
chmod 700 "$evidence_dir"
for artifact in \
  state-after-c1.json http-evidence.tsv party.json project.json project-replay.json neighbor-project.json \
  business-owner-assignment.json business-owner-assignment-replay.json production-owner-assignment.json \
  participant-assignment.json stale-assignment-denied.json project-before-completion.json project-active.json \
  participant-read-main.json participant-read-neighbor-denied.json participant-authorize-neighbor-denied.json
do
  cp "$workspace/$artifact" "$evidence_dir/$artifact"
done
cp "$workspace/state-private-c1.json" "$evidence_dir/state-private-c1.json"
chmod 600 "$evidence_dir/state-private-c1.json"

echo "PASS C1 shared Party/People/Project fixture: project=$project_id revision=$project_revision"
echo "evidence: $evidence_dir/state-after-c1.json"
