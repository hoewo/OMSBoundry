  jq -e --arg obligation "$obligation_id" '.state=="accepted" and .revision==3 and .target_revision==2 and .obligation.id==$obligation and .obligation.revision==1' "$workspace/suggestion-accepted.json" >/dev/null
  json_request POST "$base_url/cost-outsourcing/api/v1/payable-suggestions/$suggestion_id/synchronization" "$business_cookies" '' "$sync_payload" "$workspace/suggestion-sync-replay.json" 200 'REPLAY C6 synchronization'
  jq -e --arg obligation "$obligation_id" '.state=="accepted" and .revision==3 and .obligation.id==$obligation' "$workspace/suggestion-sync-replay.json" >/dev/null
