#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
d1_dir=${D1_DIR:-"$repo_dir/deployments/d1"}
env_file=${D1_ENV_FILE:-"$d1_dir/.env"}
base_url=${D1_PUBLIC_URL:?set D1_PUBLIC_URL to the Nginx entry URL}
project=${D1_PROJECT_NAME:?set D1_PROJECT_NAME to the running isolated D1 stack}
evidence_dir=${OA_JOURNEY_EVIDENCE_DIR:-"$script_dir/.evidence/c8"}
journey_dir=$(dirname "$evidence_dir")
c7_state=${OA_JOURNEY_C7_STATE:-"$journey_dir/c7/state-after-c7.json"}
c6_state=${OA_JOURNEY_C6_STATE:-"$journey_dir/c6/state-after-c6.json"}
c5_state=${OA_JOURNEY_C5_STATE:-"$journey_dir/c5/state-after-c5.json"}
c4_state=${OA_JOURNEY_C4_STATE:-"$journey_dir/c4/state-after-c4.json"}
c2_state=${OA_JOURNEY_C2_STATE:-"$journey_dir/c2/state-after-c2.json"}
c1_state=${OA_JOURNEY_C1_STATE:-"$journey_dir/c1/state-after-c1.json"}
c1_private_state=${OA_JOURNEY_C1_PRIVATE_STATE:-"$journey_dir/c1/state-private-c1.json"}
plan_state="$evidence_dir/state-plan-c8.json"
fixture_state="$evidence_dir/state-partial-c8-work-item.json"
completed_state="$evidence_dir/state-after-c8.json"

[ "${OA_JOURNEY_C8_CONFIRM:-}" = yes ] || {
  echo 'set OA_JOURNEY_C8_CONFIRM=yes to authorize bounded IAM grants, one same-Project work item fixture, and sequential source stops' >&2
  exit 2
}
for required in "$env_file" "$c7_state" "$c6_state" "$c5_state" "$c4_state" "$c2_state" "$c1_state" "$c1_private_state"; do
  [ -f "$required" ] || { echo "required C8 input is missing: $required" >&2; exit 2; }
done
for command in curl jq openssl docker awk sed seq cmp; do
  command -v "$command" >/dev/null 2>&1 || { echo "$command is required" >&2; exit 2; }
done

env_value() {
  key=$1; fallback=${2:-}
  value=$(awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' "$env_file")
  if [ -n "$value" ]; then printf '%s' "$value"; else printf '%s' "$fallback"; fi
}

digest_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

new_uuid() {
  value=$(openssl rand -hex 16)
  printf '%s-%s-4%s-8%s-%s' \
    "$(printf '%s' "$value" | cut -c1-8)" "$(printf '%s' "$value" | cut -c9-12)" \
    "$(printf '%s' "$value" | cut -c14-16)" "$(printf '%s' "$value" | cut -c18-20)" \
    "$(printf '%s' "$value" | cut -c21-32)"
}

record_http() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$http_evidence"; }

expect_status() {
  expected=$1; actual=$2; label=$3
  [ "$actual" = "$expected" ] || { echo "$label: HTTP $actual, expected $expected" >&2; exit 1; }
}

json_request() {
  method=$1; url=$2; cookie=$3; csrf=$4; payload=$5; output=$6; expected=$7; label=$8
  set -- --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
    --request "$method" --cookie "$cookie" --cookie-jar "$cookie"
  [ -z "$csrf" ] || set -- "$@" -H "X-CSRF-Token: $csrf"
  if [ -n "$payload" ]; then set -- "$@" -H 'Content-Type: application/json' --data "$payload"; fi
  result=$(curl "$@" "$url")
  actual=${result%% *}; duration=${result#* }
  record_http "$label" "$expected" "$actual" "$duration"
  if [ "$actual" != "$expected" ]; then
    [ "$output" = /dev/null ] || [ ! -s "$output" ] || { cat "$output" >&2; printf '\n' >&2; }
    echo "$label: HTTP $actual, expected $expected" >&2
    exit 1
  fi
}

fetch_csrf() {
  cookie=$1; output=$2
  json_request GET "$base_url/auth/api/v1/csrf" "$cookie" '' '' "$output" 200 'GET IAM CSRF'
  jq -er .csrf_token "$output"
}

login() {
  cookie=$1; csrf=$2; username=$3; password=$4; output=$5; label=$6
  payload=$(jq -cn --arg username "$username" --arg password "$password" '{username:$username,password:$password}')
  json_request POST "$base_url/auth/api/v1/login" "$cookie" "$csrf" "$payload" "$output" 200 "POST IAM login ($label)"
}

authorize_app() {
  cookie=$1; csrf=$2; app=$3; output=$4; resource_type=${5:-}; resource_id=${6:-}
  set -- --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
    --cookie "$cookie" --cookie-jar "$cookie" --data-urlencode "csrf_token=$csrf"
  if [ -n "$resource_type" ]; then
    set -- "$@" --data-urlencode "resource_type=$resource_type" --data-urlencode "resource_id=$resource_id"
  fi
  result=$(curl "$@" "$base_url/gateway/authorize/$app")
  actual=${result%% *}; duration=${result#* }
  record_http "POST /gateway/authorize/$app${resource_type:+ ($resource_type)}" 303 "$actual" "$duration"
  expect_status 303 "$actual" "authorize $app"
}

assert_evidence_actions() {
  evidence_cookie=$(awk '$6=="oms_cap_evidence_service" {print $7}' "$participant_cookies")
  [ -n "$evidence_cookie" ] || { echo 'Evidence capability cookie is missing' >&2; exit 1; }
  printf '%s' "$evidence_cookie" | jq -R -e --arg tenant "$tenant_id" --arg file "$material_file" --argjson expected "$1" '
    split(".")[1] | gsub("-";"+") | gsub("_";"/") | @base64d | fromjson |
    .tid==$tenant and .aud=="evidence-service" and
    (.actions|sort)==($expected|sort) and
    .scope=={kind:"resources",resources:[{type:"file",id:$file}]}
  ' >/dev/null || { echo 'Evidence credential actions/scope changed or include a legacy view workaround' >&2; exit 1; }
}

auth_admin_json() {
  path=$1; payload=$2; output=$3; expected=$4; label=$5
  json_request POST "$base_url/auth$path" "$admin_cookies" "$admin_csrf" "$payload" "$output" "$expected" "$label"
}

grant_tenant() {
  subject=$1; audience=$2; action=$3
  payload=$(jq -cn --arg subject "$subject" --arg audience "$audience" --arg action "$action" \
    '{subject_id:$subject,audience:$audience,action:$action}')
  auth_admin_json /api/v1/admin/grants "$payload" /dev/null 204 "GRANT $audience/$action"
}

revoke_tenant() {
  subject=$1; audience=$2; action=$3
  payload=$(jq -cn --arg subject "$subject" --arg audience "$audience" --arg action "$action" \
    '{subject_id:$subject,audience:$audience,action:$action}')
  auth_admin_json /api/v1/admin/grants/revoke "$payload" /dev/null 204 "REVOKE $audience/$action"
}

grant_resource() {
  subject=$1; audience=$2; action=$3; resource_type=$4; resource_id=$5
  payload=$(jq -cn --arg subject "$subject" --arg audience "$audience" --arg action "$action" \
    --arg resource_type "$resource_type" --arg resource_id "$resource_id" \
    '{subject_id:$subject,audience:$audience,action:$action,scope:{kind:"resources",resources:[{type:$resource_type,id:$resource_id}]}}')
  auth_admin_json /api/v1/admin/grants "$payload" /dev/null 204 "GRANT $audience/$action ($resource_type)"
}

revoke_resource_quiet() {
  subject=$1; audience=$2; action=$3; resource_type=$4; resource_id=$5
  payload=$(jq -cn --arg subject "$subject" --arg audience "$audience" --arg action "$action" \
    --arg resource_type "$resource_type" --arg resource_id "$resource_id" \
    '{subject_id:$subject,audience:$audience,action:$action,scope:{kind:"resources",resources:[{type:$resource_type,id:$resource_id}]}}')
  curl --silent --output /dev/null --cookie "$admin_cookies" -H 'Content-Type: application/json' \
    -H "X-CSRF-Token: $admin_csrf" --data "$payload" "$base_url/auth/api/v1/admin/grants/revoke" || true
}

service_container() {
  container=$(docker ps --all --quiet --filter "label=com.docker.compose.project=$project" --filter "label=com.docker.compose.service=$1")
  [ -n "$container" ] || { echo "$1 container is missing from $project" >&2; exit 1; }
  [ "$(printf '%s\n' "$container" | wc -l | tr -d ' ')" = 1 ] || { echo "$1 is not unique in $project" >&2; exit 1; }
  printf '%s' "$container"
}

wait_healthy() {
  service=$1; container=$(service_container "$service")
  for _attempt in $(seq 1 90); do
    status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container")
    [ "$status" = healthy ] && return 0
    sleep 1
  done
  echo "$service did not become healthy" >&2; exit 1
}

postgres_rows() {
  database=$1; sql=$2; container=$(service_container postgres)
  docker exec "$container" sh -eu -c 'psql -U "$POSTGRES_USER" -d "$1" -At -c "$2"' sh "$database" "$sql"
}

capture_all_facts() {
  phase=$1
  output_dir="$workspace/facts-$phase"
  summary="$workspace/fact-digests-$phase.tsv"
  mkdir -p "$output_dir"
  printf 'database\trow_count\tsha256\n' >"$summary"
  for database in \
    people_groups party_directory project_workspace business_engagement contract_ledger money_flow \
    design_operations approval_audit_results billing_invoice cost_outsourcing bonus_distribution evidence_service
  do
    rows="$output_dir/$database.tsv"
    container=$(service_container postgres)
    docker exec -i "$container" sh -eu -c 'psql --quiet --tuples-only --no-align --field-separator="\t" --set=ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$1"' sh "$database" >"$rows" <<'SQL'
CREATE TEMP TABLE c8_fact_snapshot(table_name text NOT NULL, row_value text NOT NULL);
DO $$
DECLARE item record;
BEGIN
  FOR item IN
    SELECT table_name FROM information_schema.tables
    WHERE table_schema='public' AND table_type='BASE TABLE' AND table_name <> 'schema_migrations'
    ORDER BY table_name
  LOOP
    EXECUTE format(
      'INSERT INTO c8_fact_snapshot(table_name,row_value) SELECT %L,to_jsonb(value)::text FROM %I AS value',
      item.table_name,item.table_name
    );
  END LOOP;
END $$;
SELECT table_name,row_value FROM c8_fact_snapshot ORDER BY table_name,row_value;
SQL
    row_count=$(wc -l <"$rows" | tr -d ' ')
    printf '%s\t%s\t%s\n' "$database" "$row_count" "$(digest_file "$rows")" >>"$summary"
  done
}

assert_fact_snapshots_equal() {
  cmp -s "$workspace/fact-digests-before.tsv" "$workspace/fact-digests-after.tsv" || {
    echo 'one or more domain fact digests changed during C8 reads/faults' >&2
    diff -u "$workspace/fact-digests-before.tsv" "$workspace/fact-digests-after.tsv" >&2 || true
    exit 1
  }
  for before in "$workspace"/facts-before/*.tsv; do
    name=$(basename "$before")
    cmp -s "$before" "$workspace/facts-after/$name" || { echo "domain facts changed: $name" >&2; exit 1; }
  done
}

workspace=$(mktemp -d "${TMPDIR:-/tmp}/oms-full-oa-c8.XXXXXX")
http_evidence="$workspace/http-evidence.tsv"
printf 'request\texpected_status\tactual_status\ttime_seconds\n' >"$http_evidence"
stopped_service=''
participant_subject=''
neighbor_subject=''
project_id=''
material_file=''
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ -n "$stopped_service" ]; then docker start "$(service_container "$stopped_service")" >/dev/null 2>&1 || true; fi
  if [ -f "${admin_cookies:-/nonexistent}" ]; then
    for tuple in \
      "$participant_subject project-workspace project-workspace.read project $project_id" \
      "$participant_subject project-workspace project-workspace.materials.read project $project_id" \
      "$participant_subject evidence-service evidence-service.metadata.read file $material_file" \
      "$participant_subject evidence-service evidence-service.download file $material_file"
    do
      set -- $tuple
      [ -n "${1:-}" ] && [ -n "${5:-}" ] && revoke_resource_quiet "$1" "$2" "$3" "$4" "$5"
    done
    for tuple in \
      "$participant_subject money-flow-ledger money-flow-ledger.view" \
      "$participant_subject money-flow-ledger money-flow-ledger.statistics.read" \
      "$participant_subject money-flow-ledger money-flow-ledger.amount.read" \
      "$neighbor_subject production-operations production-work-item.read" \
      "$neighbor_subject production-operations production-work-item.work-items.read" \
      "$neighbor_subject production-operations production-work-item.stage.manage"
    do
      set -- $tuple
      [ -n "${1:-}" ] || continue
      payload=$(jq -cn --arg subject "$1" --arg audience "$2" --arg action "$3" '{subject_id:$subject,audience:$audience,action:$action}')
      curl --silent --output /dev/null --cookie "$admin_cookies" -H 'Content-Type: application/json' \
        -H "X-CSRF-Token: $admin_csrf" --data "$payload" "$base_url/auth/api/v1/admin/grants/revoke" || true
    done
  fi
  mkdir -p "$evidence_dir"
  for artifact in \
    http-evidence.tsv state-plan-c8.json state-partial-c8-work-item.json state-after-c8.json c8-summary.md \
    project-details.json project-materials.json project-materials-evidence-down.json project-materials-recovered.json \
    project-resource-links.json material-coverage.json evidence-metadata-only.json evidence-download-denied.json evidence-download-authorized.json evidence-download-only-metadata-denied.json evidence-download-only-authorized.json \
    production-work-item-reopened.json production-owner-work-items.json neighbor-work-items.json \
    workbench.html workbench-evidence-down.html workbench-production-down.html production-down.body production-owner-recovered.json \
    money-redacted.json money-stale-after-grant.json money-visible.json money-stale-after-revoke.json money-redacted-after-revoke.json \
    fact-digests-before.tsv fact-digests-after.tsv health-final.tsv
  do
    [ ! -f "$workspace/$artifact" ] || cp "$workspace/$artifact" "$evidence_dir/$artifact"
  done
  for phase in before after; do
    [ ! -d "$workspace/facts-$phase" ] || { rm -rf "$evidence_dir/facts-$phase"; cp -R "$workspace/facts-$phase" "$evidence_dir/facts-$phase"; }
  done
  rm -rf "$workspace"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

tenant_id=$(env_value TENANT_ID)
admin_username=$(env_value BOOTSTRAP_ADMIN_USERNAME admin)
admin_password=$(env_value BOOTSTRAP_ADMIN_PASSWORD)
[ -n "$tenant_id" ] && [ -n "$admin_password" ] || { echo 'TENANT_ID and BOOTSTRAP_ADMIN_PASSWORD are required' >&2; exit 2; }
[ "$(stat -c '%a' "$c1_private_state" 2>/dev/null || stat -f '%Lp' "$c1_private_state")" = 600 ] || { echo 'C1 private state must have mode 0600' >&2; exit 1; }

project_id=$(jq -er .project.id "$c7_state")
project_revision=$(jq -er .project.revision "$c7_state")
material_file=$(jq -er '.evidence[]|select(.purpose=="bid_document")|.file_id' "$c2_state")
production_assignment=$(jq -er '.assignments[]|select(.role_key=="production_owner")|.id' "$c1_state")
production_assignment_revision=$(jq -er '.assignments[]|select(.role_key=="production_owner")|.created_project_revision' "$c1_state")
production_subject=$(jq -er '.actors[]|select(.role=="production_owner")|.subject_id' "$c1_private_state")
production_username=$(jq -er '.actors[]|select(.role=="production_owner")|.username' "$c1_private_state")
production_password=$(jq -er '.actors[]|select(.role=="production_owner")|.password' "$c1_private_state")
participant_subject=$(jq -er '.actors[]|select(.role=="participant")|.subject_id' "$c1_private_state")
participant_username=$(jq -er '.actors[]|select(.role=="participant")|.username' "$c1_private_state")
participant_password=$(jq -er '.actors[]|select(.role=="participant")|.password' "$c1_private_state")
neighbor_subject=$(jq -er '.actors[]|select(.role=="neighbor")|.subject_id' "$c1_private_state")
neighbor_username=$(jq -er '.actors[]|select(.role=="neighbor")|.username' "$c1_private_state")
neighbor_password=$(jq -er '.actors[]|select(.role=="neighbor")|.password' "$c1_private_state")

for state in "$c1_state" "$c2_state" "$c4_state" "$c5_state" "$c6_state" "$c7_state"; do
  jq -e --arg tenant "$tenant_id" --arg project "$project_id" '.result=="pass" and .tenant_id==$tenant and .project.id==$project' "$state" >/dev/null || {
    echo "continuous input does not preserve the same passing Tenant/Project: $state" >&2; exit 1;
  }
done
[ "$project_revision" = 12 ] || { echo "C8 expected Project revision 12, got $project_revision" >&2; exit 1; }

admin_cookies="$workspace/admin.cookies"
admin_csrf=$(fetch_csrf "$admin_cookies" "$workspace/admin-csrf.json")
login "$admin_cookies" "$admin_csrf" "$admin_username" "$admin_password" "$workspace/admin-login.json" admin
authorize_app "$admin_cookies" "$admin_csrf" production-operations "$workspace/admin-authorize-production.out"

echo '[1/8] Reuse the exact C1 actors and append one resumable follow-up to the completed C4 work item'
mkdir -p "$evidence_dir"
if [ ! -f "$plan_state" ]; then
  jq -n --arg tenant "$tenant_id" --arg project "$project_id" --arg c7 "$(digest_file "$c7_state")" \
    --arg reopen "$(new_uuid)" \
    '{schema_version:"1",phase:"C8-plan",tenant_id:$tenant,project_id:$project,c7_state_sha256:$c7,commands:{work_item_reopen:$reopen}}' >"$plan_state"
fi
if ! jq -e '.commands.work_item_reopen' "$plan_state" >/dev/null; then
  temporary="$plan_state.tmp"
  jq --arg reopen "$(new_uuid)" '.commands.work_item_reopen=$reopen' "$plan_state" >"$temporary"
  mv "$temporary" "$plan_state"
fi
cp "$plan_state" "$workspace/state-plan-c8.json"
if [ ! -f "$fixture_state" ]; then
  work_item_id=$(jq -er .design.id "$c4_state")
  live=$(postgres_rows design_operations "SELECT jsonb_build_object('id',id,'project_id',project_id,'status',status,'revision',revision,'owner_assignment_id',owner_assignment_id,'current_stage_key',current_stage_key) FROM design_work_items WHERE tenant_id='$tenant_id' AND id='$work_item_id';")
  live_status=$(printf '%s\n' "$live" | jq -er .status)
  live_revision=$(printf '%s\n' "$live" | jq -er .revision)
  if [ "$live_status" = completed ] && [ "$live_revision" = 8 ]; then
    payload=$(jq -cn --arg command "$(jq -er .commands.work_item_reopen "$plan_state")" \
      '{command_id:$command,expected_revision:8,reason:"C8 连续旅程：完成后收到补充要求，追加一个当前个人工作项"}')
    json_request POST "$base_url/production/api/v1/production-work-items/$work_item_id/stages/construction-support/reopen" "$admin_cookies" '' "$payload" "$workspace/production-work-item-reopened.json" 200 'POST C8 reopen completed work item stage'
  elif [ "$live_status" = in-progress ] && [ "$live_revision" = 9 ]; then
    printf '%s\n' "$live" >"$workspace/production-work-item-reopened.json"
  else
    echo "C4 design work item cannot form the bounded C8 follow-up: status=$live_status revision=$live_revision" >&2
    exit 1
  fi
  jq -e --arg project "$project_id" --arg assignment "$production_assignment" '(.work_item // .) as $item | $item.project_id==$project and $item.status!="completed" and $item.status!="cancelled" and $item.owner_assignment_id==$assignment' "$workspace/production-work-item-reopened.json" >/dev/null
  jq -n --arg tenant "$tenant_id" --arg project "$project_id" --arg item "$work_item_id" --arg assignment "$production_assignment" \
    '{schema_version:"1",phase:"C8-partial-work-item",result:"resumable",tenant_id:$tenant,project_id:$project,work_item:{id:$item,revision:9,status:"in-progress",current_stage_key:"construction-support",assignment_id:$assignment},semantics:"append-only follow-up on retained C4 work item; no second Project or duplicate type"}' >"$fixture_state"
fi
cp "$fixture_state" "$workspace/state-partial-c8-work-item.json"
work_item_id=$(jq -er .work_item.id "$fixture_state")
existing=$(postgres_rows design_operations "SELECT jsonb_build_object('id',id,'project_id',project_id,'status',status,'revision',revision,'owner_assignment_id',owner_assignment_id) FROM design_work_items WHERE tenant_id='$tenant_id' AND id='$work_item_id';")
printf '%s\n' "$existing" | jq -e --arg project "$project_id" --arg assignment "$production_assignment" '.id!=null and .project_id==$project and .status!="completed" and .status!="cancelled" and .owner_assignment_id==$assignment' >/dev/null || {
  echo 'retained C8 current work item no longer matches the same Project/owner checkpoint' >&2; exit 1;
}

echo '[2/8] Grant only the C8 read surfaces to retained participant/neighbor actors'
grant_resource "$participant_subject" project-workspace project-workspace.read project "$project_id"
grant_resource "$participant_subject" project-workspace project-workspace.materials.read project "$project_id"
grant_resource "$participant_subject" evidence-service evidence-service.metadata.read file "$material_file"
grant_tenant "$participant_subject" money-flow-ledger money-flow-ledger.view
grant_tenant "$participant_subject" money-flow-ledger money-flow-ledger.statistics.read
grant_tenant "$neighbor_subject" production-operations production-work-item.read
grant_tenant "$neighbor_subject" production-operations production-work-item.work-items.read
grant_tenant "$neighbor_subject" production-operations production-work-item.stage.manage

participant_cookies="$workspace/participant.cookies"
participant_csrf=$(fetch_csrf "$participant_cookies" "$workspace/participant-csrf.json")
login "$participant_cookies" "$participant_csrf" "$participant_username" "$participant_password" "$workspace/participant-login.json" participant
authorize_app "$participant_cookies" "$participant_csrf" project-workspace "$workspace/participant-authorize-project.out" project "$project_id"
authorize_app "$participant_cookies" "$participant_csrf" evidence-service "$workspace/participant-authorize-evidence.out" file "$material_file"
authorize_app "$participant_cookies" "$participant_csrf" money-flow-ledger "$workspace/participant-authorize-money.out"

production_cookies="$workspace/production.cookies"
production_csrf=$(fetch_csrf "$production_cookies" "$workspace/production-csrf.json")
login "$production_cookies" "$production_csrf" "$production_username" "$production_password" "$workspace/production-login.json" production-owner
authorize_app "$production_cookies" "$production_csrf" production-operations "$workspace/production-authorize.out"

neighbor_cookies="$workspace/neighbor.cookies"
neighbor_csrf=$(fetch_csrf "$neighbor_cookies" "$workspace/neighbor-csrf.json")
login "$neighbor_cookies" "$neighbor_csrf" "$neighbor_username" "$neighbor_password" "$workspace/neighbor-login.json" neighbor
authorize_app "$neighbor_cookies" "$neighbor_csrf" production-operations "$workspace/neighbor-authorize.out"

echo '[3/8] Read Project links/materials and test that download requires a separate Evidence capability'
json_request GET "$base_url/project/api/v1/projects/$project_id" "$participant_cookies" '' '' "$workspace/project-details.json" 200 'GET same Project details'
json_request GET "$base_url/project/api/v1/projects/$project_id/materials" "$participant_cookies" '' '' "$workspace/project-materials.json" 200 'GET same Project materials'
jq -e --arg project "$project_id" '
  .project_id==$project and .project_revision==12 and .state=="available" and (.segments|length)==2 and
  all(.segments[];.source_application=="business-engagement" and .resource_type=="business-engagement" and .state=="available" and .evidence_version==1 and (.evidence_digest|length)==64) and
  ([..|objects|keys[]]|index("bucket")|not) and ([..|objects|keys[]]|index("object_key")|not)
' "$workspace/project-materials.json" >/dev/null || { echo 'same-Project materials did not preserve the exact C2 indirect Evidence projection' >&2; exit 1; }

