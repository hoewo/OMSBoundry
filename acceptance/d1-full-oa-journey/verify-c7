#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
d1_dir=${D1_DIR:-"$repo_dir/deployments/d1"}
env_file=${D1_ENV_FILE:-"$d1_dir/.env"}
base_url=${D1_PUBLIC_URL:?set D1_PUBLIC_URL to the Nginx entry URL}
project=${D1_PROJECT_NAME:?set D1_PROJECT_NAME to the running isolated D1 stack}
evidence_dir=${OA_JOURNEY_EVIDENCE_DIR:-"$script_dir/.evidence/c7"}
journey_dir=$(dirname "$evidence_dir")
c6_state=${OA_JOURNEY_C6_STATE:-"$journey_dir/c6/state-after-c6.json"}
c5_state=${OA_JOURNEY_C5_STATE:-"$journey_dir/c5/state-after-c5.json"}
c2_state=${OA_JOURNEY_C2_STATE:-"$journey_dir/c2/state-after-c2.json"}
c1_state=${OA_JOURNEY_C1_STATE:-"$journey_dir/c1/state-after-c1.json"}
c1_private_state=${OA_JOURNEY_C1_PRIVATE_STATE:-"$journey_dir/c1/state-private-c1.json"}
plan_state="$evidence_dir/state-plan-c7.json"
negative_state="$evidence_dir/state-partial-c7-negative.json"
links_state="$evidence_dir/state-partial-c7-source-links.json"
pools_state="$evidence_dir/state-partial-c7-pools.json"
bridge_state="$evidence_dir/state-partial-c7-party-bridge.json"
target_fault_state="$evidence_dir/state-partial-c7-target-fault.json"
suggestion_state="$evidence_dir/state-partial-c7-suggestion.json"
withdrawal_state="$evidence_dir/state-partial-c7-withdrawal.json"
completed_state="$evidence_dir/state-after-c7.json"

for required in "$env_file" "$c6_state" "$c5_state" "$c2_state" "$c1_state" "$c1_private_state"; do
  [ -f "$required" ] || { echo "required C7 input is missing: $required" >&2; exit 2; }
done
for command in curl jq openssl docker awk sed seq; do
  command -v "$command" >/dev/null 2>&1 || { echo "$command is required" >&2; exit 2; }
done

env_value() {
  key=$1; fallback=${2:-}
  value=$(awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' "$env_file")
  if [ -n "$value" ]; then printf '%s' "$value"; else printf '%s' "$fallback"; fi
}

new_uuid() {
  value=$(openssl rand -hex 16)
  printf '%s-%s-4%s-8%s-%s' \
    "$(printf '%s' "$value" | cut -c1-8)" "$(printf '%s' "$value" | cut -c9-12)" \
    "$(printf '%s' "$value" | cut -c14-16)" "$(printf '%s' "$value" | cut -c18-20)" \
    "$(printf '%s' "$value" | cut -c21-32)"
}

record_http() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$http_evidence"; }

json_request() {
  method=$1; url=$2; cookie=$3; csrf=$4; payload=$5; output=$6; expected=$7; label=$8
  set -- --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
    --request "$method" --cookie "$cookie" --cookie-jar "$cookie"
  [ -z "$csrf" ] || set -- "$@" -H "X-CSRF-Token: $csrf"
  if [ -n "$payload" ]; then set -- "$@" -H 'Content-Type: application/json' --data "$payload"; fi
  result=$(curl "$@" "$url")
  actual=${result%% *}; duration=${result#* }
  record_http "$label" "$expected" "$actual" "$duration"
  if [ "$actual" != "$expected" ]; then
    [ "$output" = /dev/null ] || [ ! -s "$output" ] || { cat "$output" >&2; printf '\n' >&2; }
    echo "$label: HTTP $actual, expected $expected" >&2
    exit 1
  fi
}

fetch_csrf() {
  cookie=$1; output=$2
  json_request GET "$base_url/auth/api/v1/csrf" "$cookie" '' '' "$output" 200 'GET /auth/api/v1/csrf'
  jq -er .csrf_token "$output"
}

login() {
  cookie=$1; csrf=$2; username=$3; password=$4; output=$5
  payload=$(jq -cn --arg username "$username" --arg password "$password" '{username:$username,password:$password}')
  json_request POST "$base_url/auth/api/v1/login" "$cookie" "$csrf" "$payload" "$output" 200 "POST login $username"
}

authorize_app() {
  cookie=$1; csrf=$2; app=$3; output=$4; resource_id=${5:-}
  set -- --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
    --cookie "$cookie" --cookie-jar "$cookie" --data-urlencode "csrf_token=$csrf"
  if [ -n "$resource_id" ]; then
    set -- "$@" --data-urlencode resource_type=project --data-urlencode "resource_id=$resource_id"
  fi
  result=$(curl "$@" "$base_url/gateway/authorize/$app")
  actual=${result%% *}; duration=${result#* }
  record_http "POST /gateway/authorize/$app" 303 "$actual" "$duration"
  [ "$actual" = 303 ] || { [ ! -s "$output" ] || cat "$output" >&2; echo "authorize $app failed: HTTP $actual" >&2; exit 1; }
}

service_container() {
  container=$(docker ps --all --quiet --filter "label=com.docker.compose.project=$project" --filter "label=com.docker.compose.service=$1")
  [ -n "$container" ] || { echo "$1 container is missing from $project" >&2; exit 1; }
  [ "$(printf '%s\n' "$container" | wc -l | tr -d ' ')" = 1 ] || { echo "$1 is not unique in $project" >&2; exit 1; }
  printf '%s' "$container"
}

wait_healthy() {
  service=$1; container=$(service_container "$service")
  for _attempt in $(seq 1 90); do
    status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container")
    [ "$status" = healthy ] && return 0
    sleep 1
  done
  echo "$service did not become healthy" >&2; exit 1
}

postgres_json() {
  database=$1; sql=$2; container=$(service_container postgres)
  docker exec "$container" sh -eu -c 'psql -U "$POSTGRES_USER" -d "$1" -At -c "$2"' sh "$database" "$sql"
}

capture_counts() {
  output=$1
  identity=$(postgres_json identity_access "SELECT jsonb_build_object('capability_grants',(SELECT count(*) FROM capability_grants));")
  bonus=$(postgres_json bonus_distribution "SELECT jsonb_build_object(
    'pools',(SELECT count(*) FROM bonus_pools),'pool_revisions',(SELECT count(*) FROM bonus_pool_revisions),
    'allocations',(SELECT count(*) FROM bonus_allocations),'allocation_revisions',(SELECT count(*) FROM bonus_allocation_revisions),
    'commands',(SELECT count(*) FROM bonus_distribution_commands),'audit_events',(SELECT count(*) FROM bonus_distribution_audit_events),
    'suggestions',(SELECT count(*) FROM bonus_payable_suggestions),'suggestion_revisions',(SELECT count(*) FROM bonus_payable_suggestion_revisions));")
  money=$(postgres_json money_flow "SELECT jsonb_build_object(
    'parties',(SELECT count(*) FROM parties),'party_runtime_projections',(SELECT count(*) FROM party_directory_runtime_projections),
    'payable_party_mappings',(SELECT count(*) FROM payable_party_source_mappings),'receipt_sets',(SELECT count(*) FROM receipt_sets),
    'intakes',(SELECT count(*) FROM payable_suggestion_intakes),'intake_revisions',(SELECT count(*) FROM payable_suggestion_intake_revisions),
    'obligations',(SELECT count(*) FROM obligations),'obligation_revisions',(SELECT count(*) FROM obligation_revisions));")
  party=$(postgres_json party_directory "SELECT jsonb_build_object('parties',(SELECT count(*) FROM parties),'revisions',(SELECT count(*) FROM party_revisions));")
  project_counts=$(postgres_json project_workspace "SELECT jsonb_build_object('projects',(SELECT count(*) FROM projects),'assignments',(SELECT count(*) FROM project_assignments),'resource_links',(SELECT count(*) FROM project_resource_links),'commands',(SELECT count(*) FROM project_commands),'history_events',(SELECT count(*) FROM project_history_events));")
  people=$(postgres_json people_groups "SELECT jsonb_build_object('persons',(SELECT count(*) FROM persons),'groups',(SELECT count(*) FROM groups),'memberships',(SELECT count(*) FROM memberships));")
  contract=$(postgres_json contract_ledger "SELECT jsonb_build_object('contracts',(SELECT count(*) FROM contracts),'revisions',(SELECT count(*) FROM contract_revisions),'settlements',(SELECT count(*) FROM contract_settlements));")
  jq -n --argjson identity "$identity" --argjson bonus "$bonus" --argjson money "$money" --argjson party "$party" \
    --argjson project "$project_counts" --argjson people "$people" --argjson contract "$contract" \
    '{identity_access:$identity,bonus_distribution:$bonus,money_flow:$money,party_directory:$party,project_workspace:$project,people_groups:$people,contract_ledger:$contract}' >"$output"
}

ensure_grant() {
  action=$1
  active=$(postgres_json identity_access "SELECT count(*) FROM capability_grants WHERE subject_id='$business_subject' AND audience='bonus-distribution' AND action='$action' AND revoked_at IS NULL;")
  case "$active" in
    0)
      payload=$(jq -cn --arg subject "$business_subject" --arg action "$action" '{subject_id:$subject,audience:"bonus-distribution",action:$action}')
      json_request POST "$base_url/auth/api/v1/admin/grants" "$admin_cookies" "$admin_csrf" "$payload" /dev/null 204 "GRANT $action"
      ;;
    1) ;;
    *) echo "unexpected active grant count for $action: $active" >&2; exit 1 ;;
  esac
}

assert_workload_audit() {
  workload=$1; audience=$2; action=$3; resource_type=$4; resource_id=$5
  count=$(postgres_json identity_access "SELECT count(*) FROM iam_audit_entries WHERE action='iam_service_credential_issued' AND details->>'workload_id'='$workload' AND details->>'audience'='$audience' AND details->'actions' @> '[\"$action\"]'::jsonb AND details->'scope'->'resources' @> '[{\"type\":\"$resource_type\",\"id\":\"$resource_id\"}]'::jsonb;")
  printf '%s\t%s\t%s\t%s\t%s\n' "$workload" "$audience" "$action" "$resource_type" "$resource_id" >>"$workspace/workload-audits.tsv"
  [ "$count" -ge 1 ] || { echo "missing exact workload audit: $workload/$audience/$action/$resource_type/$resource_id" >&2; exit 1; }
}

workspace=$(mktemp -d "${TMPDIR:-/tmp}/oms-full-oa-c7.XXXXXX")
http_evidence="$workspace/http-evidence.tsv"
printf 'request\texpected_status\tactual_status\ttime_seconds\n' >"$http_evidence"
stopped_service=''
prior_pass=false
[ ! -f "$completed_state" ] || prior_pass=true
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ -n "$stopped_service" ]; then docker start "$(service_container "$stopped_service")" >/dev/null 2>&1 || true; fi
  mkdir -p "$evidence_dir"
  for artifact in ownership-before.json ownership-after.json ownership-delta.json workload-audits.tsv receipt-set-runtime.json \
    state-plan-c7.json state-partial-c7-negative.json state-partial-c7-source-links.json state-partial-c7-pools.json state-partial-c7-party-bridge.json \
    state-partial-c7-target-fault.json state-partial-c7-suggestion.json state-partial-c7-withdrawal.json \
    stale-source.json over-allocation.json business-published.json production-published.json business-history.json production-history.json \
    person-directory-party.json party-projection.json party-projection-replay.json payable-party-map.json payable-party-map-replay.json \
    suggestion-target-unavailable.json suggestion-final.json suggestion-history.json money-intake-final.json money-intake-history.json \
    money-obligation-source.json business-withdrawn.json business-history-withdrawn.json; do
    [ ! -f "$workspace/$artifact" ] || cp "$workspace/$artifact" "$evidence_dir/$artifact"
  done
  if [ "$prior_pass" = true ]; then
    [ ! -f "$workspace/http-evidence.tsv" ] || cp "$workspace/http-evidence.tsv" "$evidence_dir/http-evidence-completed-rerun.tsv"
    [ ! -f "$workspace/state-after-c7.json" ] || cp "$workspace/state-after-c7.json" "$evidence_dir/state-after-c7-completed-rerun.json"
    [ ! -f "$workspace/c7-summary.md" ] || cp "$workspace/c7-summary.md" "$evidence_dir/c7-summary-completed-rerun.md"
  else
    [ ! -f "$workspace/http-evidence.tsv" ] || cp "$workspace/http-evidence.tsv" "$evidence_dir/http-evidence.tsv"
    [ ! -f "$workspace/state-after-c7.json" ] || cp "$workspace/state-after-c7.json" "$completed_state"
    [ ! -f "$workspace/c7-summary.md" ] || cp "$workspace/c7-summary.md" "$evidence_dir/c7-summary.md"
  fi
  rm -rf "$workspace"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

tenant_id=$(env_value TENANT_ID)
admin_username=$(env_value BOOTSTRAP_ADMIN_USERNAME admin)
admin_password=$(env_value BOOTSTRAP_ADMIN_PASSWORD)
[ -n "$tenant_id" ] && [ -n "$admin_password" ] || { echo 'TENANT_ID and BOOTSTRAP_ADMIN_PASSWORD are required' >&2; exit 2; }
[ "$(stat -c '%a' "$c1_private_state" 2>/dev/null || stat -f '%Lp' "$c1_private_state")" = 600 ] || { echo 'C1 private state must have mode 0600' >&2; exit 1; }

c6_sha=$(openssl dgst -sha256 "$c6_state" | awk '{print $2}')
c5_sha=$(openssl dgst -sha256 "$c5_state" | awk '{print $2}')
c2_sha=$(openssl dgst -sha256 "$c2_state" | awk '{print $2}')
c1_sha=$(openssl dgst -sha256 "$c1_state" | awk '{print $2}')
project_id=$(jq -er .project.id "$c6_state")
project_revision=$(jq -er .project.revision "$c6_state")
settlement_id=$(jq -er .settlement.id "$c2_state")
settlement_revision=$(jq -er .settlement.revision "$c2_state")
ledger_owner_directory=$(jq -er .parties.supplier.id "$c2_state")
business_subject=$(jq -er '.actors[]|select(.role=="business_owner")|.subject_id' "$c1_private_state")
business_username=$(jq -er '.actors[]|select(.role=="business_owner")|.username' "$c1_private_state")
business_password=$(jq -er '.actors[]|select(.role=="business_owner")|.password' "$c1_private_state")
business_person=$(jq -er '.people[]|select(.role=="business_owner")|.person_id' "$c1_state")
production_person=$(jq -er '.people[]|select(.role=="production_owner")|.person_id' "$c1_state")
business_person_revision=$(jq -er '.people[]|select(.role=="business_owner")|.person_revision' "$c1_state")
production_person_revision=$(jq -er '.people[]|select(.role=="production_owner")|.person_revision' "$c1_state")
business_assignment=$(jq -er --arg person "$business_person" '.assignments[]|select(.subject_id==$person)|.id' "$c1_state")
production_assignment=$(jq -er --arg person "$production_person" '.assignments[]|select(.subject_id==$person)|.id' "$c1_state")
business_assignment_revision=$(jq -er --arg person "$business_person" '.assignments[]|select(.subject_id==$person)|.created_project_revision' "$c1_state")
production_assignment_revision=$(jq -er --arg person "$production_person" '.assignments[]|select(.subject_id==$person)|.created_project_revision' "$c1_state")
business_display=$(jq -er --arg person "$business_person" '.assignments[]|select(.subject_id==$person)|.display_snapshot' "$c1_state")

jq -e --arg tenant "$tenant_id" --arg project "$project_id" '.phase=="C6" and .result=="pass" and .tenant_id==$tenant and .project.id==$project and .project.revision==11' "$c6_state" >/dev/null || { echo 'C6 state is not the required passing checkpoint' >&2; exit 1; }
jq -e --arg tenant "$tenant_id" --arg project "$project_id" '.phase=="C5" and .result=="pass" and .tenant_id==$tenant and .project.id==$project' "$c5_state" >/dev/null || { echo 'C5 state is not compatible with C6' >&2; exit 1; }
jq -e --arg tenant "$tenant_id" --arg project "$project_id" '.phase=="C2" and .result=="pass" and .tenant_id==$tenant and .project.id==$project and .settlement.revision==1' "$c2_state" >/dev/null || { echo 'C2 state is not compatible with C6' >&2; exit 1; }
jq -e --arg tenant "$tenant_id" --arg project "$project_id" '.phase=="C1" and .result=="pass" and .tenant_id==$tenant and .project.id==$project and (.assignments|length)==3' "$c1_state" >/dev/null || { echo 'C1 state is not compatible with C6' >&2; exit 1; }

echo '[1/9] Revalidate C6, derive the retained C3 Receipt Set, and authorize the C1 actor'
receipt_rows=$(postgres_json money_flow "SELECT coalesce(jsonb_agg(jsonb_build_object('id',id,'revision',revision,'status',status,'total_amount_minor',total_amount_minor,'currency',currency,'project_id',project_id) ORDER BY id),'[]'::jsonb) FROM receipt_sets WHERE tenant_id='$tenant_id' AND project_id='$project_id';")
printf '%s\n' "$receipt_rows" >"$workspace/receipt-set-runtime.json"
jq -e --arg project "$project_id" 'length==1 and .[0].project_id==$project and .[0].status=="confirmed" and .[0].revision==1 and .[0].currency=="CNY" and .[0].total_amount_minor==2500000' "$workspace/receipt-set-runtime.json" >/dev/null || { echo 'retained C3 Receipt Set runtime fact is not unique and exact' >&2; exit 1; }
receipt_set=$(jq -er '.[0].id' "$workspace/receipt-set-runtime.json")
receipt_sha=$(jq -Sc '.[0]' "$workspace/receipt-set-runtime.json" | openssl dgst -sha256 -r | awk '{print $1}')

admin_cookies="$workspace/admin.cookies"
admin_csrf=$(fetch_csrf "$admin_cookies" "$workspace/admin-csrf.json")
login "$admin_cookies" "$admin_csrf" "$admin_username" "$admin_password" "$workspace/admin-login.json"
authorize_app "$admin_cookies" "$admin_csrf" money-flow-ledger "$workspace/admin-authorize-money.out"
authorize_app "$admin_cookies" "$admin_csrf" party-directory "$workspace/admin-authorize-party.out"
authorize_app "$admin_cookies" "$admin_csrf" project-workspace "$workspace/admin-authorize-project.out"
mkdir -p "$evidence_dir"
if [ -f "$evidence_dir/ownership-before.json" ]; then cp "$evidence_dir/ownership-before.json" "$workspace/ownership-before.json"; else capture_counts "$workspace/ownership-before.json"; cp "$workspace/ownership-before.json" "$evidence_dir/ownership-before.json"; fi
for action in \
  bonus-pool.business.calculate bonus-pool.business.publish bonus-pool.business.withdraw \
  bonus-pool.production.calculate bonus-pool.production.publish bonus-pool.read bonus-pool.history.read \
  bonus-allocation.manage bonus-allocation.read bonus-allocation.amount.read \
  bonus-payable-suggestion.create bonus-payable-suggestion.read
do ensure_grant "$action"; done
business_cookies="$workspace/business.cookies"
business_csrf=$(fetch_csrf "$business_cookies" "$workspace/business-csrf.json")
login "$business_cookies" "$business_csrf" "$business_username" "$business_password" "$workspace/business-login.json"
authorize_app "$business_cookies" "$business_csrf" bonus-distribution "$workspace/business-authorize-bonus.out" "$project_id"

if [ ! -f "$plan_state" ]; then
  due_on=$(date -u -d '+60 days' '+%Y-%m-%d')
  jq -n --arg tenant "$tenant_id" --arg project "$project_id" --arg c6 "$c6_sha" --arg c5 "$c5_sha" --arg c2 "$c2_sha" --arg c1 "$c1_sha" --arg receipt "$receipt_set" --arg receipt_sha "$receipt_sha" --arg due "$due_on" \
    --arg stale "$(new_uuid)" --arg over "$(new_uuid)" --arg link_settlement "$(new_uuid)" --arg business "$(new_uuid)" --arg business_publish "$(new_uuid)" \
    --arg production "$(new_uuid)" --arg production_publish "$(new_uuid)" --arg party "$(new_uuid)" --arg projection "$(new_uuid)" \
    --arg mapping "$(new_uuid)" --arg suggestion "$(new_uuid)" --arg decision "$(new_uuid)" --arg synchronization "$(new_uuid)" --arg withdrawal "$(new_uuid)" \
    '{schema_version:"1",phase:"C7-plan",tenant_id:$tenant,project_id:$project,c6_state_sha256:$c6,c5_state_sha256:$c5,c2_state_sha256:$c2,c1_state_sha256:$c1,receipt_set:{id:$receipt,revision:1,sha256:$receipt_sha},due_on:$due,commands:{stale_source:$stale,over_allocation:$over,link_settlement:$link_settlement,business_draft:$business,business_publish:$business_publish,production_draft:$production,production_publish:$production_publish,party_create:$party,party_projection:$projection,payable_party_map:$mapping,suggestion:$suggestion,money_decision:$decision,synchronization:$synchronization,business_withdrawal:$withdrawal}}' >"$plan_state"
fi
if ! jq -e '.commands.link_settlement' "$plan_state" >/dev/null; then
  plan_tmp="$plan_state.tmp"
  jq --arg settlement "$(new_uuid)" '.commands.link_settlement=$settlement' "$plan_state" >"$plan_tmp"
  mv "$plan_tmp" "$plan_state"
fi
cp "$plan_state" "$workspace/state-plan-c7.json"
jq -e --arg tenant "$tenant_id" --arg project "$project_id" --arg c6 "$c6_sha" --arg receipt "$receipt_set" '.phase=="C7-plan" and .tenant_id==$tenant and .project_id==$project and .c6_state_sha256==$c6 and .receipt_set.id==$receipt' "$plan_state" >/dev/null

business_base=$(jq -cn --arg project "$project_id" --argjson project_revision "$project_revision" --arg settlement "$settlement_id" --argjson settlement_revision "$settlement_revision" --arg person "$business_person" --argjson person_revision "$business_person_revision" --arg assignment "$business_assignment" --argjson assignment_revision "$business_assignment_revision" \
  '{project:{id:$project,revision:$project_revision},source:{settlement_id:$settlement,revision:$settlement_revision},policy:{key:"reference-oa-bonus-v1",version:"1.0.0",rate_basis_points:1000,rounding:"half_up"},allocations:[{person:{id:$person,revision:$person_revision},assignment:{id:$assignment,revision:$assignment_revision},ratio_basis_points:10000,reason:"经营负责人参与 C7 连续旅程"}]}')

if [ ! -f "$negative_state" ]; then
  echo '[2/9] Reject stale source and over-allocation without writing Bonus facts'
  before_negative=$(postgres_json bonus_distribution "SELECT jsonb_build_object('pools',(SELECT count(*) FROM bonus_pools),'pool_revisions',(SELECT count(*) FROM bonus_pool_revisions),'allocations',(SELECT count(*) FROM bonus_allocations),'commands',(SELECT count(*) FROM bonus_distribution_commands));")
  stale_payload=$(printf '%s' "$business_base" | jq -c --arg command "$(jq -er .commands.stale_source "$plan_state")" '.command_id=$command|.source.revision=99')
  over_payload=$(printf '%s' "$business_base" | jq -c --arg command "$(jq -er .commands.over_allocation "$plan_state")" '.command_id=$command|.allocations[0].ratio_basis_points=10001')
  json_request POST "$base_url/bonus/api/v1/bonus-pools/business-drafts" "$business_cookies" '' "$stale_payload" "$workspace/stale-source.json" 422 'POST stale C7 Settlement revision'
  json_request POST "$base_url/bonus/api/v1/bonus-pools/business-drafts" "$business_cookies" '' "$over_payload" "$workspace/over-allocation.json" 422 'POST C7 over-allocation'
  jq -e '.error.code=="REFERENCE_OR_POLICY_INVALID" and .error.retryable==false' "$workspace/stale-source.json" >/dev/null
  jq -e '.error.code=="REFERENCE_OR_POLICY_INVALID" and .error.retryable==false' "$workspace/over-allocation.json" >/dev/null
  after_negative=$(postgres_json bonus_distribution "SELECT jsonb_build_object('pools',(SELECT count(*) FROM bonus_pools),'pool_revisions',(SELECT count(*) FROM bonus_pool_revisions),'allocations',(SELECT count(*) FROM bonus_allocations),'commands',(SELECT count(*) FROM bonus_distribution_commands));")
  [ "$before_negative" = "$after_negative" ] || { echo 'negative C7 attempts changed Bonus facts' >&2; exit 1; }
  jq -n --arg tenant "$tenant_id" --arg c6 "$c6_sha" '{schema_version:"1",phase:"C7-partial-negative",result:"resumable",tenant_id:$tenant,c6_state_sha256:$c6,checks:{stale_source_zero_write:true,over_allocation_zero_write:true}}' >"$negative_state"
fi
cp "$negative_state" "$workspace/state-partial-c7-negative.json"

if [ ! -f "$links_state" ]; then
  echo '[3/9] Append the exact Settlement link through Project Workspace'
  settlement_link=$(jq -cn --arg command "$(jq -er .commands.link_settlement "$plan_state")" --arg settlement "$settlement_id" --argjson revision "$settlement_revision" '{command_id:$command,expected_revision:11,operation:"link",target_service:"contract-ledger",resource_type:"settlement",resource_id:$settlement,source_revision:$revision,relation_key:"business-settlement",note:"C7 exact business Bonus source"}')
