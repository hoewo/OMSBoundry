#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
d1_dir=${D1_DIR:-"$repo_dir/deployments/d1"}
env_file=${D1_ENV_FILE:-"$d1_dir/.env"}
base_url=${D1_PUBLIC_URL:?set D1_PUBLIC_URL to the Nginx entry URL}
project=${D1_PROJECT_NAME:?set D1_PROJECT_NAME to the running isolated D1 stack}
evidence_dir=${OA_JOURNEY_EVIDENCE_DIR:-"$script_dir/.evidence/c5"}
c4_dir=${OA_JOURNEY_C4_DIR:-"$(dirname "$evidence_dir")/c4"}
c2_dir=${OA_JOURNEY_C2_DIR:-"$(dirname "$evidence_dir")/c2"}
c1_dir=${OA_JOURNEY_C1_DIR:-"$(dirname "$evidence_dir")/c1"}
c4_state=${OA_JOURNEY_C4_STATE:-"$c4_dir/state-after-c4.json"}
c2_state=${OA_JOURNEY_C2_STATE:-"$c2_dir/state-after-c2.json"}
c1_state=${OA_JOURNEY_C1_STATE:-"$c1_dir/state-after-c1.json"}
c1_private_state=${OA_JOURNEY_C1_PRIVATE_STATE:-"$c1_dir/state-private-c1.json"}
plan_state="$evidence_dir/state-plan-c5.json"
approval_state="$evidence_dir/state-partial-c5-approval.json"
assessment_state="$evidence_dir/state-partial-c5-assessment.json"
core_state="$evidence_dir/state-partial-c5-core.json"
fault_state="$evidence_dir/state-partial-c5-fault.json"
completed_state="$evidence_dir/state-after-c5.json"

for required in "$env_file" "$c4_state" "$c2_state" "$c1_state" "$c1_private_state"; do
  [ -f "$required" ] || { echo "required C5 input is missing: $required" >&2; exit 2; }
done
for command in curl jq openssl docker awk sed; do
  command -v "$command" >/dev/null 2>&1 || { echo "$command is required" >&2; exit 2; }
done

env_value() {
  key=$1; fallback=${2:-}
  value=$(awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' "$env_file")
  if [ -n "$value" ]; then printf '%s' "$value"; else printf '%s' "$fallback"; fi
}

new_uuid() {
  value=$(openssl rand -hex 16)
  printf '%s-%s-4%s-8%s-%s' \
    "$(printf '%s' "$value" | cut -c1-8)" "$(printf '%s' "$value" | cut -c9-12)" \
    "$(printf '%s' "$value" | cut -c14-16)" "$(printf '%s' "$value" | cut -c18-20)" \
    "$(printf '%s' "$value" | cut -c21-32)"
}

expect_status() {
  expected=$1; actual=$2; label=$3
  [ "$actual" = "$expected" ] || { echo "$label: HTTP $actual, expected $expected" >&2; exit 1; }
}

record_http() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$http_evidence"; }

json_request() {
  method=$1; url=$2; cookie=$3; csrf=$4; payload=$5; output=$6; expected=$7; label=$8; idempotency=${9:-}
  set -- --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
    --request "$method" --cookie "$cookie" --cookie-jar "$cookie"
  [ -z "$csrf" ] || set -- "$@" -H "X-CSRF-Token: $csrf"
  [ -z "$idempotency" ] || set -- "$@" -H "Idempotency-Key: $idempotency"
  if [ -n "$payload" ]; then set -- "$@" -H 'Content-Type: application/json' --data "$payload"; fi
  result=$(curl "$@" "$url")
  actual=${result%% *}; duration=${result#* }
  record_http "$label" "$expected" "$actual" "$duration"
  if [ "$actual" != "$expected" ] && [ "$output" != /dev/null ] && [ -s "$output" ]; then cat "$output" >&2; printf '\n' >&2; fi
  expect_status "$expected" "$actual" "$label"
}

fetch_csrf() {
  cookie=$1; output=$2
  json_request GET "$base_url/auth/api/v1/csrf" "$cookie" '' '' "$output" 200 'GET /auth/api/v1/csrf'
  jq -er .csrf_token "$output"
}

login() {
  cookie=$1; csrf=$2; username=$3; password=$4; output=$5
  payload=$(jq -cn --arg username "$username" --arg password "$password" '{username:$username,password:$password}')
  json_request POST "$base_url/auth/api/v1/login" "$cookie" "$csrf" "$payload" "$output" 200 "POST login $username"
}

authorize_app() {
  cookie=$1; csrf=$2; app=$3; output=$4; resource_id=${5:-}
  set -- --silent --show-error --output "$output" --write-out '%{http_code} %{time_total}' \
    --cookie "$cookie" --cookie-jar "$cookie" --data-urlencode "csrf_token=$csrf"
  if [ -n "$resource_id" ]; then
    set -- "$@" --data-urlencode resource_type=project --data-urlencode "resource_id=$resource_id"
  fi
  result=$(curl "$@" "$base_url/gateway/authorize/$app")
  actual=${result%% *}; duration=${result#* }
  record_http "POST /gateway/authorize/$app" 303 "$actual" "$duration"
  [ "$actual" = 303 ] || { [ ! -s "$output" ] || cat "$output" >&2; }
  expect_status 303 "$actual" "authorize $app"
}

service_container() {
  container=$(docker ps --all --quiet --filter "label=com.docker.compose.project=$project" --filter "label=com.docker.compose.service=$1")
  [ -n "$container" ] || { echo "$1 container is missing from $project" >&2; exit 1; }
  [ "$(printf '%s\n' "$container" | wc -l | tr -d ' ')" = 1 ] || { echo "$1 is not unique in $project" >&2; exit 1; }
  printf '%s' "$container"
}

wait_healthy() {
  service=$1; container=$(service_container "$service")
  for _attempt in $(seq 1 90); do
    status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container")
    [ "$status" = healthy ] && return 0
    sleep 1
  done
  echo "$service did not become healthy" >&2; exit 1
}

postgres_json() {
  database=$1; sql=$2; container=$(service_container postgres)
  docker exec "$container" sh -eu -c 'psql -U "$POSTGRES_USER" -d "$1" -At -c "$2"' sh "$database" "$sql"
}

capture_counts() {
  output=$1
  identity=$(postgres_json identity_access "SELECT jsonb_build_object('capability_grants',(SELECT count(*) FROM capability_grants));")
  results=$(postgres_json approval_audit_results "SELECT jsonb_build_object('results',(SELECT count(*) FROM approval_audit_results),'revisions',(SELECT count(*) FROM approval_audit_result_revisions),'commands',(SELECT count(*) FROM approval_audit_result_commands),'audit_events',(SELECT count(*) FROM approval_audit_result_audit_events));")
  project_counts=$(postgres_json project_workspace "SELECT jsonb_build_object('projects',(SELECT count(*) FROM projects),'resource_links',(SELECT count(*) FROM project_resource_links),'commands',(SELECT count(*) FROM project_commands),'history_events',(SELECT count(*) FROM project_history_events),'completion_confirmations',(SELECT count(*) FROM project_completion_confirmations));")
  contract=$(postgres_json contract_ledger "SELECT jsonb_build_object('contracts',(SELECT count(*) FROM contracts),'revisions',(SELECT count(*) FROM contract_revisions));")
  evidence=$(postgres_json evidence_service "SELECT jsonb_build_object('files',(SELECT count(*) FROM files),'versions',(SELECT count(*) FROM file_versions));")
  people=$(postgres_json people_groups "SELECT jsonb_build_object('persons',(SELECT count(*) FROM persons),'groups',(SELECT count(*) FROM groups));")
  production=$(postgres_json design_operations "SELECT jsonb_build_object('work_items',(SELECT count(*) FROM design_work_items));")
  jq -n --argjson identity "$identity" --argjson results "$results" --argjson project "$project_counts" \
    --argjson contract "$contract" --argjson evidence "$evidence" --argjson people "$people" --argjson production "$production" \
    '{identity_access:$identity,approval_audit_results:$results,project_workspace:$project,contract_ledger:$contract,evidence_service:$evidence,people_groups:$people,production_operations:$production}' >"$output"
}

ensure_grant() {
  subject=$1; action=$2
  active=$(postgres_json identity_access "SELECT count(*) FROM capability_grants WHERE subject_id='$subject' AND audience='approval-audit-results' AND action='$action' AND revoked_at IS NULL;")
  case "$active" in
    0)
      payload=$(jq -cn --arg subject "$subject" --arg action "$action" '{subject_id:$subject,audience:"approval-audit-results",action:$action}')
      json_request POST "$base_url/auth/api/v1/admin/grants" "$admin_cookies" "$admin_csrf" "$payload" /dev/null 204 "GRANT $action to $subject"
      ;;
    1) ;;
    *) echo "unexpected active grant count for $subject $action: $active" >&2; exit 1 ;;
  esac
}

set_grant() {
  subject=$1; action=$2; operation=$3
  endpoint=grants; [ "$operation" != revoke ] || endpoint=grants/revoke
  payload=$(jq -cn --arg subject "$subject" --arg action "$action" '{subject_id:$subject,audience:"approval-audit-results",action:$action}')
  json_request POST "$base_url/auth/api/v1/admin/$endpoint" "$admin_cookies" "$admin_csrf" "$payload" /dev/null 204 "$operation $action"
}

assert_final_results() {
  json_request GET "$base_url/results/api/v1/approval-audit-results/$approval_id" "$business_cookies" '' '' "$workspace/approval-final.json" 200 'GET final approval result'
  json_request GET "$base_url/results/api/v1/approval-audit-results/$audit_id" "$business_cookies" '' '' "$workspace/audit-final.json" 200 'GET final audit result'
  jq -e --arg project "$project_id" --arg contract "$contract_id" --arg file "$evidence_file" '
    .project.id==$project and .project.revision==11 and .kind=="approval" and .state=="recorded" and .revision==2 and
    .source.resource_id==$contract and .source.revision==1 and .evidence[0].file_id==$file and .evidence[0].version==1 and
    .external_confirmed_by=="C5 连续旅程更正后的外部批复登记"
  ' "$workspace/approval-final.json" >/dev/null
  jq -e --arg project "$project_id" --arg approval "$approval_id" '
    .project.id==$project and .project.revision==10 and .kind=="audit" and .state=="recorded" and .revision==1 and
    .source.resource_id==$approval and .source.revision==1
  ' "$workspace/audit-final.json" >/dev/null
  json_request GET "$base_url/results/api/v1/approval-audit-results/$approval_id/history" "$business_cookies" '' '' "$workspace/approval-history.json" 200 'GET final approval history'
  json_request GET "$base_url/results/api/v1/approval-audit-results/$audit_id/history" "$business_cookies" '' '' "$workspace/audit-history.json" 200 'GET final audit history'
  jq -e '[.items[].event_kind]==["recorded","corrected"] and [.items[].revision]==[1,2]' "$workspace/approval-history.json" >/dev/null
  jq -e '[.items[].event_kind]==["recorded"] and [.items[].revision]==[1]' "$workspace/audit-history.json" >/dev/null
  json_request GET "$base_url/project/api/v1/projects/$project_id/completion-assessment?profile=reference-oa-c5-v1" "$admin_cookies" '' '' "$workspace/assessment-final.json" 200 'GET final C5 completion assessment'
  jq -e '.project_revision==11 and .overall_status=="satisfied" and .drifted==true and .latest_confirmation.confirmed_project_revision==11' "$workspace/assessment-final.json" >/dev/null
}

workspace=$(mktemp -d "${TMPDIR:-/tmp}/oms-full-oa-c5.XXXXXX")
http_evidence="$workspace/http-evidence.tsv"
printf 'request\texpected_status\tactual_status\ttime_seconds\n' >"$http_evidence"
stopped_service=''
prior_pass=false
[ ! -f "$completed_state" ] || prior_pass=true
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ -n "$stopped_service" ]; then docker start "$(service_container "$stopped_service")" >/dev/null 2>&1 || true; fi
  mkdir -p "$evidence_dir"
  for artifact in ownership-before.json ownership-after.json ownership-delta.json state-plan-c5.json \
    state-partial-c5-approval.json state-partial-c5-assessment.json state-partial-c5-core.json state-partial-c5-fault.json \
    approval-final.json audit-final.json approval-history.json audit-history.json assessment-final.json dependency-fault.json results-fault.json; do
    [ ! -f "$workspace/$artifact" ] || cp "$workspace/$artifact" "$evidence_dir/$artifact"
  done
  if [ "$prior_pass" = true ]; then
    [ ! -f "$workspace/http-evidence.tsv" ] || cp "$workspace/http-evidence.tsv" "$evidence_dir/http-evidence-completed-rerun.tsv"
    [ ! -f "$workspace/state-after-c5.json" ] || cp "$workspace/state-after-c5.json" "$evidence_dir/state-after-c5-completed-rerun.json"
    [ ! -f "$workspace/c5-summary.md" ] || cp "$workspace/c5-summary.md" "$evidence_dir/c5-summary-completed-rerun.md"
  else
    [ ! -f "$workspace/http-evidence.tsv" ] || cp "$workspace/http-evidence.tsv" "$evidence_dir/http-evidence.tsv"
    [ ! -f "$workspace/state-after-c5.json" ] || cp "$workspace/state-after-c5.json" "$completed_state"
    [ ! -f "$workspace/c5-summary.md" ] || cp "$workspace/c5-summary.md" "$evidence_dir/c5-summary.md"
  fi
  rm -rf "$workspace"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

tenant_id=$(env_value TENANT_ID)
admin_username=$(env_value BOOTSTRAP_ADMIN_USERNAME admin)
admin_password=$(env_value BOOTSTRAP_ADMIN_PASSWORD)
[ -n "$tenant_id" ] && [ -n "$admin_password" ] || { echo 'TENANT_ID and BOOTSTRAP_ADMIN_PASSWORD are required' >&2; exit 2; }
c4_sha=$(openssl dgst -sha256 "$c4_state" | awk '{print $2}')
c2_sha=$(openssl dgst -sha256 "$c2_state" | awk '{print $2}')
jq -e --arg tenant "$tenant_id" '.phase=="C4" and .result=="pass" and .tenant_id==$tenant and .project.status=="active" and .project.revision==10' "$c4_state" >/dev/null || { echo 'C4 state is not the required passing checkpoint' >&2; exit 1; }
jq -e --arg tenant "$tenant_id" --arg project "$(jq -er .project.id "$c4_state")" '.phase=="C2" and .result=="pass" and .tenant_id==$tenant and .project.id==$project and .contract.status=="active" and .contract.revision==1' "$c2_state" >/dev/null || { echo 'C2 source state is not compatible with C4' >&2; exit 1; }
[ "$(stat -c '%a' "$c1_private_state" 2>/dev/null || stat -f '%Lp' "$c1_private_state")" = 600 ] || { echo 'C1 private state must have mode 0600' >&2; exit 1; }

project_id=$(jq -er .project.id "$c4_state")
contract_id=$(jq -er .contract.id "$c2_state")
contract_revision=$(jq -er .contract.revision "$c2_state")
evidence_file=$(jq -er '.evidence[]|select(.purpose=="award_document")|.file_id' "$c2_state")
evidence_version=$(jq -er '.evidence[]|select(.purpose=="award_document")|.version' "$c2_state")
business_subject=$(jq -er '.actors[]|select(.role=="business_owner")|.subject_id' "$c1_private_state")
business_username=$(jq -er '.actors[]|select(.role=="business_owner")|.username' "$c1_private_state")
business_password=$(jq -er '.actors[]|select(.role=="business_owner")|.password' "$c1_private_state")
observer_subject=$(jq -er '.actors[]|select(.role=="participant")|.subject_id' "$c1_private_state")
observer_username=$(jq -er '.actors[]|select(.role=="participant")|.username' "$c1_private_state")
observer_password=$(jq -er '.actors[]|select(.role=="participant")|.password' "$c1_private_state")

echo '[1/8] Revalidate C4 and authorize the retained C1 actors through IAM'
admin_cookies="$workspace/admin.cookies"
admin_csrf=$(fetch_csrf "$admin_cookies" "$workspace/admin-csrf.json")
login "$admin_cookies" "$admin_csrf" "$admin_username" "$admin_password" "$workspace/admin-login.json"
authorize_app "$admin_cookies" "$admin_csrf" project-workspace "$workspace/admin-authorize-project.out"
if [ -f "$evidence_dir/ownership-before.json" ]; then cp "$evidence_dir/ownership-before.json" "$workspace/ownership-before.json"; else capture_counts "$workspace/ownership-before.json"; fi
for action in approval-audit-result.create approval-audit-result.read approval-audit-result.amount.read approval-audit-result.correct approval-audit-result.withdraw approval-audit-result.evidence.manage approval-audit-result.history.read; do
  ensure_grant "$business_subject" "$action"
done
ensure_grant "$observer_subject" approval-audit-result.read

business_cookies="$workspace/business-owner.cookies"
business_csrf=$(fetch_csrf "$business_cookies" "$workspace/business-owner-csrf.json")
login "$business_cookies" "$business_csrf" "$business_username" "$business_password" "$workspace/business-owner-login.json"
authorize_app "$business_cookies" "$business_csrf" approval-audit-results "$workspace/business-owner-authorize.out" "$project_id"
observer_cookies="$workspace/observer.cookies"
observer_csrf=$(fetch_csrf "$observer_cookies" "$workspace/observer-csrf.json")
login "$observer_cookies" "$observer_csrf" "$observer_username" "$observer_password" "$workspace/observer-login.json"
authorize_app "$observer_cookies" "$observer_csrf" approval-audit-results "$workspace/observer-authorize.out" "$project_id"

if [ ! -f "$plan_state" ]; then
  mkdir -p "$evidence_dir"
  stamp="$(date -u '+%Y%m%dT%H%M%SZ')-$(openssl rand -hex 3)"
  confirmed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  jq -n --arg tenant "$tenant_id" --arg project "$project_id" --arg c4 "$c4_sha" --arg c2 "$c2_sha" --arg stamp "$stamp" --arg confirmed "$confirmed_at" \
    --arg approval "$(new_uuid)" --arg audit "$(new_uuid)" --arg confirm "$(new_uuid)" --arg correct "$(new_uuid)" --arg confirm_down "$(new_uuid)" \
    '{schema_version:"1",phase:"C5-plan",tenant_id:$tenant,project_id:$project,c4_state_sha256:$c4,c2_state_sha256:$c2,stamp:$stamp,external_confirmed_at:$confirmed,commands:{approval:$approval,audit:$audit,confirmation:$confirm,correction:$correct,new_confirmation_during_outage:$confirm_down}}' >"$plan_state"
fi
cp "$plan_state" "$workspace/state-plan-c5.json"
jq -e --arg tenant "$tenant_id" --arg project "$project_id" --arg c4 "$c4_sha" --arg c2 "$c2_sha" '.phase=="C5-plan" and .tenant_id==$tenant and .project_id==$project and .c4_state_sha256==$c4 and .c2_state_sha256==$c2' "$plan_state" >/dev/null

approval_payload=$(jq -cn --arg command "$(jq -er .commands.approval "$plan_state")" --arg project "$project_id" --arg contract "$contract_id" \
  --arg file "$evidence_file" --argjson version "$evidence_version" --arg confirmed "$(jq -er .external_confirmed_at "$plan_state")" \
  '{command_id:$command,expected_revision:0,project_ref:{id:$project,revision:10},kind:"approval",currency:"CNY",source_ref:{application:"contract-ledger",resource_type:"contract",resource_id:$contract,revision:1},evidence_refs:[{file_id:$file,version:$version,slot:"approval_document"}],external_confirmed_by:"C5 连续旅程外部批复登记",external_confirmed_at:$confirmed}')

if [ ! -f "$approval_state" ]; then
  echo '[2/8] Prove Evidence and Contract outages write no Results, then recover one approval'
  json_request GET "$base_url/results/api/v1/approval-audit-results?project_id=$project_id" "$business_cookies" '' '' "$workspace/results-before.json" 200 'GET Results before C5 writes'
  jq -e '.items==[]' "$workspace/results-before.json" >/dev/null || { echo 'C5 Project already has Results without a checkpoint' >&2; exit 1; }
  evidence_container=$(service_container evidence-service)
  docker stop "$evidence_container" >/dev/null; stopped_service=evidence-service
  json_request POST "$base_url/results/api/v1/approval-audit-results" "$business_cookies" '' "$approval_payload" "$workspace/approval-evidence-down.json" 503 'POST approval with Evidence down'
  json_request GET "$base_url/results/api/v1/approval-audit-results?project_id=$project_id" "$business_cookies" '' '' "$workspace/results-after-evidence-failure.json" 200 'GET Results after Evidence failure'
  jq -e '.items==[]' "$workspace/results-after-evidence-failure.json" >/dev/null
  docker start "$evidence_container" >/dev/null; wait_healthy evidence-service; stopped_service=''
  contract_container=$(service_container contract-ledger)
  docker stop "$contract_container" >/dev/null; stopped_service=contract-ledger
  json_request POST "$base_url/results/api/v1/approval-audit-results" "$business_cookies" '' "$approval_payload" "$workspace/approval-contract-down.json" 503 'POST approval with Contract down'
  json_request GET "$base_url/results/api/v1/approval-audit-results?project_id=$project_id" "$business_cookies" '' '' "$workspace/results-after-contract-failure.json" 200 'GET Results after Contract failure'
  jq -e '.items==[]' "$workspace/results-after-contract-failure.json" >/dev/null
  docker start "$contract_container" >/dev/null; wait_healthy contract-ledger; stopped_service=''
  json_request POST "$base_url/results/api/v1/approval-audit-results" "$business_cookies" '' "$approval_payload" "$workspace/approval-created.json" 201 'POST approval after dependency recovery'
  approval_id=$(jq -er .id "$workspace/approval-created.json")
  jq -e --arg project "$project_id" --arg contract "$contract_id" --arg file "$evidence_file" '.project.id==$project and .project.revision==10 and .kind=="approval" and .state=="recorded" and .revision==1 and .source.resource_id==$contract and .source.revision==1 and .evidence[0].file_id==$file' "$workspace/approval-created.json" >/dev/null
  json_request POST "$base_url/results/api/v1/approval-audit-results" "$business_cookies" '' "$approval_payload" "$workspace/approval-replay.json" 201 'REPLAY approval after dependency recovery'
  jq -e --arg id "$approval_id" '.id==$id and .revision==1' "$workspace/approval-replay.json" >/dev/null
  jq -n --arg tenant "$tenant_id" --arg c4 "$c4_sha" --arg approval "$approval_id" \
    '{schema_version:"1",phase:"C5-partial-approval",result:"resumable",tenant_id:$tenant,c4_state_sha256:$c4,approval:{id:$approval,revision:1},checks:{evidence_failure_zero_write:true,contract_failure_zero_write:true,same_command_recovery:true}}' >"$approval_state"
  jq -n --arg approval "$approval_id" '{phase:"C5-dependency-fault",result:"pass",approval_id:$approval,evidence_failure_zero_write:true,contract_failure_zero_write:true,same_command_recovery_single_commit:true}' >"$workspace/dependency-fault.json"
  cp "$workspace/dependency-fault.json" "$evidence_dir/dependency-fault.json"
fi
cp "$approval_state" "$workspace/state-partial-c5-approval.json"
jq -e --arg tenant "$tenant_id" --arg c4 "$c4_sha" '.phase=="C5-partial-approval" and .tenant_id==$tenant and .c4_state_sha256==$c4 and .approval.revision==1' "$approval_state" >/dev/null
approval_id=$(jq -er .approval.id "$approval_state")

audit_payload=$(jq -cn --arg command "$(jq -er .commands.audit "$plan_state")" --arg project "$project_id" --arg approval "$approval_id" --arg confirmed "$(jq -er .external_confirmed_at "$plan_state")" \
  '{command_id:$command,expected_revision:0,project_ref:{id:$project,revision:10},kind:"audit",currency:"CNY",source_ref:{application:"approval-audit-results",resource_type:"approval-result",resource_id:$approval,revision:1},external_confirmed_by:"C5 连续旅程外部审计登记",external_confirmed_at:$confirmed}')

if [ ! -f "$assessment_state" ]; then
  echo '[3/8] Register audit, prove amount redaction, and evaluate without writing Project'
  json_request POST "$base_url/results/api/v1/approval-audit-results" "$business_cookies" '' "$audit_payload" "$workspace/audit-created.json" 201 'POST audit from approval revision 1'
  audit_id=$(jq -er .id "$workspace/audit-created.json")
  jq -e --arg project "$project_id" --arg approval "$approval_id" '.project.id==$project and .project.revision==10 and .kind=="audit" and .state=="recorded" and .revision==1 and .source.resource_id==$approval and .source.revision==1' "$workspace/audit-created.json" >/dev/null
  json_request GET "$base_url/results/api/v1/approval-audit-results?project_id=$project_id" "$observer_cookies" '' '' "$workspace/observer-results.json" 200 'GET C5 Results without amount capability'
  jq -e '(.items|length)==2 and all(.items[];has("total_amount_minor")|not) and all(.items[];(.allowed_actions|sort)==["approval-audit-result.read"])' "$workspace/observer-results.json" >/dev/null
  before_revision=$(postgres_json project_workspace "SELECT revision FROM projects WHERE tenant_id='$tenant_id' AND id='$project_id';")
  before_confirmations=$(postgres_json project_workspace "SELECT count(*) FROM project_completion_confirmations WHERE tenant_id='$tenant_id' AND project_id='$project_id';")
  json_request GET "$base_url/project/api/v1/projects/$project_id/completion-assessment?profile=reference-oa-c5-v1" "$admin_cookies" '' '' "$workspace/assessment-ready.json" 200 'GET C5 completion assessment without write'
  jq -e '.project_revision==10 and .overall_status=="satisfied" and .drifted==false and all(.requirements[];.status=="satisfied")' "$workspace/assessment-ready.json" >/dev/null
  [ "$before_revision" = 10 ] && [ "$before_confirmations" = 0 ] || { echo 'Project C5 baseline is unexpected' >&2; exit 1; }
  [ "$(postgres_json project_workspace "SELECT revision FROM projects WHERE tenant_id='$tenant_id' AND id='$project_id';")" = 10 ] || { echo 'completion GET changed Project revision' >&2; exit 1; }
  [ "$(postgres_json project_workspace "SELECT count(*) FROM project_completion_confirmations WHERE tenant_id='$tenant_id' AND project_id='$project_id';")" = 0 ] || { echo 'completion GET created a confirmation' >&2; exit 1; }
  expected_sources=$(jq -c '[.requirements[]|{requirement_key:.key,result_id:.source.id,result_kind:.source.kind,revision:.source.revision,digest:.source.digest}]' "$workspace/assessment-ready.json")
  jq -n --arg tenant "$tenant_id" --arg c4 "$c4_sha" --arg approval "$approval_id" --arg audit "$audit_id" --argjson sources "$expected_sources" \
    '{schema_version:"1",phase:"C5-partial-assessment",result:"resumable",tenant_id:$tenant,c4_state_sha256:$c4,approval:{id:$approval,revision:1},audit:{id:$audit,revision:1},project_revision:10,expected_sources:$sources,checks:{amount_redacted_not_zero:true,assessment_get_zero_write:true}}' >"$assessment_state"
fi
cp "$assessment_state" "$workspace/state-partial-c5-assessment.json"
jq -e --arg tenant "$tenant_id" --arg c4 "$c4_sha" --arg approval "$approval_id" '.phase=="C5-partial-assessment" and .tenant_id==$tenant and .c4_state_sha256==$c4 and .approval.id==$approval and .audit.revision==1 and .project_revision==10 and (.expected_sources|length)==2' "$assessment_state" >/dev/null
audit_id=$(jq -er .audit.id "$assessment_state")
expected_sources=$(jq -c .expected_sources "$assessment_state")
confirmation_payload=$(jq -cn --arg command "$(jq -er .commands.confirmation "$plan_state")" --argjson sources "$expected_sources" '{command_id:$command,expected_revision:10,profile_key:"reference-oa-c5-v1",expected_sources:$sources}')

if [ ! -f "$core_state" ]; then
  echo '[4/8] Confirm the Project checkpoint, then correct Results and expose source drift'
  json_request POST "$base_url/project/api/v1/projects/$project_id/completion-confirmations" "$admin_cookies" '' "$confirmation_payload" "$workspace/confirmation.json" 200 'POST C5 completion confirmation'
  jq -e '.observed_project_revision==10 and .confirmed_project_revision==11 and (.sources|length)==2' "$workspace/confirmation.json" >/dev/null
  json_request GET "$base_url/project/api/v1/projects/$project_id/completion-assessment?profile=reference-oa-c5-v1" "$admin_cookies" '' '' "$workspace/assessment-confirmed.json" 200 'GET confirmed C5 assessment'
  jq -e '.project_revision==11 and .overall_status=="satisfied" and .drifted==false and .latest_confirmation.confirmed_project_revision==11' "$workspace/assessment-confirmed.json" >/dev/null

  set_grant "$business_subject" approval-audit-result.correct revoke
  authorize_app "$business_cookies" "$business_csrf" approval-audit-results "$workspace/business-owner-correct-revoked.out" "$project_id"
  correction_payload=$(jq -cn --arg command "$(jq -er .commands.correction "$plan_state")" --arg contract "$contract_id" --arg file "$evidence_file" --argjson version "$evidence_version" --arg confirmed "$(jq -er .external_confirmed_at "$plan_state")" \
    '{command_id:$command,expected_revision:1,reason:"C5 连续旅程更正外部确认人",currency:"CNY",source_ref:{application:"contract-ledger",resource_type:"contract",resource_id:$contract,revision:1},evidence_refs:[{file_id:$file,version:$version,slot:"approval_document"}],external_confirmed_by:"C5 连续旅程更正后的外部批复登记",external_confirmed_at:$confirmed}')
  json_request POST "$base_url/results/api/v1/approval-audit-results/$approval_id/corrections" "$business_cookies" '' "$correction_payload" "$workspace/correction-denied.json" 403 'POST correction after capability revoke'
  set_grant "$business_subject" approval-audit-result.correct grant
  authorize_app "$business_cookies" "$business_csrf" approval-audit-results "$workspace/business-owner-correct-restored.out" "$project_id"
  json_request POST "$base_url/results/api/v1/approval-audit-results/$approval_id/corrections" "$business_cookies" '' "$correction_payload" "$workspace/approval-corrected.json" 200 'POST approval correction after Project confirmation'
  jq -e '.revision==2 and .project.revision==11 and .external_confirmed_by=="C5 连续旅程更正后的外部批复登记"' "$workspace/approval-corrected.json" >/dev/null
  json_request GET "$base_url/project/api/v1/projects/$project_id/completion-assessment?profile=reference-oa-c5-v1" "$admin_cookies" '' '' "$workspace/assessment-drifted.json" 200 'GET C5 assessment with source drift'
  jq -e '.project_revision==11 and .overall_status=="satisfied" and .drifted==true and .latest_confirmation.confirmed_project_revision==11' "$workspace/assessment-drifted.json" >/dev/null
  jq -n --arg tenant "$tenant_id" --arg c4 "$c4_sha" --arg approval "$approval_id" --arg audit "$audit_id" --arg confirm "$(jq -er .id "$workspace/confirmation.json")" \
    --argjson sources "$expected_sources" '{schema_version:"1",phase:"C5-partial-core",result:"resumable",tenant_id:$tenant,c4_state_sha256:$c4,project_revision:11,approval:{id:$approval,revision:2},audit:{id:$audit,revision:1},confirmation:{id:$confirm,revision:11,sources:$sources},checks:{capability_revoke_denied:true,correction_appended:true,source_drift_visible:true}}' >"$core_state"
fi
cp "$core_state" "$workspace/state-partial-c5-core.json"
jq -e --arg tenant "$tenant_id" --arg c4 "$c4_sha" --arg approval "$approval_id" --arg audit "$audit_id" '.phase=="C5-partial-core" and .tenant_id==$tenant and .c4_state_sha256==$c4 and .project_revision==11 and .approval.id==$approval and .approval.revision==2 and .audit.id==$audit and .audit.revision==1' "$core_state" >/dev/null

if [ ! -f "$fault_state" ]; then
  echo '[5/8] Stop only Results: GET degrades, old confirmation replays, new confirmation fails closed'
  results_container=$(service_container approval-audit-results)
  docker stop "$results_container" >/dev/null; stopped_service=approval-audit-results
  json_request GET "$base_url/project/api/v1/projects/$project_id/completion-assessment?profile=reference-oa-c5-v1" "$admin_cookies" '' '' "$workspace/assessment-unavailable.json" 200 'GET C5 assessment with Results down'
  jq -e '.project_revision==11 and .overall_status=="unavailable" and all(.requirements[];.status=="unavailable")' "$workspace/assessment-unavailable.json" >/dev/null
  json_request POST "$base_url/project/api/v1/projects/$project_id/completion-confirmations" "$admin_cookies" '' "$confirmation_payload" "$workspace/confirmation-replay-down.json" 200 'REPLAY successful confirmation with Results down'
  jq -e '.confirmed_project_revision==11' "$workspace/confirmation-replay-down.json" >/dev/null
  new_confirmation=$(jq -cn --arg command "$(jq -er .commands.new_confirmation_during_outage "$plan_state")" --argjson sources "$expected_sources" '{command_id:$command,expected_revision:11,profile_key:"reference-oa-c5-v1",expected_sources:$sources}')
  json_request POST "$base_url/project/api/v1/projects/$project_id/completion-confirmations" "$admin_cookies" '' "$new_confirmation" "$workspace/confirmation-new-down.json" 503 'POST new confirmation with Results down'
  json_request GET "$base_url/project/api/v1/projects/$project_id" "$admin_cookies" '' '' "$workspace/project-after-results-failure.json" 200 'GET Project after failed C5 confirmation'
  jq -e '.project.revision==11 and .project.status=="active"' "$workspace/project-after-results-failure.json" >/dev/null
  docker start "$results_container" >/dev/null; wait_healthy approval-audit-results; stopped_service=''
  json_request GET "$base_url/project/api/v1/projects/$project_id/completion-assessment?profile=reference-oa-c5-v1" "$admin_cookies" '' '' "$workspace/assessment-recovered.json" 200 'GET C5 assessment after Results recovery'
  jq -e '.project_revision==11 and .overall_status=="satisfied" and .drifted==true' "$workspace/assessment-recovered.json" >/dev/null
  jq -n --arg tenant "$tenant_id" --arg c4 "$c4_sha" '{schema_version:"1",phase:"C5-partial-fault",result:"resumable",tenant_id:$tenant,c4_state_sha256:$c4,checks:{results_unavailable_projection:true,successful_confirmation_local_replay:true,new_confirmation_failure_zero_write:true,recovered_with_drift:true}}' >"$fault_state"
  jq -n --arg project "$project_id" '{phase:"C5-results-fault",result:"pass",project_id:$project,successful_confirmation_local_replay:true,new_confirmation_failure_zero_write:true,recovered_with_drift:true}' >"$workspace/results-fault.json"
  cp "$workspace/results-fault.json" "$evidence_dir/results-fault.json"
fi
cp "$fault_state" "$workspace/state-partial-c5-fault.json"
jq -e --arg tenant "$tenant_id" --arg c4 "$c4_sha" '.phase=="C5-partial-fault" and .tenant_id==$tenant and .c4_state_sha256==$c4 and .checks.new_confirmation_failure_zero_write==true' "$fault_state" >/dev/null

echo '[6/8] Re-read final facts, immutable histories and exact workload scopes'
assert_final_results
for expectation in \
  "approval-audit-results|project-workspace|project-workspace.read|project|$project_id" \
  "approval-audit-results|contract-ledger|contract-ledger.reference.read|contract|$contract_id" \
  "approval-audit-results|evidence-service|evidence-service.view|file|$evidence_file" \
  "project-workspace|approval-audit-results|approval-audit-result.read|project|$project_id"
do
  IFS='|' read -r workload audience action type id <<EOF
$expectation
EOF
  count=$(postgres_json identity_access "SELECT count(*) FROM iam_audit_entries WHERE action='iam_service_credential_issued' AND details->>'workload_id'='$workload' AND details->>'audience'='$audience' AND details->'actions' @> '[\"$action\"]'::jsonb AND details->'scope'->'resources' @> '[{\"type\":\"$type\",\"id\":\"$id\"}]'::jsonb;")
  [ "$count" -ge 1 ] || { echo "missing exact workload credential audit: $expectation" >&2; exit 1; }
done

echo '[7/8] Prove exact application ownership deltas'
capture_counts "$workspace/ownership-after.json"
jq -n --slurpfile before "$workspace/ownership-before.json" --slurpfile after "$workspace/ownership-after.json" '
  $after[0] as $a | $before[0] as $b |
  reduce ($a|keys[]) as $app ({};.[$app]=reduce ($a[$app]|keys[]) as $key ({};.[$key]=($a[$app][$key]-$b[$app][$key])))
' >"$workspace/ownership-delta.json"
jq -e '
  .identity_access.capability_grants==8 and
  .approval_audit_results.results==2 and .approval_audit_results.revisions==3 and .approval_audit_results.commands==3 and .approval_audit_results.audit_events==3 and
  .project_workspace.projects==0 and .project_workspace.resource_links==0 and .project_workspace.commands==1 and .project_workspace.history_events==1 and .project_workspace.completion_confirmations==1 and
  .contract_ledger.contracts==0 and .contract_ledger.revisions==0 and
  .evidence_service.files==0 and .evidence_service.versions==0 and
  .people_groups.persons==0 and .people_groups.groups==0 and .production_operations.work_items==0
' "$workspace/ownership-delta.json" >/dev/null || { echo 'C5 ownership delta is unexpected' >&2; cat "$workspace/ownership-delta.json" >&2; exit 1; }

echo '[8/8] Persist C5 and leave the isolated stack healthy'
running=$(docker ps --filter "label=com.docker.compose.project=$project" --format '{{.ID}}' | wc -l | tr -d ' ')
healthy=$(docker ps --filter "label=com.docker.compose.project=$project" --format '{{.Status}}' | awk '/healthy/{count++} END{print count+0}')
[ "$running" = 17 ] && [ "$healthy" = 17 ] || { echo "isolated stack ended $running/$healthy, expected 17/17" >&2; exit 1; }
captured_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
jq -n --arg captured "$captured_at" --arg tenant "$tenant_id" --arg c4 "$c4_sha" --arg project "$project_id" \
  --arg approval "$approval_id" --arg audit "$audit_id" --arg confirmation "$(jq -er .confirmation.id "$core_state")" \
  --slurpfile delta "$workspace/ownership-delta.json" \
  '{schema_version:"1",scenario_id:"reference-oa-full-suite-continuous-v1",phase:"C5",result:"pass",captured_at:$captured,tenant_id:$tenant,c4_state_sha256:$c4,
    project:{id:$project,revision:11,status:"active"},approval:{id:$approval,revision:2,state:"recorded"},audit:{id:$audit,revision:1,state:"recorded",frozen_approval_revision:1},
    completion_confirmation:{id:$confirmation,confirmed_project_revision:11},
    checks:{same_tenant_and_project:"pass",assessment_get_zero_write:"pass",dependency_failures_zero_write:"pass",same_command_recovery_single_commit:"pass",amount_redacted_not_zero:"pass",capability_revoke_denied:"pass",source_drift_visible:"pass",results_failure_local_replay_and_zero_write:"pass",exact_workload_credentials:"pass",ownership_delta_exact:"pass",isolated_stack_health:"17/17"},ownership_delta:$delta[0]}' >"$workspace/state-after-c5.json"

assertions=$(awk -F '\t' 'NR>1{count++} END{print count+0}' "$http_evidence")
mismatches=$(awk -F '\t' 'NR>1 && $2!=$3{count++} END{print count+0}' "$http_evidence")
[ "$mismatches" = 0 ] || { echo "HTTP mismatches=$mismatches" >&2; exit 1; }
cat >"$workspace/c5-summary.md" <<EOF
# C5 continuous journey result

- Result: pass
- Tenant: \`$tenant_id\`
- Project: \`$project_id\` revision 10 → 11; status remains active
- Approval: \`$approval_id\` revision 2 after append-only correction
- Audit: \`$audit_id\` revision 1, permanently freezing approval revision 1
- Completion: one explicit Project-owned checkpoint; later source correction is visible as drift
- Negative and fault paths: amount redaction, capability revoke, Evidence／Contract zero-write failures, Results unavailable and recovery
- HTTP assertions: $assertions; mismatches: 0
- Isolated stack health: 17/17
EOF
mkdir -p "$evidence_dir"
for artifact in ownership-before.json ownership-after.json ownership-delta.json approval-final.json audit-final.json approval-history.json audit-history.json assessment-final.json; do
  [ ! -f "$workspace/$artifact" ] || cp "$workspace/$artifact" "$evidence_dir/$artifact"
done
echo "PASS C5: tenant=$tenant_id project=$project_id@11 approval=$approval_id@2 audit=$audit_id@1"
