HTTP_ADDR=:8089
DATABASE_URL=postgres://business_engagement:business_engagement_dev@127.0.0.1:55439/business_engagement?sslmode=disable
MIGRATION_MODE=auto
SHUTDOWN_TIMEOUT=10s
REFERENCE_TIMEOUT=3s

# 本地模板仍强制 Bearer Token；不存在 AUTH_DISABLED 开关。
IDENTITY_PROVIDER=template
TEMPLATE_TENANT_ID=33333333-3333-4333-8333-333333333333
TEMPLATE_SUBJECT_ID=44444444-4444-4444-8444-444444444444
TEMPLATE_DISPLAY_NAME=本地经营管理员
TEMPLATE_ACCESS_TOKEN=replace-with-at-least-24-random-bytes

# Business Engagement 创建与材料关联必须在线校验 Project 和 Evidence。
PROJECT_BASE_URL=http://127.0.0.1:8086
PROJECT_ACCESS_TOKEN=replace-with-project-reference-token
EVIDENCE_BASE_URL=http://127.0.0.1:8085
EVIDENCE_ACCESS_TOKEN=replace-with-evidence-reference-token

# 正式 IAM 模式禁止上面的三个静态 Token；进站和出站都必须使用 IAM。
# IDENTITY_PROVIDER=iam
# IAM_ISSUER=https://oms.example.test/auth
# IAM_TENANT_ID=22222222-2222-4222-8222-222222222222
# IAM_PUBLIC_KEYS_PATH=/run/secrets/iam-public-keys.json
# IAM_SERVICE_CREDENTIAL_URL=https://oms.example.test/auth/api/v1/service-credentials
# WORKLOAD_ID=business-engagement
# WORKLOAD_SUBJECT_ID=44444444-4444-4444-8444-444444444444
# WORKLOAD_KEY_FILE=/run/secrets/business-engagement-workload-private.json
# WORKLOAD_REFRESH_BEFORE=15s
