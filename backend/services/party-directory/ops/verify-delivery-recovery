#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
app_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

for command_name in docker curl jq tar unzip; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "$command_name is required" >&2
    exit 1
  fi
done

acceptance_network=${PARTY_ACCEPTANCE_DOCKER_NETWORK:-}
if [ -z "$acceptance_network" ] && docker network inspect design-operations_default >/dev/null 2>&1; then
  acceptance_network=design-operations_default
fi
if [ -z "$acceptance_network" ]; then
  acceptance_network=$(docker network ls --filter driver=bridge --format '{{.Name}}' | awk '$1 != "bridge" { print; exit }')
fi
if [ -z "$acceptance_network" ] || ! docker network inspect "$acceptance_network" >/dev/null 2>&1; then
  echo "an existing user-defined Docker bridge network is required; set PARTY_ACCEPTANCE_DOCKER_NETWORK" >&2
  exit 1
fi

acceptance_root=$(mktemp -d)
acceptance_suffix="$(date +%s)-$$"
image="party-directory-acceptance:$acceptance_suffix"
postgres_container="party-directory-pg-$acceptance_suffix"
source_server="party-directory-source-$acceptance_suffix"
target_server="party-directory-target-$acceptance_suffix"

cleanup() {
  docker rm -f "$source_server" "$target_server" "$postgres_container" >/dev/null 2>&1 || true
  docker image rm "$image" >/dev/null 2>&1 || true
  case "$acceptance_root" in
    /tmp/*|/private/tmp/*|/var/folders/*) rm -rf "$acceptance_root" ;;
  esac
}
trap cleanup EXIT HUP INT TERM

release_dir="$acceptance_root/release"
extract_dir="$acceptance_root/extracted"
share_dir="$acceptance_root/share"
mkdir -p "$release_dir" "$extract_dir" "$share_dir"
chmod 0777 "$share_dir"

RELEASE_PROVENANCE_MODE=development RELEASE_COMMIT=party-acceptance RELEASE_BUILT_AT=2026-09-27T00:00:00Z \
  "$script_dir/build-release" v0.1.0-acceptance.1 "$release_dir" >/dev/null
archive="$release_dir/party-directory_v0.1.0-acceptance.1_$(go env GOOS)_$(go env GOARCH).tar.gz"
checksum="$archive.sha256"
if [ -z "$archive" ] || [ ! -f "$checksum" ]; then
  echo "release archive or checksum was not created" >&2
  exit 1
fi
(
  cd "$release_dir"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -c "$(basename "$checksum")"
  else
    shasum -a 256 -c "$(basename "$checksum")"
  fi
) >/dev/null
tar -xzf "$archive" -C "$extract_dir"
set -- "$extract_dir"/party-directory_*
if [ "$#" -ne 1 ]; then
  echo "release bundle must contain exactly one root directory" >&2
  exit 1
fi
bundle_root=$1
if [ ! -d "$bundle_root" ] || [ ! -x "$bundle_root/bin/party-directory-server" ] || [ ! -x "$bundle_root/bin/party-directory-ops" ] || [ ! -x "$bundle_root/bin/party-directory-backup" ]; then
  echo "release bundle is missing executable entries" >&2
  exit 1
fi
"$bundle_root/bin/party-directory-server" version | jq -e '.service == "party-directory" and .version == "v0.1.0-acceptance.1" and .commit == "party-acceptance"' >/dev/null
contract_count=$(find "$bundle_root/contracts" -type f -name 'party-*.yaml' | wc -l | tr -d ' ')
if [ "$contract_count" -ne 7 ] || [ ! -f "$bundle_root/models/Party.yaml" ] || [ ! -f "$bundle_root/models/PartyRevision.yaml" ]; then
  echo "release bundle does not contain the versioned Party contract set" >&2
  exit 1
fi

docker build \
  --build-arg VERSION=v0.1.0-acceptance.1 \
  --build-arg COMMIT=party-acceptance \
  --build-arg BUILT_AT=2026-09-27T00:00:00Z \
  -t "$image" "$app_dir" >/dev/null
image_user=$(docker image inspect "$image" --format '{{.Config.User}}')
if [ -z "$image_user" ] || [ "$image_user" = "0" ] || [ "$image_user" = "root" ]; then
  echo "Party image must declare a non-root user" >&2
  exit 1
fi
docker run --rm --entrypoint /bin/sh "$image" -c 'test "$(id -u)" -ne 0 && pg_dump --version >/dev/null && party-directory-server version' \
  | jq -e '.service == "party-directory" and .version == "v0.1.0-acceptance.1"' >/dev/null

database_user=party_acceptance
database_password=party_acceptance_password
source_database=party_source
target_database=party_target
docker run -d --name "$postgres_container" --network "$acceptance_network" \
  --tmpfs /var/lib/postgresql:rw,noexec,nosuid,size=512m \
  -e POSTGRES_DB=postgres -e POSTGRES_USER="$database_user" -e POSTGRES_PASSWORD="$database_password" \
  postgres:18.6-alpine >/dev/null
ready=0
for attempt in $(seq 1 60); do
  if docker exec "$postgres_container" pg_isready -U "$database_user" -d postgres >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done
if [ "$ready" -ne 1 ]; then
  echo "acceptance PostgreSQL did not become ready" >&2
  exit 1
fi
docker exec "$postgres_container" createdb -U "$database_user" "$source_database"
docker exec "$postgres_container" createdb -U "$database_user" "$target_database"

source_url="postgres://$database_user:$database_password@$postgres_container:5432/$source_database?sslmode=disable&connect_timeout=5"
target_url="postgres://$database_user:$database_password@$postgres_container:5432/$target_database?sslmode=disable&connect_timeout=5"
docker run --rm --network "$acceptance_network" -e DATABASE_URL="$source_url" --entrypoint party-directory-ops "$image" migrate >/dev/null

tenant_id=11111111-1111-4111-8111-111111111111
subject_id=22222222-2222-4222-8222-222222222222
access_token=party-directory-acceptance-token
cursor_key=party-directory-acceptance-cursor-key-32-bytes
docker run -d --name "$source_server" --network "$acceptance_network" -p 127.0.0.1::8090 \
  -e HTTP_ADDR=:8090 -e DATABASE_URL="$source_url" -e MIGRATION_MODE=verify \
  -e CURSOR_HMAC_KEY="$cursor_key" -e IDENTITY_PROVIDER=template \
  -e TEMPLATE_TENANT_ID="$tenant_id" -e TEMPLATE_SUBJECT_ID="$subject_id" \
  -e TEMPLATE_DISPLAY_NAME='Party Acceptance Admin' -e TEMPLATE_ACCESS_TOKEN="$access_token" \
  "$image" >/dev/null
source_port=$(docker port "$source_server" 8090/tcp | head -1 | sed 's/.*://')
source_base="http://127.0.0.1:$source_port"
ready=0
for attempt in $(seq 1 60); do
  if curl -fsS "$source_base/health/ready" >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done
if [ "$ready" -ne 1 ]; then
  docker logs "$source_server" >&2
  echo "Party source server did not become ready" >&2
  exit 1
fi

party_json=$(curl -fsS -X POST "$source_base/api/v1/parties" \
  -H "Authorization: Bearer $access_token" -H 'Content-Type: application/json' \
  -d '{"command_id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","kind":"organization","legal_name":"恢复验收设计院","registration_identifier":"TEST-001"}')
party_id=$(printf '%s' "$party_json" | jq -er 'select(.revision == 1 and .status == "active") | .id')
curl -fsS -X PUT "$source_base/api/v1/parties/$party_id" \
  -H "Authorization: Bearer $access_token" -H 'Content-Type: application/json' \
  -d '{"command_id":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb","expected_revision":1,"kind":"organization","legal_name":"恢复验收设计院（更正）","registration_identifier":"TEST-001","reason":"恢复演练前更正"}' \
  | jq -e '.revision == 2 and .legal_name == "恢复验收设计院（更正）"' >/dev/null
curl -fsS -X POST "$source_base/api/v1/parties/$party_id/status-changes" \
  -H "Authorization: Bearer $access_token" -H 'Content-Type: application/json' \
  -d '{"command_id":"cccccccc-cccc-4ccc-8ccc-cccccccccccc","expected_revision":2,"status":"inactive","reason":"恢复演练前停用"}' \
  | jq -e '.revision == 3 and .status == "inactive"' >/dev/null

docker rm -f "$source_server" >/dev/null
backup_path="$share_dir/party-directory-backup.zip"
docker run --rm --network "$acceptance_network" -v "$share_dir:/work" --entrypoint party-directory-backup "$image" \
  create --database-url "$source_url" --output /work/party-directory-backup.zip >/dev/null
unzip -p "$backup_path" manifest.json \
  | jq -e '.format == "omsbizfoundry.party-directory/full-backup-v1" and .database.schema_version == "000001_party_directory.sql" and ([.database.tables[].name] | index("parties") != null) and ([.database.tables[].name] | index("party_revisions") != null)' >/dev/null

docker run --rm --network "$acceptance_network" -v "$share_dir:/work:ro" --entrypoint party-directory-backup "$image" \
  restore --database-url "$target_url" --input /work/party-directory-backup.zip >/dev/null
if docker run --rm --network "$acceptance_network" -v "$share_dir:/work:ro" --entrypoint party-directory-backup "$image" \
  restore --database-url "$target_url" --input /work/party-directory-backup.zip >"$acceptance_root/nonempty.out" 2>"$acceptance_root/nonempty.err"; then
  echo "restore unexpectedly overwrote a non-empty target" >&2
  exit 1
fi
if ! grep -q 'restore target database is not empty' "$acceptance_root/nonempty.err"; then
  cat "$acceptance_root/nonempty.err" >&2
  echo "non-empty target rejection was not explicit" >&2
  exit 1
fi
docker run --rm --network "$acceptance_network" -e DATABASE_URL="$target_url" --entrypoint party-directory-ops "$image" check >/dev/null

docker run -d --name "$target_server" --network "$acceptance_network" -p 127.0.0.1::8090 \
  -e HTTP_ADDR=:8090 -e DATABASE_URL="$target_url" -e MIGRATION_MODE=verify \
  -e CURSOR_HMAC_KEY="$cursor_key" -e IDENTITY_PROVIDER=template \
  -e TEMPLATE_TENANT_ID="$tenant_id" -e TEMPLATE_SUBJECT_ID="$subject_id" \
  -e TEMPLATE_DISPLAY_NAME='Party Acceptance Admin' -e TEMPLATE_ACCESS_TOKEN="$access_token" \
  "$image" >/dev/null
target_port=$(docker port "$target_server" 8090/tcp | head -1 | sed 's/.*://')
target_base="http://127.0.0.1:$target_port"
ready=0
for attempt in $(seq 1 60); do
  if curl -fsS "$target_base/health/ready" >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done
if [ "$ready" -ne 1 ]; then
  docker logs "$target_server" >&2
  echo "Party restored server did not become ready" >&2
  exit 1
fi
curl -fsS "$target_base/api/v1/parties/$party_id" -H "Authorization: Bearer $access_token" \
  | jq -e --arg id "$party_id" '.id == $id and .revision == 3 and .status == "inactive" and .legal_name == "恢复验收设计院（更正）"' >/dev/null
curl -fsS "$target_base/api/v1/parties/$party_id/history" -H "Authorization: Bearer $access_token" \
  | jq -e '.items | length == 3' >/dev/null
curl -fsS -X POST "$target_base/api/v1/parties/$party_id/status-changes" \
  -H "Authorization: Bearer $access_token" -H 'Content-Type: application/json' \
  -d '{"command_id":"dddddddd-dddd-4ddd-8ddd-dddddddddddd","expected_revision":3,"status":"active","reason":"恢复后继续写入"}' \
  | jq -e '.revision == 4 and .status == "active"' >/dev/null

echo "Party Directory delivery/recovery acceptance passed: release checksum + contracts + non-root image + revision 1→3 backup + empty-target restore + revision 4 continued write"
