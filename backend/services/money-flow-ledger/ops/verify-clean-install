#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: verify-clean-install /absolute/release.tar.gz /absolute/release.tar.gz.sha256" >&2
  exit 2
fi

bundle_path=$1
checksum_path=$2
case "$bundle_path" in
  /*) ;;
  *) echo "release bundle path must be absolute" >&2; exit 2 ;;
esac
case "$checksum_path" in
  /*) ;;
  *) echo "release checksum path must be absolute" >&2; exit 2 ;;
esac
if [ ! -f "$bundle_path" ] || [ ! -f "$checksum_path" ]; then
  echo "release bundle and checksum must both be regular files" >&2
  exit 2
fi
if [ -z "${TEST_DATABASE_URL:-}" ]; then
  echo "TEST_DATABASE_URL is required" >&2
  exit 2
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
app_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

cd "$app_dir"
DELIVERY_BUNDLE_PATH="$bundle_path" \
DELIVERY_BUNDLE_SHA256_PATH="$checksum_path" \
GOWORK=off \
go test -count=1 -tags=integration \
  -run '^TestMoneyFlowReleaseCleanInstall$' \
  ./internal/deliveryacceptance
