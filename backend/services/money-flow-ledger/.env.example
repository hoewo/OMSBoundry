HTTP_ADDR=:8083
DATABASE_URL=postgres://money_flow:money_flow_dev@127.0.0.1:55433/money_flow?sslmode=disable
SHUTDOWN_TIMEOUT=10s
SESSION_TTL=12h
SESSION_COOKIE_SECURE=false
# 本地开发默认 auto；正式安装和升级使用 verify，并在启动前显式执行 ops migrate。
MIGRATION_MODE=auto
# local 保留独立安装；完整组合设置 iam 并由 Gateway 提供 Audience 专属凭证。
IDENTITY_PROVIDER=local
# IAM_ISSUER=https://oms.example.test/auth
# IAM_TENANT_ID=22222222-2222-4222-8222-222222222222
# IAM_PUBLIC_KEYS_PATH=/run/oms/iam-public-keys.json
# PUBLIC_BASE_PATH=/money
# Project Workspace 本地组合读取义务和收付款稳定投影时使用；两项必须成对设置。
# 正式 IAM 模式可以留空，改用 audience=money-flow-ledger 的短期 Capability Credential。
# REFERENCE_TENANT_ID=22222222-2222-4222-8222-222222222222
# REFERENCE_ACCESS_TOKEN=replace-with-random-24-plus-byte-token
# 可选：给实际收付款追加 Evidence 引用。本地模式必须同时设置 URL 与静态令牌；IAM 模式只设置 URL。
# EVIDENCE_BASE_URL=http://127.0.0.1:8085
# EVIDENCE_ACCESS_TOKEN=replace-with-random-24-plus-byte-token
# Empty user databases require this one-time pair. Remove the password after the first successful start.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Money Flow Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-bytes

# 仅全量备份／恢复 CLI 使用。通常与 DATABASE_URL 相同；本地 Compose wrapper 可使用容器内地址。
# POSTGRES_CLIENT_DATABASE_URL=postgres://money_flow:money_flow_dev@127.0.0.1:55433/money_flow?sslmode=disable
# PG_DUMP_BIN=pg_dump
# PG_RESTORE_BIN=pg_restore
