HTTP_ADDR=:8087
DATABASE_URL=postgres://design_operations:design_operations_dev@127.0.0.1:55438/design_operations?sslmode=disable
MIGRATION_MODE=auto
SHUTDOWN_TIMEOUT=10s
REFERENCE_TIMEOUT=3s
# 显式客户版本，默认关闭；不转换既有 version 1 任务。
REFERENCE_STAGE_MATERIAL_PROFILE=
# REFERENCE_STAGE_MATERIAL_PROFILE=reference-oa-stage-materials-v1

# 本地 Demo 仍验证 Bearer Token；不存在 AUTH_DISABLED 开关。
IDENTITY_PROVIDER=template
TEMPLATE_TENANT_ID=33333333-3333-4333-8333-333333333333
TEMPLATE_SUBJECT_ID=44444444-4444-4444-8444-444444444444
TEMPLATE_DISPLAY_NAME=本地设计管理员
TEMPLATE_ACCESS_TOKEN=replace-with-at-least-24-random-bytes

# 正式 IAM 模式改为：
# IDENTITY_PROVIDER=iam
# IAM_ISSUER=https://oms.example.test/auth
# IAM_TENANT_ID=33333333-3333-4333-8333-333333333333
# IAM_PUBLIC_KEYS_PATH=/path/to/public-keys.json
# IAM_SERVICE_CREDENTIAL_URL=https://oms.example.test/auth/v1/service-credentials
# WORKLOAD_ID=production-operations
# WORKLOAD_SUBJECT_ID=99999999-9999-4999-8999-999999999999
# WORKLOAD_KEY_FILE=/run/secrets/production-operations-workload-private.json
# WORKLOAD_REFRESH_BEFORE=15s

# Design Operations 只通过版本化只读引用接口校验外部事实。
PROJECT_BASE_URL=http://127.0.0.1:8086
PROJECT_ACCESS_TOKEN=replace-with-project-reference-token
PEOPLE_BASE_URL=http://127.0.0.1:8084
PEOPLE_ACCESS_TOKEN=replace-with-people-policy-fact-token
EVIDENCE_BASE_URL=http://127.0.0.1:8085
EVIDENCE_ACCESS_TOKEN=replace-with-evidence-reference-token
