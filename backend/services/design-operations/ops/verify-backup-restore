#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
app_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
run_suffix="$(date +%s)_$$"
source_db="design_operations_backup_source_$run_suffix"
target_db="design_operations_backup_target_$run_suffix"
work_dir=$(mktemp -d)
archive="$work_dir/design-operations.dump"

case "$source_db:$target_db" in
  design_operations_backup_source_[0-9]*:design_operations_backup_target_[0-9]*) ;;
  *) echo "unsafe temporary database name" >&2; exit 1 ;;
esac

database_admin() {
  docker compose --project-directory "$app_dir" exec -T postgres sh -c \
    'export PGPASSWORD="$POSTGRES_PASSWORD"; exec psql -v ON_ERROR_STOP=1 -U design_operations -d postgres "$@"' sh "$@"
}

cleanup() {
  database_admin -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname IN ('$source_db','$target_db') AND pid<>pg_backend_pid()" >/dev/null 2>&1 || true
  database_admin -c "DROP DATABASE IF EXISTS $target_db" -c "DROP DATABASE IF EXISTS $source_db" >/dev/null 2>&1 || true
  rm -rf "$work_dir"
}
trap cleanup EXIT HUP INT TERM

database_admin -c "CREATE DATABASE $source_db OWNER design_operations" -c "CREATE DATABASE $target_db OWNER design_operations" >/dev/null
(
  cd "$app_dir"
  DATABASE_URL="postgres://design_operations:design_operations_dev@127.0.0.1:55438/$source_db?sslmode=disable" \
  IDENTITY_PROVIDER=template \
  TEMPLATE_TENANT_ID=11111111-1111-4111-8111-111111111111 \
  TEMPLATE_SUBJECT_ID=22222222-2222-4222-8222-222222222222 \
  TEMPLATE_DISPLAY_NAME=backup-test \
  TEMPLATE_ACCESS_TOKEN=backup-test-token-123456789 \
  PROJECT_BASE_URL=http://127.0.0.1:18086 PROJECT_ACCESS_TOKEN=project-reference-test-token \
  EVIDENCE_BASE_URL=http://127.0.0.1:18085 EVIDENCE_ACCESS_TOKEN=evidence-reference-test-token \
  go run ./cmd/ops migrate
)

docker compose --project-directory "$app_dir" exec -T postgres sh -c \
  'export PGPASSWORD="$POSTGRES_PASSWORD"; exec psql -v ON_ERROR_STOP=1 -U design_operations -d "$1"' sh "$source_db" <<'SQL'
INSERT INTO design_work_items(id,tenant_id,project_id,project_source_revision,type_key,type_definition_version,status,revision,current_stage_key,created_by,created_at,updated_at)
VALUES('33333333-3333-4333-8333-333333333333','11111111-1111-4111-8111-111111111111','44444444-4444-4444-8444-444444444444',4,'design-v1',1,'draft',1,'scheme','22222222-2222-4222-8222-222222222222',clock_timestamp(),clock_timestamp());
INSERT INTO design_stages(tenant_id,work_item_id,stage_key,sequence,status,updated_at) VALUES
('11111111-1111-4111-8111-111111111111','33333333-3333-4333-8333-333333333333','scheme',10,'ready',clock_timestamp()),
('11111111-1111-4111-8111-111111111111','33333333-3333-4333-8333-333333333333','preliminary-design',20,'pending',clock_timestamp()),
('11111111-1111-4111-8111-111111111111','33333333-3333-4333-8333-333333333333','construction-drawing',30,'pending',clock_timestamp()),
('11111111-1111-4111-8111-111111111111','33333333-3333-4333-8333-333333333333','construction-support',40,'pending',clock_timestamp());
INSERT INTO design_commands(tenant_id,command_id,request_hash,response_status,response_json,created_at)
VALUES('11111111-1111-4111-8111-111111111111','aaaaaaaa-aaaa-4aaa-8aaa-000000000001',repeat('a',64),201,'{}',clock_timestamp());
INSERT INTO design_history_events(id,tenant_id,work_item_id,work_item_revision,event_sequence,event_type,command_id,actor_subject,occurred_at,payload)
VALUES('55555555-5555-4555-8555-555555555555','11111111-1111-4111-8111-111111111111','33333333-3333-4333-8333-333333333333',1,1,'work_item_created','aaaaaaaa-aaaa-4aaa-8aaa-000000000001','22222222-2222-4222-8222-222222222222',clock_timestamp(),'{}');
SQL

PGDATABASE="$source_db" "$app_dir/ops/local-pg-dump" --format=custom --no-owner --no-privileges > "$archive"
PGDATABASE="$target_db" "$app_dir/ops/local-pg-restore" --exit-on-error --no-owner --no-privileges --dbname="$target_db" < "$archive"

snapshot_sql="SELECT count(*)||':'||(SELECT count(*) FROM design_stages)||':'||(SELECT count(*) FROM design_commands)||':'||(SELECT count(*) FROM design_history_events)||':'||min(id::text)||':'||min(revision)::text FROM design_work_items"
source_snapshot=$(docker compose --project-directory "$app_dir" exec -T postgres sh -c 'export PGPASSWORD="$POSTGRES_PASSWORD"; exec psql -At -U design_operations -d "$1" -c "$2"' sh "$source_db" "$snapshot_sql")
target_snapshot=$(docker compose --project-directory "$app_dir" exec -T postgres sh -c 'export PGPASSWORD="$POSTGRES_PASSWORD"; exec psql -At -U design_operations -d "$1" -c "$2"' sh "$target_db" "$snapshot_sql")
if [ "$source_snapshot" != "$target_snapshot" ] || [ "$target_snapshot" != "1:4:1:1:33333333-3333-4333-8333-333333333333:1" ]; then
  echo "backup/restore mismatch: source=$source_snapshot target=$target_snapshot" >&2
  exit 1
fi
printf 'backup/restore verified: %s\n' "$target_snapshot"
