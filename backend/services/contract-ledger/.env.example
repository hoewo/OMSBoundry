HTTP_ADDR=:8081
DATABASE_URL=postgres://contract_ledger:contract_ledger_dev@127.0.0.1:55432/contract_ledger?sslmode=disable
SHUTDOWN_TIMEOUT=10s
# 本地开发默认 auto；正式安装和升级必须先用 ops migrate，再设置 verify。
MIGRATION_MODE=auto
SESSION_TTL=12h
# 本地 HTTP 使用 false；HTTPS 部署必须设置为 true。
SESSION_COOKIE_SECURE=false
IDENTITY_PROVIDER=local
# IAM mode requires the following values and must not set BOOTSTRAP_ADMIN_*:
# IDENTITY_PROVIDER=iam
# IAM_ISSUER=https://oms.example.test/auth
# IAM_TENANT_ID=22222222-2222-4222-8222-222222222222
# IAM_PUBLIC_KEYS_PATH=/run/oms/iam-public-keys.json
# PUBLIC_BASE_PATH=/contract
# Project Workspace 本地组合读取合同稳定投影时使用；两项必须成对设置。
# 正式 IAM 模式可以留空，改用 audience=contract-ledger 的短期 Capability Credential。
# REFERENCE_TENANT_ID=22222222-2222-4222-8222-222222222222
# REFERENCE_ACCESS_TOKEN=replace-with-random-24-plus-byte-token
# 遗留内嵌 Evidence 兼容目录；与 Contract 数据库联合备份，不接收参考 OA 新附件。
EVIDENCE_STORAGE_DIR=.data/evidence
# 可选外部 Evidence 新引用端口。未设置时附件明确不可用，不影响结构化合同。
# EXTERNAL_EVIDENCE_BASE_URL=https://evidence.example.test
# 正式 IAM 使用自己的 workload key，禁止 EXTERNAL_EVIDENCE_ACCESS_TOKEN。
# IAM_SERVICE_CREDENTIAL_URL=https://identity.example.test/api/v1/service-credentials
# WORKLOAD_ID=contract-reference-oa
# WORKLOAD_SUBJECT_ID=33333333-3333-4333-8333-333333333333
# WORKLOAD_KEY_FILE=/run/oms/contract-workload-private.json
# REFERENCE_TIMEOUT=3s
# 默认单文件上限 20 MiB。
EVIDENCE_MAX_UPLOAD_BYTES=20971520
# 仅备份／恢复 CLI 使用。通常与 DATABASE_URL 相同；当 PostgreSQL 客户端在容器内执行时可使用容器内地址。
# POSTGRES_CLIENT_DATABASE_URL=postgres://contract_ledger:contract_ledger_dev@127.0.0.1:55432/contract_ledger?sslmode=disable
# PG_DUMP_BIN=pg_dump
# PG_RESTORE_BIN=pg_restore
# 仅空数据库首次启动时使用；部署时必须替换示例密码并通过安全方式注入。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=本地管理员
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start
