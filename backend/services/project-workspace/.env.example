HTTP_ADDR=:8086
DATABASE_URL=postgres://project_workspace:project_workspace_dev@127.0.0.1:55437/project_workspace?sslmode=disable
MIGRATION_MODE=auto
SHUTDOWN_TIMEOUT=10s
REFERENCE_TIMEOUT=3s
# Closed customer overlay, off by default. Does not enroll existing Projects,
# expand old grants or expose personnel without native capability + scope.
# REFERENCE_OA_PRODUCTION_PERSONNEL_PROFILE=reference-oa-production-personnel-v1

# 本地 Demo 仍然验证 Bearer Token；不存在 AUTH_DISABLED 开关。
IDENTITY_PROVIDER=template
TEMPLATE_TENANT_ID=33333333-3333-4333-8333-333333333333
TEMPLATE_SUBJECT_ID=44444444-4444-4444-8444-444444444444
TEMPLATE_DISPLAY_NAME=本地项目管理员
TEMPLATE_ACCESS_TOKEN=replace-with-at-least-24-random-bytes

# 正式 IAM 模式改为：
# IDENTITY_PROVIDER=iam
# IAM_ISSUER=https://oms.example.test/auth
# IAM_TENANT_ID=22222222-2222-4222-8222-222222222222
# IAM_PUBLIC_KEYS_PATH=/path/to/public-keys.json

# Assignment 创建时必须在线验证 Person／Group。本地 template 模式可使用同形测试 Token。
# PEOPLE_BASE_URL=http://127.0.0.1:8084
# PEOPLE_ACCESS_TOKEN=replace-with-people-capability-token

# 普通 Project 可在创建时选择一个 Party，并冻结选择当时的最小快照。
# 未使用该能力时无需配置；template 模式使用同形测试 Token。
# PARTY_BASE_URL=http://127.0.0.1:8089
# PARTY_ACCESS_TOKEN=replace-with-party-reference-token

# 正式 IAM 模式禁止所有静态下游 ACCESS_TOKEN，必须使用可轮换工作负载身份动态交换精确资源凭证。
# IAM_SERVICE_CREDENTIAL_URL=https://oms.example.test/auth/api/v1/service-credentials
# WORKLOAD_ID=project-workspace
# WORKLOAD_SUBJECT_ID=44444444-4444-4444-8444-444444444444
# WORKLOAD_KEY_FILE=/run/secrets/project-workload-private.json
# WORKLOAD_REFRESH_BEFORE=15s

# Resource Link 只在实际使用对应类型时要求配置目标服务。
# CONTRACT_BASE_URL=http://127.0.0.1:8081
# CONTRACT_ACCESS_TOKEN=replace-with-contract-reference-token
# MONEY_BASE_URL=http://127.0.0.1:8083
# MONEY_ACCESS_TOKEN=replace-with-money-reference-token
# EVIDENCE_BASE_URL=http://127.0.0.1:8085
# EVIDENCE_ACCESS_TOKEN=replace-with-evidence-reference-token
# DESIGN_BASE_URL=http://127.0.0.1:8087
# DESIGN_ACCESS_TOKEN=replace-with-design-reference-token
# canonical Production materials are separate from the legacy Design port.
# PRODUCTION_BASE_URL=https://production.example.test
# Optional C6 material source; formal IAM uses workload identity, not a token.
# COST_BASE_URL=https://cost.example.test
# PRODUCTION_ACCESS_TOKEN=replace-with-production-reference-token
# BILLING_BASE_URL=http://127.0.0.1:8092
# BILLING_ACCESS_TOKEN=replace-with-billing-reference-token
# Business Engagement 只暴露当前 Evidence 引用投影；Project 再用自己的 Evidence 权限读取元数据。
# BUSINESS_ENGAGEMENT_BASE_URL=http://127.0.0.1:8091
# BUSINESS_ENGAGEMENT_ACCESS_TOKEN=replace-with-business-engagement-material-reference-token
# Completion Profile 只读评估按 Project Scope 读取批复／审计最小投影。
# RESULTS_BASE_URL=http://127.0.0.1:8095
# RESULTS_ACCESS_TOKEN=replace-with-results-reference-token
