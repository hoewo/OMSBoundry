HTTP_ADDR=:8097
DATABASE_URL=postgres://invoice_recognition:invoice_recognition_dev@127.0.0.1:55447/invoice_recognition?sslmode=disable
MIGRATION_MODE=auto
IDENTITY_PROVIDER=template
TEMPLATE_TENANT_ID=11111111-1111-4111-8111-111111111111
TEMPLATE_SUBJECT_ID=22222222-2222-4222-8222-222222222222
TEMPLATE_DISPLAY_NAME=本地发票复核员
TEMPLATE_ACCESS_TOKEN=replace-with-at-least-24-characters
EVIDENCE_BASE_URL=http://127.0.0.1:8083
EVIDENCE_ACCESS_TOKEN=replace-with-at-least-24-characters

# IAM mode
IAM_ISSUER=https://iam.example.test
IAM_TENANT_ID=11111111-1111-4111-8111-111111111111
IAM_PUBLIC_KEYS_PATH=/run/iam/public-keys.json
IAM_SERVICE_CREDENTIAL_URL=http://identity-access:8081/v1/service-credentials
WORKLOAD_ID=invoice-recognition
WORKLOAD_SUBJECT_ID=33333333-3333-4333-8333-333333333333
WORKLOAD_KEY_FILE=/run/secrets/invoice-recognition-workload-private-key.pem

# Optional image/PDF/OFD provider. XML recognition does not require it.
INVOICE_AI_PROVIDER_URL=
INVOICE_AI_PROVIDER_API_KEY=
INVOICE_AI_PROVIDER_MODEL=
INVOICE_AI_PROVIDER_TIMEOUT=90s

# Offline JPEG/PNG/PDF recognition fallback.
INVOICE_LOCAL_OCR_ENABLED=true
INVOICE_LOCAL_OCR_COMMAND=tesseract
INVOICE_PDF_RASTERIZER_COMMAND=pdftoppm
INVOICE_LOCAL_OCR_TIMEOUT=90s
