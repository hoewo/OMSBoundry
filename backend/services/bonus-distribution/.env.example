# IAM mode replaces all static user and reference tokens.
# IDENTITY_PROVIDER=iam
# IAM_ISSUER=https://iam.example.test
# IAM_TENANT_ID=11111111-1111-4111-8111-111111111111
# IAM_PUBLIC_KEYS_PATH=/run/secrets/iam-public-keys.json
# IAM_SERVICE_CREDENTIAL_URL=http://identity-access:8084/api/v1/service-credentials
# WORKLOAD_ID=bonus-distribution
# WORKLOAD_SUBJECT_ID=22222222-2222-4222-8222-222222222222
