# Explicit customer overlay; empty keeps the existing confirmed-source Pool API.
REFERENCE_OA_BONUS_PROFILE=
# Explicit customer overlay: v2 keeps legacy Assignment input; v3 also consumes
# Project's source-qualified reference-oa-production-personnel-v1 references.
# Empty disables both manual allocation routes. Selection never grants access.
