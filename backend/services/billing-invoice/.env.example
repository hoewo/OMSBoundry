HTTP_ADDR=:8091
DATABASE_URL=postgres://billing_invoice:billing_invoice_dev@127.0.0.1:55441/billing_invoice?sslmode=disable
MIGRATION_MODE=auto
ALLOWED_CURRENCIES=CNY
REFERENCE_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s

PARTY_BASE_URL=http://127.0.0.1:8090
PROJECT_BASE_URL=http://127.0.0.1:8086
CONTRACT_BASE_URL=http://127.0.0.1:8081
MONEY_BASE_URL=http://127.0.0.1:8083
EVIDENCE_BASE_URL=http://127.0.0.1:8085

# Local template mode. Replace every token; never reuse these values in IAM mode.
IDENTITY_PROVIDER=template
TEMPLATE_TENANT_ID=11111111-1111-4111-8111-111111111111
TEMPLATE_SUBJECT_ID=22222222-2222-4222-8222-222222222222
TEMPLATE_DISPLAY_NAME=本地 Billing 管理员
TEMPLATE_ACCESS_TOKEN=replace-with-32-byte-billing-token
PARTY_ACCESS_TOKEN=replace-with-party-reference-token
PROJECT_ACCESS_TOKEN=replace-with-project-reference-token
CONTRACT_ACCESS_TOKEN=replace-with-contract-reference-token
MONEY_ACCESS_TOKEN=replace-with-money-reference-token
EVIDENCE_ACCESS_TOKEN=replace-with-evidence-reference-token

# IAM mode replaces all template/static token settings above.
# IDENTITY_PROVIDER=iam
# IAM_ISSUER=https://iam.example.test
# IAM_TENANT_ID=11111111-1111-4111-8111-111111111111
# IAM_PUBLIC_KEYS_PATH=/run/secrets/iam-public-keys.json
# IAM_SERVICE_CREDENTIAL_URL=http://identity-access:8087/api/v1/service-credentials/exchange
# WORKLOAD_ID=billing-invoice
# WORKLOAD_SUBJECT_ID=33333333-3333-4333-8333-333333333333
# WORKLOAD_KEY_FILE=/run/secrets/billing-invoice-workload-key.json
# WORKLOAD_REFRESH_BEFORE=15s
