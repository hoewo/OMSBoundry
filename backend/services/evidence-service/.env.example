HTTP_ADDR=:8085
DATABASE_URL=postgres://evidence_service:evidence_service_dev@127.0.0.1:55436/evidence_service?sslmode=disable
# compose.standalone.yaml uses this password only on its private Docker network.
EVIDENCE_DB_PASSWORD=replace-with-a-long-random-url-safe-password
EVIDENCE_PORT=8085
MIGRATION_MODE=auto
IDENTITY_PROVIDER=template
PUBLIC_BASE_URL=http://127.0.0.1:8085
UPLOAD_SESSION_TTL=15m
ACCESS_GRANT_TTL=5m
MAX_UPLOAD_BYTES=2147483648
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./.runtime/evidence

# Replace with at least 32 random bytes encoded as unpadded base64url.
LOCAL_SIGNING_KEY=replace-with-unpadded-base64url

# Standalone template provider. Replace every value; this is authentication, not AUTH_DISABLED.
TEMPLATE_TENANT_ID=33333333-3333-4333-8333-333333333333
TEMPLATE_SUBJECT_ID=44444444-4444-4444-8444-444444444444
TEMPLATE_DISPLAY_NAME=本地文件管理员
TEMPLATE_ACCESS_TOKEN=replace-with-at-least-24-random-bytes

# IAM mode instead uses:
# IDENTITY_PROVIDER=iam
# IAM_ISSUER=https://oms.example.test/auth
# IAM_TENANT_ID=22222222-2222-4222-8222-222222222222
# IAM_PUBLIC_KEYS_PATH=/path/to/public-keys.json

# Aliyun OSS mode instead uses the Alibaba Cloud default credential chain for the server.
# STORAGE_PROVIDER=aliyun-oss
# OSS_REGION=cn-beijing
# OSS_BROWSER_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_SERVICE_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
# OSS_BUCKET=private-evidence-bucket
# OSS_ROLE_ARN=acs:ram::1234567890123456:role/evidence-browser-upload
# OSS_STS_ENDPOINT=sts.cn-beijing.aliyuncs.com
# OSS_STS_DURATION=15m
# OSS_ENDPOINT remains a backward-compatible fallback for both endpoint values,
# but new deployments should configure the browser and service endpoints explicitly.
