# Copy to .env.oss-validation. This file is intentionally not usable until every
# replace-with value is replaced. Never commit the copied file.
EVIDENCE_DB_PASSWORD=replace-with-a-long-random-url-safe-password
EVIDENCE_PORT=8085
MIGRATION_MODE=auto

IDENTITY_PROVIDER=template
TEMPLATE_TENANT_ID=33333333-3333-4333-8333-333333333333
TEMPLATE_SUBJECT_ID=44444444-4444-4444-8444-444444444444
TEMPLATE_DISPLAY_NAME=OSS 验收管理员
TEMPLATE_ACCESS_TOKEN=replace-with-at-least-24-random-bytes

PUBLIC_BASE_URL=http://127.0.0.1:8085
UPLOAD_SESSION_TTL=15m
ACCESS_GRANT_TTL=5m
MAX_UPLOAD_BYTES=2147483648

STORAGE_PROVIDER=aliyun-oss
OSS_REGION=replace-with-region-id
# Browser uploads and signed downloads must use the public endpoint.
OSS_BROWSER_ENDPOINT=https://oss-replace-with-region-id.aliyuncs.com
# Local validation also uses the public endpoint. On a same-region ECS, replace
# this with https://oss-replace-with-region-id-internal.aliyuncs.com.
OSS_SERVICE_ENDPOINT=https://oss-replace-with-region-id.aliyuncs.com
OSS_BUCKET=replace-with-private-bucket
OSS_ROLE_ARN=acs:ram::replace-with-aliyun-account-id:role/omsbizfoundryevidenceuploadrole
OSS_STS_DURATION=15m

# Local validation only. Production ECS uses an attached instance RAM role.
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-local-validation-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-local-validation-access-key-secret
